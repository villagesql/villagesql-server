#
# Case 1: database with routines only.
#
CREATE DATABASE test_sp_params_db;
USE test_sp_params_db;
CREATE PROCEDURE p1(IN input_val COMPLEX, OUT output_val COMPLEX)
BEGIN
SET output_val = input_val;
END//
CREATE FUNCTION f1(input_val COMPLEX) RETURNS COMPLEX DETERMINISTIC
BEGIN
RETURN input_val;
END//
SET SESSION debug='+d,skip_dd_table_access_check';
SELECT db_name, sp_name, param_name, type_name
FROM villagesql.custom_sp_params
WHERE db_name = 'test_sp_params_db'
  ORDER BY sp_name, param_name;
db_name	sp_name	param_name	type_name
test_sp_params_db	f1	@returns	COMPLEX
test_sp_params_db	f1	input_val	COMPLEX
test_sp_params_db	p1	input_val	COMPLEX
test_sp_params_db	p1	output_val	COMPLEX
USE test;
DROP DATABASE test_sp_params_db;
SHOW DATABASES LIKE 'test_sp_params_db';
Database (test_sp_params_db)
SET SESSION debug='+d,skip_dd_table_access_check';
SELECT db_name, sp_name, param_name, type_name
FROM villagesql.custom_sp_params
WHERE db_name = 'test_sp_params_db'
  ORDER BY sp_name, param_name;
db_name	sp_name	param_name	type_name
#
# Case 2: database with routines and a custom-typed column, so that
# custom_sp_params and custom_columns both have rows staged for deletion
# in the same statement.
#
CREATE DATABASE test_sp_params_tbl_db;
USE test_sp_params_tbl_db;
CREATE PROCEDURE p1(IN input_val COMPLEX, OUT output_val COMPLEX)
BEGIN
SET output_val = input_val;
END//
CREATE FUNCTION f1(input_val COMPLEX) RETURNS COMPLEX DETERMINISTIC
BEGIN
RETURN input_val;
END//
CREATE TABLE t1 (id INT PRIMARY KEY, c COMPLEX);
INSERT INTO t1 VALUES (1, '(1.0, 2.0)');
SET SESSION debug='+d,skip_dd_table_access_check';
SELECT db_name, sp_name, param_name, type_name
FROM villagesql.custom_sp_params
WHERE db_name = 'test_sp_params_tbl_db'
  ORDER BY sp_name, param_name;
db_name	sp_name	param_name	type_name
test_sp_params_tbl_db	f1	@returns	COMPLEX
test_sp_params_tbl_db	f1	input_val	COMPLEX
test_sp_params_tbl_db	p1	input_val	COMPLEX
test_sp_params_tbl_db	p1	output_val	COMPLEX
SELECT db_name, table_name, column_name, type_name
FROM villagesql.custom_columns
WHERE db_name = 'test_sp_params_tbl_db'
  ORDER BY table_name, column_name;
db_name	table_name	column_name	type_name
test_sp_params_tbl_db	t1	c	COMPLEX
USE test;
DROP DATABASE test_sp_params_tbl_db;
SHOW DATABASES LIKE 'test_sp_params_tbl_db';
Database (test_sp_params_tbl_db)
SET SESSION debug='+d,skip_dd_table_access_check';
SELECT db_name, sp_name, param_name, type_name
FROM villagesql.custom_sp_params
WHERE db_name = 'test_sp_params_tbl_db'
  ORDER BY sp_name, param_name;
db_name	sp_name	param_name	type_name
SELECT db_name, table_name, column_name, type_name
FROM villagesql.custom_columns
WHERE db_name = 'test_sp_params_tbl_db'
  ORDER BY table_name, column_name;
db_name	table_name	column_name	type_name
