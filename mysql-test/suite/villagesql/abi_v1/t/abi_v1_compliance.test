# ABI v1 Compliance Test
#
# Compiles an extension against villagesql/stable_sdk/v1/ headers and verifies
# it loads and runs correctly against the current server.  This test catches ABI
# regressions: if the server breaks binary compatibility with v1, the
# extension will fail to load or produce wrong results.
#
# Requires: cmake in PATH, C++ compiler in PATH

--source include/villagesql/binlog_check_begin.inc

--echo # ABI v1 Compliance Test

--let $veb_dir = `SELECT @@veb_dir`
--let $build_dir = `SELECT @@basedir`
--let $test_dir = $MYSQLTEST_VARDIR/tmp/abi_v1_test

# Write the build dir path for perl to read
--exec mkdir -p $MYSQLTEST_VARDIR/tmp
--exec printf '%s' "$build_dir" > $MYSQLTEST_VARDIR/tmp/abi_v1_build_dir.txt

# Locate the stable_sdk/v1/ snapshot via the cmake-generated source dir file
--perl
use strict;

my $vardir = $ENV{'MYSQLTEST_VARDIR'};

open(my $fh, '<', "$vardir/tmp/abi_v1_build_dir.txt") or die "Cannot read build dir: $!";
my $build_dir = <$fh>;
chomp $build_dir;
close $fh;
$build_dir =~ s{//+}{/}g;

my $src_file = "$build_dir/villagesql_source_dir.txt";
if (!-f $src_file) {
    print "villagesql_source_dir.txt not found at: $src_file\n";
    print "Re-run cmake to regenerate.\n";
    exit(1);
}

open(my $sf, '<', $src_file) or die "Cannot read source dir file: $!";
my $src = <$sf>;
chomp $src;
close $sf;
$src =~ s{//+}{/}g;

if (!-d "$src/villagesql/stable_sdk/v1") {
    print "SDK v1 directory not found at: $src/villagesql/stable_sdk/v1\n";
    exit(1);
}
print "Found SDK v1 source directory\n";

# Save source dir for the --exec shell commands below
open(my $out, '>', "$vardir/tmp/abi_v1_src.txt") or die "Cannot write source dir: $!";
print $out $src;
close $out;
EOF

--echo # Building test extension
--exec rm -rf $test_dir
--exec mkdir -p $test_dir/build
--exec sh -c "snapshot=\$(cat $MYSQLTEST_VARDIR/tmp/abi_v1_src.txt)/villagesql/stable_sdk/v1 && cmake -S \$snapshot/test_extension -B $test_dir/build -DCMAKE_PREFIX_PATH=\$snapshot > $test_dir/cmake_out.txt 2>&1"
--exec sh -c "cmake --build $test_dir/build > $test_dir/make_out.txt 2>&1"

--echo # Verify VEB was created
--file_exists $test_dir/build/abi_v1_test.veb

--echo # Copy VEB to server's VEB directory
--exec cp $test_dir/build/abi_v1_test.veb $veb_dir/

--echo # Install the extension
INSTALL EXTENSION abi_v1_test;

--echo # Verify extension is installed
SELECT extension_name, extension_version FROM INFORMATION_SCHEMA.EXTENSIONS
WHERE extension_name = 'abi_v1_test';

--echo #
--echo # from_string: STRING -> BYTEARRAY callable VDF
--echo #

--echo # Round-trip: from_string then to_string
SELECT abi_v1_test.to_string(abi_v1_test.from_string('hello')) AS roundtrip;

--echo #
--echo # mask: mixed BYTEARRAY + INT parameters
--echo #

--echo # Mask position 0
SELECT abi_v1_test.to_string(abi_v1_test.mask(abi_v1_test.from_string('hello'), 0)) AS result;

--echo # Mask position 1
SELECT abi_v1_test.to_string(abi_v1_test.mask(abi_v1_test.from_string('hello'), 1)) AS result;

--echo # Mask position 7 (last position in 8-byte array)
SELECT abi_v1_test.to_string(abi_v1_test.mask(abi_v1_test.from_string('abcdefgh'), 7)) AS result;

--echo # Out-of-range offset error returns NULL and a warning
SELECT abi_v1_test.to_string(abi_v1_test.mask(abi_v1_test.from_string('hello'), 100)) AS result;

--echo #
--echo # NULL handling: each parameter slot independently
--echo #

--echo # NULL BYTEARRAY input
SELECT abi_v1_test.mask(NULL, 0) AS result;

--echo # NULL INT offset
SELECT abi_v1_test.mask(abi_v1_test.from_string('hello'), NULL) AS result;

--echo #
--echo # Same-function chaining against table data
--echo #

CREATE TABLE t (id INT PRIMARY KEY, data BYTEARRAY);
INSERT INTO t VALUES (1, 'password'), (2, 'abcdefgh');

SELECT id,
       abi_v1_test.to_string(
         abi_v1_test.mask(abi_v1_test.mask(data, 0), 1)
       ) AS masked_0_1
FROM t ORDER BY id;

DROP TABLE t;

--echo # Uninstall extension
UNINSTALL EXTENSION abi_v1_test;

--echo # Verify extension was removed
SELECT extension_name FROM INFORMATION_SCHEMA.EXTENSIONS
WHERE extension_name = 'abi_v1_test';

--echo # Cleanup
--exec rm -rf $test_dir
--exec rm -f $veb_dir/abi_v1_test.veb
--exec rm -f $MYSQLTEST_VARDIR/tmp/abi_v1_build_dir.txt
--exec rm -f $MYSQLTEST_VARDIR/tmp/abi_v1_src.txt

--source include/villagesql/binlog_check_end.inc
