# ABI v1 Binary Compatibility Test
Found VillageSQL SDK paths
# Building test extension against stable SDK
# Verify VEB was created
# Copy VEB to server's VEB directory
# Install the extension
INSTALL EXTENSION abi_v1_test;
# Verify extension is installed
SELECT extension_name, extension_version FROM INFORMATION_SCHEMA.EXTENSIONS
WHERE extension_name = 'abi_v1_test';
EXTENSION_NAME	EXTENSION_VERSION
abi_v1_test	0.0.1
#
# from_string: STRING -> BYTEARRAY callable VDF
#
# Round-trip: from_string then to_string
SELECT abi_v1_test.to_string(abi_v1_test.from_string('hello')) AS roundtrip;
roundtrip
hello   
# Type-methods: not supported for raw function pointers
SELECT abi_v1_test.BYTEARRAY::from_string('hello') AS typemethod;
ERROR HY000: Type 'BYTEARRAY' method 'from_string' does not support '::' syntax (not registered with a '::' name)
#
# mask: mixed BYTEARRAY + INT parameters
#
# Mask position 0
SELECT abi_v1_test.to_string(abi_v1_test.mask(abi_v1_test.from_string('hello'), 0)) AS result;
result
*ello   
# Mask position 1
SELECT abi_v1_test.to_string(abi_v1_test.mask(abi_v1_test.from_string('hello'), 1)) AS result;
result
h*llo   
# Mask position 7 (last position in 8-byte array)
SELECT abi_v1_test.to_string(abi_v1_test.mask(abi_v1_test.from_string('abcdefgh'), 7)) AS result;
result
abcdefg*
# Out-of-range offset
# (v1 behavior: returns NULL with warning)
SELECT abi_v1_test.to_string(abi_v1_test.mask(abi_v1_test.from_string('hello'), 100)) AS result;
result
NULL
Warnings:
Warning	3200	VDF error in function 'mask': offset 100 is out of range [0, 7]
#
# NULL handling: each parameter slot independently
#
# NULL BYTEARRAY input
SELECT abi_v1_test.mask(NULL, 0) AS result;
result
NULL
# NULL INT offset
SELECT abi_v1_test.mask(abi_v1_test.from_string('hello'), NULL) AS result;
result
NULL
#
# Same-function chaining against table data
#
CREATE TABLE t (id INT PRIMARY KEY, data BYTEARRAY);
INSERT INTO t VALUES (1, 'password'), (2, 'abcdefgh');
SELECT id,
abi_v1_test.to_string(
abi_v1_test.mask(abi_v1_test.mask(data, 0), 1)
) AS masked_0_1
FROM t ORDER BY id;
id	masked_0_1
1	**ssword
2	**cdefgh
DROP TABLE t;
# Uninstall extension
UNINSTALL EXTENSION abi_v1_test;
# Verify extension was removed
SELECT extension_name FROM INFORMATION_SCHEMA.EXTENSIONS
WHERE extension_name = 'abi_v1_test';
EXTENSION_NAME
INSTALL EXTENSION abi_v1_test;
SELECT NEGOTIATED_PROTOCOL FROM INFORMATION_SCHEMA.EXTENSION_REGISTRATION
WHERE EXTENSION_NAME = 'abi_v1_test';
NEGOTIATED_PROTOCOL
1
CREATE TABLE t (id INT PRIMARY KEY, data abi_v1_test.BYTEARRAY);
INSERT INTO t VALUES (1, _binary 'literal'), (2, _binary 0xFF41);
INSERT INTO t VALUES (6, 0x686578), (7, b'01100010');
CREATE TABLE t_bin (id INT PRIMARY KEY, b VARBINARY(8));
INSERT INTO t_bin VALUES (3, 'column'), (4, 0xC3A9);
INSERT INTO t SELECT id, b FROM t_bin;
PREPARE s FROM 'INSERT INTO t VALUES (?, ?)';
SET @id = 5, @v = _binary 'param';
EXECUTE s USING @id, @v;
DEALLOCATE PREPARE s;
SELECT id, HEX(abi_v1_test.to_string(data)) AS data FROM t ORDER BY id;
id	data
1	6C69746572616C20
2	FF41202020202020
3	636F6C756D6E2020
4	C3A9202020202020
5	706172616D202020
6	6865782020202020
7	6220202020202020
SELECT id FROM t WHERE data = 0x686578;
id
6
SELECT HEX(abi_v1_test.to_string(abi_v1_test.mask(_binary 'argument', 0)))
AS masked;
masked
2A7267756D656E74
SET @id = NULL, @v = NULL;
DROP TABLE t, t_bin;
UNINSTALL EXTENSION abi_v1_test;
# Cleanup
include/rpl/deprecated/show_binlog_events.inc
Log_name	Pos	Event_type	Server_id	End_log_pos	Info
