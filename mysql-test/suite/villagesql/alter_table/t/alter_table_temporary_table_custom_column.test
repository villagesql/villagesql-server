# Test ALTER TABLE on temporary tables with COMPLEX columns.
# Covers adding and dropping a custom column, and verifies data integrity.

--source include/villagesql/install_complex_extension.inc
--source include/villagesql/binlog_check_begin.inc

CREATE TEMPORARY TABLE t1 (
    id INT PRIMARY KEY,
    name VARCHAR(50)
);

SHOW COLUMNS FROM t1;

# Add a custom column to the temporary table.
ALTER TABLE t1 ADD COLUMN value COMPLEX;

SHOW COLUMNS FROM t1;

INSERT INTO t1 VALUES (1, 'test1', '(1.0,2.0)');
INSERT INTO t1 VALUES (2, 'test2', '(3.5,-1.2)');

SELECT * FROM t1;

# Drop the custom column and verify data integrity.
ALTER TABLE t1 DROP COLUMN value;

SHOW COLUMNS FROM t1;

SELECT * FROM t1;

DROP TABLE t1;

--source include/villagesql/binlog_check_end.inc
--source include/villagesql/uninstall_complex_extension.inc
