# ALTER TABLE and CREATE TABLE ... LIKE of a table with a custom type column,
# racing FLUSH TABLES. #1667.
#
# Metadata_modifier::process_alter() opens the VillageSQL system tables with
# a second open_tables() call, after mysql_alter_table() has opened the table
# it alters. When a FLUSH TABLES ran in between, the shares of the two opens
# have different versions, and open_tables() backs off: it closes all tables
# the statement has opened so far, the altered table included, and opens only
# the system tables again. mysql_alter_table() then went on with the closed
# TABLE and read freed memory in prepare_fields_and_keys().
# CREATE TABLE ... LIKE read the closed source table the same way: it failed
# with ER_WRONG_COLUMN_NAME on a column name read from freed memory, or
# crashed in count_keys().
# Found by pstress (lifecycle workload, FLUSH TABLES of the vsql tables).
#
# Verifies:
# - the ALTER completes and the table has the altered definition and its rows
# - the CREATE TABLE ... LIKE completes and copies the source definition
# - the server stays up

--source include/have_debug_sync.inc
--source include/count_sessions.inc

--source include/villagesql/install_complex_extension.inc

CREATE TABLE t1 (id INT PRIMARY KEY, c COMPLEX, c2 COMPLEX) ENGINE=InnoDB;
INSERT INTO t1 VALUES (1, '(1,2)', '(3,4)'), (2, '(5,6)', '(7,8)');

connect (con_ddl,localhost,root,,test);
connect (con_flush,localhost,root,,test);

--echo #
--echo # ALTER TABLE
--echo #

connection con_ddl;
--echo # con_ddl: ALTER TABLE, parked after it opened t1
SET DEBUG_SYNC = 'alter_table_after_mdl_lock_fk SIGNAL opened WAIT_FOR flushed';
--send ALTER TABLE t1 MODIFY c2 COMPLEX

connection default;
SET DEBUG_SYNC = 'now WAIT_FOR opened';

connection con_flush;
--echo # con_flush: FLUSH TABLES, which waits for t1 to be closed
--send FLUSH TABLES

connection default;
let $wait_condition =
  SELECT COUNT(*) = 1 FROM information_schema.processlist
  WHERE info = 'FLUSH TABLES' AND state = 'Waiting for table flush';
--source include/wait_condition.inc
--echo # default: let the ALTER go on to open the system tables
SET DEBUG_SYNC = 'now SIGNAL flushed';

connection con_ddl;
reap;
SET DEBUG_SYNC = 'RESET';

connection con_flush;
reap;

connection default;
SHOW CREATE TABLE t1;
SELECT id, c, c2 FROM t1 ORDER BY id;

--echo #
--echo # CREATE TABLE ... LIKE
--echo #

CREATE TABLE t2 (id INT PRIMARY KEY, c COMPLEX, KEY k_c (c),
                 KEY k_fn ((complex_real(c)))) ENGINE=InnoDB;
INSERT INTO t2 VALUES (1, '(1,2)');

connection con_ddl;
--echo # con_ddl: CREATE TABLE ... LIKE, parked after it opened t2
SET DEBUG_SYNC = 'create_table_like_after_open SIGNAL opened WAIT_FOR flushed';
--send CREATE TABLE t3 LIKE t2

connection default;
SET DEBUG_SYNC = 'now WAIT_FOR opened';

connection con_flush;
--echo # con_flush: FLUSH TABLES, which waits for t2 to be closed
--send FLUSH TABLES

connection default;
--source include/wait_condition.inc
--echo # default: let the CREATE go on to open the system tables
SET DEBUG_SYNC = 'now SIGNAL flushed';

connection con_ddl;
reap;
SET DEBUG_SYNC = 'RESET';

connection con_flush;
reap;

connection default;
SHOW CREATE TABLE t3;

disconnect con_ddl;
disconnect con_flush;
DROP TABLE t1, t2, t3;
--source include/villagesql/uninstall_complex_extension.inc
SET DEBUG_SYNC = 'RESET';
--source include/wait_until_count_sessions.inc
