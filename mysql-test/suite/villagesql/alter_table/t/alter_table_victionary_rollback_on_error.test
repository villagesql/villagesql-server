# Test that a failed ALTER TABLE adding a custom type column does not leave a
# stale victionary entry. If it does, a subsequent ALTER adding a non-custom
# column with the same name causes a field_length mismatch assertion on table
# open.
#
# Derived from RQG crash (vil_dbg_crash1.sql):
#   ALTER TABLE t13 ADD COLUMN rqg_c4 COMPLEX, MODIFY COLUMN rqg_c4 INT ...
#   (fails: unknown column rqg_c4 in MODIFY)
#   ALTER TABLE t13 ADD COLUMN rqg_c4 INT ...
#   (table open asserts field_length=4 != persisted_length=16)

--source include/villagesql/install_complex_extension.inc

CREATE TABLE t (id INT PRIMARY KEY, val INT);
INSERT INTO t VALUES (1, 10);

# This fails because MODIFY references a column being added in the same statement.
--error ER_BAD_FIELD_ERROR
ALTER TABLE t ADD COLUMN z COMPLEX, MODIFY COLUMN z INT NOT NULL;

# Now add z as a non-custom type. Should not crash with field_length mismatch.
ALTER TABLE t ADD COLUMN z INT;

SELECT * FROM t ORDER BY id;

DROP TABLE t;

# Regression for issue #1189: a failed ALTER that adds a custom column under
# LOCK TABLES fails inside process_alter (opening the villagesql system tables
# is not permitted under LOCK TABLES) after the victionary mark was already
# staged. The staged mark must be rolled back; otherwise the implicit commit at
# the start of the next statement sweeps it into the committed set, and a
# subsequent CHANGE COLUMN referring to that never-created column asserts on
# find_field_in_table_sef returning null.
CREATE TABLE t1 (c1 INT);
LOCK TABLES t1 WRITE;
--error ER_TABLE_NOT_LOCKED
ALTER TABLE t1 ADD COLUMN c2 COMPLEX;
# c2 was never created and its staged victionary mark was rolled back, so this
# is treated as a plain-to-custom conversion of a non-existent column and errors
# cleanly instead of crashing.
--error ER_VILLAGESQL_GENERIC_ERROR
ALTER TABLE t1 CHANGE COLUMN c2 c3 COMPLEX;
UNLOCK TABLES;
DROP TABLE t1;

--source include/villagesql/uninstall_complex_extension.inc
