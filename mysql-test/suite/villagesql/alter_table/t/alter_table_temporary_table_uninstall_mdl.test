# Test that extension uninstall is blocked while a temporary table holds a
# custom column added via ALTER TABLE, and succeeds once the column is dropped.

--source include/villagesql/install_complex_extension.inc

CREATE TEMPORARY TABLE t1 (id INT PRIMARY KEY, name VARCHAR(50));

# No custom columns yet - uninstall should succeed.
--source include/villagesql/uninstall_complex_extension.inc
--source include/villagesql/install_complex_extension.inc

ALTER TABLE t1 ADD COLUMN value COMPLEX;

--echo # UNINSTALL should fail - t1 holds a reference via the custom column
--error ER_VILLAGESQL_GENERIC_ERROR
UNINSTALL EXTENSION vsql_complex;

ALTER TABLE t1 DROP COLUMN value;

--echo # UNINSTALL should now succeed - custom column dropped
--source include/villagesql/uninstall_complex_extension.inc

DROP TABLE t1;
