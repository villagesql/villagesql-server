# ALTER TABLE ... RENAME TO on a table with several custom columns, where the
# same statement changes only some of them.
#
# The rename has to move the columns the statement does not otherwise mention,
# and leave the ones it does to their own operation. Moving all of them
# duplicates work already done per column; moving none of them strands the
# untouched columns under the old table name.

--source include/villagesql/install_complex_extension.inc

CREATE TABLE t1 (c1 COMPLEX, c2 COMPLEX, c3 COMPLEX);
--source include/villagesql/query_custom_columns.inc

ALTER TABLE t1 RENAME TO t2, DROP COLUMN c1, RENAME COLUMN c2 TO c9;

# c1 is gone, c2 became c9, and the untouched c3 followed the rename.
--source include/villagesql/query_custom_columns.inc
SHOW CREATE TABLE t2;

INSERT INTO t2 VALUES ('(1.0,2.0)', '(3.0,4.0)');
SELECT * FROM t2;

DROP TABLE t2;
--source include/villagesql/query_custom_columns.inc

--source include/villagesql/uninstall_complex_extension.inc
