# Test ALTER TABLE type conversion with NULL values using native MySQL types.
# This documents expected behavior for comparison with custom type behavior.

# nullable -> nullable: NULL is preserved
CREATE TABLE t1 (
    id INT PRIMARY KEY,
    value INT
);

INSERT INTO t1 VALUES (1, 42);
INSERT INTO t1 VALUES (2, NULL);

SELECT * FROM t1;

ALTER TABLE t1 MODIFY COLUMN value VARCHAR(20);

SELECT * FROM t1;

DROP TABLE t1;

# nullable -> NOT NULL with NULL data: errors in strict mode
CREATE TABLE t2 (
    id INT PRIMARY KEY,
    value VARCHAR(20)
);

INSERT INTO t2 VALUES (1, 'hello');
INSERT INTO t2 VALUES (2, NULL);

SELECT * FROM t2;

--error ER_INVALID_USE_OF_NULL
ALTER TABLE t2 MODIFY COLUMN value VARCHAR(20) NOT NULL;

SELECT * FROM t2;

DROP TABLE t2;

# nullable -> NOT NULL INT with NULL data: errors in strict mode
CREATE TABLE t3 (
    id INT PRIMARY KEY,
    value INT
);

INSERT INTO t3 VALUES (1, 42);
INSERT INTO t3 VALUES (2, NULL);

SELECT * FROM t3;

--error ER_INVALID_USE_OF_NULL
ALTER TABLE t3 MODIFY COLUMN value INT NOT NULL;

SELECT * FROM t3;

DROP TABLE t3;
