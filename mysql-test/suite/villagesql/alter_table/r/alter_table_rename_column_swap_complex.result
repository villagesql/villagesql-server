# A RENAME TABLE that swaps two tables whose custom columns have the same
# name, then renames one of the swapped tables in the same statement.
CREATE TABLE s1 (id INT PRIMARY KEY, c COMPLEX);
CREATE TABLE s2 (id INT PRIMARY KEY, c COMPLEX2);
# When a later pair fails, the statement changes nothing.
CREATE TABLE s4 (id INT PRIMARY KEY);
RENAME TABLE s1 TO tmp, s2 TO s1, tmp TO s2, s2 TO s4;
ERROR 42S01: Table 's4' already exists
SELECT * FROM villagesql.custom_columns;
db_name	table_name	column_name	extension_name	extension_version	type_name	type_parameters
test	s1	c	vsql_complex	0.0.1	COMPLEX	{}
test	s2	c	vsql_complex	0.0.1	COMPLEX2	{}
DROP TABLE s4;
RENAME TABLE s1 TO tmp, s2 TO s1, tmp TO s2, s2 TO s3;
SELECT * FROM villagesql.custom_columns;
db_name	table_name	column_name	extension_name	extension_version	type_name	type_parameters
test	s1	c	vsql_complex	0.0.1	COMPLEX2	{}
test	s3	c	vsql_complex	0.0.1	COMPLEX	{}
SHOW CREATE TABLE s1;
Table	Create Table
s1	CREATE TABLE `s1` (
  `id` int NOT NULL,
  `c` vsql_complex.COMPLEX2 DEFAULT NULL,
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
SHOW CREATE TABLE s3;
Table	Create Table
s3	CREATE TABLE `s3` (
  `id` int NOT NULL,
  `c` vsql_complex.COMPLEX DEFAULT NULL,
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
DROP TABLE s1, s3;
