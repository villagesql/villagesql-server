Table	Create Table
t1	CREATE TABLE `t1` (
  `id` int NOT NULL,
  `string_val` varchar(100) DEFAULT NULL,
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
