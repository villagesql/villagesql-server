  `name` varchar(50) DEFAULT NULL,
  `value` vsql_complex.COMPLEX DEFAULT NULL,
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
ALTER TABLE t1 ADD INDEX idx_real ((COMPLEX_REAL(value)));
ALTER TABLE t1 ADD INDEX idx_imag ((COMPLEX_IMAG(value)));
ALTER TABLE t1 ADD INDEX idx_abs ((COMPLEX_ABS(value)));
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `id` int NOT NULL,
  `name` varchar(50) DEFAULT NULL,
  `value` vsql_complex.COMPLEX DEFAULT NULL,
  PRIMARY KEY (`id`),
  KEY `idx_real` ((vsql_complex.complex_real(`value`))),
  KEY `idx_imag` ((vsql_complex.complex_imag(`value`))),
  KEY `idx_abs` ((vsql_complex.complex_abs(`value`)))
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
