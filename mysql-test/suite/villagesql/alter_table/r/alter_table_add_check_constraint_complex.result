CREATE TABLE t1 (
id INT PRIMARY KEY,
name VARCHAR(50),
value COMPLEX
);
INSERT INTO t1 VALUES (1, 'test1', '(1.0,2.0)');
INSERT INTO t1 VALUES (2, 'test2', '(3.5,-1.2)');
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `id` int NOT NULL,
  `name` varchar(50) DEFAULT NULL,
  `value` vsql_complex.COMPLEX DEFAULT NULL,
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
ALTER TABLE t1 ADD CONSTRAINT chk_complex_range CHECK (COMPLEX_REAL(value) >= 0 AND COMPLEX_IMAG(value) >= -5);
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `id` int NOT NULL,
  `name` varchar(50) DEFAULT NULL,
  `value` vsql_complex.COMPLEX DEFAULT NULL,
  PRIMARY KEY (`id`),
  CONSTRAINT `chk_complex_range` CHECK (((vsql_complex.complex_real(`value`) >= 0) and (vsql_complex.complex_imag(`value`) >= -(5))))
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
INSERT INTO t1 VALUES (3, 'test3', '(2.5,1.0)');
INSERT INTO t1 VALUES (4, 'test4', '(-1.0,2.0)');
ERROR HY000: Check constraint 'chk_complex_range' is violated.
