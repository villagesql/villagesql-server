CREATE TABLE t1 (
id INT PRIMARY KEY,
name VARCHAR(50),
value COMPLEX,
CONSTRAINT chk_complex CHECK (COMPLEX_ABS(value) < 10.0)
);
INSERT INTO t1 VALUES (1, 'test1', '(1.0,2.0)');
