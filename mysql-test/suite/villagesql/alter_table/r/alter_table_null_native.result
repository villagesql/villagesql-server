CREATE TABLE t1 (
id INT PRIMARY KEY,
value INT
);
INSERT INTO t1 VALUES (1, 42);
INSERT INTO t1 VALUES (2, NULL);
SELECT * FROM t1;
id	value
1	42
2	NULL
ALTER TABLE t1 MODIFY COLUMN value VARCHAR(20);
SELECT * FROM t1;
id	value
1	42
2	NULL
DROP TABLE t1;
CREATE TABLE t2 (
id INT PRIMARY KEY,
value VARCHAR(20)
);
INSERT INTO t2 VALUES (1, 'hello');
INSERT INTO t2 VALUES (2, NULL);
SELECT * FROM t2;
id	value
1	hello
2	NULL
ALTER TABLE t2 MODIFY COLUMN value VARCHAR(20) NOT NULL;
ERROR 22004: Invalid use of NULL value
SELECT * FROM t2;
id	value
1	hello
2	NULL
DROP TABLE t2;
CREATE TABLE t3 (
id INT PRIMARY KEY,
value INT
);
INSERT INTO t3 VALUES (1, 42);
INSERT INTO t3 VALUES (2, NULL);
SELECT * FROM t3;
id	value
1	42
2	NULL
ALTER TABLE t3 MODIFY COLUMN value INT NOT NULL;
