CREATE TABLE t1 (id INT PRIMARY KEY, name VARCHAR(50)) ENGINE=MyISAM;
INSERT INTO t1 VALUES (1, 'hello');
INSERT INTO t1 VALUES (2, 'world');
SELECT * FROM t1;
id	name
1	hello
2	world
ALTER TABLE t1 ADD COLUMN value COMPLEX, ENGINE=InnoDB;
ERROR HY000: Cannot combine storage engine change with custom type columns.
ALTER TABLE t1 ENGINE=InnoDB;
ALTER TABLE t1 ADD COLUMN value COMPLEX;
SELECT * FROM t1;
id	name	value
1	hello	NULL
2	world	NULL
INSERT INTO t1 VALUES (3, 'HELLO', '(-1.0,2.0)');
INSERT INTO t1 VALUES (4, 'WORLD', '(1.0,-2.0)');
SELECT * FROM t1;
id	name	value
1	hello	NULL
2	world	NULL
3	HELLO	(-1,2)
4	WORLD	(1,-2)
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `id` int NOT NULL,
  `name` varchar(50) DEFAULT NULL,
  `value` vsql_complex.COMPLEX DEFAULT NULL,
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
DROP TABLE t1;
