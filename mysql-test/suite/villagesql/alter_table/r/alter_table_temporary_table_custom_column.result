CREATE TEMPORARY TABLE t1 (
id INT PRIMARY KEY,
name VARCHAR(50)
);
SHOW COLUMNS FROM t1;
Field	Type	Null	Key	Default	Extra
id	int	NO	PRI	NULL	NULL
name	varchar(50)	YES		NULL	NULL
ALTER TABLE t1 ADD COLUMN value COMPLEX;
SHOW COLUMNS FROM t1;
Field	Type	Null	Key	Default	Extra
id	int	NO	PRI	NULL	NULL
name	varchar(50)	YES		NULL	NULL
value	vsql_complex.COMPLEX	YES		NULL	NULL
INSERT INTO t1 VALUES (1, 'test1', '(1.0,2.0)');
INSERT INTO t1 VALUES (2, 'test2', '(3.5,-1.2)');
SELECT * FROM t1;
id	name	value
1	test1	(1,2)
2	test2	(3.5,-1.2)
ALTER TABLE t1 DROP COLUMN value;
SHOW COLUMNS FROM t1;
Field	Type	Null	Key	Default	Extra
id	int	NO	PRI	NULL	NULL
name	varchar(50)	YES		NULL	NULL
SELECT * FROM t1;
id	name
1	test1
2	test2
DROP TABLE t1;
