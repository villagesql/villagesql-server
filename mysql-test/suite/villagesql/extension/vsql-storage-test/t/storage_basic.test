# Basic smoke test for the vsql_storage_test extension.
# Exercises the STORED_INT custom type, which uses the experimental
# vsql::experimental::storage API to persist values in a dedicated InnoDB
# segment (one page per row) rather than inline in the clustered index.
#
# Covers: install, CREATE TABLE, INSERT, SELECT, UPDATE, DELETE, DROP TABLE,
# and UNINSTALL EXTENSION.

SET PERSIST vsql_allow_preview_extensions = ON;

--echo # Install extension
INSTALL EXTENSION vsql_storage_test;

--echo # Create a table with a STORED_INT column
CREATE TABLE t1 (id INT PRIMARY KEY, n STORED_INT);

--echo # Insert several values including negative and zero
INSERT INTO t1 VALUES (1, '42');
INSERT INTO t1 VALUES (2, '-7');
INSERT INTO t1 VALUES (3, '0');

--echo # Select all rows
SELECT id, n FROM t1 ORDER BY id;

--echo # Update a value (triggers mark_delete + insert in storage)
UPDATE t1 SET n = '999' WHERE id = 1;
SELECT id, n FROM t1 ORDER BY id;

--echo # Delete a row (triggers mark_delete in storage, purge happens async)
DELETE FROM t1 WHERE id = 2;
SELECT id, n FROM t1 ORDER BY id;

DROP TABLE t1;

--echo #
--echo # Two column-store columns in one table. The extension registers
--echo # STORED_INT and STORED_INT_2 as separate entries of one
--echo # ColumnStoreCapability, so each column owns its own segment and every
--echo # storage callback runs once per column.
--echo #
CREATE TABLE t2 (id INT PRIMARY KEY, a STORED_INT, b STORED_INT_2);
INSERT INTO t2 VALUES (1, '10', '20');
INSERT INTO t2 VALUES (2, '-3', '0');
--echo # A NULL custom column stores no value at all
INSERT INTO t2 VALUES (3, NULL, '7');
SELECT id, a, b FROM t2 ORDER BY id;

--echo # Update both columns of a row
UPDATE t2 SET a = '111', b = '222' WHERE id = 1;
SELECT id, a, b FROM t2 ORDER BY id;

--echo # Update only one of the two columns
UPDATE t2 SET b = '999' WHERE id = 2;
SELECT id, a, b FROM t2 ORDER BY id;

--echo # Check updating a NULL column
UPDATE t2 SET a = '55' WHERE a IS NULL;
SELECT * FROM t2;
UPDATE t2 SET a = NULL WHERE a = '55';
SELECT * FROM t2;

--echo # Update a NULL column to a value, and a value back to NULL
UPDATE t2 SET a = '55' WHERE id = 3;
UPDATE t2 SET b = NULL WHERE id = 2;
SELECT id, a, b FROM t2 ORDER BY id;

--echo # Delete a row: both columns are delete-marked
DELETE FROM t2 WHERE id = 1;
SELECT id, a, b FROM t2 ORDER BY id;

--echo # Rebuild the table: both columns are fetched and re-inserted
ALTER TABLE t2 FORCE, ALGORITHM=INPLACE;
SELECT id, a, b FROM t2 ORDER BY id;
CHECK TABLE t2;

--echo # Drop one of the two columns: its segment goes, the other survives
ALTER TABLE t2 DROP COLUMN a;
SELECT id, b FROM t2 ORDER BY id;

--echo # Cleanup
DROP TABLE t2;

--echo # Uninstall extension
UNINSTALL EXTENSION vsql_storage_test;

SET PERSIST vsql_allow_preview_extensions = OFF;
RESET PERSIST vsql_allow_preview_extensions;
