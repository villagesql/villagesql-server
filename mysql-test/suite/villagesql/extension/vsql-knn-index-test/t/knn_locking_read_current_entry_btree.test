# A READ COMMITTED locking KNN read must return the rows whose index entry is
# current, whatever else happened to the row.
#
# The extension reports the inserting transaction as each entry's trx_ref.
# Index type kvec_l2_btree stores no primary key: the server resolves rows through
# its column reference to primary key mapping B-tree.
#   1. Fresh rows: every row is returned.
#   2. After an UPDATE of a non-indexed column, the row is still returned:
#      the index entry is unchanged and still current.
#   3. A row locked by another session's uncommitted change is waited for (here
#      reported by NOWAIT), not silently skipped.

--source include/count_sessions.inc

INSTALL EXTENSION vsql_knn_index_test;

--let $kvec_key = v kvec_profile_l2_btree
--let $kvec_index = kvec_l2_btree
--source suite/villagesql/extension/vsql-knn-index-test/t/knn_locking_read_current_entry.inc

UNINSTALL EXTENSION vsql_knn_index_test;
--source include/wait_until_count_sessions.inc
