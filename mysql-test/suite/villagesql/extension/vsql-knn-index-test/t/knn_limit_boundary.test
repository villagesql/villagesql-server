# KNN scan with a LIMIT around the largest limit that fits in the scan
# descriptor (32 bits, 4294967295).
#
# A limit up to 4294967295, including the OFFSET, uses the KNN scan. A larger
# limit does not: the rows are sorted instead. Either way the query must return
# the K nearest rows in the right order, and never a truncated number of rows.
# The table has fewer rows than any of these limits, so every query returns all
# the rows. The number of KNN scans started tells which plan was used.
#
# A KNN scan is not used for a locking read under REPEATABLE READ, so UPDATE
# runs under READ COMMITTED.

--source include/have_binlog_format_row.inc

INSTALL EXTENSION vsql_knn_index_test;

CREATE TABLE t (
  id INT PRIMARY KEY,
  v  KVECTOR,
  n  INT DEFAULT 0
);
CREATE INDEX idx_v ON t (v)
  USING EXTENDED(vsql_knn_index_test.kvec_l2);

--echo # Distances from [0,0,0,0] are 10, 1, 20, 3 and 5. Nearest first: 2, 4, 5, 1, 3.
INSERT INTO t (id, v) VALUES
  (1, '[10,0,0,0]'),
  (2, '[1,0,0,0]'),
  (3, '[20,0,0,0]'),
  (4, '[3,0,0,0]'),
  (5, '[5,0,0,0]');

--echo # --- LIMIT 4294967295 fits: the KNN scan is used ---
SET @begins = vsql_knn_index_test.kvec_scan_begin_count();
SELECT id FROM t
ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[0,0,0,0]') LIMIT 4294967295;
SELECT vsql_knn_index_test.kvec_scan_begin_count() - @begins AS knn_scans;

--echo # --- LIMIT 4294967296 does not fit: no KNN scan, same rows ---
SET @begins = vsql_knn_index_test.kvec_scan_begin_count();
SELECT id FROM t
ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[0,0,0,0]') LIMIT 4294967296;
SELECT vsql_knn_index_test.kvec_scan_begin_count() - @begins AS knn_scans;

--echo # --- LIMIT 4294967297, a value that would truncate to 1 ---
SET @begins = vsql_knn_index_test.kvec_scan_begin_count();
SELECT id FROM t
ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[0,0,0,0]') LIMIT 4294967297;
SELECT vsql_knn_index_test.kvec_scan_begin_count() - @begins AS knn_scans;

--echo # --- The largest LIMIT ---
SET @begins = vsql_knn_index_test.kvec_scan_begin_count();
SELECT id FROM t
ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[0,0,0,0]')
LIMIT 18446744073709551615;
SELECT vsql_knn_index_test.kvec_scan_begin_count() - @begins AS knn_scans;

--echo # --- The OFFSET counts: 4294967295 + 1 does not fit ---
SET @begins = vsql_knn_index_test.kvec_scan_begin_count();
SELECT id FROM t
ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[0,0,0,0]')
LIMIT 4294967295 OFFSET 1;
SELECT vsql_knn_index_test.kvec_scan_begin_count() - @begins AS knn_scans;

--echo # --- 4294967290 + 2 fits ---
SET @begins = vsql_knn_index_test.kvec_scan_begin_count();
SELECT id FROM t
ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[0,0,0,0]')
LIMIT 4294967290 OFFSET 2;
SELECT vsql_knn_index_test.kvec_scan_begin_count() - @begins AS knn_scans;

--echo # --- UPDATE with a LIMIT that fits and one that does not ---
SET SESSION TRANSACTION ISOLATION LEVEL READ COMMITTED;
SET @begins = vsql_knn_index_test.kvec_scan_begin_count();
UPDATE t SET n = n + 1
ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[0,0,0,0]') LIMIT 4294967295;
SELECT vsql_knn_index_test.kvec_scan_begin_count() - @begins AS knn_scans;

SET @begins = vsql_knn_index_test.kvec_scan_begin_count();
UPDATE t SET n = n + 1
ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[0,0,0,0]') LIMIT 4294967296;
SELECT vsql_knn_index_test.kvec_scan_begin_count() - @begins AS knn_scans;
SELECT id, n FROM t ORDER BY id;

DROP TABLE t;
UNINSTALL EXTENSION vsql_knn_index_test;
