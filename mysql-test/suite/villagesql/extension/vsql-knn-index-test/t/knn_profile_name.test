# The index learns which profile is bound to its key column through the
# profile's name, and computes that profile's metric itself.
#
# kvec_native has two profiles, kvec_profile_native_l2 and
# kvec_profile_native_cos. Its scan reads the name with Index::profile_name()
# and ranks with its own L2 or cosine code instead of calling the profile's
# helper. kvec_native_scan_count() counts those scans. A kvec_l2 scan still
# ranks through the helper.
#
# Distances from [1,0,0,0]:
#   id  v            L2      cosine
#   1   [1,0,0,0]    0       0
#   2   [0,2,0,0]    2.236   1
#   3   [3,0.1,0,0]  2.002   0.0006
#   4   [1,1,0,0]    1       0.293
#   5   [2,1,0,0]    1.414   0.106
# L2 nearest 3: 1 4 5. Cosine nearest 3: 1 3 5.

INSTALL EXTENSION vsql_knn_index_test;

--disable_query_log
--disable_result_log
SELECT vsql_knn_index_test.kvec_reset_counters();
--enable_result_log
--enable_query_log

CREATE TABLE t_l2 (id INT PRIMARY KEY, v KVECTOR);
CREATE TABLE t_cos (id INT PRIMARY KEY, v KVECTOR);
CREATE TABLE t_helper (id INT PRIMARY KEY, v KVECTOR);

CREATE INDEX idx_v ON t_l2 (v kvec_profile_native_l2)
  USING EXTENDED(vsql_knn_index_test.kvec_native);
CREATE INDEX idx_v ON t_cos (v kvec_profile_native_cos)
  USING EXTENDED(vsql_knn_index_test.kvec_native);
CREATE INDEX idx_v ON t_helper (v)
  USING EXTENDED(vsql_knn_index_test.kvec_l2);

INSERT INTO t_l2 VALUES
  (1, '[1,0,0,0]'),
  (2, '[0,2,0,0]'),
  (3, '[3,0.1,0,0]'),
  (4, '[1,1,0,0]'),
  (5, '[2,1,0,0]');
INSERT INTO t_cos SELECT * FROM t_l2;
INSERT INTO t_helper SELECT * FROM t_l2;

--echo #
--echo # L2 profile: the KNN scan ranks with the index's own L2 code.
--echo #
--replace_regex /cost=[0-9.e+-]+/cost=COST/ /rows=[0-9.e+-]+/rows=ROWS/
EXPLAIN FORMAT=tree
SELECT id FROM t_l2
ORDER BY vsql_knn_index_test.kvec_l2_distance(v,
           KVECTOR::from_string('[1,0,0,0]'))
LIMIT 3;

SELECT id FROM t_l2
ORDER BY vsql_knn_index_test.kvec_l2_distance(v,
           KVECTOR::from_string('[1,0,0,0]'))
LIMIT 3;

SELECT vsql_knn_index_test.kvec_native_scan_count() AS native_scans;

--echo #
--echo # Cosine profile on the same index type: the scan ranks with the index's
--echo # own cosine code.
--echo #
--replace_regex /cost=[0-9.e+-]+/cost=COST/ /rows=[0-9.e+-]+/rows=ROWS/
EXPLAIN FORMAT=tree
SELECT id FROM t_cos
ORDER BY vsql_knn_index_test.kvec_cos_distance(v,
           KVECTOR::from_string('[1,0,0,0]'))
LIMIT 3;

SELECT id FROM t_cos
ORDER BY vsql_knn_index_test.kvec_cos_distance(v,
           KVECTOR::from_string('[1,0,0,0]'))
LIMIT 3;

SELECT vsql_knn_index_test.kvec_native_scan_count() AS native_scans;

--echo #
--echo # The kvec_l2 profile ranks through the helper: the KNN scan runs, and the
--echo # native scan count is unchanged.
--echo #
SELECT vsql_knn_index_test.kvec_scan_begin_count() INTO @begins_before;

SELECT id FROM t_helper
ORDER BY vsql_knn_index_test.kvec_l2_distance(v,
           KVECTOR::from_string('[1,0,0,0]'))
LIMIT 3;

SELECT vsql_knn_index_test.kvec_scan_begin_count() - @begins_before
  AS helper_scans;
SELECT vsql_knn_index_test.kvec_native_scan_count() AS native_scans;

DROP TABLE t_l2, t_cos, t_helper;
UNINSTALL EXTENSION vsql_knn_index_test;
