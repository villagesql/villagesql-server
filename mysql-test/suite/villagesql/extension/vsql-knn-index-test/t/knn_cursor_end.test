# The server ends the extension cursor of a KNN scan.
#
# A KNN scan can stop before the end of the index, for example at a LIMIT, so
# the cursor is not always closed when the scan reaches the end. The server must
# end it when the scan ends. The extension counts the cursors that were created
# and not ended (kvec_open_cursors), which must be 0 after each statement.
#
# The test also switches the same table handler between a KNN scan, a primary
# key scan and a scan of another secondary index, including an UPDATE or DELETE
# after a scan that read the end of the other index. The KNN scan must not use
# the cursor position left by the earlier scan of the clustered index.
#
# A KNN scan is not used for a locking read under REPEATABLE READ, so the test
# runs under READ COMMITTED.

--source include/have_binlog_format_row.inc

INSTALL EXTENSION vsql_knn_index_test;

CREATE TABLE t (
  id INT PRIMARY KEY,
  v  KVECTOR,
  n  INT,
  KEY idx_n (n)
);
CREATE INDEX idx_v ON t (v)
  USING EXTENDED(vsql_knn_index_test.kvec_l2);

--echo # Distances from [0,0,0,0] are 1, 3, 5, 10 and 20: all distinct.
INSERT INTO t VALUES
  (1, '[1,0,0,0]', 50),
  (2, '[3,0,0,0]', 40),
  (3, '[0,5,0,0]', 30),
  (4, '[10,0,0,0]', 20),
  (5, '[20,0,0,0]', 10);

SET SESSION TRANSACTION ISOLATION LEVEL READ COMMITTED;

--echo # --- A SELECT stopped by LIMIT leaves no cursor open ---
SELECT id FROM t
ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[0,0,0,0]') LIMIT 1;
SELECT vsql_knn_index_test.kvec_open_cursors() AS open_cursors;

--echo # --- A DELETE stopped by LIMIT leaves no cursor open ---
SET @begins = vsql_knn_index_test.kvec_scan_begin_count();
DELETE FROM t
ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[0,0,0,0]') LIMIT 1;
SELECT vsql_knn_index_test.kvec_scan_begin_count() - @begins AS knn_scans;
SELECT vsql_knn_index_test.kvec_open_cursors() AS open_cursors;

--echo # --- An UPDATE stopped by LIMIT leaves no cursor open ---
SET @begins = vsql_knn_index_test.kvec_scan_begin_count();
UPDATE t SET n = n + 1
ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[0,0,0,0]') LIMIT 1;
SELECT vsql_knn_index_test.kvec_scan_begin_count() - @begins AS knn_scans;
SELECT vsql_knn_index_test.kvec_open_cursors() AS open_cursors;

--echo # --- Switch between KNN, primary key and secondary index scans ---
--echo # KNN scan stopped by LIMIT, then a primary key scan.
SELECT id FROM t
ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[0,0,0,0]') LIMIT 1;
SELECT id FROM t ORDER BY id LIMIT 2;
SELECT vsql_knn_index_test.kvec_open_cursors() AS open_cursors;

--echo # Then a scan of the other secondary index.
SELECT id FROM t FORCE INDEX (idx_n) ORDER BY n LIMIT 2;
SELECT vsql_knn_index_test.kvec_open_cursors() AS open_cursors;

--echo # Then a KNN scan again.
SELECT id FROM t
ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[0,0,0,0]') LIMIT 2;
SELECT vsql_knn_index_test.kvec_open_cursors() AS open_cursors;

--echo # --- DELETE after a primary key scan that read the end of the index ---
SELECT id, n FROM t ORDER BY id;
DELETE FROM t
ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[0,0,0,0]') LIMIT 1;
SELECT id FROM t ORDER BY id;
SELECT vsql_knn_index_test.kvec_open_cursors() AS open_cursors;

--echo # --- UPDATE after a secondary index scan that read the end of the index ---
SELECT id FROM t FORCE INDEX (idx_n) ORDER BY n;
UPDATE t SET n = n + 100
ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[0,0,0,0]') LIMIT 1;
SELECT id, n FROM t ORDER BY id;
SELECT vsql_knn_index_test.kvec_open_cursors() AS open_cursors;

DROP TABLE t;
UNINSTALL EXTENSION vsql_knn_index_test;
