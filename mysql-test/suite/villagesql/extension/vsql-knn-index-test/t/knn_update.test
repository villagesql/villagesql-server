# UPDATE ... ORDER BY <distance> LIMIT k uses the KNN scan to find the rows.
#
# A KNN scan is not used for a locking read under REPEATABLE READ, so the test
# runs under READ COMMITTED.

--source include/have_binlog_format_row.inc

INSTALL EXTENSION vsql_knn_index_test;

CREATE TABLE t (
  id INT PRIMARY KEY,
  v  KVECTOR,
  g  INT,
  n  INT DEFAULT 0
);
CREATE INDEX idx_v ON t (v)
  USING EXTENDED(vsql_knn_index_test.kvec_l2);

--echo # Distances from [0,0,0,0] are 1, 3, 5, 10 and 20: all distinct.
INSERT INTO t (id, v, g) VALUES
  (1, '[1,0,0,0]', 1),
  (2, '[3,0,0,0]', 2),
  (3, '[0,5,0,0]', 1),
  (4, '[10,0,0,0]', 2),
  (5, '[20,0,0,0]', 1);

SET SESSION TRANSACTION ISOLATION LEVEL READ COMMITTED;

--echo # --- Update a column that is not indexed for the two nearest rows ---
UPDATE t SET n = n + 10
ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[0,0,0,0]') LIMIT 2;
SELECT id, n FROM t ORDER BY id;

--echo # --- A condition rejects rows: the nearest matching rows are updated ---
UPDATE t SET n = n + 100 WHERE g = 1
ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[0,0,0,0]') LIMIT 2;
SELECT id, n FROM t ORDER BY id;

--echo # --- Update the indexed column of the nearest rows ---
--echo # Each row is updated once, although it moves to a later position in the
--echo # scan. Rows 1 and 2 move to distances 30 and 40.
UPDATE t SET v = '[30,0,0,0]'
ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[0,0,0,0]') LIMIT 1;
UPDATE t SET v = '[40,0,0,0]'
ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[0,0,0,0]') LIMIT 1;
SELECT id FROM t
ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[0,0,0,0]') LIMIT 10;

--echo # --- Update the indexed column of several rows in one statement ---
--echo # A row moved by the update must not be updated again. Rows 3, 4 and 5 move
--echo # to distance 100, behind rows 1 and 2.
UPDATE t SET v = '[100,0,0,0]', n = n + 1
ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[0,0,0,0]') LIMIT 3;
SELECT id, n FROM t ORDER BY id;
SELECT id FROM t
ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[0,0,0,0]') LIMIT 2;

DROP TABLE t;
UNINSTALL EXTENSION vsql_knn_index_test;
