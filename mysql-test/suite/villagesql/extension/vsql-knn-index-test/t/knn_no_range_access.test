# A custom index that does not advertise HA_READ_RANGE / HA_READ_ORDER must not
# be chosen by the optimizer for WHERE predicates (ref, range) or for a plain
# ORDER BY on the column. KNN ordering must keep working.

INSTALL EXTENSION vsql_knn_index_test;

CREATE TABLE t (
  id INT PRIMARY KEY,
  v  KVECTOR
);
CREATE INDEX idx_v ON t (v)
  USING EXTENDED(vsql_knn_index_test.kvec_l2);
INSERT INTO t VALUES
  (1, '[1,0,0,0]'),
  (2, '[0,1,0,0]'),
  (3, '[0,0,1,0]');

--echo # Equality, range and NULL predicates must not use idx_v.
--replace_column 10 ROWS 11 FILTERED
EXPLAIN SELECT * FROM t WHERE v = '[0,1,0,0]';
--replace_column 10 ROWS 11 FILTERED
EXPLAIN SELECT * FROM t WHERE v > '[0,1,0,0]';
--replace_column 10 ROWS 11 FILTERED
EXPLAIN SELECT * FROM t WHERE v IS NULL;
--replace_column 10 ROWS 11 FILTERED
EXPLAIN SELECT * FROM t WHERE v IS NOT NULL;
SELECT id FROM t WHERE v = '[0,1,0,0]';

--echo # Plain ORDER BY on the column must not use idx_v.
--replace_column 10 ROWS 11 FILTERED
EXPLAIN SELECT * FROM t ORDER BY v;

--echo # KNN ordering still uses idx_v.
--replace_regex /cost=[0-9.e+-]+/cost=COST/ /rows=[0-9.e+-]+/rows=ROWS/
EXPLAIN FORMAT=tree
SELECT id FROM t
ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]') LIMIT 2;

DROP TABLE t;
UNINSTALL EXTENSION vsql_knn_index_test;
