# A column of a const table printed in EXPLAIN.
#
# The optimizer reads a const table (one row found by its primary key) while
# planning, and EXPLAIN prints its column values instead of the column names.
# A custom type value must be printed in its readable form, and a NULL value
# must be printed as NULL without trying to decode it. A column of a const table
# can also be the query point of a KNN scan, which EXPLAIN prints.

INSTALL EXTENSION vsql_knn_index_test;

CREATE TABLE t (
  id INT PRIMARY KEY,
  v  KVECTOR
);
CREATE INDEX idx_v ON t (v)
  USING EXTENDED(vsql_knn_index_test.kvec_l2);
INSERT INTO t VALUES
  (1, '[1,0,0,0]'),
  (2, '[3,0,0,0]'),
  (3, '[5,0,0,0]'),
  (4, '[10,0,0,0]'),
  (5, '[20,0,0,0]');

CREATE TABLE q (
  id INT PRIMARY KEY,
  v  KVECTOR
);
INSERT INTO q VALUES (1, '[0,0,0,0]'), (2, NULL);

--echo # --- A custom type value of a const table is printed in readable form ---
--disable_result_log
EXPLAIN SELECT v FROM q WHERE id = 1;
--enable_result_log
SHOW WARNINGS;

--echo # --- A NULL value of a const table is printed as NULL ---
--disable_result_log
EXPLAIN SELECT v FROM q WHERE id = 2;
--enable_result_log
SHOW WARNINGS;

--echo # --- A const table column as the query point of a KNN scan ---
--replace_regex /cost=[0-9.e+-]+/cost=COST/ /rows=[0-9.e+-]+/rows=ROWS/
EXPLAIN FORMAT=tree
SELECT t.id FROM t, q WHERE q.id = 1
ORDER BY vsql_knn_index_test.kvec_l2_distance(t.v, q.v) LIMIT 2;

SELECT t.id FROM t, q WHERE q.id = 1
ORDER BY vsql_knn_index_test.kvec_l2_distance(t.v, q.v) LIMIT 2;

--echo # --- A NULL const table column as the query point gives no KNN scan ---
SET @begins = vsql_knn_index_test.kvec_scan_begin_count();
--error ER_UDF_ERROR
SELECT t.id FROM t, q WHERE q.id = 2
ORDER BY vsql_knn_index_test.kvec_l2_distance(t.v, q.v) LIMIT 2;
SELECT vsql_knn_index_test.kvec_scan_begin_count() - @begins AS knn_scans;

DROP TABLE q;
DROP TABLE t;
UNINSTALL EXTENSION vsql_knn_index_test;
