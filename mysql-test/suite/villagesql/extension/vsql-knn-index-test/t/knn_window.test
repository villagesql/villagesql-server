# KNN distance ordering combined with window functions.

INSTALL EXTENSION vsql_knn_index_test;

CREATE TABLE t (
  id INT PRIMARY KEY,
  v KVECTOR
);
CREATE INDEX idx_v ON t (v)
  USING EXTENDED(vsql_knn_index_test.kvec_l2);
INSERT INTO t VALUES
  (30, '[1,0,0,0]'),
  (10, '[0,2,0,0]'),
  (20, '[0,0,3,0]'),
  (4, '[4,0,0,0]'),
  (5, '[0,0,0,5]');

--echo # A distance expression used as a window sort key.
SELECT id,
  ROW_NUMBER() OVER (
    ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[0,0,0,0]')) AS rn
FROM t ORDER BY id;

--echo # The window sees all input rows before the outer KNN ORDER BY and LIMIT.
--disable_query_log
--disable_result_log
SELECT vsql_knn_index_test.kvec_reset_counters();
--enable_result_log
--enable_query_log
SELECT id, COUNT(*) OVER () AS total
FROM t
ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[0,0,0,0]')
LIMIT 2;
SELECT vsql_knn_index_test.kvec_scan_begin_count() AS scan_begins;
SELECT vsql_knn_index_test.kvec_scan_fetch_count() AS scan_fetches;

--echo # A window over the rows returned by an indexed KNN derived table.
--disable_query_log
--disable_result_log
SELECT vsql_knn_index_test.kvec_reset_counters();
--enable_result_log
--enable_query_log
SELECT id, ROW_NUMBER() OVER (ORDER BY id) AS rn
FROM (
  SELECT id FROM t
  ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[0,0,0,0]')
  LIMIT 4
) AS nearest
ORDER BY id;
SELECT vsql_knn_index_test.kvec_scan_begin_count() AS scan_begins;
SELECT vsql_knn_index_test.kvec_scan_fetch_count() AS scan_fetches;

DROP TABLE t;
UNINSTALL EXTENSION vsql_knn_index_test;
