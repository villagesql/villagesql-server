# Locking reads through a KNN scan that release or modify the locked row.
#
# The clustered index cursor used for the row lock has to keep its position
# after the scan returns the row. Two server paths depend on that:
#  1. unlock_row(): in READ COMMITTED the SQL layer calls it for a returned row
#     that fails the WHERE condition, and the lock taken for it is released.
#  2. UPDATE and DELETE: the update is applied at the cursor position of the
#     row the scan has just returned. A single-table UPDATE or DELETE does not
#     use the KNN scan today, so the test only records that it filesorts.
# TODO(villagesql-indexing): cover this path once such statements use KNN.
#
# The locks held after each read are read from performance_schema.data_locks.
#
# Also checks that locks taken for entries the scan skips (stale entries) do not
# leak into the lock tracking of the next entry.

--source include/have_binlog_format_row.inc

INSTALL EXTENSION vsql_knn_index_test;

CREATE TABLE t (
  id INT PRIMARY KEY,
  v  KVECTOR,
  n  INT
);
CREATE INDEX idx_v ON t (v)
  USING EXTENDED(vsql_knn_index_test.kvec_l2);

--echo # Distances from [0,0,0,0] are 1, 3, 5 and 10: all distinct.
INSERT INTO t VALUES
  (1, '[1,0,0,0]', 0),
  (2, '[3,0,0,0]', 1),
  (3, '[0,5,0,0]', 0),
  (4, '[10,0,0,0]', 1);

SET SESSION TRANSACTION ISOLATION LEVEL READ COMMITTED;

--echo # --- unlock_row(): rows rejected by the WHERE condition are unlocked ---
--echo # Rows 1 and 3 (n = 0) are fetched and locked by the scan, then rejected.
--echo # Only the returned rows 2 and 4 stay locked, each by a no-gap record lock.
--replace_regex /cost=[0-9.e+-]+/cost=COST/ /rows=[0-9.e+-]+/rows=ROWS/
EXPLAIN FORMAT=tree
SELECT id FROM t WHERE n = 1
ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[0,0,0,0]') LIMIT 2
FOR UPDATE;

START TRANSACTION;
SELECT id FROM t WHERE n = 1
ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[0,0,0,0]') LIMIT 2
FOR UPDATE;

SELECT index_name, lock_mode, lock_data FROM performance_schema.data_locks
WHERE object_name = 't' AND lock_type = 'RECORD' ORDER BY lock_data;
COMMIT;

--echo # --- unlock_row(): a stale entry skipped before a rejected row ---
--echo # Moving id=1 leaves a stale entry at distance 1. The scan locks and
--echo # releases row 1 for the stale entry, then fetches rows 2, 3 and 4.
UPDATE t SET v = '[20,0,0,0]' WHERE id = 1;
START TRANSACTION;
SELECT id FROM t WHERE n = 1
ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[0,0,0,0]') LIMIT 2
FOR UPDATE;

SELECT index_name, lock_mode, lock_data FROM performance_schema.data_locks
WHERE object_name = 't' AND lock_type = 'RECORD' ORDER BY lock_data;
COMMIT;

--echo # --- UPDATE ordered by distance ---
--echo # A single-table UPDATE or DELETE does not use the KNN scan: it sorts the
--echo # rows itself (Using filesort), so it does not reach the locking read of
--echo # the custom index. EXPLAIN FORMAT=tree prints no plan for these statements.
--disable_warnings
--replace_column 10 ROWS 11 FILTERED
EXPLAIN
UPDATE t SET n = n + 10
ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[0,0,0,0]') LIMIT 2;
--enable_warnings

START TRANSACTION;
UPDATE t SET n = n + 10
ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[0,0,0,0]') LIMIT 2;
SELECT id, n FROM t ORDER BY id;
COMMIT;

--echo # --- DELETE ordered by distance ---
--disable_warnings
--replace_column 10 ROWS 11 FILTERED
EXPLAIN
DELETE FROM t
ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[0,0,0,0]') LIMIT 2;
--enable_warnings

START TRANSACTION;
DELETE FROM t
ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[0,0,0,0]') LIMIT 2;
SELECT id, n FROM t ORDER BY id;
COMMIT;

DROP TABLE t;
UNINSTALL EXTENSION vsql_knn_index_test;
