INSTALL EXTENSION vsql_knn_index_test;
CREATE TABLE t (
id INT PRIMARY KEY,
v  KVECTOR,
n  INT
);
CREATE INDEX idx_v ON t (v)
USING EXTENDED(vsql_knn_index_test.kvec_l2);
# Distances from [0,0,0,0] are 1, 3, 5 and 10: all distinct.
INSERT INTO t VALUES
(1, '[1,0,0,0]', 0),
(2, '[3,0,0,0]', 1),
(3, '[0,5,0,0]', 0),
(4, '[10,0,0,0]', 1);
SET SESSION TRANSACTION ISOLATION LEVEL READ COMMITTED;
# --- unlock_row(): rows rejected by the WHERE condition are unlocked ---
# Rows 1 and 3 (n = 0) are fetched and locked by the scan, then rejected.
# Only the returned rows 2 and 4 stay locked, each by a no-gap record lock.
EXPLAIN FORMAT=tree
SELECT id FROM t WHERE n = 1
ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[0,0,0,0]') LIMIT 2
FOR UPDATE;
EXPLAIN
-> Limit: 2 row(s)  (cost=COST rows=ROWS)
    -> Filter: (t.n = 1)  (cost=COST rows=ROWS)
        -> Index KNN scan on t using idx_v (v <-> '[0,0,0,0]'), limit 2  (cost=COST rows=ROWS)

START TRANSACTION;
SELECT id FROM t WHERE n = 1
ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[0,0,0,0]') LIMIT 2
FOR UPDATE;
id
2
4
SELECT index_name, lock_mode, lock_data FROM performance_schema.data_locks
WHERE object_name = 't' AND lock_type = 'RECORD' ORDER BY lock_data;
index_name	lock_mode	lock_data
PRIMARY	X,REC_NOT_GAP	2
PRIMARY	X,REC_NOT_GAP	4
COMMIT;
# --- unlock_row(): a stale entry skipped before a rejected row ---
# Moving id=1 leaves a stale entry at distance 1. The scan locks and
# releases row 1 for the stale entry, then fetches rows 2, 3 and 4.
UPDATE t SET v = '[20,0,0,0]' WHERE id = 1;
START TRANSACTION;
SELECT id FROM t WHERE n = 1
ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[0,0,0,0]') LIMIT 2
FOR UPDATE;
id
2
4
SELECT index_name, lock_mode, lock_data FROM performance_schema.data_locks
WHERE object_name = 't' AND lock_type = 'RECORD' ORDER BY lock_data;
index_name	lock_mode	lock_data
PRIMARY	X,REC_NOT_GAP	2
PRIMARY	X,REC_NOT_GAP	4
COMMIT;
# --- UPDATE ordered by distance ---
# Row 1 still has a stale entry at distance 1. The scan skips it, and
# fetches rows 2, 3 and 4. Row 3 (n = 0) is rejected by the WHERE
# condition and unlocked. Only the updated rows 2 and 4 stay locked.
EXPLAIN
UPDATE t SET n = n + 10 WHERE n = 1
ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[0,0,0,0]') LIMIT 2;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	UPDATE	t	NULL	index	NULL	idx_v	KEY_LEN	NULL	ROWS	FILTERED	Using where; Using temporary
START TRANSACTION;
UPDATE t SET n = n + 10 WHERE n = 1
ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[0,0,0,0]') LIMIT 2;
SELECT index_name, lock_mode, lock_data FROM performance_schema.data_locks
WHERE object_name = 't' AND lock_type = 'RECORD' ORDER BY lock_data;
index_name	lock_mode	lock_data
PRIMARY	X,REC_NOT_GAP	2
PRIMARY	X,REC_NOT_GAP	4
SELECT id, n FROM t ORDER BY id;
id	n
1	0
2	11
3	0
4	11
COMMIT;
# --- DELETE ordered by distance ---
# The scan skips the stale entry of row 1, rejects row 3 (n < 11) and
# deletes rows 2 and 4 at the cursor position. Only the deleted rows stay
# locked.
EXPLAIN
DELETE FROM t WHERE n >= 11
ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[0,0,0,0]') LIMIT 2;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	DELETE	t	NULL	index	NULL	idx_v	KEY_LEN	NULL	ROWS	FILTERED	Using where
START TRANSACTION;
DELETE FROM t WHERE n >= 11
ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[0,0,0,0]') LIMIT 2;
SELECT index_name, lock_mode, lock_data FROM performance_schema.data_locks
WHERE object_name = 't' AND lock_type = 'RECORD' ORDER BY lock_data;
index_name	lock_mode	lock_data
PRIMARY	X,REC_NOT_GAP	2
PRIMARY	X,REC_NOT_GAP	4
SELECT id, n FROM t ORDER BY id;
id	n
1	0
3	0
COMMIT;
DROP TABLE t;
UNINSTALL EXTENSION vsql_knn_index_test;
