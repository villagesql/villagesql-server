INSTALL EXTENSION vsql_knn_index_test;
CREATE TABLE t (
id INT PRIMARY KEY,
v  KVECTOR,
g  INT,
n  INT DEFAULT 0
);
CREATE INDEX idx_v ON t (v)
USING EXTENDED(vsql_knn_index_test.kvec_l2);
# Distances from [0,0,0,0] are 1, 3, 5, 10 and 20: all distinct.
INSERT INTO t (id, v, g) VALUES
(1, '[1,0,0,0]', 1),
(2, '[3,0,0,0]', 2),
(3, '[0,5,0,0]', 1),
(4, '[10,0,0,0]', 2),
(5, '[20,0,0,0]', 1);
SET SESSION TRANSACTION ISOLATION LEVEL READ COMMITTED;
# --- Update a column that is not indexed for the two nearest rows ---
UPDATE t SET n = n + 10
ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[0,0,0,0]') LIMIT 2;
SELECT id, n FROM t ORDER BY id;
id	n
1	10
2	10
3	0
4	0
5	0
# --- A condition rejects rows: the nearest matching rows are updated ---
UPDATE t SET n = n + 100 WHERE g = 1
ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[0,0,0,0]') LIMIT 2;
SELECT id, n FROM t ORDER BY id;
id	n
1	110
2	10
3	100
4	0
5	0
# --- Update the indexed column of the nearest rows ---
# Each row is updated once, although it moves to a later position in the
# scan. Rows 1 and 2 move to distances 30 and 40.
UPDATE t SET v = '[30,0,0,0]'
ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[0,0,0,0]') LIMIT 1;
UPDATE t SET v = '[40,0,0,0]'
ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[0,0,0,0]') LIMIT 1;
SELECT id FROM t
ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[0,0,0,0]') LIMIT 10;
id
3
4
5
1
2
# --- Update the indexed column of several rows in one statement ---
# A row moved by the update must not be updated again. Rows 3, 4 and 5 move
# to distance 100, behind rows 1 and 2.
UPDATE t SET v = '[100,0,0,0]', n = n + 1
ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[0,0,0,0]') LIMIT 3;
SELECT id, n FROM t ORDER BY id;
id	n
1	110
2	10
3	101
4	1
5	1
SELECT id FROM t
ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[0,0,0,0]') LIMIT 2;
id
1
2
DROP TABLE t;
UNINSTALL EXTENSION vsql_knn_index_test;
