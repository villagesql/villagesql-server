INSTALL EXTENSION vsql_knn_index_test;
CREATE TABLE t (
id      INT PRIMARY KEY,
v       KVECTOR,
payload VARCHAR(32)
);
CREATE INDEX idx_v ON t (v)
USING EXTENDED(vsql_knn_index_test.kvec_l2);
INSERT INTO t VALUES
(1, '[1,0,0,0]', 'one'),
(2, '[0,1,0,0]', 'two'),
(3, '[0,0,1,0]', 'three'),
(4, '[1,1,0,0]', 'four'),
(5, '[2,0,0,0]', 'five');
# KNN is served by the index (custom index distance scan, no filesort).
EXPLAIN FORMAT=tree
SELECT id, payload
FROM t
ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]')
LIMIT 5;
EXPLAIN
-> Limit: 5 row(s)  (cost=COST rows=ROWS)
    -> Custom index distance scan on idx_v  (cost=COST rows=ROWS)

# Baseline order and payloads.
SELECT id, payload
FROM t
ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]')
LIMIT 5;
id	payload
1	one
4	four
5	five
2	two
3	three
SELECT vsql_knn_index_test.kvec_insert_count() AS inserts_before_update;
inserts_before_update
5
UPDATE t SET payload = 'ONE-UPDATED' WHERE id = 1;
# A payload-only update triggers no index insert.
SELECT vsql_knn_index_test.kvec_insert_count() AS inserts_after_update;
inserts_after_update
5
# Same order, row 1 shows the new payload.
SELECT id, payload
FROM t
ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]')
LIMIT 5;
id	payload
1	ONE-UPDATED
4	four
5	five
2	two
3	three
UPDATE t SET payload = 'THREE-UPDATED' WHERE id = 3;
SELECT vsql_knn_index_test.kvec_insert_count() AS inserts_after_second_update;
inserts_after_second_update
5
# Both updated payloads are reflected; order unchanged.
SELECT id, payload
FROM t
ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]')
LIMIT 5;
id	payload
1	ONE-UPDATED
4	four
5	five
2	two
3	THREE-UPDATED
DROP TABLE t;
UNINSTALL EXTENSION vsql_knn_index_test;
