INSTALL EXTENSION vsql_knn_index_test;
CREATE TABLE t (
id  INT PRIMARY KEY,
grp INT,
v   KVECTOR
);
CREATE INDEX idx_v ON t (v)
USING EXTENDED(vsql_knn_index_test.kvec_l2);
INSERT INTO t VALUES
(1, 10, '[1,0,0,0]'),
(2, 10, '[0,1,0,0]'),
(3, 20, '[0,0,1,0]'),
(4, 20, '[1,1,0,0]'),
(5, 30, '[2,0,0,0]');
# Group by grp, order groups by their nearest member's distance
# (MIN over the distance). Legal aggregation; groups ordered nearest-first.
# grp 10 has id 1 (dist 0), grp 20 has id 4 (dist 1), grp 30 has id 5
# (dist 1) -> order 10, 20, 30.
EXPLAIN FORMAT=tree
SELECT grp, MIN(vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]')) AS md
FROM t
GROUP BY grp
ORDER BY md LIMIT 3;
EXPLAIN
-> Limit: 3 row(s)
    -> Sort: md, limit input to 3 row(s) per chunk
        -> Table scan on <temporary>
            -> Aggregate using temporary table
                -> Table scan on t  (cost=COST rows=ROWS)

SELECT grp, MIN(vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]')) AS md
FROM t
GROUP BY grp
ORDER BY md LIMIT 3;
grp	md
10	0
20	1
30	1
# Group by the distance value itself (projected), ordered by it: rows with
# equal distance collapse into one group, groups ordered by distance.
EXPLAIN FORMAT=tree
SELECT vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]') AS d, COUNT(*) AS n
FROM t
GROUP BY d
ORDER BY d LIMIT 3;
EXPLAIN
-> Limit: 3 row(s)  (cost=COST rows=ROWS)
    -> Group aggregate: count(0)  (cost=COST rows=ROWS)
        -> Custom index distance scan on idx_v  (cost=COST rows=ROWS)

SELECT vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]') AS d, COUNT(*) AS n
FROM t
GROUP BY d
ORDER BY d LIMIT 3;
d	n
0	1
1	2
1.4142135623730951	2
# Group by a column, order by the raw (non-aggregated) distance: the
# distance is not functionally dependent on the group, so this is rejected
# for the same reason DISTINCT rejects it.
SELECT grp
FROM t
GROUP BY grp
ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]') LIMIT 3;
ERROR 42000: Expression #1 of ORDER BY clause is not in GROUP BY clause and contains nonaggregated column 'test.t.v' which is not functionally dependent on columns in GROUP BY clause; this is incompatible with sql_mode=only_full_group_by
DROP TABLE t;
UNINSTALL EXTENSION vsql_knn_index_test;
