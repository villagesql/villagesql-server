INSTALL EXTENSION vsql_knn_index_test;
CREATE TABLE tvm (
id INT PRIMARY KEY,
v KVECTOR
);
CREATE INDEX idx_vm ON tvm (v)
USING EXTENDED(vsql_knn_index_test.kvec_l2);
INSERT INTO tvm VALUES
(1, '[1,0,0,0]'),
(2, '[0,1,0,0]'),
(3, '[0,0,1,0]'),
(4, '[1,1,0,0]'),
(5, '[2,0,0,0]');
#
# Matching case: L2 ORDER BY against the L2 index -> custom scan chosen.
#
EXPLAIN FORMAT=tree
SELECT id
FROM tvm
ORDER BY vsql_knn_index_test.kvec_l2_distance(v,
KVECTOR::from_string('[1,0,0,0]'))
LIMIT 3;
EXPLAIN
-> Limit: 3 row(s)  (cost=COST rows=ROWS)
    -> Custom index distance scan on idx_vm  (cost=COST rows=ROWS)

SELECT vsql_knn_index_test.kvec_scan_begin_count() AS l2_begins_before;
l2_begins_before
0
SELECT id
FROM tvm
ORDER BY vsql_knn_index_test.kvec_l2_distance(v,
KVECTOR::from_string('[1,0,0,0]'))
LIMIT 3;
id
1
4
5
# Scan fired for the matching L2 query.
SELECT vsql_knn_index_test.kvec_scan_begin_count() AS l2_begins_after;
l2_begins_after
1
#
# Mismatched case: cosine ORDER BY against a table that has only an L2
# index. kvec_cos_distance is a recognized distance function (bound
# in the kvec_cos profile), but no kvec_cos index exists here,
# so the optimizer must NOT take a custom scan -- EXPLAIN shows a sort,
# not a "Custom index distance scan".
#
EXPLAIN FORMAT=tree
SELECT id
FROM tvm
ORDER BY vsql_knn_index_test.kvec_cos_distance(v,
KVECTOR::from_string('[1,0,0,0]'))
LIMIT 3;
EXPLAIN
-> Limit: 3 row(s)
    -> Sort: vsql_knn_index_test.kvec_cos_distance(tvm.v,vsql_knn_index_test.kvector::from_string('[1,0,0,0]')), limit input to 3 row(s) per chunk
        -> Stream results  (cost=COST rows=ROWS)
            -> Table scan on tvm  (cost=COST rows=ROWS)

SELECT vsql_knn_index_test.kvec_scan_begin_count() AS cos_begins_before;
cos_begins_before
1
#
# Results are still correct (cosine order, computed by filesort). Nearest
# by cosine to [1,0,0,0]: id=1 and id=5 are colinear (cos dist 0), then
# id=4 (45 degrees).
#
SELECT id
FROM tvm
ORDER BY vsql_knn_index_test.kvec_cos_distance(v,
KVECTOR::from_string('[1,0,0,0]')),
id
LIMIT 3;
id
1
5
4
#
# The custom scan did NOT fire for the mismatched cosine query: the
# begin count is unchanged from before the query.
#
SELECT vsql_knn_index_test.kvec_scan_begin_count() AS cos_begins_after;
cos_begins_after
1
DROP TABLE tvm;
UNINSTALL EXTENSION vsql_knn_index_test;
