INSTALL EXTENSION vsql_knn_index_test;
CREATE TABLE t (
id INT PRIMARY KEY,
v  KVECTOR
);
CREATE INDEX idx_v ON t (v)
USING EXTENDED(vsql_knn_index_test.kvec_l2);
# Distances from [0,0,0,0] are 1, 3, 5 and 10: all distinct.
INSERT INTO t VALUES
(1, '[1,0,0,0]'),
(2, '[3,0,0,0]'),
(3, '[0,5,0,0]'),
(4, '[10,0,0,0]');
SET SESSION TRANSACTION ISOLATION LEVEL READ COMMITTED;
SET SESSION TRANSACTION ISOLATION LEVEL READ COMMITTED;
SET SESSION innodb_lock_wait_timeout = 1;
# --- The locking read uses the KNN scan and returns the nearest rows ---
EXPLAIN FORMAT=tree
SELECT id FROM t
ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[0,0,0,0]') LIMIT 2
FOR UPDATE;
EXPLAIN
-> Limit: 2 row(s)  (cost=COST rows=ROWS)
    -> Index KNN scan on t using idx_v (v <-> '[0,0,0,0]'), limit 2  (cost=COST rows=ROWS)

START TRANSACTION;
SELECT id FROM t
ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[0,0,0,0]') LIMIT 2
FOR UPDATE;
id
1
2
# --- Exactly the returned rows are locked ---
SELECT id FROM t WHERE id = 1 FOR UPDATE NOWAIT;
ERROR HY000: Statement aborted because lock(s) could not be acquired immediately and NOWAIT is set.
SELECT id FROM t WHERE id = 2 FOR UPDATE NOWAIT;
ERROR HY000: Statement aborted because lock(s) could not be acquired immediately and NOWAIT is set.
SELECT id FROM t WHERE id = 3 FOR UPDATE NOWAIT;
id
3
SELECT id FROM t WHERE id = 4 FOR UPDATE NOWAIT;
id
4
COMMIT;
COMMIT;
# --- A row locked by another transaction blocks the locking read ---
START TRANSACTION;
SELECT id FROM t WHERE id = 1 FOR UPDATE;
id
1
START TRANSACTION;
SELECT id FROM t
ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[0,0,0,0]') LIMIT 2
FOR UPDATE;
ERROR HY000: Lock wait timeout exceeded; try restarting transaction
ROLLBACK;
# SKIP LOCKED skips the locked row and returns the next nearest ones.
START TRANSACTION;
SELECT id FROM t
ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[0,0,0,0]') LIMIT 2
FOR UPDATE SKIP LOCKED;
id
2
3
ROLLBACK;
COMMIT;
# --- A stale entry left by an update is not returned or locked ---
# Moving id=1 far away leaves its old entry (vector [1,0,0,0]) in the
# index. A locking read must not return id=1 at the old distance (it would
# rank first) or twice; at its new distance it ranks last.
UPDATE t SET v = '[20,0,0,0]' WHERE id = 1;
START TRANSACTION;
SELECT id FROM t
ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[0,0,0,0]') LIMIT 4
FOR UPDATE;
id
2
3
4
1
COMMIT;
# --- A row deleted by a committed transaction is not returned ---
DELETE FROM t WHERE id = 2;
START TRANSACTION;
SELECT id FROM t
ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[0,0,0,0]') LIMIT 4
FOR UPDATE;
id
3
4
1
COMMIT;
# --- REPEATABLE READ: the KNN scan is not used for a locking read ---
# Check that the scan did not run.
SET SESSION TRANSACTION ISOLATION LEVEL REPEATABLE READ;
SET @begins = vsql_knn_index_test.kvec_scan_begin_count();
START TRANSACTION;
SELECT id FROM t
ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[0,0,0,0]') LIMIT 2
FOR UPDATE;
id
3
4
COMMIT;
SELECT vsql_knn_index_test.kvec_scan_begin_count() = @begins AS knn_scan_not_used;
knn_scan_not_used
1
DROP TABLE t;
UNINSTALL EXTENSION vsql_knn_index_test;
