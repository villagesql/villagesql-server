INSTALL EXTENSION vsql_knn_index_test;
CREATE TABLE t (
id INT PRIMARY KEY,
v  KVECTOR,
n  INT DEFAULT 0
);
CREATE INDEX idx_v ON t (v)
USING EXTENDED(vsql_knn_index_test.kvec_l2);
# Distances from [0,0,0,0] are 1, 3, 5, 10 and 20: all distinct.
INSERT INTO t (id, v) VALUES
(1, '[1,0,0,0]'),
(2, '[3,0,0,0]'),
(3, '[5,0,0,0]'),
(4, '[10,0,0,0]'),
(5, '[20,0,0,0]');
SET @q = '[0,0,0,0]';
# --- SELECT prepared under READ COMMITTED ---
SET SESSION TRANSACTION ISOLATION LEVEL READ COMMITTED;
PREPARE sel FROM 'SELECT id FROM t ORDER BY vsql_knn_index_test.kvec_l2_distance(v, ?) LIMIT 2';
# Executed under READ COMMITTED: the KNN scan is used.
SET @begins = vsql_knn_index_test.kvec_scan_begin_count();
EXECUTE sel USING @q;
id
1
2
SELECT vsql_knn_index_test.kvec_scan_begin_count() - @begins AS knn_scans;
knn_scans
1
# Executed under SERIALIZABLE: no KNN scan, same rows.
SET SESSION TRANSACTION ISOLATION LEVEL SERIALIZABLE;
SET @begins = vsql_knn_index_test.kvec_scan_begin_count();
EXECUTE sel USING @q;
id
1
2
SELECT vsql_knn_index_test.kvec_scan_begin_count() - @begins AS knn_scans;
knn_scans
0
# Executed again under READ COMMITTED: the KNN scan is used again.
SET SESSION TRANSACTION ISOLATION LEVEL READ COMMITTED;
SET @begins = vsql_knn_index_test.kvec_scan_begin_count();
EXECUTE sel USING @q;
id
1
2
SELECT vsql_knn_index_test.kvec_scan_begin_count() - @begins AS knn_scans;
knn_scans
1
DEALLOCATE PREPARE sel;
# --- SELECT prepared under SERIALIZABLE, executed under READ COMMITTED ---
# The plan is not checked: only the rows must be right.
SET SESSION TRANSACTION ISOLATION LEVEL SERIALIZABLE;
PREPARE sel FROM 'SELECT id FROM t ORDER BY vsql_knn_index_test.kvec_l2_distance(v, ?) LIMIT 2';
SET SESSION TRANSACTION ISOLATION LEVEL READ COMMITTED;
EXECUTE sel USING @q;
id
1
2
DEALLOCATE PREPARE sel;
# --- UPDATE prepared under READ COMMITTED ---
PREPARE upd FROM 'UPDATE t SET n = n + 1 ORDER BY vsql_knn_index_test.kvec_l2_distance(v, ?) LIMIT 2';
# Executed under READ COMMITTED: the KNN scan is used.
SET @begins = vsql_knn_index_test.kvec_scan_begin_count();
EXECUTE upd USING @q;
SELECT vsql_knn_index_test.kvec_scan_begin_count() - @begins AS knn_scans;
knn_scans
1
# Executed under SERIALIZABLE: no KNN scan, same rows updated.
SET SESSION TRANSACTION ISOLATION LEVEL SERIALIZABLE;
SET @begins = vsql_knn_index_test.kvec_scan_begin_count();
EXECUTE upd USING @q;
SELECT vsql_knn_index_test.kvec_scan_begin_count() - @begins AS knn_scans;
knn_scans
0
# Executed again under READ COMMITTED: the KNN scan is used again.
SET SESSION TRANSACTION ISOLATION LEVEL READ COMMITTED;
SET @begins = vsql_knn_index_test.kvec_scan_begin_count();
EXECUTE upd USING @q;
SELECT vsql_knn_index_test.kvec_scan_begin_count() - @begins AS knn_scans;
knn_scans
1
DEALLOCATE PREPARE upd;
# Rows 1 and 2 were updated by each of the three executions.
SELECT id, n FROM t ORDER BY id;
id	n
1	3
2	3
3	0
4	0
5	0
# --- HANDLER READ on the KNN index ---
# HANDLER does not start a KNN scan, so it is rejected at any isolation
# level.
SET SESSION TRANSACTION ISOLATION LEVEL READ COMMITTED;
HANDLER t OPEN;
HANDLER t READ idx_v FIRST;
Got one of the listed errors
SET SESSION TRANSACTION ISOLATION LEVEL SERIALIZABLE;
HANDLER t READ idx_v FIRST;
Got one of the listed errors
HANDLER t CLOSE;
DROP TABLE t;
UNINSTALL EXTENSION vsql_knn_index_test;
