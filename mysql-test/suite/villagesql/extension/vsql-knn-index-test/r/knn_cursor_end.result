INSTALL EXTENSION vsql_knn_index_test;
CREATE TABLE t (
id INT PRIMARY KEY,
v  KVECTOR,
n  INT,
KEY idx_n (n)
);
CREATE INDEX idx_v ON t (v)
USING EXTENDED(vsql_knn_index_test.kvec_l2);
# Distances from [0,0,0,0] are 1, 3, 5, 10 and 20: all distinct.
INSERT INTO t VALUES
(1, '[1,0,0,0]', 50),
(2, '[3,0,0,0]', 40),
(3, '[0,5,0,0]', 30),
(4, '[10,0,0,0]', 20),
(5, '[20,0,0,0]', 10);
SET SESSION TRANSACTION ISOLATION LEVEL READ COMMITTED;
# --- A SELECT stopped by LIMIT leaves no cursor open ---
SELECT id FROM t
ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[0,0,0,0]') LIMIT 1;
id
1
SELECT vsql_knn_index_test.kvec_open_cursors() AS open_cursors;
open_cursors
0
# --- A DELETE stopped by LIMIT leaves no cursor open ---
SET @begins = vsql_knn_index_test.kvec_scan_begin_count();
DELETE FROM t
ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[0,0,0,0]') LIMIT 1;
SELECT vsql_knn_index_test.kvec_scan_begin_count() - @begins AS knn_scans;
knn_scans
1
SELECT vsql_knn_index_test.kvec_open_cursors() AS open_cursors;
open_cursors
0
# --- An UPDATE stopped by LIMIT leaves no cursor open ---
SET @begins = vsql_knn_index_test.kvec_scan_begin_count();
UPDATE t SET n = n + 1
ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[0,0,0,0]') LIMIT 1;
SELECT vsql_knn_index_test.kvec_scan_begin_count() - @begins AS knn_scans;
knn_scans
1
SELECT vsql_knn_index_test.kvec_open_cursors() AS open_cursors;
open_cursors
0
# --- Switch between KNN, primary key and secondary index scans ---
# KNN scan stopped by LIMIT, then a primary key scan.
SELECT id FROM t
ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[0,0,0,0]') LIMIT 1;
id
2
SELECT id FROM t ORDER BY id LIMIT 2;
id
2
3
SELECT vsql_knn_index_test.kvec_open_cursors() AS open_cursors;
open_cursors
0
# Then a scan of the other secondary index.
SELECT id FROM t FORCE INDEX (idx_n) ORDER BY n LIMIT 2;
id
5
4
SELECT vsql_knn_index_test.kvec_open_cursors() AS open_cursors;
open_cursors
0
# Then a KNN scan again.
SELECT id FROM t
ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[0,0,0,0]') LIMIT 2;
id
2
3
SELECT vsql_knn_index_test.kvec_open_cursors() AS open_cursors;
open_cursors
0
# --- DELETE after a primary key scan that read the end of the index ---
SELECT id, n FROM t ORDER BY id;
id	n
2	41
3	30
4	20
5	10
DELETE FROM t
ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[0,0,0,0]') LIMIT 1;
SELECT id FROM t ORDER BY id;
id
3
4
5
SELECT vsql_knn_index_test.kvec_open_cursors() AS open_cursors;
open_cursors
0
# --- UPDATE after a secondary index scan that read the end of the index ---
SELECT id FROM t FORCE INDEX (idx_n) ORDER BY n;
id
5
4
3
UPDATE t SET n = n + 100
ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[0,0,0,0]') LIMIT 1;
SELECT id, n FROM t ORDER BY id;
id	n
3	130
4	20
5	10
SELECT vsql_knn_index_test.kvec_open_cursors() AS open_cursors;
open_cursors
0
DROP TABLE t;
UNINSTALL EXTENSION vsql_knn_index_test;
