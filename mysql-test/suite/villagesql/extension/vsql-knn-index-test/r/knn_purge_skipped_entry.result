INSTALL EXTENSION vsql_knn_index_test;
CREATE TABLE t_skip (id INT PRIMARY KEY, v KVECTOR);
CREATE INDEX idx_v ON t_skip (v)
USING EXTENDED(vsql_knn_index_test.kvec_l2);
INSERT INTO t_skip VALUES (1, '[1,0,0,0]'), (2, '[0,1,0,0]');
CREATE TABLE t_upd (id INT PRIMARY KEY, v KVECTOR);
CREATE INDEX idx_v ON t_upd (v)
USING EXTENDED(vsql_knn_index_test.kvec_l2);
INSERT INTO t_upd VALUES (1, '[1,0,0,0]');
# Skip custom index entry purge, then delete a row and update another
SET GLOBAL debug = '+d,villagesql_skip_custom_index_purge';
DELETE FROM t_skip WHERE id = 1;
UPDATE t_upd SET v = '[0,0,1,0]' WHERE id = 1;
# Slow shutdown purges the delete-marked row and the old column version
SET GLOBAL innodb_fast_shutdown = 0;
# restart
Pattern "Skipped freeing data of custom column v of table test\.t_skip" found
# Delete path
SELECT id FROM t_skip ORDER BY id;
id
2
# Update path
Pattern "Skipped freeing data of custom column v of table test\.t_upd" found
SELECT id, v FROM t_upd ORDER BY id;
id	v
1	[0,0,1,0]
# Control: normal purge frees the data without a warning
CREATE TABLE t_ctl (id INT PRIMARY KEY, v KVECTOR);
CREATE INDEX idx_v ON t_ctl (v)
USING EXTENDED(vsql_knn_index_test.kvec_l2);
INSERT INTO t_ctl VALUES (1, '[1,0,0,0]');
DELETE FROM t_ctl WHERE id = 1;
Pattern "Skipped freeing data of custom column v of table test\.t_ctl" not found
DROP TABLE t_skip;
DROP TABLE t_upd;
DROP TABLE t_ctl;
UNINSTALL EXTENSION vsql_knn_index_test;
