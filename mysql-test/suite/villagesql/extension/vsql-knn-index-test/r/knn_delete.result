INSTALL EXTENSION vsql_knn_index_test;
CREATE TABLE t (
id INT PRIMARY KEY,
v  KVECTOR,
g  INT
);
CREATE INDEX idx_v ON t (v)
USING EXTENDED(vsql_knn_index_test.kvec_l2);
# Distances from [0,0,0,0] are 1, 3, 5, 10 and 20: all distinct.
INSERT INTO t VALUES
(1, '[1,0,0,0]', 1),
(2, '[3,0,0,0]', 2),
(3, '[0,5,0,0]', 1),
(4, '[10,0,0,0]', 2),
(5, '[20,0,0,0]', 1);
SET SESSION TRANSACTION ISOLATION LEVEL READ COMMITTED;
# --- Delete the two nearest rows ---
DELETE FROM t
ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[0,0,0,0]') LIMIT 2;
SELECT id FROM t ORDER BY id;
id
3
4
5
# --- A condition rejects rows: the nearest matching rows are deleted ---
DELETE FROM t WHERE g = 1
ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[0,0,0,0]') LIMIT 1;
SELECT id FROM t ORDER BY id;
id
4
5
# --- The index no longer returns the deleted rows ---
SELECT id FROM t
ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[0,0,0,0]') LIMIT 10;
id
4
5
DROP TABLE t;
UNINSTALL EXTENSION vsql_knn_index_test;
