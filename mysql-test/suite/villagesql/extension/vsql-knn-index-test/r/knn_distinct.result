INSTALL EXTENSION vsql_knn_index_test;
CREATE TABLE t (
id  INT PRIMARY KEY,
grp INT,
v   KVECTOR
);
CREATE INDEX idx_v ON t (v)
USING EXTENDED(vsql_knn_index_test.kvec_l2);
INSERT INTO t VALUES
(1, 10, '[1,0,0,0]'),
(2, 10, '[0,1,0,0]'),
(3, 20, '[0,0,1,0]'),
(4, 20, '[1,1,0,0]'),
(5, 30, '[2,0,0,0]');
# Ordering by a distance over a NON-selected column is incompatible with
# DISTINCT and is rejected up front (before any KNN routing).
SELECT DISTINCT id FROM t
ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]') LIMIT 3;
ERROR HY000: Expression #1 of ORDER BY clause is not in SELECT list, references column 'test.t.v' which is not in SELECT list; this is incompatible with DISTINCT
# Projecting the distance makes the ordering legal under DISTINCT. The
# distance column is in the SELECT list, so ORDER BY it is allowed and the
# KNN path can apply. Nearest 3 to [1,0,0,0]: ids 1(0), 4(1), 5(1).
EXPLAIN FORMAT=tree
SELECT DISTINCT id, vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]') AS d
FROM t
ORDER BY d LIMIT 3;
EXPLAIN
-> Limit: 3 row(s)  (cost=COST rows=ROWS)
    -> Custom index distance scan on idx_v  (cost=COST rows=ROWS)

SELECT DISTINCT id, vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]') AS d
FROM t
ORDER BY d LIMIT 3;
id	d
1	0
4	1
5	1
# DISTINCT over a non-unique projection (grp + distance): rows with the
# same (grp, d) collapse. Ordered by distance.
EXPLAIN FORMAT=tree
SELECT DISTINCT grp, vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]') AS d
FROM t
ORDER BY d LIMIT 3;
EXPLAIN
-> Limit: 3 row(s)  (cost=COST rows=ROWS)
    -> Table scan on <temporary>  (cost=COST rows=ROWS)
        -> Temporary table with deduplication  (cost=COST rows=ROWS)
            -> Limit table size: 3 unique row(s)
                -> Custom index distance scan on idx_v  (cost=COST rows=ROWS)

SELECT DISTINCT grp, vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]') AS d
FROM t
ORDER BY d LIMIT 3;
grp	d
10	0
20	1
30	1
DROP TABLE t;
UNINSTALL EXTENSION vsql_knn_index_test;
