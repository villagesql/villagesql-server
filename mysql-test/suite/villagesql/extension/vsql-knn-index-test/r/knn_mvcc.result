INSTALL EXTENSION vsql_knn_index_test;
CREATE TABLE t (
id INT PRIMARY KEY,
v  KVECTOR
);
CREATE INDEX idx_v ON t (v)
USING EXTENDED(vsql_knn_index_test.kvec_l2);
# Three committed rows.
INSERT INTO t VALUES
(1, '[1,0,0,0]'),
(2, '[0,1,0,0]'),
(3, '[0,0,1,0]');
# --- Same transaction sees its own uncommitted insert ---
START TRANSACTION;
INSERT INTO t VALUES (99, '[1,1,1,1]');
# The query vector equals id=99's vector, so it is the nearest and must
# appear first for the inserting transaction.
SELECT id
FROM t
ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[1,1,1,1]')
LIMIT 1;
id
99
# --- Another connection must NOT see the uncommitted row ---
# LIMIT 10 exceeds the visible rows, so all committed rows come back; the
# uncommitted id=99 must be absent and the query must not error. The
# committed vectors are equidistant from the query, so --sorted_result
# compares the set, not the order.
SELECT id
FROM t
ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[1,1,1,1]')
LIMIT 10;
id
1
2
3
# --- The inserting transaction rolls back ---
ROLLBACK;
# id=99 is gone: no transaction ever committed it.
SELECT id
FROM t
ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[1,1,1,1]')
LIMIT 10;
id
1
2
3
# --- Re-insert and COMMIT this time; the row becomes visible everywhere ---
START TRANSACTION;
INSERT INTO t VALUES (99, '[1,1,1,1]');
COMMIT;
# Now id=99 is the nearest for the default connection.
SELECT id
FROM t
ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[1,1,1,1]')
LIMIT 1;
id
99
# ...and for the other connection too.
SELECT id
FROM t
ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[1,1,1,1]')
LIMIT 1;
id
99
DROP TABLE t;
UNINSTALL EXTENSION vsql_knn_index_test;
