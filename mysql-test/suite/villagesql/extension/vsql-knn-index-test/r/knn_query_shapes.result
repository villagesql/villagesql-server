INSTALL EXTENSION vsql_knn_index_test;
CREATE TABLE t (
id INT PRIMARY KEY,
v  KVECTOR
);
CREATE INDEX idx_v ON t (v)
USING EXTENDED(vsql_knn_index_test.kvec_l2);
INSERT INTO t VALUES
(1, '[1,0,0,0]'),
(2, '[0,1,0,0]'),
(3, '[0,0,1,0]'),
(4, '[1,1,0,0]'),
(5, '[2,0,0,0]');
#
# === Shapes that route to the index ===
#
# 1. field first, constant second: routes.
EXPLAIN FORMAT=tree
SELECT id FROM t
ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]') LIMIT 3;
EXPLAIN
-> Limit: 3 row(s)  (cost=COST rows=ROWS)
    -> Custom index distance scan on idx_v  (cost=COST rows=ROWS)

SELECT id FROM t
ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]') LIMIT 3;
id
1
4
5
# 2. constant first, field second (swapped args): also routes.
EXPLAIN FORMAT=tree
SELECT id FROM t
ORDER BY vsql_knn_index_test.kvec_l2_distance('[1,0,0,0]', v) LIMIT 3;
EXPLAIN
-> Limit: 3 row(s)  (cost=COST rows=ROWS)
    -> Custom index distance scan on idx_v  (cost=COST rows=ROWS)

SELECT id FROM t
ORDER BY vsql_knn_index_test.kvec_l2_distance('[1,0,0,0]', v) LIMIT 3;
id
1
4
5
# 3. LIMIT larger than the table: routes, returns every row in order.
EXPLAIN FORMAT=tree
SELECT id FROM t
ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]') LIMIT 100;
EXPLAIN
-> Limit: 100 row(s)  (cost=COST rows=ROWS)
    -> Custom index distance scan on idx_v  (cost=COST rows=ROWS)

SELECT id FROM t
ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]') LIMIT 100;
id
1
4
5
2
3
#
# === Shapes that fall back to a plain scan + sort ===
#
# 4. DESC ordering (farthest first): the index serves nearest-first only,
# so this falls back. Rows must still be correctly ordered farthest-first.
EXPLAIN FORMAT=tree
SELECT id FROM t
ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]') DESC LIMIT 3;
EXPLAIN
-> Limit: 3 row(s)  (cost=COST rows=ROWS)
    -> Sort: vsql_knn_index_test.kvec_l2_distance(t.v,'[1,0,0,0]') DESC, limit input to 3 row(s) per chunk  (cost=COST rows=ROWS)
        -> Table scan on t  (cost=COST rows=ROWS)

SELECT id FROM t
ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]') DESC LIMIT 3;
id
2
3
4
# 5. No LIMIT: falls back; all rows returned nearest-first.
EXPLAIN FORMAT=tree
SELECT id FROM t
ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]');
EXPLAIN
-> Sort: vsql_knn_index_test.kvec_l2_distance(t.v,'[1,0,0,0]')  (cost=COST rows=ROWS)
    -> Table scan on t  (cost=COST rows=ROWS)

SELECT id FROM t
ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]');
id
1
4
5
2
3
# 6. Distance between two columns, but one side is pinned to a single row
# by WHERE a.id = 1: the optimizer folds a.v to a constant, so this becomes
# a genuine "column vs constant" KNN over b and DOES route to the index.
# The nearest b rows to a.v ([1,0,0,0]) come back.
EXPLAIN FORMAT=tree
SELECT a.id AS aid, b.id AS bid
FROM t a, t b
WHERE a.id = 1
ORDER BY vsql_knn_index_test.kvec_l2_distance(a.v, b.v) LIMIT 3;
EXPLAIN
-> Limit: 3 row(s)  (cost=COST rows=ROWS)
    -> Custom index distance scan on idx_v  (cost=COST rows=ROWS)

SELECT a.id AS aid, b.id AS bid
FROM t a, t b
WHERE a.id = 1
ORDER BY vsql_knn_index_test.kvec_l2_distance(a.v, b.v) LIMIT 3;
aid	bid
1	1
1	4
1	5
# 7. WHERE predicate alongside ORDER BY distance: the KNN ordering still
# routes; the predicate selects a subset of the ordered rows.
EXPLAIN FORMAT=tree
SELECT id FROM t
WHERE id > 2
ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]') LIMIT 3;
EXPLAIN
-> Limit: 3 row(s)  (cost=COST rows=ROWS)
    -> Filter: (t.id > 2)  (cost=COST rows=ROWS)
        -> Custom index distance scan on idx_v  (cost=COST rows=ROWS)

SELECT id FROM t
WHERE id > 2
ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]') LIMIT 3;
id
4
5
3
# 8. LIMIT with OFFSET: skips the nearest OFFSET rows, returns the next.
EXPLAIN FORMAT=tree
SELECT id FROM t
ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]') LIMIT 2 OFFSET 2;
EXPLAIN
-> Limit/Offset: 2/2 row(s)  (cost=COST rows=ROWS)
    -> Custom index distance scan on idx_v  (cost=COST rows=ROWS)

SELECT id FROM t
ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]') LIMIT 2 OFFSET 2;
id
5
2
# 9. Distance between two columns with NEITHER side constant-foldable (a
# self-join over all rows): not a column-vs-constant KNN, so it does NOT
# route and falls back to a plain sort over the pairwise distances.
EXPLAIN FORMAT=tree
SELECT a.id AS aid, b.id AS bid
FROM t a JOIN t b ON a.id < b.id
ORDER BY vsql_knn_index_test.kvec_l2_distance(a.v, b.v) LIMIT 3;
EXPLAIN
-> Limit: 3 row(s)
    -> Sort: vsql_knn_index_test.kvec_l2_distance(a.v,b.v), limit input to 3 row(s) per chunk
        -> Stream results  (cost=COST rows=ROWS)
            -> Nested loop inner join  (cost=COST rows=ROWS)
                -> Table scan on a  (cost=COST rows=ROWS)
                -> Filter: (a.id < b.id)  (cost=COST rows=ROWS)
                    -> Index range scan on b (re-planned for each iteration)  (cost=COST rows=ROWS)

SELECT a.id AS aid, b.id AS bid
FROM t a JOIN t b ON a.id < b.id
ORDER BY vsql_knn_index_test.kvec_l2_distance(a.v, b.v) LIMIT 3;
aid	bid
1	4
1	5
2	4
#
# === Differential check: an unindexed column gives the same answer ===
#
CREATE TABLE t_noidx (
id INT PRIMARY KEY,
v  KVECTOR
);
INSERT INTO t_noidx SELECT id, v FROM t;
# No index: the same KNN query is served by a plain scan + sort and must
# return the identical rows as the indexed table (shape 1 above).
EXPLAIN FORMAT=tree
SELECT id FROM t_noidx
ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]') LIMIT 3;
EXPLAIN
-> Limit: 3 row(s)
    -> Sort: vsql_knn_index_test.kvec_l2_distance(t_noidx.v,'[1,0,0,0]'), limit input to 3 row(s) per chunk
        -> Stream results  (cost=COST rows=ROWS)
            -> Table scan on t_noidx  (cost=COST rows=ROWS)

SELECT id FROM t_noidx
ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]') LIMIT 3;
id
1
4
5
DROP TABLE t_noidx;
DROP TABLE t;
UNINSTALL EXTENSION vsql_knn_index_test;
