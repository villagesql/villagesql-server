INSTALL EXTENSION vsql_knn_index_test;
CREATE TABLE t (
id INT PRIMARY KEY,
v  KVECTOR
);
CREATE INDEX idx_v ON t (v)
USING EXTENDED(vsql_knn_index_test.kvec_l2);
INSERT INTO t VALUES
(1, '[1,0,0,0]'),
(2, '[0,1,0,0]'),
(3, '[0,0,1,0]'),
(4, '[1,1,0,0]'),
(5, '[2,0,0,0]');
# A mergeable view exposing the table; the KNN ordering is applied by the
# outer query and should route to the index through the merged view.
CREATE VIEW v_merge AS SELECT id, v FROM t;
EXPLAIN FORMAT=tree
SELECT id FROM v_merge
ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]') LIMIT 3;
EXPLAIN
-> Limit: 3 row(s)  (cost=COST rows=ROWS)
    -> Custom index distance scan on idx_v  (cost=COST rows=ROWS)

SELECT id FROM v_merge
ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]') LIMIT 3;
id
1
4
5
DROP VIEW v_merge;
# A view whose definition already contains the KNN ordering + LIMIT; the
# outer query just reads it.
CREATE VIEW v_knn AS
SELECT id FROM t
ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]') LIMIT 3;
EXPLAIN FORMAT=tree
SELECT id FROM v_knn;
EXPLAIN
-> Table scan on v_knn  (cost=COST rows=ROWS)
    -> Materialize  (cost=COST rows=ROWS)
        -> Limit: 3 row(s)  (cost=COST rows=ROWS)
            -> Custom index distance scan on idx_v  (cost=COST rows=ROWS)

SELECT id FROM v_knn;
id
1
4
5
DROP VIEW v_knn;
# A view forced to materialize into a temporary table (ALGORITHM=TEMPTABLE),
# then a KNN ordering over it: the distance scan feeds / is wrapped by the
# temp table.
CREATE ALGORITHM=TEMPTABLE VIEW v_tmp AS SELECT id, v FROM t;
EXPLAIN FORMAT=tree
SELECT id FROM v_tmp
ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]') LIMIT 3;
EXPLAIN
-> Limit: 3 row(s)
    -> Sort: vsql_knn_index_test.kvec_l2_distance(v_tmp.v,'[1,0,0,0]'), limit input to 3 row(s) per chunk
        -> Stream results  (cost=COST rows=ROWS)
            -> Table scan on v_tmp  (cost=COST rows=ROWS)
                -> Materialize  (cost=COST rows=ROWS)
                    -> Table scan on t  (cost=COST rows=ROWS)

SELECT id FROM v_tmp
ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]') LIMIT 3;
id
1
4
5
DROP VIEW v_tmp;
DROP TABLE t;
UNINSTALL EXTENSION vsql_knn_index_test;
