#
# Driver test: ORDER BY vec_chain_l2_distance(...) LIMIT k is
# routed through the vec_chain custom index via the hypergraph
# optimizer hook. Validates the end-to-end path:
#   parser → optimizer recognition → custom-index scan →
#   walk_chain (gref traversal) → base-row fetch by PK → emit.
#
INSTALL EXTENSION VSQL_VEC_CHAIN_TEST;
CREATE TABLE t (
id INT PRIMARY KEY,
v VSQL_VEC_CHAIN(3) NOT NULL,
INDEX idx_v (v) USING EXTENDED(vec_chain)
);
INSERT INTO t VALUES (1, '[10,0,0]');
INSERT INTO t VALUES (2, '[0,10,0]');
INSERT INTO t VALUES (3, '[0,0,10]');
INSERT INTO t VALUES (4, '[1,1,1]');
INSERT INTO t VALUES (5, '[2,0,0]');
# Capture the scan-count baseline; the counter is process-wide
# so the absolute value depends on what other tests ran. We only
# care about the delta across the ORDER BY queries below.
# Nearest 3 to [10,0,0]: id=1 (exact), id=5, id=4.
SELECT id
FROM t
ORDER BY VSQL_VEC_CHAIN_TEST.vec_chain_l2_distance(
v, VSQL_VEC_CHAIN::from_string('[10,0,0]'))
LIMIT 3;
id
1
5
4
# Nearest 1 to the origin: id=4 ([1,1,1]).
SELECT id
FROM t
ORDER BY VSQL_VEC_CHAIN_TEST.vec_chain_l2_distance(
v, VSQL_VEC_CHAIN::from_string('[0,0,0]'))
LIMIT 1;
id
4
# All five rows ordered by distance from the origin.
# A full-scan fallback would tie-break by PK order (1,2,3); the
# walker traverses newest-first so ties come out as (3,2,1).
# That difference is the signal that the index is actually used.
SELECT id
FROM t
ORDER BY VSQL_VEC_CHAIN_TEST.vec_chain_l2_distance(
v, VSQL_VEC_CHAIN::from_string('[0,0,0]'))
LIMIT 100;
id
4
5
3
2
1
# LIMIT 4 must include the first member of the three-way tie
# (one of id=1/2/3), not skip it. Expected: 4,5,3,2 — proving
# the truncate happens AFTER the sort, not during the walk.
SELECT id
FROM t
ORDER BY VSQL_VEC_CHAIN_TEST.vec_chain_l2_distance(
v, VSQL_VEC_CHAIN::from_string('[0,0,0]'))
LIMIT 4;
id
4
5
3
2
# Insert a new node that should slot between id=4 (~1.73) and
# id=5 (2.0): id=6 at [1.5,0,0] (distance 1.5). Expected new
# order from origin: 6,4,5,3,2,1.
INSERT INTO t VALUES (6, '[1.5,0,0]');
SELECT id
FROM t
ORDER BY VSQL_VEC_CHAIN_TEST.vec_chain_l2_distance(
v, VSQL_VEC_CHAIN::from_string('[0,0,0]'))
LIMIT 100;
id
6
4
5
3
2
1
# Tombstone behavior survives the optimizer path: deleting
# id=4 (now a middle-of-chain node, after id=6 was inserted)
# drops it from results without breaking the chain. With id=4
# gone, ordered by origin distance: 6 (1.5), 5 (2), then ties
# 3,2,1 at 10 → top-4 = 6,5,3,2.
DELETE FROM t WHERE id = 4;
SELECT id
FROM t
ORDER BY VSQL_VEC_CHAIN_TEST.vec_chain_l2_distance(
v, VSQL_VEC_CHAIN::from_string('[0,0,0]'))
LIMIT 4;
id
6
5
3
2
# Each of the six ORDER BY queries above should have invoked
# vec_chain's scan_begin once. If the optimizer routed through
# the custom index for all of them, scans_run = 6. A lower value
# would mean some query fell back to a full table scan + sort.
SELECT VSQL_VEC_CHAIN_TEST.vec_chain_scan_count() - @scans_before AS scans_run;
scans_run
6
DROP TABLE t;
UNINSTALL EXTENSION VSQL_VEC_CHAIN_TEST;
