--echo #
--echo # Driver test: VSQL_VEC_CHAIN custom type basics — create column,
--echo # insert from string, select, distance VDF. No index yet.
--echo #

INSTALL EXTENSION VSQL_VEC_CHAIN_TEST;

CREATE TABLE t (
  id INT PRIMARY KEY,
  v VSQL_VEC_CHAIN(3) NOT NULL
);

INSERT INTO t VALUES (1, '[1.0,0.0,0.0]');
INSERT INTO t VALUES (2, '[0.0,1.0,0.0]');
INSERT INTO t VALUES (3, '[0.0,0.0,1.0]');
INSERT INTO t VALUES (4, '[1.0,1.0,1.0]');

SELECT id, v FROM t ORDER BY id;

--echo # L2 distance between known vectors.
SELECT id, VSQL_VEC_CHAIN_TEST.vec_chain_l2_distance(v, '[0,0,0]') AS d
  FROM t ORDER BY id;

--echo # Dot product against a query vector.
SELECT id, VSQL_VEC_CHAIN_TEST.vec_chain_dot_product(v, '[1,1,1]') AS dp
  FROM t ORDER BY id;

DROP TABLE t;
UNINSTALL EXTENSION VSQL_VEC_CHAIN_TEST;
