# SET GLOBAL is rejected; must use SET PERSIST
SET GLOBAL vsql_allow_preview_extensions = ON;
ERROR HY000: vsql_allow_preview_extensions must be set with SET PERSIST, not SET GLOBAL, to ensure the setting survives server restart
SET PERSIST vsql_allow_preview_extensions = ON;
INSTALL EXTENSION vsql_preview_ping_test;
# ping() returns a positive integer
SELECT vsql_preview_ping_test.ping() > 0 AS ping_positive;
ping_positive
1
# Consecutive calls return strictly increasing values
SELECT vsql_preview_ping_test.ping() < vsql_preview_ping_test.ping() AS ping_increases;
ping_increases
1
# SET ... = OFF is rejected while preview extensions are installed
SET PERSIST vsql_allow_preview_extensions = OFF;
ERROR HY000: Cannot set vsql_allow_preview_extensions = OFF while preview extensions are installed. Uninstall all preview extensions first.
UNINSTALL EXTENSION vsql_preview_ping_test;
SET PERSIST vsql_allow_preview_extensions = OFF;
RESET PERSIST vsql_allow_preview_extensions;
