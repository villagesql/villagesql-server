call mtr.add_suppression("no matching ABI version for capability");
call mtr.add_suppression("vsql_allow_preview_extensions");
# With preview capabilities blocked (default), install fails immediately
INSTALL EXTENSION vsql_preview_ping_v2_test;
ERROR HY000: Failed to load VEF extension 'vsql_preview_ping_v2_test': extension requires preview capabilities but vsql_allow_preview_extensions is OFF
# With preview capabilities allowed, install fails due to ABI hash mismatch
SET PERSIST vsql_allow_preview_extensions = ON;
INSTALL EXTENSION vsql_preview_ping_v2_test;
ERROR HY000: Failed to load VEF extension 'vsql_preview_ping_v2_test': no matching ABI version for capability 'vsql::preview::ping' (extension requires ver-2)
SET PERSIST vsql_allow_preview_extensions = OFF;
RESET PERSIST vsql_allow_preview_extensions;
