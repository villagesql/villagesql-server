call mtr.add_suppression("capability version too old");
call mtr.add_suppression("capability rejected by extension");
call mtr.add_suppression("vsql_allow_preview_extensions");
# With preview capabilities blocked (default), install fails immediately
INSTALL EXTENSION vsql_preview_ping_v2_test;
ERROR HY000: Failed to load VEF extension 'vsql_preview_ping_v2_test': extension requires preview capabilities but vsql_allow_preview_extensions is OFF
# With preview capabilities allowed, install fails due to version mismatch
SET PERSIST vsql_allow_preview_extensions = ON;
INSTALL EXTENSION vsql_preview_ping_v2_test;
ERROR HY000: Failed to load VEF extension 'vsql_preview_ping_v2_test': capability version too old: vsql::preview::ping (server=1, required=2)
SET PERSIST vsql_allow_preview_extensions = OFF;
RESET PERSIST vsql_allow_preview_extensions;
