# Test that an extension compiled against a future capability shape (ping v2)
# fails to load against a server that only provides ping v1.
#
# The extension uses a local ping_abi_v2.h (vef_preview_ping_v2_t with pong())
# and requires ping as "ver-2", which matches neither the server's
# fingerprint for vef_preview_ping_t nor its one legacy tag, "ver-1".
# populate_capabilities() looks up the (name, hash) pair and rejects the
# extension because no registered ABI version matches.

call mtr.add_suppression("no matching ABI version for capability");
call mtr.add_suppression("vsql_allow_preview_extensions");

--echo # With preview capabilities blocked (default), install fails immediately
--error ER_VILLAGESQL_GENERIC_ERROR
INSTALL EXTENSION vsql_preview_ping_v2_test;

--echo # With preview capabilities allowed, install fails due to ABI hash mismatch
SET PERSIST vsql_allow_preview_extensions = ON;
--error ER_VILLAGESQL_GENERIC_ERROR
INSTALL EXTENSION vsql_preview_ping_v2_test;
SET PERSIST vsql_allow_preview_extensions = OFF;
RESET PERSIST vsql_allow_preview_extensions;
