SET PERSIST vsql_allow_preview_extensions = ON;
INSTALL EXTENSION vsql_index_test;
SET SESSION debug='+d,villagesql_custom_index_proceed';
CREATE TABLE t1 (id INT PRIMARY KEY, a dummy_type_vector,
INDEX i_a (a) USING EXTENDED(dummy_index_hnsw));
CREATE TABLE t2 (id INT PRIMARY KEY, b dummy_type_vector,
INDEX i_b (b dummy_profile_hnsw_desc DESC) USING EXTENDED(dummy_index_hnsw));
db_name	table_name	index_name	extension_name	extension_version	index_type_name	index_type_parameters
test	t1	i_a	vsql_index_test	0.0.1	dummy_index_hnsw	{}
test	t2	i_b	vsql_index_test	0.0.1	dummy_index_hnsw	{}
table_name	index_name	key_position	column_name	extension_name	extension_version	profile_name
t1	i_a	0	a	vsql_index_test	0.0.1	dummy_profile_hnsw_l2
t2	i_b	0	b	vsql_index_test	0.0.1	dummy_profile_hnsw_desc
# RENAME TABLE moves the index metadata to the new name.
RENAME TABLE t1 TO r1;
db_name	table_name	index_name	extension_name	extension_version	index_type_name	index_type_parameters
test	r1	i_a	vsql_index_test	0.0.1	dummy_index_hnsw	{}
test	t2	i_b	vsql_index_test	0.0.1	dummy_index_hnsw	{}
table_name	index_name	key_position	column_name	extension_name	extension_version	profile_name
r1	i_a	0	a	vsql_index_test	0.0.1	dummy_profile_hnsw_l2
t2	i_b	0	b	vsql_index_test	0.0.1	dummy_profile_hnsw_desc
SHOW CREATE TABLE r1;
Table	Create Table
r1	CREATE TABLE `r1` (
  `id` int NOT NULL,
  `a` vsql_index_test.dummy_type_vector DEFAULT NULL,
  PRIMARY KEY (`id`),
  KEY `i_a` (`a` `vsql_index_test`.`dummy_profile_hnsw_l2`) USING EXTENDED(`vsql_index_test`.`dummy_index_hnsw`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
# ALTER TABLE ... RENAME moves it too.
ALTER TABLE r1 RENAME TO r2;
db_name	table_name	index_name	extension_name	extension_version	index_type_name	index_type_parameters
test	r2	i_a	vsql_index_test	0.0.1	dummy_index_hnsw	{}
test	t2	i_b	vsql_index_test	0.0.1	dummy_index_hnsw	{}
table_name	index_name	key_position	column_name	extension_name	extension_version	profile_name
r2	i_a	0	a	vsql_index_test	0.0.1	dummy_profile_hnsw_l2
t2	i_b	0	b	vsql_index_test	0.0.1	dummy_profile_hnsw_desc
# Also when the ALTER rebuilds the table.
ALTER TABLE r2 RENAME TO r3, FORCE;
db_name	table_name	index_name	extension_name	extension_version	index_type_name	index_type_parameters
test	r3	i_a	vsql_index_test	0.0.1	dummy_index_hnsw	{}
test	t2	i_b	vsql_index_test	0.0.1	dummy_index_hnsw	{}
table_name	index_name	key_position	column_name	extension_name	extension_version	profile_name
r3	i_a	0	a	vsql_index_test	0.0.1	dummy_profile_hnsw_l2
t2	i_b	0	b	vsql_index_test	0.0.1	dummy_profile_hnsw_desc
SHOW CREATE TABLE r3;
Table	Create Table
r3	CREATE TABLE `r3` (
  `id` int NOT NULL,
  `a` vsql_index_test.dummy_type_vector DEFAULT NULL,
  PRIMARY KEY (`id`),
  KEY `i_a` (`a` `vsql_index_test`.`dummy_profile_hnsw_l2`) USING EXTENDED(`vsql_index_test`.`dummy_index_hnsw`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
# The rebuild re-created i_a as a custom index: a later in-place ALTER,
# which writes every index's storage reference back, succeeds.
ALTER TABLE r3 ADD INDEX i_id (id), ALGORITHM=INPLACE;
ALTER TABLE r3 DROP INDEX i_id, ALGORITHM=INPLACE;
# A RENAME TABLE that swaps two tables swaps their indexes.
RENAME TABLE r3 TO tmp, t2 TO r3, tmp TO t2;
db_name	table_name	index_name	extension_name	extension_version	index_type_name	index_type_parameters
test	r3	i_b	vsql_index_test	0.0.1	dummy_index_hnsw	{}
test	t2	i_a	vsql_index_test	0.0.1	dummy_index_hnsw	{}
table_name	index_name	key_position	column_name	extension_name	extension_version	profile_name
r3	i_b	0	b	vsql_index_test	0.0.1	dummy_profile_hnsw_desc
t2	i_a	0	a	vsql_index_test	0.0.1	dummy_profile_hnsw_l2
SHOW CREATE TABLE r3;
Table	Create Table
r3	CREATE TABLE `r3` (
  `id` int NOT NULL,
  `b` vsql_index_test.dummy_type_vector DEFAULT NULL,
  PRIMARY KEY (`id`),
  KEY `i_b` (`b` `vsql_index_test`.`dummy_profile_hnsw_desc` DESC) USING EXTENDED(`vsql_index_test`.`dummy_index_hnsw`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
SHOW CREATE TABLE t2;
Table	Create Table
t2	CREATE TABLE `t2` (
  `id` int NOT NULL,
  `a` vsql_index_test.dummy_type_vector DEFAULT NULL,
  PRIMARY KEY (`id`),
  KEY `i_a` (`a` `vsql_index_test`.`dummy_profile_hnsw_l2`) USING EXTENDED(`vsql_index_test`.`dummy_index_hnsw`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
# RENAME TABLE to another database.
CREATE DATABASE db2;
RENAME TABLE t2 TO db2.t2;
db_name	table_name	index_name	extension_name	extension_version	index_type_name	index_type_parameters
test	r3	i_b	vsql_index_test	0.0.1	dummy_index_hnsw	{}
table_name	index_name	key_position	column_name	extension_name	extension_version	profile_name
r3	i_b	0	b	vsql_index_test	0.0.1	dummy_profile_hnsw_desc
USE db2;
db_name	table_name	index_name	extension_name	extension_version	index_type_name	index_type_parameters
db2	t2	i_a	vsql_index_test	0.0.1	dummy_index_hnsw	{}
table_name	index_name	key_position	column_name	extension_name	extension_version	profile_name
t2	i_a	0	a	vsql_index_test	0.0.1	dummy_profile_hnsw_l2
USE test;
SHOW CREATE TABLE db2.t2;
Table	Create Table
t2	CREATE TABLE `t2` (
  `id` int NOT NULL,
  `a` vsql_index_test.dummy_type_vector DEFAULT NULL,
  PRIMARY KEY (`id`),
  KEY `i_a` (`a` `vsql_index_test`.`dummy_profile_hnsw_l2`) USING EXTENDED(`vsql_index_test`.`dummy_index_hnsw`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
# The old name can be reused with the same index name.
CREATE TABLE t1 (id INT PRIMARY KEY, a dummy_type_vector,
INDEX i_a (a) USING EXTENDED(dummy_index_hnsw));
db_name	table_name	index_name	extension_name	extension_version	index_type_name	index_type_parameters
test	r3	i_b	vsql_index_test	0.0.1	dummy_index_hnsw	{}
test	t1	i_a	vsql_index_test	0.0.1	dummy_index_hnsw	{}
table_name	index_name	key_position	column_name	extension_name	extension_version	profile_name
r3	i_b	0	b	vsql_index_test	0.0.1	dummy_profile_hnsw_desc
t1	i_a	0	a	vsql_index_test	0.0.1	dummy_profile_hnsw_l2
# An index added by an ALTER that renames the table is filed under the
# new name.
ALTER TABLE t1 RENAME TO r4, ADD COLUMN c dummy_type_vector,
ADD INDEX i_c (c) USING EXTENDED(dummy_index_hnsw);
db_name	table_name	index_name	extension_name	extension_version	index_type_name	index_type_parameters
test	r3	i_b	vsql_index_test	0.0.1	dummy_index_hnsw	{}
test	r4	i_a	vsql_index_test	0.0.1	dummy_index_hnsw	{}
test	r4	i_c	vsql_index_test	0.0.1	dummy_index_hnsw	{}
table_name	index_name	key_position	column_name	extension_name	extension_version	profile_name
r3	i_b	0	b	vsql_index_test	0.0.1	dummy_profile_hnsw_desc
r4	i_a	0	a	vsql_index_test	0.0.1	dummy_profile_hnsw_l2
r4	i_c	0	c	vsql_index_test	0.0.1	dummy_profile_hnsw_l2
SHOW CREATE TABLE r4;
Table	Create Table
r4	CREATE TABLE `r4` (
  `id` int NOT NULL,
  `a` vsql_index_test.dummy_type_vector DEFAULT NULL,
  `c` vsql_index_test.dummy_type_vector DEFAULT NULL,
  PRIMARY KEY (`id`),
  KEY `i_a` (`a` `vsql_index_test`.`dummy_profile_hnsw_l2`) USING EXTENDED(`vsql_index_test`.`dummy_index_hnsw`),
  KEY `i_c` (`c` `vsql_index_test`.`dummy_profile_hnsw_l2`) USING EXTENDED(`vsql_index_test`.`dummy_index_hnsw`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
# An index dropped by an ALTER that renames the table is removed.
ALTER TABLE r4 RENAME TO r5, DROP INDEX i_a;
db_name	table_name	index_name	extension_name	extension_version	index_type_name	index_type_parameters
test	r3	i_b	vsql_index_test	0.0.1	dummy_index_hnsw	{}
test	r5	i_c	vsql_index_test	0.0.1	dummy_index_hnsw	{}
table_name	index_name	key_position	column_name	extension_name	extension_version	profile_name
r3	i_b	0	b	vsql_index_test	0.0.1	dummy_profile_hnsw_desc
r5	i_c	0	c	vsql_index_test	0.0.1	dummy_profile_hnsw_l2
SHOW CREATE TABLE r5;
Table	Create Table
r5	CREATE TABLE `r5` (
  `id` int NOT NULL,
  `a` vsql_index_test.dummy_type_vector DEFAULT NULL,
  `c` vsql_index_test.dummy_type_vector DEFAULT NULL,
  PRIMARY KEY (`id`),
  KEY `i_c` (`c` `vsql_index_test`.`dummy_profile_hnsw_l2`) USING EXTENDED(`vsql_index_test`.`dummy_index_hnsw`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
# With every table dropped, the extension can be uninstalled.
DROP TABLE r3, r5;
DROP DATABASE db2;
SET SESSION debug='-d,villagesql_custom_index_proceed';
UNINSTALL EXTENSION vsql_index_test;
SET PERSIST vsql_allow_preview_extensions = OFF;
RESET PERSIST vsql_allow_preview_extensions;
