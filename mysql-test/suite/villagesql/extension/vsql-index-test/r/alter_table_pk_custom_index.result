SET PERSIST vsql_allow_preview_extensions = ON;
INSTALL EXTENSION vsql_index_test;
CREATE TABLE t (
k VARBINARY(8) NOT NULL PRIMARY KEY,
a dummy_type_vector,
INDEX idx (a) USING EXTENDED(dummy_index_hnsw)
);
SHOW CREATE TABLE t;
Table	Create Table
t	CREATE TABLE `t` (
  `k` varbinary(8) NOT NULL,
  `a` vsql_index_test.dummy_type_vector DEFAULT NULL,
  PRIMARY KEY (`k`),
  KEY `idx` (`a` `vsql_index_test`.`dummy_profile_hnsw_l2`) USING EXTENDED(`vsql_index_test`.`dummy_index_hnsw`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
# Modifying a primary-key column is rejected: INPLACE, COPY, and default.
ALTER TABLE t MODIFY k VARBINARY(64) NOT NULL, ALGORITHM=INPLACE;
ERROR HY000: VillageSQL: Changing the primary key of a table with a USING EXTENDED index is not supported
ALTER TABLE t MODIFY k VARBINARY(64) NOT NULL, ALGORITHM=COPY;
ERROR HY000: VillageSQL: Changing the primary key of a table with a USING EXTENDED index is not supported
ALTER TABLE t MODIFY k VARBINARY(64) NOT NULL;
ERROR HY000: VillageSQL: Changing the primary key of a table with a USING EXTENDED index is not supported
# Dropping/adding or re-defining the primary key is likewise rejected.
ALTER TABLE t DROP PRIMARY KEY, ADD PRIMARY KEY (k, a);
ERROR HY000: VillageSQL: Changing the primary key of a table with a USING EXTENDED index is not supported
ALTER TABLE t DROP PRIMARY KEY;
ERROR HY000: VillageSQL: Changing the primary key of a table with a USING EXTENDED index is not supported
# The table and its primary key are unchanged by the rejected ALTERs.
SHOW CREATE TABLE t;
Table	Create Table
t	CREATE TABLE `t` (
  `k` varbinary(8) NOT NULL,
  `a` vsql_index_test.dummy_type_vector DEFAULT NULL,
  PRIMARY KEY (`k`),
  KEY `idx` (`a` `vsql_index_test`.`dummy_profile_hnsw_l2`) USING EXTENDED(`vsql_index_test`.`dummy_index_hnsw`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
# An ALTER that does not touch the primary key is allowed.
ALTER TABLE t ADD COLUMN note INT DEFAULT 0;
SHOW CREATE TABLE t;
Table	Create Table
t	CREATE TABLE `t` (
  `k` varbinary(8) NOT NULL,
  `a` vsql_index_test.dummy_type_vector DEFAULT NULL,
  `note` int DEFAULT '0',
  PRIMARY KEY (`k`),
  KEY `idx` (`a` `vsql_index_test`.`dummy_profile_hnsw_l2`) USING EXTENDED(`vsql_index_test`.`dummy_index_hnsw`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
DROP TABLE t;
# Same rejection for a multi-part (composite) primary key.
CREATE TABLE tm (
k1 INT NOT NULL,
k2 VARBINARY(8) NOT NULL,
a dummy_type_vector,
PRIMARY KEY (k1, k2),
INDEX idx (a) USING EXTENDED(dummy_index_hnsw)
);
SHOW CREATE TABLE tm;
Table	Create Table
tm	CREATE TABLE `tm` (
  `k1` int NOT NULL,
  `k2` varbinary(8) NOT NULL,
  `a` vsql_index_test.dummy_type_vector DEFAULT NULL,
  PRIMARY KEY (`k1`,`k2`),
  KEY `idx` (`a` `vsql_index_test`.`dummy_profile_hnsw_l2`) USING EXTENDED(`vsql_index_test`.`dummy_index_hnsw`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
# Modifying either primary-key part is rejected (INPLACE, COPY, default).
ALTER TABLE tm MODIFY k2 VARBINARY(64) NOT NULL, ALGORITHM=INPLACE;
ERROR HY000: VillageSQL: Changing the primary key of a table with a USING EXTENDED index is not supported
ALTER TABLE tm MODIFY k1 BIGINT NOT NULL, ALGORITHM=COPY;
ERROR HY000: VillageSQL: Changing the primary key of a table with a USING EXTENDED index is not supported
ALTER TABLE tm MODIFY k2 VARBINARY(64) NOT NULL;
ERROR HY000: VillageSQL: Changing the primary key of a table with a USING EXTENDED index is not supported
# Dropping/re-defining the composite primary key is likewise rejected.
ALTER TABLE tm DROP PRIMARY KEY, ADD PRIMARY KEY (k1);
ERROR HY000: VillageSQL: Changing the primary key of a table with a USING EXTENDED index is not supported
ALTER TABLE tm DROP PRIMARY KEY;
ERROR HY000: VillageSQL: Changing the primary key of a table with a USING EXTENDED index is not supported
# The composite primary key is unchanged by the rejected ALTERs.
SHOW CREATE TABLE tm;
Table	Create Table
tm	CREATE TABLE `tm` (
  `k1` int NOT NULL,
  `k2` varbinary(8) NOT NULL,
  `a` vsql_index_test.dummy_type_vector DEFAULT NULL,
  PRIMARY KEY (`k1`,`k2`),
  KEY `idx` (`a` `vsql_index_test`.`dummy_profile_hnsw_l2`) USING EXTENDED(`vsql_index_test`.`dummy_index_hnsw`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
# An ALTER that does not touch the primary key is allowed.
ALTER TABLE tm ADD COLUMN note INT DEFAULT 0;
SHOW CREATE TABLE tm;
Table	Create Table
tm	CREATE TABLE `tm` (
  `k1` int NOT NULL,
  `k2` varbinary(8) NOT NULL,
  `a` vsql_index_test.dummy_type_vector DEFAULT NULL,
  `note` int DEFAULT '0',
  PRIMARY KEY (`k1`,`k2`),
  KEY `idx` (`a` `vsql_index_test`.`dummy_profile_hnsw_l2`) USING EXTENDED(`vsql_index_test`.`dummy_index_hnsw`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
DROP TABLE tm;
# Composite primary key whose parts are the custom (vector) type, with the
# custom index built on one of those PK columns.
CREATE TABLE tv (
v1 dummy_type_vector NOT NULL,
v2 dummy_type_vector NOT NULL,
PRIMARY KEY (v1, v2),
INDEX idx (v1) USING EXTENDED(dummy_index_hnsw)
);
SHOW CREATE TABLE tv;
Table	Create Table
tv	CREATE TABLE `tv` (
  `v1` vsql_index_test.dummy_type_vector NOT NULL,
  `v2` vsql_index_test.dummy_type_vector NOT NULL,
  PRIMARY KEY (`v1`,`v2`),
  KEY `idx` (`v1` `vsql_index_test`.`dummy_profile_hnsw_l2`) USING EXTENDED(`vsql_index_test`.`dummy_index_hnsw`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
# Changing a vector primary-key part's type is rejected.
ALTER TABLE tv MODIFY v1 VARBINARY(32) NOT NULL;
ERROR HY000: VillageSQL: Changing the primary key of a table with a USING EXTENDED index is not supported
# Narrowing or dropping the composite primary key is rejected.
ALTER TABLE tv DROP PRIMARY KEY, ADD PRIMARY KEY (v2);
ERROR HY000: VillageSQL: Changing the primary key of a table with a USING EXTENDED index is not supported
ALTER TABLE tv DROP PRIMARY KEY;
ERROR HY000: VillageSQL: Changing the primary key of a table with a USING EXTENDED index is not supported
# The primary key is unchanged by the rejected ALTERs.
SHOW CREATE TABLE tv;
Table	Create Table
tv	CREATE TABLE `tv` (
  `v1` vsql_index_test.dummy_type_vector NOT NULL,
  `v2` vsql_index_test.dummy_type_vector NOT NULL,
  PRIMARY KEY (`v1`,`v2`),
  KEY `idx` (`v1` `vsql_index_test`.`dummy_profile_hnsw_l2`) USING EXTENDED(`vsql_index_test`.`dummy_index_hnsw`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
DROP TABLE tv;
# With no custom index, a primary-key change is allowed.
CREATE TABLE t2 (k VARBINARY(8) NOT NULL PRIMARY KEY, a dummy_type_vector);
ALTER TABLE t2 MODIFY k VARBINARY(64) NOT NULL;
SHOW CREATE TABLE t2;
Table	Create Table
t2	CREATE TABLE `t2` (
  `k` varbinary(64) NOT NULL,
  `a` vsql_index_test.dummy_type_vector DEFAULT NULL,
  PRIMARY KEY (`k`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
DROP TABLE t2;
UNINSTALL EXTENSION vsql_index_test;
SET PERSIST vsql_allow_preview_extensions = OFF;
RESET PERSIST vsql_allow_preview_extensions;
