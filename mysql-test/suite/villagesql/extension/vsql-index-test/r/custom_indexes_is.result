SET PERSIST vsql_allow_preview_extensions = ON;
INSTALL EXTENSION vsql_index_test;
INSTALL EXTENSION vsql_ext_index_test;
SET SESSION debug='+d,villagesql_custom_index_proceed';
CREATE TABLE t (
id INT PRIMARY KEY,
b dummy_type_vector,
d dummy_type_vector,
e dummy_type_vector,
plain INT,
INDEX idx_plain (plain)
);
CREATE INDEX idx_ext ON t (b) USING EXTENDED(dummy_index_hnsw)
WITH (M = 16, ef_construction = 200);
CREATE INDEX idx_multi ON t (d, e) USING EXTENDED(dummy_index_hnsw);
CREATE TABLE t2 (
id INT PRIMARY KEY,
blob1 ext_index_wide_blob,
v1 dummy_type_vector,
plain INT,
INDEX idx_t2_ext  (blob1) USING EXTENDED(ext_index),
INDEX idx_t2_hnsw (v1) USING EXTENDED(dummy_index_hnsw),
INDEX idx_plain2  (plain)
);
# --- CUSTOM_INDEXES: one row per custom index, across both extensions ---
SELECT TABLE_SCHEMA, TABLE_NAME, INDEX_NAME,
INDEX_TYPE_EXTENSION_NAME, INDEX_TYPE_NAME,
INDEX_TYPE_PARAMETERS, STORAGE_REF,
MAPPING_INDEX_SPACE, MAPPING_INDEX_PAGE_NO
FROM INFORMATION_SCHEMA.CUSTOM_INDEXES
WHERE TABLE_SCHEMA = 'test'
ORDER BY TABLE_NAME, INDEX_NAME;
TABLE_SCHEMA	TABLE_NAME	INDEX_NAME	INDEX_TYPE_EXTENSION_NAME	INDEX_TYPE_NAME	INDEX_TYPE_PARAMETERS	STORAGE_REF	MAPPING_INDEX_SPACE	MAPPING_INDEX_PAGE_NO
test	t	idx_ext	vsql_index_test	dummy_index_hnsw	{"M": "16", "ef_construction": "200"}	0	#	#
test	t	idx_multi	vsql_index_test	dummy_index_hnsw	{}	0	#	#
test	t2	idx_t2_ext	vsql_ext_index_test	ext_index	{}	0	#	#
test	t2	idx_t2_hnsw	vsql_index_test	dummy_index_hnsw	{}	0	#	#
# --- CUSTOM_INDEX_COLUMNS: one row per key column, reached via INDEX_ID ---
SELECT i.TABLE_SCHEMA, i.TABLE_NAME, i.INDEX_NAME, i.INDEX_TYPE_NAME,
c.SEQ_IN_INDEX, c.COLUMN_NAME,
c.PROFILE_EXTENSION_NAME, c.PROFILE_NAME
FROM INFORMATION_SCHEMA.CUSTOM_INDEXES i
JOIN INFORMATION_SCHEMA.CUSTOM_INDEX_COLUMNS c USING (INDEX_ID)
WHERE i.TABLE_SCHEMA = 'test'
ORDER BY i.TABLE_NAME, i.INDEX_NAME, c.SEQ_IN_INDEX;
TABLE_SCHEMA	TABLE_NAME	INDEX_NAME	INDEX_TYPE_NAME	SEQ_IN_INDEX	COLUMN_NAME	PROFILE_EXTENSION_NAME	PROFILE_NAME
test	t	idx_ext	dummy_index_hnsw	1	b	vsql_index_test	dummy_profile_hnsw_l2
test	t	idx_multi	dummy_index_hnsw	1	d	vsql_index_test	dummy_profile_hnsw_l2
test	t	idx_multi	dummy_index_hnsw	2	e	vsql_index_test	dummy_profile_hnsw_l2
test	t2	idx_t2_ext	ext_index	1	blob1	vsql_ext_index_test	ext_index_default
test	t2	idx_t2_hnsw	dummy_index_hnsw	1	v1	vsql_index_test	dummy_profile_hnsw_l2
# --- Regular indexes are absent by construction ---
SELECT s.TABLE_NAME, s.INDEX_NAME,
CASE WHEN ci.INDEX_NAME IS NULL THEN 'absent (correct)'
            ELSE 'present (WRONG)' END AS in_custom_indexes
FROM INFORMATION_SCHEMA.STATISTICS s
LEFT JOIN INFORMATION_SCHEMA.CUSTOM_INDEXES ci
USING (TABLE_SCHEMA, TABLE_NAME, INDEX_NAME)
WHERE s.TABLE_SCHEMA = 'test'
  AND s.INDEX_NAME IN ('PRIMARY', 'idx_plain', 'idx_plain2')
AND s.SEQ_IN_INDEX = 1
ORDER BY s.TABLE_NAME, s.INDEX_NAME;
TABLE_NAME	INDEX_NAME	in_custom_indexes
t	idx_plain	absent (correct)
t	PRIMARY	absent (correct)
t2	idx_plain2	absent (correct)
t2	PRIMARY	absent (correct)
SELECT INDEX_NAME
FROM INFORMATION_SCHEMA.CUSTOM_INDEXES
WHERE TABLE_SCHEMA = 'test';
INDEX_NAME
idx_ext
idx_multi
idx_t2_ext
idx_t2_hnsw
# --- A single parameter is reachable by key ---
SELECT INDEX_NAME, INDEX_TYPE_PARAMETERS->>'$.M' AS m_raw
FROM INFORMATION_SCHEMA.CUSTOM_INDEXES
WHERE TABLE_SCHEMA = 'test' AND INDEX_NAME = 'idx_ext';
INDEX_NAME	m_raw
idx_ext	16
# --- Reaching STATISTICS  ---
SELECT s.TABLE_NAME, s.INDEX_NAME, s.SEQ_IN_INDEX, s.COLUMN_NAME,
s.INDEX_TYPE, c.PROFILE_NAME
FROM INFORMATION_SCHEMA.STATISTICS s
JOIN INFORMATION_SCHEMA.CUSTOM_INDEXES i
USING (TABLE_SCHEMA, TABLE_NAME, INDEX_NAME)
JOIN INFORMATION_SCHEMA.CUSTOM_INDEX_COLUMNS c
ON c.INDEX_ID = i.INDEX_ID AND c.SEQ_IN_INDEX = s.SEQ_IN_INDEX
WHERE s.TABLE_SCHEMA = 'test'
ORDER BY s.TABLE_NAME, s.INDEX_NAME, s.SEQ_IN_INDEX;
TABLE_NAME	INDEX_NAME	SEQ_IN_INDEX	COLUMN_NAME	INDEX_TYPE	PROFILE_NAME
t	idx_ext	1	b	DUMMY_INDEX_HNSW	dummy_profile_hnsw_l2
t	idx_multi	1	d	DUMMY_INDEX_HNSW	dummy_profile_hnsw_l2
t	idx_multi	2	e	DUMMY_INDEX_HNSW	dummy_profile_hnsw_l2
t2	idx_t2_ext	1	blob1	EXT_INDEX	ext_index_default
t2	idx_t2_hnsw	1	v1	DUMMY_INDEX_HNSW	dummy_profile_hnsw_l2
# --- EXTENSION_INDEX_TYPES: what an index of this type can actually do ---
SELECT * FROM INFORMATION_SCHEMA.EXTENSION_INDEX_TYPES
ORDER BY INDEX_TYPE_EXTENSION_NAME, INDEX_TYPE_NAME;
INDEX_TYPE_EXTENSION_NAME	INDEX_TYPE_EXTENSION_VERSION	INDEX_TYPE_NAME	SUPPORTS_POINT_LOOKUP	SUPPORTS_RANGE_SCAN	SUPPORTS_REVERSE_SCAN	SUPPORTS_ORDER_BY	SUPPORTS_KNN	HAS_COLUMN_REF	HAS_ROW_REF	SUPPORTS_REF_LOOKUP
vsql_ext_index_test	0.0.1	ext_index	NO	NO	NO	NO	YES	YES	NO	YES
vsql_index_test	0.0.1	dummy_index_hnsw	NO	NO	NO	NO	YES	YES	NO	YES
# --- EXTENSION_INDEX_PROFILES: what a profile binds ---
SELECT * FROM INFORMATION_SCHEMA.EXTENSION_INDEX_PROFILES
ORDER BY PROFILE_EXTENSION_NAME, PROFILE_NAME;
PROFILE_EXTENSION_NAME	PROFILE_NAME	DATA_TYPE_EXTENSION_NAME	DATA_TYPE_NAME	INDEX_TYPE_EXTENSION_NAME	INDEX_TYPE_NAME	ORDERING_ASC	ORDERING_DESC	IS_DEFAULT_PROFILE
vsql_ext_index_test	ext_index_default	vsql_ext_index_test	ext_index_wide_blob	vsql_ext_index_test	ext_index	YES	NO	YES
vsql_index_test	dummy_profile_hnsw_l2	vsql_index_test	dummy_type_vector	vsql_index_test	dummy_index_hnsw	YES	NO	YES
# --- EXTENSION_INDEX_PROFILE_FUNCTIONS: SQL functions each profile ---
#     registers --
SELECT * FROM INFORMATION_SCHEMA.EXTENSION_INDEX_PROFILE_FUNCTIONS
ORDER BY PROFILE_EXTENSION_NAME, PROFILE_NAME, FUNCTION_NAME;
PROFILE_EXTENSION_NAME	PROFILE_NAME	FUNCTION_NAME
vsql_ext_index_test	ext_index_default	ext_index_fn
vsql_index_test	dummy_profile_hnsw_l2	dummy_l2_distance
# --- Reaching from an index to the SQL functions it exposes ---
SELECT i.INDEX_NAME, c.COLUMN_NAME, c.PROFILE_NAME, pf.FUNCTION_NAME
FROM INFORMATION_SCHEMA.CUSTOM_INDEXES i
JOIN INFORMATION_SCHEMA.CUSTOM_INDEX_COLUMNS c USING (INDEX_ID)
JOIN INFORMATION_SCHEMA.EXTENSION_INDEX_PROFILE_FUNCTIONS pf
USING (PROFILE_EXTENSION_NAME, PROFILE_NAME)
WHERE i.TABLE_SCHEMA = 'test'
ORDER BY i.INDEX_NAME, c.SEQ_IN_INDEX, pf.FUNCTION_NAME;
INDEX_NAME	COLUMN_NAME	PROFILE_NAME	FUNCTION_NAME
idx_ext	b	dummy_profile_hnsw_l2	dummy_l2_distance
idx_multi	d	dummy_profile_hnsw_l2	dummy_l2_distance
idx_multi	e	dummy_profile_hnsw_l2	dummy_l2_distance
idx_t2_ext	blob1	ext_index_default	ext_index_fn
idx_t2_hnsw	v1	dummy_profile_hnsw_l2	dummy_l2_distance
# --- PROFILE_NAME from CUSTOM_INDEX_COLUMNS ---
SELECT i.INDEX_NAME, c.SEQ_IN_INDEX, c.COLUMN_NAME,
p.DATA_TYPE_NAME, p.INDEX_TYPE_NAME, p.IS_DEFAULT_PROFILE
FROM INFORMATION_SCHEMA.CUSTOM_INDEXES i
JOIN INFORMATION_SCHEMA.CUSTOM_INDEX_COLUMNS c USING (INDEX_ID)
JOIN INFORMATION_SCHEMA.EXTENSION_INDEX_PROFILES p
USING (PROFILE_EXTENSION_NAME, PROFILE_NAME)
WHERE i.TABLE_SCHEMA = 'test'
ORDER BY i.INDEX_NAME, c.SEQ_IN_INDEX;
INDEX_NAME	SEQ_IN_INDEX	COLUMN_NAME	DATA_TYPE_NAME	INDEX_TYPE_NAME	IS_DEFAULT_PROFILE
idx_ext	1	b	dummy_type_vector	dummy_index_hnsw	YES
idx_multi	1	d	dummy_type_vector	dummy_index_hnsw	YES
idx_multi	2	e	dummy_type_vector	dummy_index_hnsw	YES
idx_t2_ext	1	blob1	ext_index_wide_blob	ext_index	YES
idx_t2_hnsw	1	v1	dummy_type_vector	dummy_index_hnsw	YES
# --- The long way round: index -> key column -> profile -> index type ---
SELECT i.INDEX_NAME, c.COLUMN_NAME, p.PROFILE_NAME,
x.SUPPORTS_KNN, x.SUPPORTS_ORDER_BY
FROM INFORMATION_SCHEMA.CUSTOM_INDEXES i
JOIN INFORMATION_SCHEMA.CUSTOM_INDEX_COLUMNS c USING (INDEX_ID)
JOIN INFORMATION_SCHEMA.EXTENSION_INDEX_PROFILES p
USING (PROFILE_EXTENSION_NAME, PROFILE_NAME)
JOIN INFORMATION_SCHEMA.EXTENSION_INDEX_TYPES x
ON  x.INDEX_TYPE_EXTENSION_NAME = p.INDEX_TYPE_EXTENSION_NAME
AND  x.INDEX_TYPE_NAME           = p.INDEX_TYPE_NAME
WHERE i.TABLE_SCHEMA = 'test'
ORDER BY i.INDEX_NAME, c.SEQ_IN_INDEX;
INDEX_NAME	COLUMN_NAME	PROFILE_NAME	SUPPORTS_KNN	SUPPORTS_ORDER_BY
idx_ext	b	dummy_profile_hnsw_l2	YES	NO
idx_multi	d	dummy_profile_hnsw_l2	YES	NO
idx_multi	e	dummy_profile_hnsw_l2	YES	NO
idx_t2_ext	blob1	ext_index_default	YES	NO
idx_t2_hnsw	v1	dummy_profile_hnsw_l2	YES	NO
# --- Joining the two answers "can this index serve my ORDER BY?" ---
SELECT c.INDEX_NAME, c.INDEX_TYPE_NAME,
x.SUPPORTS_KNN, x.SUPPORTS_ORDER_BY, x.SUPPORTS_RANGE_SCAN
FROM INFORMATION_SCHEMA.CUSTOM_INDEXES c
JOIN INFORMATION_SCHEMA.EXTENSION_INDEX_TYPES x
USING (INDEX_TYPE_EXTENSION_NAME, INDEX_TYPE_NAME)
WHERE c.TABLE_SCHEMA = 'test'
ORDER BY c.INDEX_NAME;
INDEX_NAME	INDEX_TYPE_NAME	SUPPORTS_KNN	SUPPORTS_ORDER_BY	SUPPORTS_RANGE_SCAN
idx_ext	dummy_index_hnsw	YES	NO	NO
idx_multi	dummy_index_hnsw	YES	NO	NO
idx_t2_ext	ext_index	YES	NO	NO
idx_t2_hnsw	dummy_index_hnsw	YES	NO	NO
#
# Privilege filtering
#
CREATE DATABASE secretdb;
CREATE TABLE secretdb.st (
id INT PRIMARY KEY,
a dummy_type_vector,
INDEX idx_secret (a) USING EXTENDED(dummy_index_hnsw)
);
CREATE USER nobody@localhost;
# --- Upstream STATISTICS hides secretdb from an unprivileged user ---
SELECT TABLE_SCHEMA, TABLE_NAME, INDEX_NAME
FROM INFORMATION_SCHEMA.STATISTICS
WHERE TABLE_SCHEMA IN ('test', 'secretdb')
ORDER BY TABLE_SCHEMA, INDEX_NAME;
TABLE_SCHEMA	TABLE_NAME	INDEX_NAME
test	t	idx_ext
test	t	idx_multi
test	t	idx_multi
test	t	idx_plain
test	t2	idx_plain2
test	t2	idx_t2_ext
test	t2	idx_t2_hnsw
test	t	PRIMARY
test	t2	PRIMARY
# --- CUSTOM_INDEXES must hide it identically ---
SELECT TABLE_SCHEMA, TABLE_NAME, INDEX_NAME
FROM INFORMATION_SCHEMA.CUSTOM_INDEXES
WHERE TABLE_SCHEMA IN ('test', 'secretdb')
ORDER BY TABLE_SCHEMA, INDEX_NAME;
TABLE_SCHEMA	TABLE_NAME	INDEX_NAME
test	t	idx_ext
test	t	idx_multi
test	t2	idx_t2_ext
test	t2	idx_t2_hnsw
# --- CUSTOM_INDEX_COLUMNS must hide it too ---
SELECT COUNT(*) AS secret_key_columns_visible
FROM INFORMATION_SCHEMA.CUSTOM_INDEX_COLUMNS c
WHERE c.COLUMN_NAME = 'a';
secret_key_columns_visible
0
# --- The two catalogues are visible to the same user, by design ---
SELECT INDEX_TYPE_EXTENSION_NAME, INDEX_TYPE_NAME, SUPPORTS_KNN
FROM INFORMATION_SCHEMA.EXTENSION_INDEX_TYPES
ORDER BY INDEX_TYPE_NAME;
INDEX_TYPE_EXTENSION_NAME	INDEX_TYPE_NAME	SUPPORTS_KNN
vsql_index_test	dummy_index_hnsw	YES
vsql_ext_index_test	ext_index	YES
SELECT PROFILE_EXTENSION_NAME, PROFILE_NAME, INDEX_TYPE_NAME
FROM INFORMATION_SCHEMA.EXTENSION_INDEX_PROFILES
ORDER BY PROFILE_NAME;
PROFILE_EXTENSION_NAME	PROFILE_NAME	INDEX_TYPE_NAME
vsql_index_test	dummy_profile_hnsw_l2	dummy_index_hnsw
vsql_ext_index_test	ext_index_default	ext_index
DROP USER nobody@localhost;
#
# Lifecycle
#
# --- Dropping an index removes its rows ---
DROP INDEX idx_multi ON t;
SELECT INDEX_NAME FROM INFORMATION_SCHEMA.CUSTOM_INDEXES
WHERE TABLE_SCHEMA = 'test' ORDER BY INDEX_NAME;
INDEX_NAME
idx_ext
idx_t2_ext
idx_t2_hnsw
SELECT i.INDEX_NAME, c.SEQ_IN_INDEX
FROM INFORMATION_SCHEMA.CUSTOM_INDEXES i
JOIN INFORMATION_SCHEMA.CUSTOM_INDEX_COLUMNS c USING (INDEX_ID)
WHERE i.TABLE_SCHEMA = 'test' ORDER BY i.INDEX_NAME, c.SEQ_IN_INDEX;
INDEX_NAME	SEQ_IN_INDEX
idx_ext	1
idx_t2_ext	1
idx_t2_hnsw	1
# --- Dropping both tables removes the rest ---
DROP TABLE t;
SELECT INDEX_NAME AS rows_for_test_db FROM INFORMATION_SCHEMA.CUSTOM_INDEXES
WHERE TABLE_SCHEMA = 'test';
rows_for_test_db
idx_t2_ext
idx_t2_hnsw
DROP TABLE t2;
SELECT COUNT(*) AS rows_for_test_db FROM INFORMATION_SCHEMA.CUSTOM_INDEXES
WHERE TABLE_SCHEMA = 'test';
rows_for_test_db
0
DROP DATABASE secretdb;
# --- Uninstalling both extensions  ---
SET SESSION debug='-d,villagesql_custom_index_proceed';
UNINSTALL EXTENSION vsql_ext_index_test;
UNINSTALL EXTENSION vsql_index_test;
SELECT COUNT(*) AS index_types_after_uninstall
FROM INFORMATION_SCHEMA.EXTENSION_INDEX_TYPES;
index_types_after_uninstall
0
SELECT COUNT(*) AS profiles_after_uninstall
FROM INFORMATION_SCHEMA.EXTENSION_INDEX_PROFILES;
profiles_after_uninstall
0
SELECT COUNT(*) AS profile_functions_after_uninstall
FROM INFORMATION_SCHEMA.EXTENSION_INDEX_PROFILE_FUNCTIONS;
profile_functions_after_uninstall
0
SET PERSIST vsql_allow_preview_extensions = OFF;
RESET PERSIST vsql_allow_preview_extensions;
