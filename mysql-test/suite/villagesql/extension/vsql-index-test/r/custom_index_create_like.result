SET PERSIST vsql_allow_preview_extensions = ON;
INSTALL EXTENSION vsql_index_test;
SET SESSION debug='+d,villagesql_custom_index_proceed';
CREATE TABLE src (id INT PRIMARY KEY,
a dummy_type_vector, b dummy_type_vector, c dummy_type_vector,
d dummy_type_vector,
INDEX i_default (a) USING EXTENDED(dummy_index_hnsw),
INDEX i_desc (b dummy_profile_hnsw_desc DESC) USING EXTENDED(dummy_index_hnsw),
INDEX i_desc_none (c dummy_profile_hnsw_desc) USING EXTENDED(dummy_index_hnsw),
INDEX i_none (d dummy_profile_hnsw_none) USING EXTENDED(dummy_index_hnsw));
CREATE TABLE dst LIKE src;
# dst has the same profile on every key part as src.
db_name	table_name	index_name	extension_name	extension_version	index_type_name	index_type_parameters
test	dst	i_default	vsql_index_test	0.0.1	dummy_index_hnsw	{}
test	dst	i_desc	vsql_index_test	0.0.1	dummy_index_hnsw	{}
test	dst	i_desc_none	vsql_index_test	0.0.1	dummy_index_hnsw	{}
test	dst	i_none	vsql_index_test	0.0.1	dummy_index_hnsw	{}
