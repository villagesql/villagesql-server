# --- ALTER TABLE ADD INDEX: multiple indexes same extension -- MDL dedup ---
CREATE TABLE t_dedup (id INT PRIMARY KEY, x dummy_type_vector, y dummy_type_vector);
ALTER TABLE t_dedup
ADD INDEX idx_dedup1 (x dummy_profile_hnsw_l2) USING EXTENDED(dummy_index_hnsw),
ADD INDEX idx_dedup2 (y dummy_profile_hnsw_l2) USING EXTENDED(dummy_index_hnsw);
