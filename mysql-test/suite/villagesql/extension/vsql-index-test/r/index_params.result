SET PERSIST vsql_allow_preview_extensions = ON;
INSTALL EXTENSION vsql_index_test;
SET SESSION debug='+d,villagesql_custom_index_proceed';
CREATE TABLE t (id INT PRIMARY KEY,
a dummy_type_vector,
b dummy_type_vector,
c dummy_type_vector,
d dummy_type_vector,
e dummy_type_vector);
# --- No WITH clause: the index type supplies every default ---
CREATE INDEX idx_none ON t (a) USING EXTENDED(dummy_index_hnsw);
SHOW CREATE TABLE t;
Table	Create Table
t	CREATE TABLE `t` (
  `id` int NOT NULL,
  `a` vsql_index_test.dummy_type_vector DEFAULT NULL,
  `b` vsql_index_test.dummy_type_vector DEFAULT NULL,
  `c` vsql_index_test.dummy_type_vector DEFAULT NULL,
  `d` vsql_index_test.dummy_type_vector DEFAULT NULL,
  `e` vsql_index_test.dummy_type_vector DEFAULT NULL,
  PRIMARY KEY (`id`),
  KEY `idx_none` (`a` `vsql_index_test`.`dummy_profile_hnsw_l2`) USING EXTENDED(`vsql_index_test`.`dummy_index_hnsw`) WITH (`ef_construction` = 200, `m` = 16)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
