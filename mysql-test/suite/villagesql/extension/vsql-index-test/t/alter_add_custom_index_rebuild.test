# A custom (USING EXTENDED) index can be added to a populated table under any
# ALTER algorithm -- the default choice, INPLACE, COPY, and a COPY that also
# rebuilds the table (FORCE). In every case the new index is created as a custom
# index (its USING EXTENDED clause and per-column profile survive) and the rows
# are preserved. Adding further custom indexes in later statements keeps the
# ones already present.

SET PERSIST vsql_allow_preview_extensions = ON;
INSTALL EXTENSION vsql_ext_index_test;

CREATE TABLE t1 (
  id INT PRIMARY KEY,
  a  ext_index_wide_blob,
  b  ext_index_wide_blob,
  c  ext_index_wide_blob,
  d  ext_index_wide_blob
);
INSERT INTO t1 (id) VALUES (1), (2), (3);

--echo # --- Add via the default algorithm ---
ALTER TABLE t1 ADD INDEX idx_a (a ext_index_default) USING EXTENDED(ext_index);
SHOW CREATE TABLE t1;

--echo # --- Add via INPLACE, with a custom index already present ---
ALTER TABLE t1 ADD INDEX idx_b (b ext_index_default) USING EXTENDED(ext_index),
               ALGORITHM=INPLACE;
SHOW CREATE TABLE t1;

--echo # --- Add via COPY ---
ALTER TABLE t1 ADD INDEX idx_c (c ext_index_default) USING EXTENDED(ext_index),
               ALGORITHM=COPY;
SHOW CREATE TABLE t1;

--echo # --- Add combined with a table rebuild (FORCE, COPY) ---
ALTER TABLE t1 ADD INDEX idx_d (d ext_index_default) USING EXTENDED(ext_index),
               FORCE, ALGORITHM=COPY;
SHOW CREATE TABLE t1;

--echo # All four custom indexes and all rows survived.
SELECT COUNT(*) AS rows_total FROM t1;
INSERT INTO t1 (id) VALUES (4);
SELECT COUNT(*) AS rows_after_insert FROM t1;

DROP TABLE t1;

UNINSTALL EXTENSION vsql_ext_index_test;
SET PERSIST vsql_allow_preview_extensions = OFF;
RESET PERSIST vsql_allow_preview_extensions;
