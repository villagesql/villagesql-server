# Test error paths for CREATE INDEX USING EXTENDED.
#
# Covers:
#   Unknown index type name (unqualified and qualified)
#   Wrong extension qualifier for a known type
#   Unknown per-column profile name (unqualified and qualified)
#   Wrong extension qualifier for a known profile
#   Non-custom column with no default profile
#   Explicit profile for wrong column type
#   WITH (...) naming an unknown option, or giving one an unusable value
#   Profile validated against new column type when column is dropped and re-added
#   UNINSTALL EXTENSION blocked by: custom type columns, live custom index, index profile
#   UNINSTALL then INSTALL in the same session (ghost-descriptor regression)
#
# All error cases expect ER_VILLAGESQL_GENERIC_ERROR (HY000).

# TODO(villagesql-indexing): Remove have_debug.inc and the debug flag below once
# custom index execution is fully implemented and the guard in
# PT_custom_index_type::do_contextualize() is removed.
--source include/have_debug.inc

SET PERSIST vsql_allow_preview_extensions = ON;
INSTALL EXTENSION vsql_index_test;
SET SESSION debug='+d,villagesql_custom_index_proceed';

CREATE TABLE t (id INT PRIMARY KEY,
  a dummy_type_vector,
  b dummy_type_vector,
  c dummy_type_vector);

--echo # --- Unknown index type name ---
--error ER_VILLAGESQL_GENERIC_ERROR
CREATE INDEX idx ON t (a) USING EXTENDED(no_such_type);

--echo # --- Wrong extension qualifier for known type ---
--error ER_VILLAGESQL_GENERIC_ERROR
CREATE INDEX idx ON t (a) USING EXTENDED(no_such_ext.dummy_index_hnsw);

--echo # --- Qualified type with unknown name ---
--error ER_VILLAGESQL_GENERIC_ERROR
CREATE INDEX idx ON t (a) USING EXTENDED(vsql_index_test.no_such_type);

--echo # --- Unknown per-column profile ---
--error ER_VILLAGESQL_GENERIC_ERROR
CREATE INDEX idx ON t (a no_such_profile) USING EXTENDED(dummy_index_hnsw);

--echo # --- Wrong extension qualifier for known profile ---
--error ER_VILLAGESQL_GENERIC_ERROR
CREATE INDEX idx ON t (a no_such_ext.dummy_profile_hnsw_l2) USING EXTENDED(dummy_index_hnsw);

--echo # --- Qualified profile with unknown name ---
--error ER_VILLAGESQL_GENERIC_ERROR
CREATE INDEX idx ON t (a vsql_index_test.no_such_profile) USING EXTENDED(dummy_index_hnsw);

--echo # --- Non-custom column: no default profile ---
--error ER_VILLAGESQL_GENERIC_ERROR
CREATE INDEX idx ON t (id) USING EXTENDED(dummy_index_hnsw);

--echo # --- Explicit profile for wrong column type ---
--error ER_VILLAGESQL_GENERIC_ERROR
CREATE INDEX idx ON t (id dummy_profile_hnsw_l2) USING EXTENDED(dummy_index_hnsw);

--echo # --- CREATE INDEX: WITH incorrect parameter N ---
# The index type's parse hook runs at DDL, so its own message comes back as the
# SQL error rather than only reaching the server error log.
--error ER_VILLAGESQL_GENERIC_ERROR
CREATE INDEX idx_ext ON t (b) USING EXTENDED(dummy_index_hnsw)
  WITH (N = 16, ef_construction = 200);

--echo # --- CREATE INDEX: WITH out-of-range and non-numeric values ---
# dummy_index_hnsw accepts 1..65536 for both numeric options. Rejecting these
# at DDL is what keeps an unusable value from being persisted and then
# re-validated on every index open.
--error ER_VILLAGESQL_GENERIC_ERROR
CREATE INDEX idx_zero ON t (b) USING EXTENDED(dummy_index_hnsw) WITH (M = 0);

--error ER_VILLAGESQL_GENERIC_ERROR
CREATE INDEX idx_big ON t (b) USING EXTENDED(dummy_index_hnsw) WITH (M = 99999);

--error ER_VILLAGESQL_GENERIC_ERROR
CREATE INDEX idx_nan ON t (b) USING EXTENDED(dummy_index_hnsw) WITH (M = 'abc');

--echo # The second option is validated the same way as the first.
--error ER_VILLAGESQL_GENERIC_ERROR
CREATE INDEX idx_ef ON t (b) USING EXTENDED(dummy_index_hnsw)
  WITH (ef_construction = 0);

--echo # A bad value is rejected even when every other option is valid.
--error ER_VILLAGESQL_GENERIC_ERROR
CREATE INDEX idx_mixed ON t (b) USING EXTENDED(dummy_index_hnsw)
  WITH (M = 16, ef_construction = 99999, label = 'l2');

--echo # --- Drop+re-add: old type matches profile but new type does not (error) ---
# Column a was dummy_type_vector (T1); re-added as INT (T2). Profile requires
# dummy_type_vector, so the new column type must be checked, not the old one.
CREATE TABLE t_readd (id INT PRIMARY KEY, a dummy_type_vector);
--error ER_VILLAGESQL_GENERIC_ERROR
ALTER TABLE t_readd DROP COLUMN a, ADD COLUMN a INT,
  ADD INDEX idx (a dummy_profile_hnsw_l2) USING EXTENDED(dummy_index_hnsw);
DROP TABLE t_readd;

--echo # --- Drop+re-add: new type matches profile, old type did not (success) ---
# Column a was INT (T1); re-added as dummy_type_vector (T2). Profile requires
# dummy_type_vector, so the new column type satisfies the check.
CREATE TABLE t_readd (id INT PRIMARY KEY, a INT);
ALTER TABLE t_readd DROP COLUMN a, ADD COLUMN a dummy_type_vector,
  ADD INDEX idx (a dummy_profile_hnsw_l2) USING EXTENDED(dummy_index_hnsw);
DROP TABLE t_readd;

--echo # --- Custom index on partitioned table ---
CREATE TABLE t_part (id INT PRIMARY KEY, a dummy_type_vector)
  PARTITION BY RANGE (id) (
    PARTITION p0 VALUES LESS THAN (100),
    PARTITION p1 VALUES LESS THAN MAXVALUE);
--error ER_VILLAGESQL_GENERIC_ERROR
CREATE INDEX idx ON t_part (a) USING EXTENDED(dummy_index_hnsw);
DROP TABLE t_part;

--echo # --- Custom index on partitioned table via CREATE TABLE ---
--error ER_VILLAGESQL_GENERIC_ERROR
CREATE TABLE t_part (id INT PRIMARY KEY, a dummy_type_vector,
  INDEX idx (a) USING EXTENDED(dummy_index_hnsw))
  PARTITION BY RANGE (id) (
    PARTITION p0 VALUES LESS THAN (100),
    PARTITION p1 VALUES LESS THAN MAXVALUE);

--echo # --- UNINSTALL blocked by existing custom type ---
# Default: column check fires first.
CREATE INDEX idx_block ON t (a) USING EXTENDED(dummy_index_hnsw);
--error ER_VILLAGESQL_GENERIC_ERROR
UNINSTALL EXTENSION vsql_index_test;

--echo # --- UNINSTALL blocked by custom index ---
# Skip the column check so the index count check is the blocker.
SET SESSION debug='+d,villagesql_skip_uninstall_column_check';
--error ER_VILLAGESQL_GENERIC_ERROR
UNINSTALL EXTENSION vsql_index_test;

--echo # --- UNINSTALL blocked by index profile ---
# Also skip the index count check so the profile check is the blocker.
SET SESSION debug='+d,villagesql_skip_uninstall_index_check';
--error ER_VILLAGESQL_GENERIC_ERROR
UNINSTALL EXTENSION vsql_index_test;
SET SESSION debug='-d,villagesql_skip_uninstall_column_check';
SET SESSION debug='-d,villagesql_skip_uninstall_index_check';

--echo # --- DROP INDEX + DROP TABLE unblocks UNINSTALL; reinstall succeeds in same session ---
DROP INDEX idx_block ON t;
DROP TABLE t;
SET SESSION debug='-d,villagesql_custom_index_proceed';
UNINSTALL EXTENSION vsql_index_test;
INSTALL EXTENSION vsql_index_test;
UNINSTALL EXTENSION vsql_index_test;
SET PERSIST vsql_allow_preview_extensions = OFF;
RESET PERSIST vsql_allow_preview_extensions;
