# CUSTOM_INDEXES       one row per index, mirroring villagesql.custom_indexes
# CUSTOM_INDEX_COLUMNS one row per key column, mirroring custom_index_columns
# EXTENSION_INDEX_TYPES one row per index type, from memory-only descriptors
# EXTENSION_INDEX_PROFILES one row per profile, from memory-only descriptors
#
# The first two are privilege-filtered, because their rows name user objects,
# and join each other on INDEX_ID. The last two are deliberately NOT filtered --
# their rows name only installed software.
#
# The index/column split mirrors the villagesql tables, and follows upstream's
# INNODB_INDEXES / INNODB_FIELDS pair down to the INDEX_ID join key.
#
# Two extensions are involved in a custom index and need not be the same one, so
# every extension column is prefixed by the role it names: INDEX_TYPE_EXTENSION_*
# in CUSTOM_INDEXES and EXTENSION_INDEX_TYPES, PROFILE_EXTENSION_* in
# CUSTOM_INDEX_COLUMNS and EXTENSION_INDEX_PROFILES. A given name therefore means
# one thing everywhere, which is what lets the joins below use USING -- and makes
# joining the wrong extension impossible to write rather than silently right for
# every in-tree extension.
#
# TODO(villagesql-indexing): Remove have_debug.inc and the debug flag below once
# custom index execution is fully implemented and the guard in
# PT_custom_index_type::do_contextualize() is removed.
--source include/have_debug.inc

SET PERSIST vsql_allow_preview_extensions = ON;
INSTALL EXTENSION vsql_index_test;
SET SESSION debug='+d,villagesql_custom_index_proceed';

CREATE TABLE t (
  id INT PRIMARY KEY,
  b dummy_type_vector,
  d dummy_type_vector,
  e dummy_type_vector,
  plain INT,
  INDEX idx_plain (plain)
);
CREATE INDEX idx_ext ON t (b) USING EXTENDED(dummy_index_hnsw)
  WITH (M = 16, ef_construction = 200);
CREATE INDEX idx_multi ON t (d, e) USING EXTENDED(dummy_index_hnsw);

--echo # --- CUSTOM_INDEXES: one row per custom index ---
SELECT TABLE_SCHEMA, TABLE_NAME, INDEX_NAME,
       INDEX_TYPE_EXTENSION_NAME, INDEX_TYPE_EXTENSION_VERSION, INDEX_TYPE_NAME,
       INDEX_TYPE_PARAMETERS
FROM INFORMATION_SCHEMA.CUSTOM_INDEXES
WHERE TABLE_SCHEMA = 'test'
ORDER BY TABLE_NAME, INDEX_NAME;

--echo # --- CUSTOM_INDEX_COLUMNS: one row per key column, reached via INDEX_ID ---
# idx_multi spans (d, e) and so yields two rows. The extension columns here name
# the PROFILE's extension, which is why they are PROFILE_EXTENSION_* rather than
# the INDEX_TYPE_EXTENSION_* pair CUSTOM_INDEXES publishes.
#
# This view carries no schema or table columns, so every per-table question goes
# through CUSTOM_INDEXES.
SELECT i.TABLE_SCHEMA, i.TABLE_NAME, i.INDEX_NAME,
       c.SEQ_IN_INDEX, c.COLUMN_NAME,
       c.PROFILE_EXTENSION_NAME, c.PROFILE_EXTENSION_VERSION, c.PROFILE_NAME
FROM INFORMATION_SCHEMA.CUSTOM_INDEXES i
JOIN INFORMATION_SCHEMA.CUSTOM_INDEX_COLUMNS c USING (INDEX_ID)
WHERE i.TABLE_SCHEMA = 'test'
ORDER BY i.TABLE_NAME, i.INDEX_NAME, c.SEQ_IN_INDEX;

--echo # --- INDEX_ID joins CUSTOM_INDEXES and CUSTOM_INDEX_COLUMNS ---
SELECT COUNT(*) AS joined_rows,
       COUNT(DISTINCT i.INDEX_NAME) AS distinct_indexes
FROM INFORMATION_SCHEMA.CUSTOM_INDEXES i
JOIN INFORMATION_SCHEMA.CUSTOM_INDEX_COLUMNS c USING (INDEX_ID)
WHERE i.TABLE_SCHEMA = 'test';

--echo # --- Regular indexes are absent by construction ---
SELECT COUNT(*) AS regular_index_rows
FROM INFORMATION_SCHEMA.CUSTOM_INDEXES
WHERE TABLE_SCHEMA = 'test' AND INDEX_NAME IN ('idx_plain', 'PRIMARY');

--echo # --- A single parameter is reachable by key ---
# The column is JSON, so one parameter can be extracted without parsing the
# whole object. That the values are JSON *strings* -- vef_index_param_t renders
# numeric literals as decimal strings -- is pinned by the first query above,
# whose output keeps the quotes; ->> strips them, so it cannot show that here.
SELECT INDEX_NAME, INDEX_TYPE_PARAMETERS->>'$.M' AS m_raw
FROM INFORMATION_SCHEMA.CUSTOM_INDEXES
WHERE TABLE_SCHEMA = 'test' AND INDEX_NAME = 'idx_ext';

--echo # --- Reaching STATISTICS  ---
SELECT s.INDEX_NAME, s.SEQ_IN_INDEX, s.COLUMN_NAME, s.INDEX_TYPE,
       c.PROFILE_NAME
FROM INFORMATION_SCHEMA.STATISTICS s
JOIN INFORMATION_SCHEMA.CUSTOM_INDEXES i
  USING (TABLE_SCHEMA, TABLE_NAME, INDEX_NAME)
JOIN INFORMATION_SCHEMA.CUSTOM_INDEX_COLUMNS c
  ON c.INDEX_ID = i.INDEX_ID AND c.SEQ_IN_INDEX = s.SEQ_IN_INDEX
WHERE s.TABLE_SCHEMA = 'test' AND s.TABLE_NAME = 't'
ORDER BY s.INDEX_NAME, s.SEQ_IN_INDEX;

--echo # --- EXTENSION_INDEX_TYPES: what an index of this type can actually do ---
# Every VEF_INDEX_CAP_* and VEF_INDEX_STORAGE_* bit is decoded into its own
# YES/NO column;
SELECT * FROM INFORMATION_SCHEMA.EXTENSION_INDEX_TYPES
ORDER BY INDEX_TYPE_EXTENSION_NAME, INDEX_TYPE_NAME;

--echo # --- EXTENSION_INDEX_PROFILES: what a profile binds ---
# A profile binds a data type to an index type, and three extensions can be
# involved: the profile's own, the data type's, and the index type's.
#
# ORDERING_ASC/DESC are as *declared*. The SDK cannot express "unordered" and
# defaults to ASC, so a KNN profile still reports ORDERING_ASC = YES; see the
# TODO(villagesql-indexing) in villagesql/system_views/statistics.cc.
SELECT * FROM INFORMATION_SCHEMA.EXTENSION_INDEX_PROFILES
ORDER BY PROFILE_EXTENSION_NAME, PROFILE_NAME;

--echo # --- PROFILE_NAME from CUSTOM_INDEX_COLUMNS now resolves ---
# Before this table existed, CUSTOM_INDEX_COLUMNS published a complete
# (PROFILE_EXTENSION_NAME, PROFILE_EXTENSION_VERSION, PROFILE_NAME) triple that
# joined to nothing.
#
# The triple carries the same names on both sides, so this is a plain USING.
# CUSTOM_INDEXES is in the same FROM and does not interfere: its extension
# columns are INDEX_TYPE_EXTENSION_*, a different role and a different name.
SELECT i.INDEX_NAME, c.SEQ_IN_INDEX, c.COLUMN_NAME,
       p.DATA_TYPE_NAME, p.INDEX_TYPE_NAME, p.IS_DEFAULT_PROFILE
FROM INFORMATION_SCHEMA.CUSTOM_INDEXES i
JOIN INFORMATION_SCHEMA.CUSTOM_INDEX_COLUMNS c USING (INDEX_ID)
JOIN INFORMATION_SCHEMA.EXTENSION_INDEX_PROFILES p
  USING (PROFILE_EXTENSION_NAME, PROFILE_EXTENSION_VERSION, PROFILE_NAME)
WHERE i.TABLE_SCHEMA = 'test'
ORDER BY i.INDEX_NAME, c.SEQ_IN_INDEX;

--echo # --- The long way round: index -> key column -> profile -> index type ---
# The four tables close a rectangle, not a chain: the query above reaches
# EXTENSION_INDEX_TYPES from CUSTOM_INDEXES in one hop, and this one arrives at
# the same table the long way, through each key part's profile.
#
# The last hop must be qualified, and that is the one place where qualifying is
# still right. CUSTOM_INDEXES and EXTENSION_INDEX_PROFILES both expose
# INDEX_TYPE_EXTENSION_NAME, and the two can genuinely disagree -- the
# explicit-profile DDL path checks the profile's data type against the column but
# never checks its index type against the index. USING would silently pick one.
#
# The profile's index type reference carries no version, so this hop is a
# two-column join, not the three-column key EXTENSION_INDEX_TYPES publishes.
SELECT i.INDEX_NAME, c.COLUMN_NAME, p.PROFILE_NAME,
       x.SUPPORTS_KNN, x.SUPPORTS_ORDER_BY
FROM INFORMATION_SCHEMA.CUSTOM_INDEXES i
JOIN INFORMATION_SCHEMA.CUSTOM_INDEX_COLUMNS c USING (INDEX_ID)
JOIN INFORMATION_SCHEMA.EXTENSION_INDEX_PROFILES p
  USING (PROFILE_EXTENSION_NAME, PROFILE_EXTENSION_VERSION, PROFILE_NAME)
JOIN INFORMATION_SCHEMA.EXTENSION_INDEX_TYPES x
  ON  x.INDEX_TYPE_EXTENSION_NAME = p.INDEX_TYPE_EXTENSION_NAME
 AND  x.INDEX_TYPE_NAME           = p.INDEX_TYPE_NAME
WHERE i.TABLE_SCHEMA = 'test'
ORDER BY i.INDEX_NAME, c.SEQ_IN_INDEX;

--echo # --- Joining the two answers "can this index serve my ORDER BY?" ---
SELECT c.INDEX_NAME, c.INDEX_TYPE_NAME,
       x.SUPPORTS_KNN, x.SUPPORTS_ORDER_BY, x.SUPPORTS_RANGE_SCAN
FROM INFORMATION_SCHEMA.CUSTOM_INDEXES c
JOIN INFORMATION_SCHEMA.EXTENSION_INDEX_TYPES x
  USING (INDEX_TYPE_EXTENSION_NAME, INDEX_TYPE_EXTENSION_VERSION, INDEX_TYPE_NAME)
WHERE c.TABLE_SCHEMA = 'test'
ORDER BY c.INDEX_NAME;

--echo #
--echo # Privilege filtering
--echo #
# 'test' is world-accessible through the default `%`/`test` row in mysql.db, so
# it cannot be used to test filtering. secretdb has no such grant.
CREATE DATABASE secretdb;
CREATE TABLE secretdb.st (
  id INT PRIMARY KEY,
  a dummy_type_vector,
  INDEX idx_secret (a) USING EXTENDED(dummy_index_hnsw)
);

CREATE USER nobody@localhost;
connect(con1, localhost, nobody,,);

--echo # --- Upstream STATISTICS hides secretdb from an unprivileged user ---
SELECT TABLE_SCHEMA, TABLE_NAME, INDEX_NAME
FROM INFORMATION_SCHEMA.STATISTICS
WHERE TABLE_SCHEMA IN ('test', 'secretdb')
ORDER BY TABLE_SCHEMA, INDEX_NAME;

--echo # --- CUSTOM_INDEXES must hide it identically ---
SELECT TABLE_SCHEMA, TABLE_NAME, INDEX_NAME
FROM INFORMATION_SCHEMA.CUSTOM_INDEXES
WHERE TABLE_SCHEMA IN ('test', 'secretdb')
ORDER BY TABLE_SCHEMA, INDEX_NAME;

--echo # --- CUSTOM_INDEX_COLUMNS must hide it too ---
# This view names no schema or table, so its filter is the easiest to drop by
# accident during a "it doesn't need the join" cleanup. COLUMN_NAME is still
# user data, so the count below must exclude secretdb's key columns.
SELECT COUNT(*) AS secret_key_columns_visible
FROM INFORMATION_SCHEMA.CUSTOM_INDEX_COLUMNS c
WHERE c.COLUMN_NAME = 'a';

--echo # --- The two catalogues are visible to the same user, by design ---
# Their rows name no user object. Pinned so that a later "make these consistent"
# change cannot quietly start filtering them.
SELECT INDEX_TYPE_EXTENSION_NAME, INDEX_TYPE_NAME, SUPPORTS_KNN
FROM INFORMATION_SCHEMA.EXTENSION_INDEX_TYPES
ORDER BY INDEX_TYPE_NAME;
SELECT PROFILE_EXTENSION_NAME, PROFILE_NAME, INDEX_TYPE_NAME
FROM INFORMATION_SCHEMA.EXTENSION_INDEX_PROFILES
ORDER BY PROFILE_NAME;

connection default;
disconnect con1;
DROP USER nobody@localhost;

--echo #
--echo # Lifecycle
--echo #
--echo # --- Dropping an index removes its rows ---
DROP INDEX idx_multi ON t;
SELECT INDEX_NAME FROM INFORMATION_SCHEMA.CUSTOM_INDEXES
WHERE TABLE_SCHEMA = 'test' ORDER BY INDEX_NAME;
SELECT i.INDEX_NAME, c.SEQ_IN_INDEX
FROM INFORMATION_SCHEMA.CUSTOM_INDEXES i
JOIN INFORMATION_SCHEMA.CUSTOM_INDEX_COLUMNS c USING (INDEX_ID)
WHERE i.TABLE_SCHEMA = 'test' ORDER BY i.INDEX_NAME, c.SEQ_IN_INDEX;

--echo # --- Dropping the table removes the rest ---
DROP TABLE t;
SELECT COUNT(*) AS rows_for_test_db FROM INFORMATION_SCHEMA.CUSTOM_INDEXES
WHERE TABLE_SCHEMA = 'test';

DROP DATABASE secretdb;

--echo # --- Uninstalling the extension empties the type catalogue ---
# The descriptors are memory-only, so nothing survives the unload.
SET SESSION debug='-d,villagesql_custom_index_proceed';
UNINSTALL EXTENSION vsql_index_test;
SELECT COUNT(*) AS index_types_after_uninstall
FROM INFORMATION_SCHEMA.EXTENSION_INDEX_TYPES;
SELECT COUNT(*) AS profiles_after_uninstall
FROM INFORMATION_SCHEMA.EXTENSION_INDEX_PROFILES;

SET PERSIST vsql_allow_preview_extensions = OFF;
RESET PERSIST vsql_allow_preview_extensions;
