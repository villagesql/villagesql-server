call mtr.add_suppression("Orphaned expansion directory found but not removed");
# restart: --veb-dir=MYSQLTEST_VARDIR/veb
Creating extension vdf_sb using SDK...
Created vdf_sb.veb
INSTALL EXTENSION vdf_sb;
#
# Test 1: an argument in utf8mb4 reaches both as the same bytes
#
SELECT vdf_sb.str_hex('é') AS str, vdf_sb.bin_hex('é') AS bin;
str	bin
C3A9	C3A9
#
# Test 2: an argument in another charset
#
# STRING converts it to utf8mb4; BINARY gets the bytes it was written in.
SELECT vdf_sb.str_hex(_latin1 0xE9) AS str, vdf_sb.bin_hex(_latin1 0xE9) AS bin;
str	bin
C3A9	E9
SELECT vdf_sb.str_hex(_ucs2 0x00E9) AS str, vdf_sb.bin_hex(_ucs2 0x00E9) AS bin;
str	bin
C3A9	00E9
Warnings:
Warning	1287	'ucs2' is deprecated and will be removed in a future release. Please use utf8mb4 instead
Warning	1287	'ucs2' is deprecated and will be removed in a future release. Please use utf8mb4 instead
CREATE TABLE t1 (txt VARCHAR(8) CHARACTER SET latin1);
INSERT INTO t1 VALUES ('é');
SELECT vdf_sb.str_hex(txt) AS str, vdf_sb.bin_hex(txt) AS bin FROM t1;
str	bin
C3A9	E9
DROP TABLE t1;
#
# Test 3: an argument in the binary charset
#
# A STRING parameter accepts it only when it is valid utf8mb4. BINARY
# takes any bytes.
SELECT vdf_sb.str_hex(0xC3A9) AS str, vdf_sb.bin_hex(0xC3A9) AS bin;
str	bin
C3A9	C3A9
SELECT vdf_sb.str_hex(0xFF);
ERROR HY000: Cannot convert string '\xFF' from binary to utf8mb4
SELECT vdf_sb.bin_hex(0xFF) AS bin;
bin
FF
# A binary value that is a view into the buffer it was read into: LPAD()
# writes into that buffer, and SUBSTRING() returns part of it.
CREATE TABLE t3 (txt VARCHAR(8));
INSERT INTO t3 VALUES ('abc'), ('é');
SELECT vdf_sb.str_hex(SUBSTRING(CAST(LPAD(txt, 6, '-') AS BINARY), 2)) AS str,
HEX(SUBSTRING(CAST(LPAD(txt, 6, '-') AS BINARY), 2)) AS expected
FROM t3;
str	expected
2D2D616263	2D2D616263
2D2D2D2DC3A9	2D2D2D2DC3A9
DROP TABLE t3;
#
# Test 4: NULL
#
SELECT vdf_sb.str_hex(NULL) AS str, vdf_sb.bin_hex(NULL) AS bin;
str	bin
NULL	NULL
#
# Test 5: the charset of each result
#
SELECT CHARSET(vdf_sb.str_echo('a')) AS str, COLLATION(vdf_sb.str_echo('a')) AS str_coll;
str	str_coll
utf8mb4	utf8mb4_bin
SELECT CHARSET(vdf_sb.bin_echo('a')) AS bin, COLLATION(vdf_sb.bin_echo('a')) AS bin_coll;
bin	bin_coll
binary	binary
SELECT vdf_sb.str_echo(_latin1 0xE9) AS str;
str
é
SELECT HEX(vdf_sb.bin_echo(0x00FF10)) AS bin;
bin
00FF10
#
# Test 6: a BINARY result that is not text can be materialized
#
# A result labelled utf8mb4 would be refused here as an incorrect
# string value.
CREATE TABLE t2 AS SELECT vdf_sb.bin_echo(0xBA7816BF8F01) AS h;
SHOW CREATE TABLE t2;
Table	Create Table
t2	CREATE TABLE `t2` (
  `h` varbinary(64) DEFAULT NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
SELECT HEX(h) FROM t2;
HEX(h)
BA7816BF8F01
DROP TABLE t2;
#
# Test 7: the constant a bind_and_check_types hook is given
#
# The hook reads a constant as the VDF does: utf8mb4 for a STRING
# parameter, the bytes unconverted for any other. The *_const hooks
# reject the call with the bytes they were given.
SELECT vdf_sb.str_const(_latin1 0xE9);
ERROR HY000: Cannot initialize function 'str_const': constant C3A9
SELECT vdf_sb.bin_const(_latin1 0xE9);
ERROR HY000: Cannot initialize function 'bin_const': constant E9
SELECT vdf_sb.int_const(0xFF);
ERROR HY000: Cannot initialize function 'int_const': constant FF
# A constant that is not valid utf8mb4 still reaches an INT parameter.
SELECT vdf_sb.int_echo(0xFF) AS i;
i
255
# Reading a constant for the hook leaves the constant as it was: a latin1
# literal for a custom type is still converted to utf8mb4 for its
# from_string, with a hook or without.
SELECT vdf_sb.text8_hex(_latin1 0xE9) AS unhooked,
vdf_sb.text8_hooked(_latin1 0xE9) AS hooked;
unhooked	hooked
C3A9000000000000	C3A9000000000000
#
# Test 8: the registration lists BINARY
#
SELECT jt.name, jt.return_type, jt.params
FROM INFORMATION_SCHEMA.EXTENSION_REGISTRATION,
JSON_TABLE(REGISTRATION_JSON, '$.funcs[*]' COLUMNS (
name        VARCHAR(64) PATH '$.name',
return_type VARCHAR(64) PATH '$.return_type',
params      JSON        PATH '$.params'
)) AS jt
WHERE EXTENSION_NAME = 'vdf_sb'
ORDER BY jt.name;
name	return_type	params
bin_const	STRING	["BINARY"]
bin_echo	BINARY	["BINARY"]
bin_hex	STRING	["BINARY"]
int_const	INT	["INT"]
int_echo	INT	["INT"]
str_const	STRING	["STRING"]
str_echo	STRING	["STRING"]
str_hex	STRING	["STRING"]
text8_hex	STRING	["TEXT8"]
text8_hooked	STRING	["TEXT8"]
TEXT8::compare	INT	["TEXT8", "TEXT8"]
TEXT8::from_string	TEXT8	["STRING"]
TEXT8::to_string	STRING	["TEXT8"]
SELECT COLLATION(vdf_sb.str_echo('a' COLLATE utf8mb4_0900_ai_ci)) AS result_collation,
COERCIBILITY(vdf_sb.str_echo('a')) AS coercibility;
result_collation	coercibility
utf8mb4_bin	4
SELECT vdf_sb.str_echo('A') = vdf_sb.str_echo('a') AS case_equal,
vdf_sb.str_echo('e') = vdf_sb.str_echo('é') AS accent_equal,
vdf_sb.str_echo('a') = vdf_sb.str_echo('a ') AS space_equal,
vdf_sb.str_echo('a') LIKE vdf_sb.str_echo('a ') AS space_like,
HEX(vdf_sb.str_echo('a ')) AS preserved_spaces;
case_equal	accent_equal	space_equal	space_like	preserved_spaces
0	0	1	0	6120
CREATE TABLE result_policy (s VARCHAR(8) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci);
INSERT INTO result_policy VALUES ('a'), ('A'), ('a '), ('é'), ('e');
SELECT s, s = vdf_sb.str_echo('A') AS column_equal,
s = (vdf_sb.str_echo('A') COLLATE utf8mb4_bin) AS explicit_equal
FROM result_policy ORDER BY HEX(s);
s	column_equal	explicit_equal
A	1	1
a	1	0
a 	0	0
e	0	0
é	0	0
SELECT COUNT(DISTINCT vdf_sb.str_echo(s)) AS distinct_values FROM result_policy;
distinct_values
4
SELECT MIN(HEX(s)) AS representative, COUNT(*) AS members
FROM result_policy GROUP BY vdf_sb.str_echo(s) ORDER BY representative;
representative	members
41	1
61	2
65	1
C3A9	1
CREATE TABLE materialized_policy AS SELECT vdf_sb.str_echo(s) AS s FROM result_policy;
SELECT DISTINCT CHARSET(s), COLLATION(s), COERCIBILITY(s) FROM materialized_policy;
CHARSET(s)	COLLATION(s)	COERCIBILITY(s)
utf8mb4	utf8mb4_bin	2
SELECT HEX(s) FROM materialized_policy ORDER BY HEX(s);
HEX(s)
41
61
6120
65
C3A9
DROP TABLE materialized_policy, result_policy;
CREATE TABLE custom_text (id INT PRIMARY KEY, v TEXT8);
INSERT INTO custom_text VALUES (1, _binary 0xFF);
ERROR HY000: Incorrect TEXT8 value: '\xFF' for column 'v' at row 1
SELECT vdf_sb.text8_hex(_binary 0xFF);
ERROR HY000: Incorrect TEXT8 value: '\xFF'
SELECT vdf_sb.TEXT8::from_string(0xFF);
ERROR HY000: Cannot convert string '\xFF' from binary to utf8mb4
INSERT INTO custom_text VALUES (1, _latin1 0xE9), (2, _ucs2 0x00E9), (3, _binary 0xC3A9);
Warnings:
Warning	1287	'ucs2' is deprecated and will be removed in a future release. Please use utf8mb4 instead
SELECT id, vdf_sb.text8_hex(v) AS encoded FROM custom_text ORDER BY id;
id	encoded
1	C3A9000000000000
2	C3A9000000000000
3	C3A9000000000000
SELECT vdf_sb.text8_hex(vdf_sb.TEXT8::from_string(_latin1 0xE9)) AS explicit_encoded;
explicit_encoded
C3A9000000000000
PREPARE custom_insert FROM 'INSERT INTO custom_text VALUES (4, ?)';
SET @text = 0xFF;
EXECUTE custom_insert USING @text;
ERROR HY000: Incorrect TEXT8 value: '\xFF' for column 'v' at row 1
SET @text = _ucs2 0x00E9;
Warnings:
Warning	1287	'ucs2' is deprecated and will be removed in a future release. Please use utf8mb4 instead
EXECUTE custom_insert USING @text;
DEALLOCATE PREPARE custom_insert;
SELECT vdf_sb.text8_hex(v) AS prepared_encoded FROM custom_text WHERE id = 4;
prepared_encoded
C3A9000000000000
DROP TABLE custom_text;
#
# Cleanup
#
UNINSTALL EXTENSION vdf_sb;
