#
# An unprivileged user is denied all three extension DDL statements.
# (The privilege check fires before any VEB is touched, so vsql_complex
# need not exist yet.)
#
CREATE USER ext_none@localhost;
GRANT SELECT ON *.* TO ext_none@localhost;
INSTALL EXTENSION vsql_complex;
ERROR 42000: Access denied; you need (at least one of) the EXTENSION_ADMIN or SUPER privilege(s) for this operation
ALTER EXTENSION vsql_complex VERSION '1.0.0' AT RESTART;
ERROR 42000: Access denied; you need (at least one of) the EXTENSION_ADMIN or SUPER privilege(s) for this operation
UNINSTALL EXTENSION vsql_complex;
ERROR 42000: Access denied; you need (at least one of) the EXTENSION_ADMIN or SUPER privilege(s) for this operation
#
# A user granted EXTENSION_ADMIN can install and uninstall.
#
CREATE USER ext_admin@localhost;
GRANT EXTENSION_ADMIN ON *.* TO ext_admin@localhost;
INSTALL EXTENSION vsql_complex;
SELECT extension_name FROM INFORMATION_SCHEMA.EXTENSIONS
WHERE extension_name = 'vsql_complex';
EXTENSION_NAME
vsql_complex
UNINSTALL EXTENSION vsql_complex;
#
# A user with SUPER (but not EXTENSION_ADMIN) can also run them (fallback).
#
CREATE USER ext_super@localhost;
GRANT SUPER ON *.* TO ext_super@localhost;
Warnings:
Warning	1287	The SUPER privilege identifier is deprecated
INSTALL EXTENSION vsql_complex;
UNINSTALL EXTENSION vsql_complex;
#
# Cleanup.
#
DROP USER ext_none@localhost;
DROP USER ext_admin@localhost;
DROP USER ext_super@localhost;
