# Test VDF IS NULL optimizer fold fix
call mtr.add_suppression("Orphaned expansion directory found but not removed");
# restart: --veb-dir=MYSQLTEST_VARDIR/veb
# Create test extension with echo_or_null(str) VDF
Creating extension vdf_null_return using SDK...
Created vdf_null_return.veb
# Install extension
INSTALL EXTENSION vdf_null_return;
#
# Regression cases: constant non-nullable argument, VDF returns NULL at
# runtime. Before the fix, the optimizer folded IS NULL to 0 without
# evaluating the function.
#
# VDF returns NULL for 'invalid' -- IS NULL must be 1
SELECT vdf_null_return.echo_or_null('invalid') IS NULL AS result;
result
1
# VDF returns a value for 'hello' -- IS NULL must be 0
SELECT vdf_null_return.echo_or_null('hello') IS NULL AS result;
result
0
#
# Null propagation: NULL argument -> NULL result. Was correct before
# the fix; verify it remains correct.
#
# NULL argument propagates to NULL result
SELECT vdf_null_return.echo_or_null(NULL) IS NULL AS result;
result
1
#
# Column path: optimizer cannot fold, always evaluated at runtime.
# Was correct before the fix; verify constant and column paths agree.
#
CREATE TABLE t (val VARCHAR(50));
INSERT INTO t VALUES ('invalid'), ('hello'), (NULL);
SELECT val, vdf_null_return.echo_or_null(val) IS NULL AS is_null
FROM t ORDER BY val;
val	is_null
NULL	1
hello	0
invalid	1
DROP TABLE t;
# Uninstall extension
UNINSTALL EXTENSION vdf_null_return;
include/rpl/deprecated/show_binlog_events.inc
