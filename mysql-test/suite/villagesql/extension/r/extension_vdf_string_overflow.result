FROM s_data;
field_intact
1
CREATE TABLE g_data (id INT PRIMARY KEY AUTO_INCREMENT, grp INT, s VARCHAR(60));
SELECT grp, LENGTH(agg_vdf_ext.vdf_concat(s)) AS len
FROM g_data
GROUP BY grp
ORDER BY grp;
