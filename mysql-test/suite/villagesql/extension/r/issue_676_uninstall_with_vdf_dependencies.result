# carries no persistent dependency on the VDF. Should be blocked.
UNINSTALL EXTENSION vsql_complex;
# The table is now broken: reads error with missing-function code.
SELECT * FROM t_idx;
ERROR 42000: FUNCTION vsql_complex.complex_real does not exist
DROP TABLE t_idx;
