INSTALL EXTENSION vsql_array;
SELECT extension_name, extension_version FROM INFORMATION_SCHEMA.EXTENSIONS;
EXTENSION_NAME	EXTENSION_VERSION
vsql_array	0.0.1
#
# DDL: parameters and their validation.
#
CREATE TABLE t (
id INT PRIMARY KEY,
a vsql_array.ARRAY(4),
i32 vsql_array.ARRAY('type=int32,max_size=3'),
d vsql_array.ARRAY('max_size=3,type=double')
);
SHOW CREATE TABLE t;
Table	Create Table
t	CREATE TABLE `t` (
  `id` int NOT NULL,
  `a` vsql_array.ARRAY(4) DEFAULT NULL,
  `i32` vsql_array.ARRAY('max_size=3,type=int32') DEFAULT NULL,
  `d` vsql_array.ARRAY('max_size=3,type=double') DEFAULT NULL,
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
# The default element type is int64: ARRAY(4) and
# ARRAY('type=int64,max_size=4') are the same type.
CREATE TABLE t_same (a vsql_array.ARRAY('type=int64,max_size=4'));
INSERT INTO t_same VALUES ('[1,2]');
INSERT INTO t (id, a) SELECT 100, a FROM t_same;
SELECT id, a FROM t WHERE id = 100;
id	a
100	[1,2]
DELETE FROM t WHERE id = 100;
DROP TABLE t_same;
# Unqualified ARRAY is the MySQL keyword, not this type.
CREATE TABLE bad (a ARRAY(4));
ERROR 42000: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'ARRAY(4))' at line 1
# Missing max_size.
CREATE TABLE bad (a vsql_array.ARRAY('type=int32'));
ERROR 42000: ARRAY requires a max_size parameter near 'vsql_array.ARRAY('type=int32'))' at line 1
# Non-positive max_size.
CREATE TABLE bad (a vsql_array.ARRAY(0));
ERROR 42000: Invalid length '0' for type 'vsql_array.ARRAY' near 'vsql_array.ARRAY(0))' at line 1
CREATE TABLE bad (a vsql_array.ARRAY('max_size=-1'));
ERROR 42000: ARRAY max_size must be positive near 'vsql_array.ARRAY('max_size=-1'))' at line 1
CREATE TABLE bad (a vsql_array.ARRAY('max_size=abc'));
ERROR 42000: ARRAY: invalid max_size 'abc' near 'vsql_array.ARRAY('max_size=abc'))' at line 1
# Unknown element type and unknown parameter key.
CREATE TABLE bad (a vsql_array.ARRAY('type=int16,max_size=4'));
ERROR 42000: ARRAY: type must be 'int32', 'int64' or 'double', got 'int16' near 'vsql_array.ARRAY('type=int16,max_size=4'))' at line 1
CREATE TABLE bad (a vsql_array.ARRAY('max_size=4,dims=2'));
ERROR 42000: ARRAY: unknown parameter 'dims' (expected 'type' and 'max_size') near 'vsql_array.ARRAY('max_size=4,dims=2'))' at line 1
# Bounds: 1024 int64 / 1024 double / 2048 int32 are accepted; one more
# element is rejected.
CREATE TABLE bounds (
a vsql_array.ARRAY(1024),
b vsql_array.ARRAY('type=double,max_size=1024'),
c vsql_array.ARRAY('type=int32,max_size=2048')
);
DROP TABLE bounds;
CREATE TABLE bad (a vsql_array.ARRAY(1025));
ERROR 42000: ARRAY max_size 1025 exceeds the limit of 1024 int64 elements (8192 bytes) near 'vsql_array.ARRAY(1025))' at line 1
CREATE TABLE bad (a vsql_array.ARRAY('type=double,max_size=1025'));
ERROR 42000: ARRAY max_size 1025 exceeds the limit of 1024 double elements (8192 bytes) near 'vsql_array.ARRAY('type=double,max_size=1025'))' at line 1
CREATE TABLE bad (a vsql_array.ARRAY('type=int32,max_size=2049'));
ERROR 42000: ARRAY max_size 2049 exceeds the limit of 2048 int32 elements (8192 bytes) near 'vsql_array.ARRAY('type=int32,max_size=2049'))' at line 1
#
# Insert / select: text in and out, empty array, NULL, whitespace.
#
INSERT INTO t VALUES
(1, '[1,2,3]', '[-2147483648,0,2147483647]', '[1.5,-2.25e10,0.1]'),
(2, '[]', '[]', '[]'),
(3, NULL, NULL, NULL),
(4, ' [ 9223372036854775807 , -9223372036854775808 ] ', '[ 7 ]', '[1e300, -1e-300, 0]'),
(5, '[1,2]', '[1]', '[0.30000000000000004]');
SELECT id, a, i32, d FROM t ORDER BY id;
id	a	i32	d
1	[1,2,3]	[-2147483648,0,2147483647]	[1.5,-22500000000,0.1]
2	[]	[]	[]
3	NULL	NULL	NULL
4	[9223372036854775807,-9223372036854775808]	[7]	[1e+300,-1e-300,0]
5	[1,2]	[1]	[0.30000000000000004]
#
# Compare: element-wise, then shorter first.
#
SELECT id, a FROM t WHERE a = '[1,2,3]' ORDER BY id;
id	a
1	[1,2,3]
SELECT id, a FROM t WHERE a > '[1,2]' ORDER BY id;
id	a
1	[1,2,3]
4	[9223372036854775807,-9223372036854775808]
SELECT id, a FROM t WHERE a < '[1,2]' ORDER BY id;
id	a
2	[]
SELECT id, a FROM t WHERE a IS NOT NULL ORDER BY a, id;
id	a
2	[]
5	[1,2]
1	[1,2,3]
4	[9223372036854775807,-9223372036854775808]
SELECT x.id, y.id FROM t x JOIN t y ON x.a = y.a WHERE x.id < y.id ORDER BY x.id;
id	id
# Comparing arrays with different parameters is rejected.
SELECT id FROM t WHERE a = i32;
ERROR HY000: Cannot compare types vsql_array.ARRAY(4) and vsql_array.ARRAY('max_size=3,type=int32') in =
#
# max_size overflow and wrong element text are rejected (strict mode).
#
INSERT INTO t (id, a) VALUES (10, '[1,2,3,4,5]');
ERROR HY000: Incorrect ARRAY value: '[1,2,3,4,5]' for column 'a' at row 1
INSERT INTO t (id, i32) VALUES (10, '[2147483648]');
ERROR HY000: Incorrect ARRAY value: '[2147483648]' for column 'i32' at row 1
INSERT INTO t (id, a) VALUES (10, '[9223372036854775808]');
ERROR HY000: Incorrect ARRAY value: '[9223372036854775808]' for column 'a' at row 1
INSERT INTO t (id, a) VALUES (10, '[1.5]');
ERROR HY000: Incorrect ARRAY value: '[1.5]' for column 'a' at row 1
INSERT INTO t (id, a) VALUES (10, '[1,x]');
ERROR HY000: Incorrect ARRAY value: '[1,x]' for column 'a' at row 1
