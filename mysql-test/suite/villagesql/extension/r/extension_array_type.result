ERROR HY000: Incorrect ARRAY value: '[1e400]' for column 'd' at row 1
SELECT COUNT(*) FROM t WHERE id = 10;
COUNT(*)
0
# INSERT IGNORE stores the intrinsic default '[]' in a NOT NULL column.
CREATE TABLE t_nn (id INT PRIMARY KEY, a vsql_array.ARRAY(2) NOT NULL);
INSERT IGNORE INTO t_nn VALUES (1, 'not-an-array');
Warnings:
Warning	1366	Incorrect ARRAY value: 'not-an-array' for column 'a' at row 1
SELECT id, a, vsql_array.array_length(a) FROM t_nn ORDER BY id;
id	a	vsql_array.array_length(a)
1	[]	0
DROP TABLE t_nn;
#
# Functions (1-based index, NULL out of range).
#
SELECT id,
vsql_array.array_length(a) AS len,
vsql_array.array_get(a, 1) AS first,
vsql_array.array_get(a, vsql_array.array_length(a)) AS last,
vsql_array.array_get(a, 0) AS zero,
vsql_array.array_get(a, 99) AS past_end,
vsql_array.array_get(a, NULL) AS null_idx,
vsql_array.array_get(i32, 3) AS i32_3,
vsql_array.array_get_double(d, 1) AS d_1,
vsql_array.array_get_double(a, 1) AS a_1_as_double
FROM t ORDER BY id;
id	len	first	last	zero	past_end	null_idx	i32_3	d_1	a_1_as_double
1	3	1	3	NULL	NULL	NULL	2147483647	1.5	1
2	0	NULL	NULL	NULL	NULL	NULL	NULL	NULL	NULL
3	NULL	NULL	NULL	NULL	NULL	NULL	NULL	NULL	NULL
4	2	9223372036854775807	-9223372036854775808	NULL	NULL	NULL	NULL	1e300	9.223372036854776e18
5	2	1	2	NULL	NULL	NULL	NULL	0.30000000000000004	1
SELECT id,
vsql_array.array_contains(a, 2) AS has_2,
vsql_array.array_contains(a, '9223372036854775807') AS has_max,
vsql_array.array_contains(d, 0.1) AS has_0_1,
vsql_array.array_contains(d, '1.5') AS has_1_5,
vsql_array.array_contains(a, NULL) AS null_probe
FROM t ORDER BY id;
id	has_2	has_max	has_0_1	has_1_5	null_probe
1	1	0	1	1	NULL
2	0	0	0	0	NULL
3	NULL	NULL	NULL	NULL	NULL
4	0	1	0	0	NULL
5	1	0	0	0	NULL
# A probe that is not an element of the array's type gives NULL and a
# warning.
SELECT vsql_array.array_contains(a, '1.5') FROM t WHERE id = 1;
vsql_array.array_contains(a, '1.5')
NULL
Warnings:
Warning	3200	VDF error in function 'array_contains': array_contains(int64): unexpected characters after element
SELECT vsql_array.array_contains(a, 'abc') FROM t WHERE id = 1;
vsql_array.array_contains(a, 'abc')
NULL
Warnings:
Warning	3200	VDF error in function 'array_contains': array_contains(int64): expected an integer element
# array_get on a double array is an error (use array_get_double).
SELECT vsql_array.array_get(d, 1) FROM t WHERE id = 1;
ERROR HY000: VDF error in function 'array_get': array_get: element type is double; use array_get_double
# array_append: NULL array = empty array; NULL element = NULL result.
SELECT id, vsql_array.array_append(a, 42) AS a2,
vsql_array.array_append(d, '2.5') AS d2,
vsql_array.array_append(a, NULL) AS null_elem
FROM t WHERE id IN (2, 3, 5) ORDER BY id;
id	a2	d2	null_elem
2	[42]	[2.5]	NULL
3	[42]	[2.5]	NULL
5	[1,2,42]	[0.30000000000000004,2.5]	NULL
UPDATE t SET a = vsql_array.array_append(a, 3) WHERE id = 5;
SELECT id, a FROM t WHERE id = 5;
id	a
5	[1,2,3]
# Appending past max_size, or a value of the wrong type, is an error.
UPDATE t SET a = vsql_array.array_append(vsql_array.array_append(a, 4), 5) WHERE id = 1;
ERROR HY000: VDF error in function 'array_append': array_append: result would exceed max_size (4)
UPDATE t SET a = vsql_array.array_append(a, 'x') WHERE id = 2;
ERROR HY000: VDF error in function 'array_append': array_append(int64): expected an integer element
UPDATE t SET i32 = vsql_array.array_append(i32, 2147483648) WHERE id = 2;
ERROR HY000: VDF error in function 'array_append': array_append(int32): element out of range for int32
SELECT vsql_array.array_append(NULL, 1);
ERROR HY000: VDF error in function 'array_append': array_append: the first argument has no ARRAY type parameters; pass a typed ARRAY column or variable
SELECT id, a, i32 FROM t WHERE id IN (1, 2) ORDER BY id;
id	a	i32
1	[1,2,3]	[-2147483648,0,2147483647]
2	[]	[]
# A bare string has no ARRAY parameters, so a function cannot use it
# without a typed ARRAY value to take them from.
SELECT vsql_array.array_length('[1,2]');
ERROR HY000: Cannot initialize function 'array_length': cannot determine type parameters for vsql_array.ARRAY in argument 1
#
# Full-size values: 1024 int64 and 2048 int32 elements round-trip.
#
SET SESSION group_concat_max_len = 1000000;
SET SESSION cte_max_recursion_depth = 5000;
CREATE TABLE big (
id INT PRIMARY KEY,
a vsql_array.ARRAY(1024),
c vsql_array.ARRAY('type=int32,max_size=2048')
);
SET @s1024 = (WITH RECURSIVE n(i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM n WHERE i < 1024)
SELECT CONCAT('[', GROUP_CONCAT(i * 9000000000000 ORDER BY i), ']') FROM n);
SET @s2048 = (WITH RECURSIVE n(i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM n WHERE i < 2048)
SELECT CONCAT('[', GROUP_CONCAT(-i * 1000000 ORDER BY i), ']') FROM n);
INSERT INTO big VALUES (1, @s1024, @s2048);
SELECT vsql_array.array_length(a), vsql_array.array_get(a, 1024),
vsql_array.array_length(c), vsql_array.array_get(c, 2048)
FROM big;
vsql_array.array_length(a)	vsql_array.array_get(a, 1024)	vsql_array.array_length(c)	vsql_array.array_get(c, 2048)
1024	9216000000000000	2048	-2048000000
# The text read back equals the text written (compared in mysqltest,
# because SQL string functions are not allowed on ARRAY values).
# Round-trip of 1024 int64 and 2048 int32 elements: equal.
# One element more than max_size is rejected.
SET @s1025 = CONCAT(LEFT(@s1024, LENGTH(@s1024) - 1), ',1]');
INSERT INTO big (id, a) VALUES (2, @s1025);
ERROR HY000: Incorrect ARRAY value: '[9000000000000,18000000000000,27000000000000,36000000000000,45000000000000,54000000000000,63000000000000,72000000000000,81000000' for column 'a' at row 1
UPDATE big SET a = vsql_array.array_append(a, 1);
ERROR HY000: VDF error in function 'array_append': array_append: result would exceed max_size (1024)
DROP TABLE big;
# Clean up.
DROP TABLE t;
UNINSTALL EXTENSION vsql_array;
SELECT extension_name, extension_version FROM INFORMATION_SCHEMA.EXTENSIONS;
EXTENSION_NAME	EXTENSION_VERSION
