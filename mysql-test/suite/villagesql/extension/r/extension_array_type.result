ERROR HY000: Incorrect ARRAY value: '[1,,2]' for column 'a' at row 1
INSERT INTO t (id, a) VALUES (10, '[1,2,]');
ERROR HY000: Incorrect ARRAY value: '[1,2,]' for column 'a' at row 1
INSERT INTO t (id, a) VALUES (10, '1,2');
ERROR HY000: Incorrect ARRAY value: '1,2' for column 'a' at row 1
INSERT INTO t (id, a) VALUES (10, '[1,2');
ERROR HY000: Incorrect ARRAY value: '[1,2' for column 'a' at row 1
