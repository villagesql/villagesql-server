CREATE TABLE src (id INT, s VARCHAR(32));
INSERT INTO src VALUES (24, 'ENCODE_NULL'), (25, 'OK twentyfive');
INSERT INTO t1 SELECT id, s FROM src;
SELECT id, val, val IS NULL AS is_null FROM t1 WHERE id IN (24, 25) ORDER BY id;
id	val	is_null
24	NULL	1
25	OK twentyfive	0
UPDATE src SET s = 'ENCODE_ERROR' WHERE id = 24;
INSERT INTO t1 SELECT id + 100, s FROM src;
ERROR HY000: fault_blob: encode error sentinel
SELECT COUNT(*) AS rows_from_failed_select FROM t1 WHERE id > 100;
rows_from_failed_select
0
DROP TABLE src;
