SELECT id, val, val IS NULL AS is_null FROM t1 WHERE id = 20;
id	val	is_null
20	NULL	1
PREPARE ps FROM 'INSERT INTO t1 VALUES (?, ?)';
SET @id = 22, @v = 'ENCODE_NULL';
EXECUTE ps USING @id, @v;
SET @id = 23, @v = 'ENCODE_ERROR';
EXECUTE ps USING @id, @v;
