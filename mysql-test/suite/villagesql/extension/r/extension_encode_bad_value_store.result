INSTALL EXTENSION vsql_test_only;
call mtr.add_suppression("VillageSQL.*Invalid value in column.*FAULT_BLOB");
CREATE TABLE t1 (id INT PRIMARY KEY, val vsql_test_only.FAULT_BLOB);
INSERT INTO t1 VALUES (1, 'OK one');
UPDATE IGNORE t1 SET val = 'ENCODE_WARN' WHERE id = 1;
Warnings:
Warning	1366	Incorrect FAULT_BLOB value: 'ENCODE_WARN' for column 'val' at row 1
SHOW WARNINGS;
Level	Code	Message
Warning	1366	Incorrect FAULT_BLOB value: 'ENCODE_WARN' for column 'val' at row 1
SELECT id, val, val IS NULL AS is_null FROM t1 WHERE id = 1;
id	val	is_null
1	NULL	1
SET @v = 'ENCODE_WARN';
INSERT IGNORE INTO t1 VALUES (2, @v);
Warnings:
Warning	1366	Incorrect FAULT_BLOB value: 'ENCODE_WARN' for column 'val' at row 1
SHOW WARNINGS;
Level	Code	Message
Warning	1366	Incorrect FAULT_BLOB value: 'ENCODE_WARN' for column 'val' at row 1
SELECT id, val, val IS NULL AS is_null FROM t1 WHERE id = 2;
id	val	is_null
2	NULL	1
PREPARE ps FROM 'INSERT IGNORE INTO t1 VALUES (?, ?)';
SET @id = 3, @v = 'ENCODE_WARN';
EXECUTE ps USING @id, @v;
Warnings:
Warning	1366	Incorrect FAULT_BLOB value: 'ENCODE_WARN' for column 'val' at row 1
SHOW WARNINGS;
Level	Code	Message
Warning	1366	Incorrect FAULT_BLOB value: 'ENCODE_WARN' for column 'val' at row 1
DEALLOCATE PREPARE ps;
SELECT id, val, val IS NULL AS is_null FROM t1 WHERE id = 3;
id	val	is_null
3	NULL	1
CREATE TABLE src (id INT, s VARCHAR(32));
INSERT INTO src VALUES (4, 'ENCODE_WARN'), (5, 'OK five');
INSERT IGNORE INTO t1 SELECT id, s FROM src;
Warnings:
Warning	1366	Incorrect FAULT_BLOB value: 'ENCODE_WARN' for column 'val' at row 1
SHOW WARNINGS;
Level	Code	Message
Warning	1366	Incorrect FAULT_BLOB value: 'ENCODE_WARN' for column 'val' at row 1
SELECT id, val, val IS NULL AS is_null FROM t1 WHERE id IN (4, 5) ORDER BY id;
id	val	is_null
4	NULL	1
5	OK five	0
DROP TABLE src;
CREATE TABLE t2 (id INT PRIMARY KEY, val vsql_test_only.FAULT_BLOB NOT NULL);
INSERT IGNORE INTO t2 VALUES (1, 'ENCODE_WARN');
Warnings:
Warning	1366	Incorrect FAULT_BLOB value: 'ENCODE_WARN' for column 'val' at row 1
SHOW WARNINGS;
Level	Code	Message
Warning	1366	Incorrect FAULT_BLOB value: 'ENCODE_WARN' for column 'val' at row 1
SELECT id, val FROM t2 WHERE id = 1;
id	val
1	OK default
SELECT COUNT(*) AS readable_rows FROM t1;
readable_rows
5
DROP TABLE t1;
DROP TABLE t2;
UNINSTALL EXTENSION vsql_test_only;
