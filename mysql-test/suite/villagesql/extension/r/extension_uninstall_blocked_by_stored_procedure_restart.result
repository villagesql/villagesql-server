# restart: --veb-dir=MYSQLTEST_VARDIR/veb
# Create a stored procedure with a COMPLEX IN parameter
CREATE PROCEDURE p1(IN val COMPLEX)
BEGIN
SELECT val;
END//
# Restart the server — sp_params are reloaded from the system table
# restart: --veb-dir=MYSQLTEST_VARDIR/veb
# Try to uninstall the extension - should still fail after restart
UNINSTALL EXTENSION vsql_complex;
ERROR HY000: Cannot uninstall extension 'vsql_complex': stored procedure test.p1 uses custom type COMPLEX
# Verify the extension is still installed
SELECT * FROM INFORMATION_SCHEMA.EXTENSIONS WHERE EXTENSION_NAME = 'vsql_complex';
EXTENSION_NAME	EXTENSION_VERSION
vsql_complex	0.0.1
# Drop the stored procedure
DROP PROCEDURE p1;
# Now uninstall should succeed
UNINSTALL EXTENSION vsql_complex;
# Verify the extension was removed
SELECT * FROM INFORMATION_SCHEMA.EXTENSIONS WHERE EXTENSION_NAME = 'vsql_complex';
EXTENSION_NAME	EXTENSION_VERSION
