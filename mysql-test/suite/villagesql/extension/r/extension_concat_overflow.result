# Install vsql_simple extension
INSTALL EXTENSION vsql_simple;
# Install vsql_complex extension
INSTALL EXTENSION vsql_complex;
# Verify extensions installed
SELECT extension_name, extension_version FROM INFORMATION_SCHEMA.EXTENSIONS;
EXTENSION_NAME	EXTENSION_VERSION
vsql_complex	0.0.1
vsql_simple	0.0.1
# create table with complex column
CREATE TABLE t (id INT, c COMPLEX);
INSERT INTO t VALUES (1, '(5,6)');
# 1 COMPLEX
SELECT ba_concat_all(c) FROM t INTO @var;
SELECT LENGTH(@var);
LENGTH(@var)
16
SELECT HEX(@var);
HEX(@var)
00000000000014400000000000001840
# 63 COMPLEX, just under 1024 buffer size
