INSTALL EXTENSION vsql_simple;
INSTALL EXTENSION vsql_complex;
# create table with complex column
CREATE TABLE t (id INT, c COMPLEX);
INSERT INTO t VALUES (1, '(5,6)');
# 1 COMPLEX
SELECT ba_concat_all(c) FROM t INTO @var;
SELECT LENGTH(@var);
LENGTH(@var)
16
SELECT HEX(@var);
HEX(@var)
00000000000014400000000000001840
# 63 COMPLEX, just under 1024 buffer size
SELECT ba_concat_all(
c, c, c, c, c, c, c, c, c, c,
c, c, c, c, c, c, c, c, c, c,
c, c, c, c, c, c, c, c, c, c,
c, c, c, c, c, c, c, c, c, c,
c, c, c, c, c, c, c, c, c, c,
c, c, c, c, c, c, c, c, c, c,
c, c, c) FROM t INTO @var;
SELECT LENGTH(@var);
LENGTH(@var)
1008
SELECT @var = REPEAT(UNHEX('00000000000014400000000000001840'), 63);
@var = REPEAT(UNHEX('00000000000014400000000000001840'), 63)
1
# 64 COMPLEX, equal to 1024 buffer size
SELECT ba_concat_all(
c, c, c, c, c, c, c, c, c, c,
c, c, c, c, c, c, c, c, c, c,
c, c, c, c, c, c, c, c, c, c,
c, c, c, c, c, c, c, c, c, c,
c, c, c, c, c, c, c, c, c, c,
c, c, c, c, c, c, c, c, c, c,
c, c, c, c) FROM t INTO @var;
SELECT LENGTH(@var);
LENGTH(@var)
1024
SELECT @var = REPEAT(UNHEX('00000000000014400000000000001840'), 64);
@var = REPEAT(UNHEX('00000000000014400000000000001840'), 64)
1
# 65 COMPLEX, just over 1024 buffer size
