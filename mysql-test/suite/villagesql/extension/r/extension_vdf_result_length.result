call mtr.add_suppression("Orphaned expansion directory found but not removed");
# restart: --veb-dir=MYSQLTEST_VARDIR/veb
Creating extension rlen_ext using SDK...
Created rlen_ext.veb
INSTALL EXTENSION rlen_ext;
CREATE TABLE b AS SELECT rlen_ext.bounded_str(1000) AS s;
SELECT LENGTH(s) AS stored_len FROM b;
stored_len
1000
SHOW CREATE TABLE b;
Table	Create Table
b	CREATE TABLE `b` (
  `s` text CHARACTER SET utf8mb4 COLLATE utf8mb4_bin
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
DROP TABLE b;
SELECT LENGTH(rlen_ext.unbounded_str(2000)) AS streamed_len;
streamed_len
2000
CREATE TABLE u AS SELECT rlen_ext.unbounded_str(1) AS s;
SHOW CREATE TABLE u;
Table	Create Table
u	CREATE TABLE `u` (
  `s` varchar(2) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin DEFAULT NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
DROP TABLE u;
SET @saved_sql_mode = @@sql_mode;
SET @@sql_mode = '';
CREATE TABLE trunc_t AS SELECT rlen_ext.unbounded_str(100) AS s;
SELECT LENGTH(s) < 100 AS was_truncated FROM trunc_t;
was_truncated
1
DROP TABLE trunc_t;
SET @@sql_mode = @saved_sql_mode;
CREATE TABLE rlen_src (grp INT, s VARCHAR(50));
INSERT INTO rlen_src VALUES (1, REPEAT('a', 40)), (1, REPEAT('b', 40)), (2, 'x');
CREATE TABLE rlen_agg AS
SELECT grp, rlen_ext.bounded_concat(s) AS c FROM rlen_src GROUP BY grp;
SELECT grp, LENGTH(c) AS c_len FROM rlen_agg ORDER BY grp;
grp	c_len
1	81
2	1
SHOW CREATE TABLE rlen_agg;
Table	Create Table
rlen_agg	CREATE TABLE `rlen_agg` (
  `grp` int DEFAULT NULL,
  `c` text CHARACTER SET utf8mb4 COLLATE utf8mb4_bin
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
DROP TABLE rlen_agg, rlen_src;
CREATE TABLE cap_t AS SELECT rlen_ext.huge_str(5) AS s;
SELECT LENGTH(s) AS cap_len FROM cap_t;
cap_len
5
SHOW CREATE TABLE cap_t;
Table	Create Table
cap_t	CREATE TABLE `cap_t` (
  `s` longtext CHARACTER SET utf8mb4 COLLATE utf8mb4_bin
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
DROP TABLE cap_t;
CREATE TABLE va AS SELECT rlen_ext.varargs_str_join('abc','def') AS s;
SHOW CREATE TABLE va;
Table	Create Table
va	CREATE TABLE `va` (
  `s` varchar(200) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin DEFAULT NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
DROP TABLE va;
UNINSTALL EXTENSION rlen_ext;
