INSTALL EXTENSION agg_vdf_ext;
CREATE TABLE t1 (
id INT PRIMARY KEY,
val INT,
category VARCHAR(20)
);
INSERT INTO t1 VALUES
(1, 10, 'A'),
(2, 20, 'A'),
(3, 30, 'B'),
(4, 40, 'B'),
(5, 50, 'B');
SELECT category, agg_vdf_ext.vdf_sum(val) AS total
FROM t1
GROUP BY category
ORDER BY category;
category	total
A	30
B	120
SELECT agg_vdf_ext.vdf_sum(val) AS total FROM t1;
total
150
CREATE TABLE t_empty (id INT PRIMARY KEY, val INT);
SELECT agg_vdf_ext.vdf_sum(val) AS total FROM t_empty;
total
NULL
DROP TABLE t_empty;
SELECT category,
agg_vdf_ext.vdf_sum(val) AS total,
agg_vdf_ext.vdf_count(val) AS cnt
FROM t1
GROUP BY category
ORDER BY category;
category	total	cnt
A	30	2
B	120	3
SELECT category,
agg_vdf_ext.vdf_sum(val) AS total,
agg_vdf_ext.simple_double(MIN(val)) AS doubled_min
FROM t1
GROUP BY category
ORDER BY category;
category	total	doubled_min
A	30	20
B	120	60
SELECT category, agg_vdf_ext.vdf_sum(val) AS total
FROM t1
GROUP BY category
HAVING agg_vdf_ext.vdf_sum(val) > 50
ORDER BY category;
category	total
B	120
SELECT category, agg_vdf_ext.vdf_sum(val) AS total
FROM t1
GROUP BY category
ORDER BY agg_vdf_ext.vdf_sum(val) DESC;
category	total
B	120
A	30
CREATE TABLE t_nulls (
id INT PRIMARY KEY,
val INT,
category VARCHAR(20)
);
INSERT INTO t_nulls VALUES
(1, 10, 'A'),
(2, NULL, 'A'),
(3, 30, 'A'),
(4, NULL, 'B'),
(5, NULL, 'B');
SELECT category,
agg_vdf_ext.vdf_sum(val) AS total,
agg_vdf_ext.vdf_count(val) AS cnt
FROM t_nulls
GROUP BY category
ORDER BY category;
category	total	cnt
A	40	2
B	NULL	0
SELECT category, agg_vdf_ext.vdf_sum(val) AS total
FROM t_nulls
WHERE category = 'B'
GROUP BY category;
category	total
B	NULL
DROP TABLE t_nulls;
SELECT * FROM t1
WHERE val > (SELECT agg_vdf_ext.vdf_sum(val) / 5 FROM t1)
