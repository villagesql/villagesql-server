Creating extension state_and_varargs using SDK...
Created state_and_varargs.veb
INSTALL EXTENSION state_and_varargs;
INSTALL EXTENSION vsql_simple;
CREATE TABLE test_bytearray (
id INT PRIMARY KEY,
data BYTEARRAY
);
INSERT INTO test_bytearray VALUES (1, 'hello');
INSERT INTO test_bytearray VALUES (2, 'world123');
INSERT INTO test_bytearray VALUES (3, 'abcdefgh');
# counter_add: state-style VDF with an SQL parameter
# (exercises WrapperTypedState forwarding SQL args alongside State&)
SELECT state_and_varargs.counter_add(10) AS sum
FROM test_bytearray ORDER BY id;
sum
10
20
30
# Coexistence: state-style and varargs VDFs from two different
# extensions in one statement. ba_call_index has its own counter,
# counter_add has its own counter, ba_concat_all is varargs/stateless.
SELECT vsql_simple.ba_call_index() AS idx,
state_and_varargs.counter_add(100) AS running,
vsql_simple.ba_concat_all(t.data, t.data) AS twice
FROM test_bytearray t ORDER BY t.id;
idx	running	twice
1	100	hello   hello   
2	200	world123world123
3	300	abcdefghabcdefgh
# varargs_indexed: varargs VDF reading per-statement state from typed
# prerun via VarArgs::state<T>(). Combines #551 (set_user_data) with
# #563 (varargs). Output is "N:" prefix plus concatenation of bytes.
SELECT state_and_varargs.varargs_indexed(t1.data, t2.data) AS indexed
FROM test_bytearray t1, test_bytearray t2
WHERE t1.id = 1 AND t2.id IN (2, 3)
ORDER BY t2.id;
indexed
1:hello   world123
2:hello   abcdefgh
# prerun_const: prerun sees each constant argument's value as the VDF
# will receive it. A NULL literal is a STRING NULL; a column and a
# subquery are not constants, a ? parameter is. A subquery without
# tables, such as (SELECT 1), is folded into its value first.
SELECT state_and_varargs.prerun_const(42) AS int_lit,
state_and_varargs.prerun_const(1 + 2) AS int_expr,
state_and_varargs.prerun_const(1.5e0) AS real_lit,
state_and_varargs.prerun_const('abc') AS str_lit,
state_and_varargs.prerun_const(NULL) AS null_lit,
state_and_varargs.prerun_const(CAST(NULL AS SIGNED)) AS null_int;
int_lit	int_expr	real_lit	str_lit	null_lit	null_int
const INT 42	const INT 3	const REAL 1.5	const STRING 'abc'	const STRING NULL	const INT NULL
SELECT state_and_varargs.prerun_const(id) AS col,
state_and_varargs.prerun_const((SELECT 1)) AS folded,
state_and_varargs.prerun_const((SELECT MAX(id) FROM test_bytearray))
AS subquery
FROM test_bytearray WHERE id = 1;
col	folded	subquery
not const	const INT 1	not const
SET @v = 7;
SELECT state_and_varargs.prerun_const(@v) AS user_var;
user_var
const INT 7
PREPARE s_const FROM 'SELECT state_and_varargs.prerun_const(?) AS param';
SET @n = NULL;
EXECUTE s_const USING @n;
param
const STRING NULL
DEALLOCATE PREPARE s_const;
SELECT state_and_varargs.prerun_const(_binary x'FF') AS bad_utf8
FROM test_bytearray WHERE id = 0;
ERROR HY000: Cannot convert string '\xFF' from binary to utf8mb4
SELECT state_and_varargs.prerun_const(CAST('1x' AS SIGNED)) AS truncated;
truncated
const INT 1
Warnings:
Warning	1292	Truncated incorrect INTEGER value: '1x'
Warning	1292	Truncated incorrect INTEGER value: '1x'
SELECT id, state_and_varargs.prerun_const(CAST('1x' AS SIGNED)) AS truncated
FROM test_bytearray ORDER BY id;
id	truncated
1	const INT 1
2	const INT 1
3	const INT 1
Warnings:
Warning	1292	Truncated incorrect INTEGER value: '1x'
Warning	1292	Truncated incorrect INTEGER value: '1x'
Warning	1292	Truncated incorrect INTEGER value: '1x'
Warning	1292	Truncated incorrect INTEGER value: '1x'
SET @v = NULL;
PREPARE s_var FROM
'SELECT state_and_varargs.prerun_const(@v) AS prerun_saw, @v AS row_value';
SET @v = 7;
EXECUTE s_var;
prerun_saw	row_value
const INT 7	7
SET @v = 8;
EXECUTE s_var;
prerun_saw	row_value
const INT 8	8
DEALLOCATE PREPARE s_var;
DROP TABLE test_bytearray;
UNINSTALL EXTENSION vsql_simple;
UNINSTALL EXTENSION state_and_varargs;
