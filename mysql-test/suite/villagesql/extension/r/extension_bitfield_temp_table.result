INSTALL EXTENSION vsql_bitfield_test;
# max_number_of_bits=8
CREATE TABLE t1 (id INT,
b vsql_bitfield_test.BITFIELD('max_number_of_bits=8'));
INSERT INTO t1 VALUES (1, '101'), (2, '11'), (3, '101');
CREATE TABLE t2 LIKE t1;
INSERT INTO t2 SELECT * FROM t1;
# The query from the issue.
SELECT id, b FROM t1 UNION ALL SELECT id, b FROM t2 ORDER BY id;
id	b
1	101
1	101
2	11
2	11
3	101
3	101
SELECT b FROM t1 UNION SELECT b FROM t2 ORDER BY b;
b
101
11
SELECT id, b FROM (SELECT id, b FROM t1 UNION ALL SELECT id, b FROM t2) d
ORDER BY id;
id	b
1	101
1	101
2	11
2	11
3	101
3	101
SELECT DISTINCT b FROM t1 ORDER BY b;
b
101
11
SELECT b, COUNT(*) FROM t1 GROUP BY b ORDER BY b;
b	COUNT(*)
101	2
11	1
SELECT id FROM t1 WHERE b IN (SELECT b FROM t2) ORDER BY id;
id
1
2
3
WITH RECURSIVE c AS (SELECT b, 1 AS n FROM t1 WHERE id = 1
UNION ALL SELECT b, n + 1 FROM c WHERE n < 3)
SELECT b, n FROM c ORDER BY n;
b	n
101	1
101	2
101	3
SELECT id, b, ROW_NUMBER() OVER (PARTITION BY b ORDER BY id) AS rn
FROM t1 ORDER BY id;
id	b	rn
1	101	1
2	11	1
3	101	2
# CREATE TABLE ... SELECT keeps the custom type.
CREATE TABLE t3 AS SELECT id, b FROM t1 UNION ALL SELECT id, b FROM t2;
SELECT id, b FROM t3 ORDER BY id, b;
id	b
1	101
1	101
2	11
2	11
3	101
3	101
SELECT COLUMN_TYPE, CHARACTER_OCTET_LENGTH FROM information_schema.columns
WHERE table_schema = 'test' AND table_name = 't3' AND column_name = 'b';
COLUMN_TYPE	CHARACTER_OCTET_LENGTH
vsql_bitfield_test.BITFIELD	514
DROP TABLE t3;
DROP TABLE t2;
DROP TABLE t1;
# max_number_of_bits=4096
CREATE TABLE t1 (id INT,
b vsql_bitfield_test.BITFIELD('max_number_of_bits=4096'));
INSERT INTO t1 VALUES (1, '101'), (2, '11'), (3, '101');
CREATE TABLE t2 LIKE t1;
INSERT INTO t2 SELECT * FROM t1;
# The query from the issue.
SELECT id, b FROM t1 UNION ALL SELECT id, b FROM t2 ORDER BY id;
id	b
1	101
1	101
2	11
2	11
3	101
3	101
SELECT b FROM t1 UNION SELECT b FROM t2 ORDER BY b;
b
101
11
SELECT id, b FROM (SELECT id, b FROM t1 UNION ALL SELECT id, b FROM t2) d
ORDER BY id;
id	b
1	101
1	101
2	11
2	11
3	101
3	101
SELECT DISTINCT b FROM t1 ORDER BY b;
b
101
11
SELECT b, COUNT(*) FROM t1 GROUP BY b ORDER BY b;
b	COUNT(*)
101	2
11	1
SELECT id FROM t1 WHERE b IN (SELECT b FROM t2) ORDER BY id;
id
1
2
3
WITH RECURSIVE c AS (SELECT b, 1 AS n FROM t1 WHERE id = 1
UNION ALL SELECT b, n + 1 FROM c WHERE n < 3)
SELECT b, n FROM c ORDER BY n;
b	n
101	1
101	2
101	3
SELECT id, b, ROW_NUMBER() OVER (PARTITION BY b ORDER BY id) AS rn
FROM t1 ORDER BY id;
id	b	rn
1	101	1
2	11	1
3	101	2
# CREATE TABLE ... SELECT keeps the custom type.
CREATE TABLE t3 AS SELECT id, b FROM t1 UNION ALL SELECT id, b FROM t2;
SELECT id, b FROM t3 ORDER BY id, b;
id	b
1	101
1	101
2	11
2	11
3	101
3	101
SELECT COLUMN_TYPE, CHARACTER_OCTET_LENGTH FROM information_schema.columns
WHERE table_schema = 'test' AND table_name = 't3' AND column_name = 'b';
COLUMN_TYPE	CHARACTER_OCTET_LENGTH
vsql_bitfield_test.BITFIELD	514
DROP TABLE t3;
DROP TABLE t2;
DROP TABLE t1;
UNINSTALL EXTENSION vsql_bitfield_test;
