call mtr.add_suppression("VEF auth: role .* is not granted; skipping");
INSTALL EXTENSION vsql_auth_test;
CREATE USER auth_user IDENTIFIED WITH vsql_auth_test;
CREATE USER vsql_auth_test_user;
GRANT SELECT ON *.* TO vsql_auth_test_user;
GRANT PROXY ON vsql_auth_test_user TO auth_user;
CREATE ROLE vsql_role_granted;
CREATE ROLE vsql_role_denied;
CREATE ROLE vsql_role_extra;
# Account holds vsql_role_extra out of band -- the token never stages it.
GRANT vsql_role_extra TO vsql_auth_test_user;
SELECT FROM_USER, TO_USER FROM mysql.role_edges WHERE TO_USER = 'vsql_auth_test_user';
FROM_USER	TO_USER
vsql_role_extra	vsql_auth_test_user
# SYNC: staged {granted, denied} are granted; unclaimed vsql_role_extra is
# revoked. Granted set becomes exactly {granted, denied}.
SET GLOBAL vsql_auth_test.auto_grant = SYNC;
SELECT FROM_USER, TO_USER FROM mysql.role_edges WHERE TO_USER = 'vsql_auth_test_user';
FROM_USER	TO_USER
vsql_role_denied	vsql_auth_test_user
vsql_role_granted	vsql_auth_test_user
# Operator pins vsql_role_extra as a DEFAULT role (re-granting it first).
# A default is deliberate operator intent, so SYNC must NOT revoke it even
# though the token never claims it.
GRANT vsql_role_extra TO vsql_auth_test_user;
ALTER USER vsql_auth_test_user DEFAULT ROLE vsql_role_extra;
# granted + denied present, and the pinned vsql_role_extra survives.
SELECT FROM_USER, TO_USER FROM mysql.role_edges WHERE TO_USER = 'vsql_auth_test_user';
FROM_USER	TO_USER
vsql_role_denied	vsql_auth_test_user
vsql_role_extra	vsql_auth_test_user
vsql_role_granted	vsql_auth_test_user
SET GLOBAL vsql_auth_test.auto_grant = OFF;
ALTER USER vsql_auth_test_user DEFAULT ROLE NONE;
DROP USER auth_user;
DROP USER vsql_auth_test_user;
DROP ROLE vsql_role_granted;
DROP ROLE vsql_role_denied;
DROP ROLE vsql_role_extra;
UNINSTALL EXTENSION vsql_auth_test;
