#
# Driver test: ALTER TABLE ADD INDEX on a table that already has
# rows colliding under lower() must fail during backfill, and the
# base table must be left in its original shape (no index added,
# no rows lost).
#
INSTALL EXTENSION VSQL_UNIQ_LOWER_TEST;
CREATE TABLE users (
id INT PRIMARY KEY,
email CHAR(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL
);
INSERT INTO users VALUES (1, 'alice@example.com');
INSERT INTO users VALUES (2, 'Alice@Example.com');
SELECT id, email FROM users ORDER BY id;
id	email
1	alice@example.com
2	Alice@Example.com
ALTER TABLE users ADD INDEX idx_lower_email (email)
USING EXTENDED(uniq_lower);
ERROR HY000: Got error 122 - 'Internal (unspecified) error in handler' from storage engine
# Base table unchanged.
SELECT id, email FROM users ORDER BY id;
id	email
1	alice@example.com
2	Alice@Example.com
SHOW CREATE TABLE users;
Table	Create Table
users	CREATE TABLE `users` (
  `id` int NOT NULL,
  `email` char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
DROP TABLE users;
UNINSTALL EXTENSION VSQL_UNIQ_LOWER_TEST;
