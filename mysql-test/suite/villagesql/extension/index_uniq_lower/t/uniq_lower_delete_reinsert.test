--echo #
--echo # Driver test: deleting a row should free its lowercased value for
--echo # reinsertion (in a separate statement).
--echo #

--disable_query_log
CALL mtr.add_suppression("Custom index '.*' maintenance failed: hidden table insert failed");
--enable_query_log

INSTALL EXTENSION VSQL_UNIQ_LOWER_TEST;

CREATE TABLE users (
  id INT PRIMARY KEY,
  email CHAR(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,
  INDEX idx_lower_email (email) USING EXTENDED(uniq_lower)
);

INSERT INTO users VALUES (1, 'alice@example.com');
DELETE FROM users WHERE id = 1;

--echo # Same lowered value is now free.
INSERT INTO users VALUES (2, 'ALICE@example.com');
SELECT id, email FROM users ORDER BY id;

--echo # And still rejects further duplicates.
--error ER_GET_ERRNO
INSERT INTO users VALUES (3, 'alice@EXAMPLE.com');
SELECT id, email FROM users ORDER BY id;

DROP TABLE users;
UNINSTALL EXTENSION VSQL_UNIQ_LOWER_TEST;
