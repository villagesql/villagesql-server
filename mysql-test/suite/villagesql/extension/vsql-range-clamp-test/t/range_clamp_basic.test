# Test on_change callbacks.
#
# min_setting and max_setting share one on_change handler that uses
# var_name() to identify which variable changed and as_int() for the value.
#
# label has its own on_change handler that uses as_str() for the value.
# Both demonstrate the SysVarChange typed API.
#
# Verifies:
# - Default values (min=0, max=100, label="")
# - Setting min above max raises max to match
# - Setting max below min lowers min to match
# - Independent changes within the current range leave the other unchanged
# - Setting both to the same value is allowed
# - Typed on_change callback fires with the new string value

INSTALL EXTENSION vsql_range_clamp_test;

--echo # Verify defaults
SELECT @@global.vsql_range_clamp_test.min_setting;
SELECT @@global.vsql_range_clamp_test.max_setting;
SELECT @@global.vsql_range_clamp_test.label;

--echo # Setting min above max raises max to match
SET GLOBAL vsql_range_clamp_test.min_setting = 200;
SELECT @@global.vsql_range_clamp_test.min_setting;
SELECT @@global.vsql_range_clamp_test.max_setting;

--echo # Setting max below min lowers min to match
SET GLOBAL vsql_range_clamp_test.max_setting = 50;
SELECT @@global.vsql_range_clamp_test.min_setting;
SELECT @@global.vsql_range_clamp_test.max_setting;

--echo # Independent change within range leaves other unchanged
SET GLOBAL vsql_range_clamp_test.min_setting = 10;
SELECT @@global.vsql_range_clamp_test.min_setting;
SELECT @@global.vsql_range_clamp_test.max_setting;

SET GLOBAL vsql_range_clamp_test.max_setting = 80;
SELECT @@global.vsql_range_clamp_test.min_setting;
SELECT @@global.vsql_range_clamp_test.max_setting;

--echo # Setting both to same value is allowed
SET GLOBAL vsql_range_clamp_test.min_setting = 42;
SET GLOBAL vsql_range_clamp_test.max_setting = 42;
SELECT @@global.vsql_range_clamp_test.min_setting;
SELECT @@global.vsql_range_clamp_test.max_setting;

--echo # Typed on_change callback fires with the new string value
SET GLOBAL vsql_range_clamp_test.label = 'hello';
SELECT vsql_range_clamp_test.last_label();
SET GLOBAL vsql_range_clamp_test.label = 'world';
SELECT vsql_range_clamp_test.last_label();

UNINSTALL EXTENSION vsql_range_clamp_test;
