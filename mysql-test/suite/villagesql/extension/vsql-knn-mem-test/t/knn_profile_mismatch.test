# Debug-build only: the custom-index execution path is gated behind the
# villagesql_custom_index_proceed debug flag.
--source include/have_debug.inc
SET SESSION debug='+d,villagesql_custom_index_proceed';

--echo #
--echo # The optimizer must tie an ORDER BY distance function to the index type
--echo # its profile actually binds. The extension registers two index types:
--echo #   kvec_knn      profile binds kvec_l2_distance
--echo #   kvec_knn_cos  profile binds kvec_cos_distance
--echo # A table with only a kvec_knn (L2) index must drive a custom distance
--echo # scan for an L2 ORDER BY, but must NOT be used for a cosine ORDER BY
--echo # (which belongs to kvec_knn_cos). Otherwise a cosine query would be
--echo # answered in L2 order — silently wrong.
--echo #

--source include/have_hypergraph.inc

INSTALL EXTENSION vsql_knn_mem_test;

# Distinct table/index names from knn_orderby.test: the runtime's loaded-index
# cache is keyed by db.table.index and has no drop-time eviction yet, so reusing
# a name across tests in the same server would return a stale, doubled index.
# See "g_loaded_indexes is temporary" in Docs/CUSTOM_INDEX_OPTIMIZER_SPLIT.md.
CREATE TABLE tvm (
  id INT PRIMARY KEY,
  v KVECTOR
);

# Only an L2 index exists on this table.
CREATE INDEX idx_vm ON tvm (v)
  USING EXTENDED(vsql_knn_mem_test.kvec_knn);

INSERT INTO tvm VALUES
  (1, '[1,0,0,0]'),
  (2, '[0,1,0,0]'),
  (3, '[0,0,1,0]'),
  (4, '[1,1,0,0]'),
  (5, '[2,0,0,0]');

--echo #
--echo # Matching case: L2 ORDER BY against the L2 index -> custom scan chosen.
--echo #
--replace_regex /cost=[0-9.e+-]+/cost=COST/ /rows=[0-9.e+-]+/rows=ROWS/
EXPLAIN FORMAT=tree
SELECT id
FROM tvm
ORDER BY vsql_knn_mem_test.kvec_l2_distance(v, KVECTOR::from_string('[1,0,0,0]'))
LIMIT 3;

SELECT vsql_knn_mem_test.kvec_scan_begin_count() AS l2_begins_before;

SELECT id
FROM tvm
ORDER BY vsql_knn_mem_test.kvec_l2_distance(v, KVECTOR::from_string('[1,0,0,0]'))
LIMIT 3;

--echo # Scan fired for the matching L2 query.
SELECT vsql_knn_mem_test.kvec_scan_begin_count() AS l2_begins_after;

--echo #
--echo # Mismatched case: cosine ORDER BY against a table that has only an L2
--echo # index. kvec_cos_distance is a recognized distance function (bound in
--echo # the kvec_knn_cos profile), but no kvec_knn_cos index exists here, so
--echo # the optimizer must NOT take a custom scan -- EXPLAIN shows a sort, not
--echo # a "Custom index distance scan".
--echo #
--replace_regex /cost=[0-9.e+-]+/cost=COST/ /rows=[0-9.e+-]+/rows=ROWS/
EXPLAIN FORMAT=tree
SELECT id
FROM tvm
ORDER BY vsql_knn_mem_test.kvec_cos_distance(v, KVECTOR::from_string('[1,0,0,0]'))
LIMIT 3;

SELECT vsql_knn_mem_test.kvec_scan_begin_count() AS cos_begins_before;

--echo #
--echo # Results are still correct (cosine order, computed by filesort). Nearest
--echo # by cosine to [1,0,0,0]: id=1 and id=5 are colinear (cos dist 0), then
--echo # id=4 (45 degrees).
--echo #
SELECT id
FROM tvm
ORDER BY vsql_knn_mem_test.kvec_cos_distance(v, KVECTOR::from_string('[1,0,0,0]')),
         id
LIMIT 3;

--echo #
--echo # The custom scan did NOT fire for the mismatched cosine query: the
--echo # begin count is unchanged from before the query.
--echo #
SELECT vsql_knn_mem_test.kvec_scan_begin_count() AS cos_begins_after;

DROP TABLE tvm;
UNINSTALL EXTENSION vsql_knn_mem_test;

SET SESSION debug='-d,villagesql_custom_index_proceed';
