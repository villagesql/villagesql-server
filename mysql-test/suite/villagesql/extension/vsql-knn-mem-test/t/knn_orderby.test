# Debug-build only: the custom-index execution path is gated behind the
# villagesql_custom_index_proceed debug flag (the parse-time "Extended Index
# feature not yet implemented" guard in PT_custom_index_type).
--source include/have_debug.inc
SET SESSION debug='+d,villagesql_custom_index_proceed';

--echo #
--echo # Functional in-memory KNN custom index: optimizer distance scan.
--echo #
--echo # Populate the index via INSERT (ha_write_row hook), then confirm the
--echo # hypergraph optimizer takes a custom INDEX_DISTANCE_SCAN for an
--echo # ORDER BY <distance-fn> LIMIT k query and returns rows in KNN order.
--echo #

--source include/have_hypergraph.inc

INSTALL EXTENSION vsql_knn_mem_test;

# Custom index is created on an EMPTY table, then populated by INSERT. The
# ALTER rebuild shadow is not maintained yet, so CREATE INDEX on an already
# populated table would not index the existing rows.
CREATE TABLE t (
  id INT PRIMARY KEY,
  v KVECTOR
);

CREATE INDEX idx_v ON t (v)
  USING EXTENDED(vsql_knn_mem_test.kvec_knn);

INSERT INTO t VALUES
  (1, '[1,0,0,0]'),
  (2, '[0,1,0,0]'),
  (3, '[0,0,1,0]'),
  (4, '[1,1,0,0]'),
  (5, '[2,0,0,0]');

--echo #
--echo # EXPLAIN shows the custom distance scan for the KNN query (proves the
--echo # optimizer chose the custom index, not a filesort).
--echo #
--replace_regex /cost=[0-9.e+-]+/cost=COST/ /rows=[0-9.e+-]+/rows=ROWS/
EXPLAIN FORMAT=tree
SELECT id
FROM t
ORDER BY vsql_knn_mem_test.kvec_l2_distance(v, KVECTOR::from_string('[1,0,0,0]'))
LIMIT 3;

--echo #
--echo # Scan callbacks have not fired yet (EXPLAIN does not execute the scan).
--echo #
SELECT vsql_knn_mem_test.kvec_scan_begin_count() AS scan_begins_before;
SELECT vsql_knn_mem_test.kvec_scan_fetch_count() AS scan_fetches_before;

--echo #
--echo # The 3 nearest neighbours of [1,0,0,0] by L2 distance are, in order:
--echo #   id=1 [1,0,0,0] (dist 0), id=4 [1,1,0,0] (dist 1), id=5 [2,0,0,0]
--echo #   (dist 1) — ids 2 and 3 are farther (dist sqrt(2)).
--echo #
SELECT id
FROM t
ORDER BY vsql_knn_mem_test.kvec_l2_distance(v, KVECTOR::from_string('[1,0,0,0]'))
LIMIT 3;

--echo #
--echo # The scan callbacks fired: begin once, fetch once per returned row.
--echo # This proves the custom index scan executed (a filesort fallback would
--echo # leave both counts at 0).
--echo #
SELECT vsql_knn_mem_test.kvec_scan_begin_count() AS scan_begins_after;
SELECT vsql_knn_mem_test.kvec_scan_fetch_count() AS scan_fetches_after;

DROP TABLE t;
UNINSTALL EXTENSION vsql_knn_mem_test;

SET SESSION debug='-d,villagesql_custom_index_proceed';
