SET SESSION debug='+d,villagesql_custom_index_proceed';
#
# Functional in-memory KNN custom index: optimizer distance scan.
#
# Populate the index via INSERT (ha_write_row hook), then confirm the
# hypergraph optimizer takes a custom INDEX_DISTANCE_SCAN for an
# ORDER BY <distance-fn> LIMIT k query and returns rows in KNN order.
#
INSTALL EXTENSION vsql_knn_mem_test;
CREATE TABLE t (
id INT PRIMARY KEY,
v KVECTOR
);
CREATE INDEX idx_v ON t (v)
USING EXTENDED(vsql_knn_mem_test.kvec_knn);
INSERT INTO t VALUES
(1, '[1,0,0,0]'),
(2, '[0,1,0,0]'),
(3, '[0,0,1,0]'),
(4, '[1,1,0,0]'),
(5, '[2,0,0,0]');
#
# EXPLAIN shows the custom distance scan for the KNN query (proves the
# optimizer chose the custom index, not a filesort).
#
EXPLAIN FORMAT=tree
SELECT id
FROM t
ORDER BY vsql_knn_mem_test.kvec_l2_distance(v, KVECTOR::from_string('[1,0,0,0]'))
LIMIT 3;
EXPLAIN
-> Limit: 3 row(s)  (cost=COST rows=ROWS)
    -> Custom index distance scan on idx_v  (cost=COST rows=ROWS)

#
# Scan callbacks have not fired yet (EXPLAIN does not execute the scan).
#
SELECT vsql_knn_mem_test.kvec_scan_begin_count() AS scan_begins_before;
scan_begins_before
0
SELECT vsql_knn_mem_test.kvec_scan_fetch_count() AS scan_fetches_before;
scan_fetches_before
0
#
# The 3 nearest neighbours of [1,0,0,0] by L2 distance are, in order:
#   id=1 [1,0,0,0] (dist 0), id=4 [1,1,0,0] (dist 1), id=5 [2,0,0,0]
#   (dist 1) — ids 2 and 3 are farther (dist sqrt(2)).
#
SELECT id
FROM t
ORDER BY vsql_knn_mem_test.kvec_l2_distance(v, KVECTOR::from_string('[1,0,0,0]'))
LIMIT 3;
id
1
4
5
#
# The scan callbacks fired: begin once, fetch once per returned row.
# This proves the custom index scan executed (a filesort fallback would
# leave both counts at 0).
#
SELECT vsql_knn_mem_test.kvec_scan_begin_count() AS scan_begins_after;
scan_begins_after
1
SELECT vsql_knn_mem_test.kvec_scan_fetch_count() AS scan_fetches_after;
scan_fetches_after
3
DROP TABLE t;
UNINSTALL EXTENSION vsql_knn_mem_test;
SET SESSION debug='-d,villagesql_custom_index_proceed';
