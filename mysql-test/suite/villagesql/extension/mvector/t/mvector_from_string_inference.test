# Exercises constant-string inference for the parameterized
# `MVECTOR::from_string('<literal>')` syntax. Before A1 case 1 this would
# error with "cannot determine type parameters"; now the params are inferred
# at fix_fields time from the literal.

INSTALL EXTENSION MVECTOR;

# Test: bare MVECTOR::from_string with a well-formed literal
# Result type is inferred to MVECTOR(3); the value round-trips through
# to_string for display.
SELECT MVECTOR::from_string('[1,2,3]') AS v;

# Fully-qualified spelling.
SELECT MVECTOR.MVECTOR::from_string('[4,5,6]') AS v;

# Test: chained TD2 - outer VDF's return type binds from the inferred arg
#
# mvector_scale(MVECTOR, REAL) -> MVECTOR. The inferred MVECTOR(3) from the
# inner call propagates as the return TypeContext of the outer call.
SELECT MVECTOR.mvector_scale(
    MVECTOR::from_string('[1,2,3]'),
    2.0) AS scaled;

# Test: TD1 with two inferred args - same dimension passes
#
# Before A1 case 1 this errored "cannot determine type parameters" because
# neither arg carried a TypeContext. Now both infer MVECTOR(3) and TD1
# accepts them.
SELECT MVECTOR.mvector_dot_product(
    MVECTOR::from_string('[1,2,3]'),
    MVECTOR::from_string('[4,5,6]')) AS dot;

# Test: TD1 with two inferred args - different dimensions conflict
#
# Each arg infers its own dimension (3 and 2), then TD1's conflict check
# rejects the mismatch.
--error ER_VILLAGESQL_GENERIC_ERROR
SELECT MVECTOR.mvector_dot_product(
    MVECTOR::from_string('[1,2,3]'),
    MVECTOR::from_string('[4,5]')) AS dot;

# Test: malformed literal surfaces at fix_fields
#
# Without the column-validation path's INSERT IGNORE wrapping, a bad
# literal here has nowhere to "store NULL" - the helper reports a
# fix_fields error and the query never runs.
--error ER_VILLAGESQL_GENERIC_ERROR
SELECT MVECTOR::from_string('[1,2,') AS v;

--error ER_VILLAGESQL_GENERIC_ERROR
SELECT MVECTOR::from_string('[abc,2,3]') AS v;

--error ER_VILLAGESQL_GENERIC_ERROR
SELECT MVECTOR::from_string('not a vector') AS v;

# Test: INSERT with from_string into a matching MVECTOR(N) column
CREATE TABLE t_dim3 (
    id INT AUTO_INCREMENT PRIMARY KEY,
    v MVECTOR(3)
);

INSERT INTO t_dim3 (v) VALUES (MVECTOR::from_string('[1,2,3]'));
INSERT INTO t_dim3 (v) VALUES (MVECTOR::from_string('[4,5,6]'));

SELECT id, v FROM t_dim3 ORDER BY id;

# Test: UPDATE with from_string into a matching MVECTOR(N) column
UPDATE t_dim3 SET v = MVECTOR::from_string('[7,8,9]') WHERE id = 1;
SELECT id, v FROM t_dim3 ORDER BY id;

# Test: INSERT with from_string whose inferred dimension does NOT match
# the column's declared dimension.
#
# The inferred MVECTOR(2) literal cannot be stored into a MVECTOR(3) column.
--error ER_VILLAGESQL_GENERIC_ERROR
INSERT INTO t_dim3 (v) VALUES (MVECTOR::from_string('[1,2]'));

--error ER_VILLAGESQL_GENERIC_ERROR
INSERT INTO t_dim3 (v) VALUES (MVECTOR::from_string('[1,2,3,4]'));

# Row count is unchanged by the failed inserts.
SELECT COUNT(*) FROM t_dim3;

# Test: UPDATE with from_string whose inferred dimension does NOT match.
--error ER_VILLAGESQL_GENERIC_ERROR
UPDATE t_dim3 SET v = MVECTOR::from_string('[9,9]') WHERE id = 1;

SELECT id, v FROM t_dim3 ORDER BY id;

# Test: inference also fires when the input string comes from a user
# variable (Item_func_get_user_var). The variable's value is read at
# fix_fields time and the params are inferred just like for a bare literal.
SET @v3 = '[1,2,3]';
SELECT MVECTOR::from_string(@v3) AS v;

# Comparison against a typed column: with the user-variable inference path,
# the LHS infers MVECTOR(3) from the variable's contents and the comparison
# succeeds. t_dim3 has (id=1, v=[7,8,9]) and (id=2, v=[4,5,6]) at this
# point.
SET @v_match = '[4,5,6]';
SELECT id FROM t_dim3 WHERE v = MVECTOR::from_string(@v_match);

# Malformed user-variable contents surface the same fix_fields error as a
# malformed literal.
SET @v_bad = '[1,2,';
--error ER_VILLAGESQL_GENERIC_ERROR
SELECT MVECTOR::from_string(@v_bad) AS v;

# Inferred dimension from a user variable that doesn't match the column
# fails the same way a literal would.
SET @v_short = '[1,2]';
--error ER_VILLAGESQL_GENERIC_ERROR
INSERT INTO t_dim3 (v) VALUES (MVECTOR::from_string(@v_short));

# Test: double-typed MVECTOR - inference defaults to the type's default
# precision (float). An override or matching column would be needed to
# write into a `type=double` column; verify that path errors when the
# inferred precision differs from the column's declared precision.
CREATE TABLE t_double3 (
    id INT AUTO_INCREMENT PRIMARY KEY,
    v MVECTOR('dimension=3,type=double')
);

# Inferred params default to type=float; column is type=double. Mismatch
# at fix_fields.
--error ER_VILLAGESQL_GENERIC_ERROR
INSERT INTO t_double3 (v) VALUES (MVECTOR::from_string('[1,2,3]'));

DROP TABLE t_double3;

# Clean up
DROP TABLE t_dim3;

UNINSTALL EXTENSION MVECTOR;
