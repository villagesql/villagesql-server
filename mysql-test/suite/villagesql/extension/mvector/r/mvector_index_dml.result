#
# MVECTOR custom index DML maintenance
#
INSTALL EXTENSION MVECTOR;
CREATE TABLE t (
id INT PRIMARY KEY,
v MVECTOR(3)
);
CREATE INDEX idx_v ON t (v) USING EXTENDED(MVECTOR.mvector_nn);
INSERT INTO t VALUES
(1, '[1,0,0]'),
(2, '[0,1,0]'),
(3, '[0,0,1]');
SELECT MVECTOR.mvector_index_count('test.t.idx_v') AS count_after_insert;
count_after_insert
3
SELECT MVECTOR.mvector_search_nn(
'test.t.idx_v', MVECTOR::from_string('[1,0,0]'), 3) AS nearest_after_insert;
nearest_after_insert
1,2,3
UPDATE t SET v = '[2,0,0]' WHERE id = 2;
SELECT MVECTOR.mvector_search_nn(
'test.t.idx_v', MVECTOR::from_string('[2,0,0]'), 3) AS nearest_after_update;
nearest_after_update
2,1,3
DELETE FROM t WHERE id = 1;
SELECT MVECTOR.mvector_index_count('test.t.idx_v') AS count_after_delete;
count_after_delete
2
SELECT MVECTOR.mvector_search_nn(
'test.t.idx_v', MVECTOR::from_string('[2,0,0]'), 3) AS nearest_after_delete;
nearest_after_delete
2,3
DROP TABLE t;
UNINSTALL EXTENSION MVECTOR;
