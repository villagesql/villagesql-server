SET PERSIST vsql_allow_preview_extensions = ON;
# Install extension
INSTALL EXTENSION vsql_session_var_test;
# Set a session value before restarting
SET SESSION vsql_session_var_test.session_str_var = 'before_restart';
SELECT @@session.vsql_session_var_test.session_str_var;
@@session.vsql_session_var_test.session_str_var
before_restart
# Restart without uninstalling
# restart: --veb-dir=MYSQLTEST_VARDIR/mysqld.1/veb/
# Extension is back after restart; variables exist with their defaults
SELECT @@global.vsql_session_var_test.session_str_var;
@@global.vsql_session_var_test.session_str_var
default_label
SELECT @@session.vsql_session_var_test.session_str_var;
@@session.vsql_session_var_test.session_str_var
default_label
SELECT vsql_session_var_test.read_session_str_var();
vsql_session_var_test.read_session_str_var()
default_label
# Uninstall cleanly
UNINSTALL EXTENSION vsql_session_var_test;
SELECT @@global.vsql_session_var_test.session_str_var;
ERROR HY000: Unknown system variable 'vsql_session_var_test.session_str_var'
SET PERSIST vsql_allow_preview_extensions = OFF;
RESET PERSIST vsql_allow_preview_extensions;
