SET PERSIST vsql_allow_preview_extensions = ON;
# Install extension
INSTALL EXTENSION vsql_session_var_test;
# Variables exist with SESSION scope and the declared defaults
SELECT @@global.vsql_session_var_test.session_int_var;
@@global.vsql_session_var_test.session_int_var
20
SELECT @@session.vsql_session_var_test.session_int_var;
@@session.vsql_session_var_test.session_int_var
20
SELECT @@global.vsql_session_var_test.session_str_var;
@@global.vsql_session_var_test.session_str_var
default_label
SELECT @@session.vsql_session_var_test.session_str_var;
@@session.vsql_session_var_test.session_str_var
default_label
# The VDF reads the caller's session value (default so far)
SELECT vsql_session_var_test.read_session_int_var();
vsql_session_var_test.read_session_int_var()
20
SELECT vsql_session_var_test.read_session_str_var();
vsql_session_var_test.read_session_str_var()
default_label
# Change this session's session_int_var; global is unchanged
SET SESSION vsql_session_var_test.session_int_var = 100;
SET SESSION vsql_session_var_test.session_str_var = 'conn1';
SELECT @@session.vsql_session_var_test.session_int_var;
@@session.vsql_session_var_test.session_int_var
100
SELECT @@global.vsql_session_var_test.session_int_var;
@@global.vsql_session_var_test.session_int_var
20
# VDF observes this session's override (fast-path IntHandle / get_session_str)
SELECT vsql_session_var_test.read_session_int_var();
vsql_session_var_test.read_session_int_var()
100
SELECT vsql_session_var_test.read_session_str_var();
vsql_session_var_test.read_session_str_var()
conn1
# A second connection has its own independent session value
# con2 sees the global default, not con1's override
SELECT @@session.vsql_session_var_test.session_int_var;
@@session.vsql_session_var_test.session_int_var
20
SELECT vsql_session_var_test.read_session_int_var();
vsql_session_var_test.read_session_int_var()
20
SELECT vsql_session_var_test.read_session_str_var();
vsql_session_var_test.read_session_str_var()
default_label
# con2 sets its own value
SET SESSION vsql_session_var_test.session_int_var = 7;
SELECT vsql_session_var_test.read_session_int_var();
vsql_session_var_test.read_session_int_var()
7
# Back on con1: its value is unaffected by con2
SELECT @@session.vsql_session_var_test.session_int_var;
@@session.vsql_session_var_test.session_int_var
100
SELECT vsql_session_var_test.read_session_int_var();
vsql_session_var_test.read_session_int_var()
100
# Changing the global default affects sessions that have not overridden
SET GLOBAL vsql_session_var_test.session_int_var = 55;
SET SESSION vsql_session_var_test.session_int_var = DEFAULT;
# con2 reset to DEFAULT now tracks the new global default
SELECT vsql_session_var_test.read_session_int_var();
vsql_session_var_test.read_session_int_var()
55
# Uninstall extension
UNINSTALL EXTENSION vsql_session_var_test;
# Variable should no longer exist
SELECT @@global.vsql_session_var_test.session_int_var;
ERROR HY000: Unknown system variable 'vsql_session_var_test.session_int_var'
SET PERSIST vsql_allow_preview_extensions = OFF;
RESET PERSIST vsql_allow_preview_extensions;
