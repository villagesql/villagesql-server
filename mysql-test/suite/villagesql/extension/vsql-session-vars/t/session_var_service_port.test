# Port of upstream's service_sys_var_registration/session_var_service.test,
# adapted to the vsql::session_var preview capability (INT + STR only), with
# the string-variable coverage upstream deliberately COMMENTED OUT re-enabled.
#
# Upstream's test SET SESSIONs only the null-default string (test_component.
# str_session_var) and comments out every operation on the non-null-default
# string (test_component.str_session_var_default, lines 56-61 of the upstream
# .test) -- because that exact operation crashes the server (a latent upstream
# bug: the THD-local MEMALLOC-string seed loop misses the bookmark by name and
# leaves the session slot aliasing the global default pointer; SET SESSION then
# frees a non-owned pointer). Reproduced on stock MySQL trunk 26.7.0.
#
# Our fork fixes it (TODO(villagesql-back-to-mysql) in sql/sql_plugin.cc), so
# vsql_session_var_test.session_str_var -- a THD-local MEMALLOC string WITH a
# non-null default ("default_label") -- is SET SESSION'd here without crashing.

SET PERSIST vsql_allow_preview_extensions = ON;

--echo # Simple load test
INSTALL EXTENSION vsql_session_var_test;

# Reset this connection's session values to the registered defaults right after
# INSTALL. If a previous test in this same server installed then uninstalled this
# extension, the reused THD-local slots are left stale (upstream bug#720: session
# variable not reset at plugin/component reinstall -- a plain read is not
# refreshed after reinstall, though an explicit SET recovers it). This makes the
# subsequent reads order-independent. Test-only workaround; the reset bug is
# generic to stock MySQL and tracked separately. Wrapped in disable_query_log so
# it does not appear in the recorded output.
--disable_query_log
SET SESSION vsql_session_var_test.session_int_var = DEFAULT;
SET SESSION vsql_session_var_test.session_str_var = DEFAULT;
--enable_query_log

--echo # Testing integer session variable, @@session vs @@global
SELECT @@global.vsql_session_var_test.session_int_var;
SELECT @@session.vsql_session_var_test.session_int_var;

SET SESSION vsql_session_var_test.session_int_var = 7;
SELECT @@session.vsql_session_var_test.session_int_var;
--echo # global is unaffected by the session SET
SELECT @@global.vsql_session_var_test.session_int_var;

--echo # Range clamping: max is 4096
SET SESSION vsql_session_var_test.session_int_var = 999999;
SELECT @@session.vsql_session_var_test.session_int_var;
--echo # Range clamping: min is 1
SET SESSION vsql_session_var_test.session_int_var = -1;
SELECT @@session.vsql_session_var_test.session_int_var;

--echo # Wrong-type assignments are rejected
--error ER_WRONG_TYPE_FOR_VAR
SET SESSION vsql_session_var_test.session_int_var = "hello";

SET SESSION vsql_session_var_test.session_int_var = DEFAULT;
SELECT @@session.vsql_session_var_test.session_int_var;

--echo #
--echo # Testing STRING session variable WITH a non-null default.
--echo # (This is the operation upstream commented out because it crashed.)
--echo #
SELECT @@global.vsql_session_var_test.session_str_var;
SELECT @@session.vsql_session_var_test.session_str_var;

SET SESSION vsql_session_var_test.session_str_var = "dictionary.txt";
SELECT @@session.vsql_session_var_test.session_str_var;
--echo # global default is unchanged by the session SET
SELECT @@global.vsql_session_var_test.session_str_var;

SET SESSION vsql_session_var_test.session_str_var = "another_value";
SELECT @@session.vsql_session_var_test.session_str_var;

--echo # Reset the session value back to the default
SET SESSION vsql_session_var_test.session_str_var = DEFAULT;
SELECT @@session.vsql_session_var_test.session_str_var;

--echo # The VDF reads the caller's per-session values (fast-path IntHandle / get_session_str)
SET SESSION vsql_session_var_test.session_int_var = 321;
SET SESSION vsql_session_var_test.session_str_var = "vdf_value";
SELECT vsql_session_var_test.read_session_int_var();
SELECT vsql_session_var_test.read_session_str_var();

--echo #
--echo # Stored-procedure paths (mirrors the upstream SP coverage): SET and
--echo # SELECT of the session string var from inside a procedure.
--echo #
CREATE PROCEDURE set_label(x VARCHAR(64))
  SET @@SESSION.vsql_session_var_test.session_str_var = x;
CREATE PROCEDURE get_label() SELECT @@vsql_session_var_test.session_str_var;

CALL get_label();
CALL set_label('from_sp');
CALL get_label();

DROP PROCEDURE set_label;
DROP PROCEDURE get_label;

--echo # Uninstall
UNINSTALL EXTENSION vsql_session_var_test;

--error ER_UNKNOWN_SYSTEM_VARIABLE
SELECT @@global.vsql_session_var_test.session_str_var;

SET PERSIST vsql_allow_preview_extensions = OFF;
RESET PERSIST vsql_allow_preview_extensions;
