# Test session-scoped (THD-local) system variables for the
# vsql_session_var_test extension. Covers: global default, per-session
# independence across connections, SET SESSION, @@session vs @@global,
# reads via the fast-path IntHandle / get_session_str VDFs, and that the storage
# global does NOT reflect a session override.

SET PERSIST vsql_allow_preview_extensions = ON;

--echo # Install extension
INSTALL EXTENSION vsql_session_var_test;

# Reset this connection's session values to the registered defaults right after
# INSTALL. If a previous test in this same server installed then uninstalled this
# extension, the reused THD-local slots are left stale (upstream bug#720: session
# variable not reset at plugin/component reinstall -- a plain read is not
# refreshed after reinstall, though an explicit SET recovers it). This makes the
# subsequent reads order-independent. Test-only workaround; the reset bug is
# generic to stock MySQL and tracked separately. Wrapped in disable_query_log so
# it does not appear in the recorded output.
--disable_query_log
SET SESSION vsql_session_var_test.session_int_var = DEFAULT;
SET SESSION vsql_session_var_test.session_str_var = DEFAULT;
--enable_query_log

--echo # Variables exist with SESSION scope and the declared defaults
SELECT @@global.vsql_session_var_test.session_int_var;
SELECT @@session.vsql_session_var_test.session_int_var;
SELECT @@global.vsql_session_var_test.session_str_var;
SELECT @@session.vsql_session_var_test.session_str_var;

--echo # The VDF reads the caller's session value (default so far)
SELECT vsql_session_var_test.read_session_int_var();
SELECT vsql_session_var_test.read_session_str_var();

--echo # Change this session's session_int_var; global is unchanged
SET SESSION vsql_session_var_test.session_int_var = 100;
SET SESSION vsql_session_var_test.session_str_var = 'conn1';
SELECT @@session.vsql_session_var_test.session_int_var;
SELECT @@global.vsql_session_var_test.session_int_var;

--echo # VDF observes this session's override (fast-path IntHandle / get_session_str)
SELECT vsql_session_var_test.read_session_int_var();
SELECT vsql_session_var_test.read_session_str_var();

--echo # A second connection has its own independent session value
connect (con2,localhost,root,,);
connection con2;

--echo # con2 sees the global default, not con1's override
SELECT @@session.vsql_session_var_test.session_int_var;
SELECT vsql_session_var_test.read_session_int_var();
SELECT vsql_session_var_test.read_session_str_var();

--echo # con2 sets its own value
SET SESSION vsql_session_var_test.session_int_var = 7;
SELECT vsql_session_var_test.read_session_int_var();

--echo # Back on con1: its value is unaffected by con2
connection default;
SELECT @@session.vsql_session_var_test.session_int_var;
SELECT vsql_session_var_test.read_session_int_var();

--echo # Changing the global default affects sessions that have not overridden
SET GLOBAL vsql_session_var_test.session_int_var = 55;
connection con2;
SET SESSION vsql_session_var_test.session_int_var = DEFAULT;
--echo # con2 reset to DEFAULT now tracks the new global default
SELECT vsql_session_var_test.read_session_int_var();

connection default;
disconnect con2;

--echo # Uninstall extension
UNINSTALL EXTENSION vsql_session_var_test;

--echo # Variable should no longer exist
--error ER_UNKNOWN_SYSTEM_VARIABLE
SELECT @@global.vsql_session_var_test.session_int_var;

SET PERSIST vsql_allow_preview_extensions = OFF;
RESET PERSIST vsql_allow_preview_extensions;
