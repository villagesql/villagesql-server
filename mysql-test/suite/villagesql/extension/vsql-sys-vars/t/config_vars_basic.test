# Test config variable registration for vsql_config_vars_test extension.
# Covers: default values, SET GLOBAL, SET PERSIST, restart persistence,
# and cleanup on UNINSTALL EXTENSION.

SET PERSIST vsql_allow_preview_extensions = ON;

--echo # Install extension
INSTALL EXTENSION vsql_config_vars_test;

--echo # Verify defaults
SELECT @@global.vsql_config_vars_test.max_items;
SELECT @@global.vsql_config_vars_test.label;
SHOW GLOBAL VARIABLES LIKE 'vsql_config_vars_test.%';

--echo # Change both variables
SET GLOBAL vsql_config_vars_test.max_items = 42;
SET GLOBAL vsql_config_vars_test.label = 'hello';

--echo # Verify changes took effect
SELECT @@global.vsql_config_vars_test.max_items;
SELECT @@global.vsql_config_vars_test.label;
SHOW GLOBAL VARIABLES LIKE 'vsql_config_vars_test.%';

--echo # Persist one variable so it survives restart
SET PERSIST vsql_config_vars_test.max_items = 99;

--echo # Restart server (extension is reinstated from villagesql.extensions)
--let $veb_dir = `SELECT @@veb_dir`
--replace_result $MYSQLTEST_VARDIR MYSQLTEST_VARDIR
--let $restart_parameters = restart: --veb-dir=$veb_dir
--source include/restart_mysqld.inc

--echo # Persisted variable should have survived restart
SELECT @@global.vsql_config_vars_test.max_items;

--echo # Non-persisted variable should be back to default
SELECT @@global.vsql_config_vars_test.label;

--echo # Clean up persisted value
RESET PERSIST vsql_config_vars_test.max_items;

--echo # Read max_items via VDF (reads storage global directly)
SELECT vsql_config_vars_test.read_max_items();

--echo # Write max_items via VDF (goes through set_variable for locking/validation)
SELECT vsql_config_vars_test.write_max_items(42);
SELECT @@global.vsql_config_vars_test.max_items;

--echo # write_max_items clamps to the declared range (0..1000000) with a warning
SELECT vsql_config_vars_test.write_max_items(9999999);
SELECT @@global.vsql_config_vars_test.max_items;

--echo # Read label via VDF (goes through get() vtable)
SELECT vsql_config_vars_test.read_label();
SET GLOBAL vsql_config_vars_test.label = 'via_get';
SELECT vsql_config_vars_test.read_label();

--echo # Uninstall extension
UNINSTALL EXTENSION vsql_config_vars_test;

--echo # Variables should no longer exist
--error ER_UNKNOWN_SYSTEM_VARIABLE
SELECT @@global.vsql_config_vars_test.max_items;
--error ER_UNKNOWN_SYSTEM_VARIABLE
SELECT @@global.vsql_config_vars_test.label;

SET PERSIST vsql_allow_preview_extensions = OFF;
RESET PERSIST vsql_allow_preview_extensions;
