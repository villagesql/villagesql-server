# UNINSTALL EXTENSION checks whether each of its variables was persisted by
# walking the server's set of persisted plugin variables
# (get_persisted_dynamic_plugin_variables) in on_depopulate_sys_var. Other
# sessions change that set under m_LOCK_persist_variables: SET PERSIST and
# RESET PERSIST of a plugin variable, and INSTALL of an extension with
# persisted values. The walk must not see a node of the set freed under it.
#
# UNINSTALL of vsql_range_clamp_test is paused on the first element of the set
# it compares, which is a persisted variable of vsql_config_vars_test. Another
# session runs RESET PERSIST, which empties the set and frees that element.
# UNINSTALL then goes on to the next element. Used to crash in
# on_depopulate_sys_var (found by pstress, sessvar workload).
#
# If the walk holds m_LOCK_persist_variables, RESET PERSIST waits for it; the
# test lets UNINSTALL go on once RESET PERSIST has finished or is waiting on
# that mutex.
#
# Reading the freed node does not crash every build: on macOS freed memory
# reads as zero and ends the walk. Run with ASan to see the read of the freed
# node.

--source include/have_debug_sync.inc
--source include/count_sessions.inc

SET PERSIST vsql_allow_preview_extensions = ON;
INSTALL EXTENSION vsql_range_clamp_test;
INSTALL EXTENSION vsql_config_vars_test;

--echo # Persist the variables of the other extension: these are the elements
--echo # UNINSTALL walks
SET PERSIST vsql_config_vars_test.max_items = 7;
SET PERSIST vsql_config_vars_test.mode = 'sync';
SET PERSIST vsql_config_vars_test.label = 'persisted';

connect (con_persist,localhost,root);
connect (con_uninstall,localhost,root);

--echo # Record waits on mutexes, to see RESET PERSIST waiting on the walk
--let $instrument_enabled = `SELECT ENABLED FROM performance_schema.setup_instruments WHERE NAME LIKE 'wait/synch/mutex/%/m_LOCK_persist_variables'`
--let $consumer_enabled = `SELECT ENABLED FROM performance_schema.setup_consumers WHERE NAME = 'events_waits_current'`
UPDATE performance_schema.setup_instruments SET ENABLED = 'YES'
  WHERE NAME LIKE 'wait/synch/mutex/%/m_LOCK_persist_variables';
UPDATE performance_schema.setup_consumers SET ENABLED = 'YES'
  WHERE NAME = 'events_waits_current';

connection con_persist;
--let $persist_id = `SELECT CONNECTION_ID()`

connection con_uninstall;
--echo # con_uninstall: park UNINSTALL on the first element it compares
SET DEBUG_SYNC = 'vef_sys_var_persisted_lookup SIGNAL in_lookup WAIT_FOR continue_uninstall';
--send UNINSTALL EXTENSION vsql_range_clamp_test

connection default;
SET DEBUG_SYNC = 'now WAIT_FOR in_lookup';

connection con_persist;
--echo # con_persist: empty the set, freeing the element UNINSTALL is on
--send RESET PERSIST

connection default;
--echo # Wait until RESET PERSIST has finished or waits on the mutex
let $wait_condition =
  SELECT COUNT(*) = 1
  FROM performance_schema.threads t
  JOIN performance_schema.events_statements_current s
    ON s.THREAD_ID = t.THREAD_ID
  WHERE t.PROCESSLIST_ID = $persist_id
    AND s.SQL_TEXT = 'RESET PERSIST'
    AND (s.END_EVENT_ID IS NOT NULL OR EXISTS (
      SELECT 1 FROM performance_schema.events_waits_current w
      WHERE w.THREAD_ID = t.THREAD_ID AND w.END_EVENT_ID IS NULL
        AND w.EVENT_NAME LIKE 'wait/synch/mutex/%/m_LOCK_persist_variables'));
--source include/wait_condition.inc

--echo # Let UNINSTALL go on to the next element
SET DEBUG_SYNC = 'now SIGNAL continue_uninstall';

connection con_uninstall;
reap;
SET DEBUG_SYNC = 'RESET';

connection con_persist;
reap;

connection default;
--disable_query_log
eval UPDATE performance_schema.setup_instruments SET ENABLED = '$instrument_enabled'
  WHERE NAME LIKE 'wait/synch/mutex/%/m_LOCK_persist_variables';
eval UPDATE performance_schema.setup_consumers SET ENABLED = '$consumer_enabled'
  WHERE NAME = 'events_waits_current';
--enable_query_log
disconnect con_persist;
disconnect con_uninstall;

--echo # vsql_range_clamp_test is gone; RESET PERSIST left the other
--echo # extension's current values as they were
--error ER_UNKNOWN_SYSTEM_VARIABLE
SELECT @@global.vsql_range_clamp_test.label;
SELECT @@global.vsql_config_vars_test.max_items;

UNINSTALL EXTENSION vsql_config_vars_test;
# on_deinit of vsql_config_vars_test writes a marker file (read by
# config_vars_on_init); remove it so the test leaves no files behind
--remove_file $MYSQL_TMP_DIR/vsql_config_vars_test.marker
SET DEBUG_SYNC = 'RESET';
SET PERSIST vsql_allow_preview_extensions = OFF;
RESET PERSIST vsql_allow_preview_extensions;
--source include/wait_until_count_sessions.inc
