call mtr.add_suppression("Persisting SENSITIVE variables in encrypted form requires keyring component loaded through manifest file.");
SET PERSIST vsql_allow_preview_extensions = ON;
INSTALL EXTENSION vsql_sys_var_sensitive_test;
CREATE USER u_plain@localhost, u_obs@localhost;
GRANT SYSTEM_VARIABLES_ADMIN ON *.* TO u_plain@localhost;
GRANT SYSTEM_VARIABLES_ADMIN, SENSITIVE_VARIABLES_OBSERVER ON *.*
TO u_obs@localhost;
# root holds SENSITIVE_VARIABLES_OBSERVER
SET GLOBAL vsql_sys_var_sensitive_test.api_token = 'secret-1';
SELECT @@global.vsql_sys_var_sensitive_test.api_token;
@@global.vsql_sys_var_sensitive_test.api_token
secret-1
# Without SENSITIVE_VARIABLES_OBSERVER the value cannot be read
SELECT @@global.vsql_sys_var_sensitive_test.api_token;
ERROR 42000: Access denied; you need (at least one of) the SENSITIVE_VARIABLES_OBSERVER privilege(s) for this operation
# and the variable is left out of the listings
SHOW GLOBAL VARIABLES LIKE 'vsql_sys_var_sensitive_test.%';
Variable_name	Value
vsql_sys_var_sensitive_test.plain	1
SELECT VARIABLE_NAME FROM performance_schema.global_variables
WHERE VARIABLE_NAME LIKE 'vsql_sys_var_sensitive_test.%'
  ORDER BY VARIABLE_NAME;
VARIABLE_NAME
vsql_sys_var_sensitive_test.plain
# nor can it be set
SET GLOBAL vsql_sys_var_sensitive_test.api_token = 'plain';
ERROR 42000: Access denied; you need (at least one of) the SENSITIVE_VARIABLES_OBSERVER privilege(s) for this operation
# The variable that is not sensitive is unaffected
SET GLOBAL vsql_sys_var_sensitive_test.plain = 5;
SELECT @@global.vsql_sys_var_sensitive_test.plain;
@@global.vsql_sys_var_sensitive_test.plain
5
# The extension reads the value whoever is connected
SELECT vsql_sys_var_sensitive_test.read_token() AS token;
token
secret-1
# With SENSITIVE_VARIABLES_OBSERVER the value can be read and set
SELECT @@global.vsql_sys_var_sensitive_test.api_token;
@@global.vsql_sys_var_sensitive_test.api_token
secret-1
SHOW GLOBAL VARIABLES LIKE 'vsql_sys_var_sensitive_test.%';
Variable_name	Value
vsql_sys_var_sensitive_test.api_token	secret-1
vsql_sys_var_sensitive_test.plain	5
SELECT VARIABLE_NAME FROM performance_schema.global_variables
WHERE VARIABLE_NAME LIKE 'vsql_sys_var_sensitive_test.%'
  ORDER BY VARIABLE_NAME;
VARIABLE_NAME
vsql_sys_var_sensitive_test.api_token
vsql_sys_var_sensitive_test.plain
# A value longer than the first read buffer reaches the extension whole
SET GLOBAL vsql_sys_var_sensitive_test.api_token = REPEAT('x', 3000);
SELECT LENGTH(vsql_sys_var_sensitive_test.read_token()) AS token_length;
token_length
3000
# So does a long value of a variable the extension did not register
SET @orig_init_replica = @@GLOBAL.init_replica;
SET GLOBAL init_replica = REPEAT('y', 3000);
SELECT LENGTH(vsql_sys_var_sensitive_test.read_var('mysql_server',
'init_replica')) AS init_replica_length;
init_replica_length
3000
SET GLOBAL init_replica = @orig_init_replica;
# The extension writes the value itself, whoever is connected
SELECT vsql_sys_var_sensitive_test.write_token('rotated') AS err;
err
0
SELECT vsql_sys_var_sensitive_test.read_token() AS token;
token
rotated
SELECT vsql_sys_var_sensitive_test.write_token('rotated-by-plain') AS err;
err
0
SELECT vsql_sys_var_sensitive_test.read_token() AS token;
token
rotated-by-plain
SELECT @@global.vsql_sys_var_sensitive_test.api_token;
@@global.vsql_sys_var_sensitive_test.api_token
rotated-by-plain
# Without a keyring, SET PERSIST stores the value in plaintext and warns
SET PERSIST vsql_sys_var_sensitive_test.api_token = 'persisted-secret';
Warnings:
Warning	4098	SENSITIVE system variable 'vsql_sys_var_sensitive_test.api_token' was persisted without encryption. Consider restarting server with keyring component support to persist SENSITIVE variables securely.
# mysqld-auto.cnf holds the value
api_token persisted: yes
# Restart with the extension installed: the persisted value is applied
# restart: --veb-dir=MYSQLTEST_VARDIR/mysqld.1/veb/
SELECT @@global.vsql_sys_var_sensitive_test.api_token;
@@global.vsql_sys_var_sensitive_test.api_token
persisted-secret
SELECT vsql_sys_var_sensitive_test.read_token() AS token;
token
persisted-secret
# on_init read and wrote the value at startup, before any session existed
SELECT vsql_sys_var_sensitive_test.init_token() AS init_token;
init_token
persisted-secret
# UNINSTALL removes the persisted value from mysqld-auto.cnf
DROP USER u_plain@localhost, u_obs@localhost;
UNINSTALL EXTENSION vsql_sys_var_sensitive_test;
api_token persisted: no
SET PERSIST vsql_allow_preview_extensions = OFF;
RESET PERSIST vsql_allow_preview_extensions;
