# Coverage for the typed bind_and_check_types API (vsql::BindArgs /
# vsql::BindResult).
#
# TAG is a custom type carrying an 8-byte counter, parameterized by a 'label'
# that is type metadata only. Its text form is "<label>#<number>".
#
# The two hooks under test cover what the built-in rules cannot express. TD1
# only propagates parameters between same-typed arguments and TD2 only copies
# an argument's parameters to a same-typed return, so neither can produce a
# return type out of an argument's VALUE.
#
# Fixture: vsql_bindcheck_test exposes TAG, tag_make, tag_relabel, tag_label
# and tag_counter.

--echo # Install the bind-hook fixture.
INSTALL EXTENSION vsql_bindcheck_test;

--echo #
--echo # tag_make: the return type's label is the VALUE of the constant first
--echo # argument, read through BindArgType::const_value().
--echo #
SELECT vsql_bindcheck_test.tag_make('user', 42) AS t;
SELECT vsql_bindcheck_test.tag_label(vsql_bindcheck_test.tag_make('user', 42))
         AS label,
       vsql_bindcheck_test.tag_counter(vsql_bindcheck_test.tag_make('user', 42))
         AS n;

--echo # A user variable is constant for execution, so the hook sees it too.
SET @l = 'order';
SELECT vsql_bindcheck_test.tag_label(vsql_bindcheck_test.tag_make(@l, 7))
         AS label;

--echo # The label is validated at resolution time, before any row is read.
--error ER_CANT_INITIALIZE_UDF
SELECT vsql_bindcheck_test.tag_make('Bad Label', 1);

--echo #
--echo # has_const_value() is false for a column reference: the hook has no
--echo # value to derive the label from and rejects the call.
--echo #
CREATE TABLE labels (l VARCHAR(16));
INSERT INTO labels VALUES ('user');

--error ER_CANT_INITIALIZE_UDF
SELECT vsql_bindcheck_test.tag_make(l, 1) FROM labels;

--echo #
--echo # A TAG column declares its label, which the text form is checked
--echo # against.
--echo #
CREATE TABLE tags (id INT PRIMARY KEY,
                   t vsql_bindcheck_test.TAG('label=user'));
INSERT INTO tags VALUES (1, 'user#100'), (2, 'user#5');

SELECT id, t, vsql_bindcheck_test.tag_label(t) AS label
FROM tags ORDER BY id;

SHOW CREATE TABLE tags;

--echo # Big-endian storage makes the byte order the numeric order.
SELECT id FROM tags WHERE t > 'user#50' ORDER BY id;

--echo # A value whose label disagrees with the column's is rejected.
--error ER_TRUNCATED_WRONG_VALUE_FOR_FIELD
INSERT INTO tags VALUES (3, 'order#1');

--echo #
--echo # tag_relabel: the hook combines the first argument's already resolved
--echo # parameters (params<P>()) with a constant (const_value()).
--echo #
SELECT id,
       vsql_bindcheck_test.tag_relabel(t, 'archived') AS relabelled,
       vsql_bindcheck_test.tag_label(
         vsql_bindcheck_test.tag_relabel(t, 'archived')) AS label
FROM tags ORDER BY id;

--echo # Having read both, the hook can reject a no-op relabel.
--error ER_CANT_INITIALIZE_UDF
SELECT vsql_bindcheck_test.tag_relabel(t, 'user') FROM tags;

--echo # The new label must be constant here as well.
--error ER_CANT_INITIALIZE_UDF
SELECT vsql_bindcheck_test.tag_relabel(tags.t, labels.l) FROM tags, labels;

--echo #
--echo # A bare literal in TAG position reaches the hook as a STRING -- it has
--echo # no type context yet. The hook recovers the label from its text and
--echo # hands it back with set_arg(), which is how the server learns to encode
--echo # the literal as TAG('label=user').
--echo #
SELECT vsql_bindcheck_test.tag_relabel('user#5', 'archived') AS from_literal;

SELECT vsql_bindcheck_test.tag_label(
         vsql_bindcheck_test.tag_relabel('user#5', 'archived')) AS new_label,
       vsql_bindcheck_test.tag_counter(
         vsql_bindcheck_test.tag_relabel('user#5', 'archived')) AS n;

--echo # The literal's own label still decides the no-op check.
--error ER_CANT_INITIALIZE_UDF
SELECT vsql_bindcheck_test.tag_relabel('user#5', 'user');

--echo # Text that is not a TAG literal has no label to recover.
--error ER_CANT_INITIALIZE_UDF
SELECT vsql_bindcheck_test.tag_relabel('nope', 'archived');

--echo #
--echo # TAGLIST: an argument whose parameters are a function of a
--echo # DIFFERENTLY-typed argument's. This is the case set_arg() alone can
--echo # serve -- a TAGLIST's text form never names its label, and TD1 only
--echo # donates between arguments of the same type, so a TAG can never hand
--echo # its label to a TAGLIST.
--echo #
--echo # Written explicitly it cannot be resolved either -- the text is silent:
--error ER_VILLAGESQL_GENERIC_ERROR
SELECT TAGLIST::from_string('[1,2,3]') AS ctor;

--echo # Through the hook, the TAG argument supplies it.
SELECT vsql_bindcheck_test.taglist_prepend(t, '[1,2,3]') AS lst,
       vsql_bindcheck_test.taglist_label(
         vsql_bindcheck_test.taglist_prepend(t, '[1,2,3]')) AS lbl,
       vsql_bindcheck_test.taglist_size(
         vsql_bindcheck_test.taglist_prepend(t, '[1,2,3]')) AS n
FROM tags WHERE id = 2;

--echo # An already resolved TAGLIST column needs no set_arg, only agreement.
CREATE TABLE lists (v vsql_bindcheck_test.TAGLIST('label=user'));
INSERT INTO lists VALUES ('[4,5]');
SELECT vsql_bindcheck_test.taglist_prepend(tags.t, lists.v) AS lst
FROM tags, lists WHERE tags.id = 2;

CREATE TABLE other_lists (v vsql_bindcheck_test.TAGLIST('label=order'));
INSERT INTO other_lists VALUES ('[9]');

--echo # Disagreement is the hook's to reject; TD1 never sees these as siblings.
--error ER_CANT_INITIALIZE_UDF
SELECT vsql_bindcheck_test.taglist_prepend(tags.t, other_lists.v)
FROM tags, other_lists;

--echo #
--echo # taglist_max: variable-length argument in, fixed-size parameterized
--echo # value out. The return's label crosses from TAGLIST to TAG -- two
--echo # different type names -- which TD2 cannot do, because it looks up only
--echo # the return type's own name among the arguments and would find none.
--echo #
SELECT v AS list,
       vsql_bindcheck_test.taglist_max(v) AS largest,
       vsql_bindcheck_test.tag_label(vsql_bindcheck_test.taglist_max(v)) AS lbl,
       vsql_bindcheck_test.tag_counter(vsql_bindcheck_test.taglist_max(v)) AS n
FROM lists;

--echo # The result really is TAG('label=user'): it stores into a matching
--echo # column and is refused by one whose label differs.
CREATE TABLE winners (t vsql_bindcheck_test.TAG('label=user'));
INSERT INTO winners SELECT vsql_bindcheck_test.taglist_max(v) FROM lists;
SELECT t FROM winners;

CREATE TABLE wrong_winners (t vsql_bindcheck_test.TAG('label=order'));
--error ER_VILLAGESQL_GENERIC_ERROR
INSERT INTO wrong_winners SELECT vsql_bindcheck_test.taglist_max(v) FROM lists;

--echo # A TAGLIST literal has no label of its own and no sibling to take one
--echo # from, so there is nothing for the hook to derive.
--error ER_CANT_INITIALIZE_UDF
SELECT vsql_bindcheck_test.taglist_max('[1,2,3]');

--echo #
--echo # Cleanup
--echo #
DROP TABLE wrong_winners;
DROP TABLE winners;
DROP TABLE other_lists;
DROP TABLE lists;
DROP TABLE tags;
DROP TABLE labels;
UNINSTALL EXTENSION vsql_bindcheck_test;
