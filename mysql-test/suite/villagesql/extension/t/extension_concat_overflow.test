# Test ba_concat_all results larger than the requested output buffer.
# Underlying math is that the default output buffer is 1024 bytes.
# Four hundred COMPLEX objects needs output buffer of 6400 bytes.
# Goal is to probe various buffer needs below and above 1024.

INSTALL EXTENSION vsql_simple;
INSTALL EXTENSION vsql_complex;

--echo # create table with complex column
CREATE TABLE t (id INT, c COMPLEX);
INSERT INTO t VALUES (1, '(5,6)');

--echo # 1 COMPLEX
SELECT ba_concat_all(c) FROM t INTO @var;

SELECT LENGTH(@var);
SELECT HEX(@var);

--echo # 63 COMPLEX, just under 1024 buffer size
SELECT ba_concat_all(
c, c, c, c, c, c, c, c, c, c,
c, c, c, c, c, c, c, c, c, c,
c, c, c, c, c, c, c, c, c, c,
c, c, c, c, c, c, c, c, c, c,
c, c, c, c, c, c, c, c, c, c,
c, c, c, c, c, c, c, c, c, c,
c, c, c) FROM t INTO @var;

SELECT LENGTH(@var);
SELECT @var = REPEAT(UNHEX('00000000000014400000000000001840'), 63);

--echo # 64 COMPLEX, equal to 1024 buffer size
SELECT ba_concat_all(
c, c, c, c, c, c, c, c, c, c,
c, c, c, c, c, c, c, c, c, c,
c, c, c, c, c, c, c, c, c, c,
c, c, c, c, c, c, c, c, c, c,
c, c, c, c, c, c, c, c, c, c,
c, c, c, c, c, c, c, c, c, c,
c, c, c, c) FROM t INTO @var;

SELECT LENGTH(@var);
SELECT HEX(@var);

--echo # 65 COMPLEX, just over 1024 buffer size
SELECT ba_concat_all(
c, c, c, c, c, c, c, c, c, c,
c, c, c, c, c, c, c, c, c, c,
c, c, c, c, c, c, c, c, c, c,
c, c, c, c, c, c, c, c, c, c,
c, c, c, c, c, c, c, c, c, c,
c, c, c, c, c, c, c, c, c, c,
c, c, c, c, c) FROM t INTO @var;

SELECT LENGTH(@var);
SELECT @var = REPEAT(UNHEX('00000000000014400000000000001840'), 65);

--echo # 400 COMPLEX arguments (original bug size)
SELECT ba_concat_all(
c, c, c, c, c, c, c, c, c, c,
c, c, c, c, c, c, c, c, c, c,
c, c, c, c, c, c, c, c, c, c,
c, c, c, c, c, c, c, c, c, c,
c, c, c, c, c, c, c, c, c, c,
c, c, c, c, c, c, c, c, c, c,
c, c, c, c, c, c, c, c, c, c,
c, c, c, c, c, c, c, c, c, c,
c, c, c, c, c, c, c, c, c, c,
c, c, c, c, c, c, c, c, c, c,
c, c, c, c, c, c, c, c, c, c,
c, c, c, c, c, c, c, c, c, c,
c, c, c, c, c, c, c, c, c, c,
c, c, c, c, c, c, c, c, c, c,
c, c, c, c, c, c, c, c, c, c,
c, c, c, c, c, c, c, c, c, c,
c, c, c, c, c, c, c, c, c, c,
c, c, c, c, c, c, c, c, c, c,
c, c, c, c, c, c, c, c, c, c,
c, c, c, c, c, c, c, c, c, c,
c, c, c, c, c, c, c, c, c, c,
c, c, c, c, c, c, c, c, c, c,
c, c, c, c, c, c, c, c, c, c,
c, c, c, c, c, c, c, c, c, c,
c, c, c, c, c, c, c, c, c, c,
c, c, c, c, c, c, c, c, c, c,
c, c, c, c, c, c, c, c, c, c,
c, c, c, c, c, c, c, c, c, c,
c, c, c, c, c, c, c, c, c, c,
c, c, c, c, c, c, c, c, c, c,
c, c, c, c, c, c, c, c, c, c,
c, c, c, c, c, c, c, c, c, c,
c, c, c, c, c, c, c, c, c, c,
c, c, c, c, c, c, c, c, c, c,
c, c, c, c, c, c, c, c, c, c,
c, c, c, c, c, c, c, c, c, c,
c, c, c, c, c, c, c, c, c, c,
c, c, c, c, c, c, c, c, c, c,
c, c, c, c, c, c, c, c, c, c,
c, c, c, c, c, c, c, c, c, c
) FROM t INTO @var;

SELECT LENGTH(@var);

SELECT @var = REPEAT(UNHEX('00000000000014400000000000001840'), 400);

--echo # Drop table with complex
DROP TABLE t;

--echo # Uninstall the extensions
UNINSTALL EXTENSION vsql_simple;
UNINSTALL EXTENSION vsql_complex;

