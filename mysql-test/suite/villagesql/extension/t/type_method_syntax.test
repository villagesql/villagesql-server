# Test for the :: type method syntax (TYPE::method and ext.TYPE::method).
# Verifies that encode, decode, compare, and error cases all work correctly.

--source include/villagesql/install_complex_extension.inc

--echo # Test 1: Qualified encode — vsql_complex.COMPLEX::from_string(value)
SELECT vsql_complex.COMPLEX::from_string('(3,4)') AS result;

--echo # Test 2: Unqualified encode — COMPLEX::from_string(value)
SELECT COMPLEX::from_string('(1,2)') AS result;

--echo # Test 3: Qualified decode — vsql_complex.COMPLEX::to_string(val)
CREATE TABLE t1 (id INT, val COMPLEX);
INSERT INTO t1 VALUES (1, '(5,6)');
SELECT vsql_complex.COMPLEX::to_string(val) AS result FROM t1;

--echo # Test 4: Unqualified decode — COMPLEX::to_string(val)
SELECT COMPLEX::to_string(val) AS result FROM t1;

DROP TABLE t1;

--echo # Test 5: View round-trip — CREATE VIEW using COMPLEX::from_string, then SHOW CREATE VIEW
# The view stores the VDF qualified name including the :: syntax.
CREATE VIEW v_encode AS SELECT COMPLEX::from_string('(7,8)') AS encoded;
SHOW CREATE VIEW v_encode;
--echo # Verify the stored view re-executes correctly (proves :: round-trips through grammar)
SELECT * FROM v_encode;
DROP VIEW v_encode;

--echo # Test 6: Error — unknown method name
--error ER_VILLAGESQL_GENERIC_ERROR
SELECT COMPLEX::nonexistent('(1,2)') AS result;

--echo # Test 7: Error — unknown type name
--error ER_VILLAGESQL_GENERIC_ERROR
SELECT NOSUCHTYPE::encode('(1,2)') AS result;

--echo # Test 8: Hidden type helpers are not SQL-callable
--error ER_VILLAGESQL_GENERIC_ERROR
SELECT vsql_complex.COMPLEX::compare('(1,2)', '(3,4)') AS result;
--error ER_VILLAGESQL_GENERIC_ERROR
SELECT COMPLEX::compare('(3,4)', '(1,2)') AS result;
--error ER_VILLAGESQL_GENERIC_ERROR
SELECT vsql_complex.COMPLEX2::hash('(1,2)') AS result;

--echo # Test 9: :: decode with FROM clause — verifies column-arg form works
CREATE TABLE t2 (id INT, val COMPLEX);
INSERT INTO t2 VALUES (1, '(10,20)');
INSERT INTO t2 VALUES (2, '(30,40)');
SELECT vsql_complex.COMPLEX::to_string(val) AS decoded FROM t2 ORDER BY id;
SELECT COMPLEX::to_string(val) AS decoded FROM t2 ORDER BY id;
DROP TABLE t2;

--source include/villagesql/uninstall_complex_extension.inc
