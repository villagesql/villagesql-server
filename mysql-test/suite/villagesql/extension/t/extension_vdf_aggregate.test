# Test aggregate VDF functions
# Verifies that VDFs registered with clear/accumulate callbacks work as
# aggregate functions with GROUP BY, HAVING, window functions, etc.

# Setup VEB directory for testing
--let $veb_dir = $MYSQLTEST_VARDIR/veb
--exec mkdir -p $veb_dir

call mtr.add_suppression("Orphaned expansion directory found but not removed");
--replace_result $MYSQLTEST_VARDIR MYSQLTEST_VARDIR
--let $restart_parameters = restart: --veb-dir=$veb_dir
--source include/restart_mysqld.inc
--source include/villagesql/binlog_check_begin.inc

# Build and install the aggregate VDF test extension
--let $extension_name = agg_vdf_ext
--let $extension_version = 1.0.0
--let $extension_source = $MYSQL_TEST_DIR/suite/villagesql/std_data/aggregate_vdf.cc
--source include/villagesql/create_extension_sdk.inc

INSTALL EXTENSION agg_vdf_ext;

CREATE TABLE t1 (
  id INT PRIMARY KEY,
  val INT,
  category VARCHAR(20)
);

INSERT INTO t1 VALUES
  (1, 10, 'A'),
  (2, 20, 'A'),
  (3, 30, 'B'),
  (4, 40, 'B'),
  (5, 50, 'B');

# Basic aggregate with GROUP BY
SELECT category, agg_vdf_ext.vdf_sum(val) AS total
FROM t1
GROUP BY category
ORDER BY category;

# Whole-table aggregate (no GROUP BY)
SELECT agg_vdf_ext.vdf_sum(val) AS total FROM t1;

# Aggregate on empty table
CREATE TABLE t_empty (id INT PRIMARY KEY, val INT);
SELECT agg_vdf_ext.vdf_sum(val) AS total FROM t_empty;
DROP TABLE t_empty;

# Multiple aggregate VDFs in one query
SELECT category,
  agg_vdf_ext.vdf_sum(val) AS total,
  agg_vdf_ext.vdf_count(val) AS cnt
FROM t1
GROUP BY category
ORDER BY category;

# Mixed scalar and aggregate VDFs
SELECT category,
  agg_vdf_ext.vdf_sum(val) AS total,
  agg_vdf_ext.simple_double(MIN(val)) AS doubled_min
FROM t1
GROUP BY category
ORDER BY category;

# HAVING clause with aggregate VDF
SELECT category, agg_vdf_ext.vdf_sum(val) AS total
FROM t1
GROUP BY category
HAVING agg_vdf_ext.vdf_sum(val) > 50
ORDER BY category;

# ORDER BY aggregate VDF
SELECT category, agg_vdf_ext.vdf_sum(val) AS total
FROM t1
GROUP BY category
ORDER BY agg_vdf_ext.vdf_sum(val) DESC;

# NULL handling: some NULLs in aggregated column
CREATE TABLE t_nulls (
  id INT PRIMARY KEY,
  val INT,
  category VARCHAR(20)
);

INSERT INTO t_nulls VALUES
  (1, 10, 'A'),
  (2, NULL, 'A'),
  (3, 30, 'A'),
  (4, NULL, 'B'),
  (5, NULL, 'B');

SELECT category,
  agg_vdf_ext.vdf_sum(val) AS total,
  agg_vdf_ext.vdf_count(val) AS cnt
FROM t_nulls
GROUP BY category
ORDER BY category;

# NULL handling: all NULLs in a group (vdf_sum returns NULL, vdf_count returns 0)
SELECT category, agg_vdf_ext.vdf_sum(val) AS total
FROM t_nulls
WHERE category = 'B'
GROUP BY category;

DROP TABLE t_nulls;

# Subquery with aggregate VDF
SELECT * FROM t1
WHERE val > (SELECT agg_vdf_ext.vdf_sum(val) / 5 FROM t1)
ORDER BY id;

# Window function with aggregate VDF (not supported for UDF aggregates)
--error ER_PARSE_ERROR
SELECT id, val, category,
  agg_vdf_ext.vdf_sum(val) OVER (PARTITION BY category) AS category_total
FROM t1
ORDER BY id;

# Unqualified aggregate VDF call
SELECT category, vdf_sum(val) AS total
FROM t1
GROUP BY category
ORDER BY category;

# vdf_concat: string aggregate with GROUP BY
SELECT category, agg_vdf_ext.vdf_concat(category) AS names
FROM t1
GROUP BY category
ORDER BY category;

# vdf_concat: whole-table
SELECT agg_vdf_ext.vdf_concat(category) AS all_cats FROM t1;

# vdf_concat: empty table
CREATE TABLE t_empty_str (id INT PRIMARY KEY, name VARCHAR(20));
SELECT agg_vdf_ext.vdf_concat(name) AS result FROM t_empty_str;
DROP TABLE t_empty_str;

# A STRING-returning aggregate VDF must report a utf8mb4 charset, not binary.
# Otherwise the mysql client treats the result as binary and displays it as
# hex (0x...). The scalar VDF STRING path already sets utf8mb4_bin; this
# verifies the aggregate path does too.
SELECT CHARSET(agg_vdf_ext.vdf_concat(category)) AS concat_charset FROM t1;
SELECT COLLATION(agg_vdf_ext.vdf_concat(category)) AS concat_collation FROM t1;

# vdf_max: raw ABI aggregate with GROUP BY
SELECT category, agg_vdf_ext.vdf_max(val) AS max_val
FROM t1
GROUP BY category
ORDER BY category;

# vdf_max: whole-table
SELECT agg_vdf_ext.vdf_max(val) AS max_val FROM t1;

# vdf_max with NULLs
CREATE TABLE t_nulls2 (id INT PRIMARY KEY, val INT, category VARCHAR(20));
INSERT INTO t_nulls2 VALUES (1, 10, 'A'), (2, NULL, 'A'), (3, NULL, 'B');
SELECT category, agg_vdf_ext.vdf_max(val) AS max_val
FROM t_nulls2
GROUP BY category
ORDER BY category;
DROP TABLE t_nulls2;

# All four aggregates in one query
SELECT category,
  agg_vdf_ext.vdf_sum(val) AS total,
  agg_vdf_ext.vdf_count(val) AS cnt,
  agg_vdf_ext.vdf_max(val) AS max_val,
  agg_vdf_ext.vdf_concat(category) AS cats
FROM t1
GROUP BY category
ORDER BY category;

# Regression test for #1317: IS NULL must be true on an aggregate VDF that
# returns NULL. Item_sum::is_null() reads the cached null_value without
# evaluating the item, and the UDF aggregate path never set it, so IS NULL
# answered 0 while the value itself printed as NULL. IFNULL, COALESCE and
# <=> NULL evaluate the item and were always right -- they are included here
# so a regression shows up as a disagreement between the columns.

# Empty table: no row is ever accumulated, so the result is NULL.
CREATE TABLE t_empty (id INT PRIMARY KEY, val INT, name VARCHAR(20));
SELECT vdf_sum(val) AS v,
       vdf_sum(val) IS NULL AS is_null,
       vdf_sum(val) IS NOT NULL AS is_not_null,
       vdf_sum(val) <=> NULL AS null_safe_eq,
       IFNULL(vdf_sum(val), -1) AS ifnull_v,
       COALESCE(vdf_sum(val), -1) AS coalesce_v
FROM t_empty;

# The STRING and raw-ABI aggregates return NULL over the same empty table.
SELECT vdf_concat(name) IS NULL AS concat_is_null,
       vdf_max(val) IS NULL AS max_is_null
FROM t_empty;
DROP TABLE t_empty;

# A group whose values are all NULL: accumulate runs but contributes nothing.
CREATE TABLE t_allnull (id INT PRIMARY KEY, val INT, category VARCHAR(20));
INSERT INTO t_allnull VALUES (1, NULL, 'A'), (2, NULL, 'A'), (3, 30, 'B');
SELECT category,
       vdf_sum(val) AS v,
       vdf_sum(val) IS NULL AS is_null,
       vdf_max(val) IS NULL AS max_is_null
FROM t_allnull
GROUP BY category
ORDER BY category;

# HAVING ... IS NULL must keep the all-NULL group and drop the other.
SELECT category, vdf_sum(val) AS v
FROM t_allnull
GROUP BY category
HAVING vdf_sum(val) IS NULL
ORDER BY category;

# ... and HAVING ... IS NOT NULL the reverse.
SELECT category, vdf_sum(val) AS v
FROM t_allnull
GROUP BY category
HAVING vdf_sum(val) IS NOT NULL
ORDER BY category;
DROP TABLE t_allnull;

# Cleanup
DROP TABLE t1;

UNINSTALL EXTENSION agg_vdf_ext;

--source include/villagesql/binlog_check_end.inc
