# Regression test for #1338: an encode VDF's non-VALUE results were collapsed
# into one undifferentiated failure, and its message was lost.
#
# Uses the vsql_test_only FAULT_BLOB type, whose encode is steered by a
# sentinel in the input string:
#
#   "ENCODE_NULL"  - encode calls out.set_null()
#   "ENCODE_WARN"  - encode calls out.warning("fault_blob: encode warning ...")
#   "ENCODE_ERROR" - encode calls out.error("fault_blob: encode error ...")
#
# set_null() stores SQL NULL. error() aborts the statement carrying the
# extension's own message. warning() is still treated as a bad value, because
# the SDK pre-sets that result before calling a from_string and so a
# deliberate out.warning() cannot be told apart from an extension that
# early-returned on a parse failure.
#
# Before the fix all three gave ER_TRUNCATED_WRONG_VALUE_FOR_FIELD (1366) in
# strict mode and a message-less warning under INSERT IGNORE, never NULL.

INSTALL EXTENSION vsql_test_only;

call mtr.add_suppression("VillageSQL.*Invalid value in column.*FAULT_BLOB");

CREATE TABLE t1 (
  id INT PRIMARY KEY,
  val vsql_test_only.FAULT_BLOB
);

# The session is strict by default; the non-strict half is exercised below.
SELECT @@session.sql_mode LIKE '%STRICT_TRANS_TABLES%' AS is_strict;

# The column is nullable, so set_null() stores SQL NULL rather than failing.
INSERT INTO t1 VALUES (1, 'ENCODE_NULL');
SELECT id, val, val IS NULL AS is_null FROM t1 WHERE id = 1;

--error ER_TRUNCATED_WRONG_VALUE_FOR_FIELD
INSERT INTO t1 VALUES (2, 'ENCODE_WARN');
SHOW WARNINGS;

--error ER_VILLAGESQL_GENERIC_ERROR
INSERT INTO t1 VALUES (3, 'ENCODE_ERROR');
SHOW WARNINGS;

# Under IGNORE a bad value warns instead of failing the statement, but an
# encode error still aborts: it is the extension's way of saying that
# continuing is unsafe, and the scalar VDF path does not consult IGNORE either.
INSERT IGNORE INTO t1 VALUES (4, 'ENCODE_NULL');
SHOW WARNINGS;
INSERT IGNORE INTO t1 VALUES (5, 'ENCODE_WARN');
SHOW WARNINGS;
--error ER_VILLAGESQL_GENERIC_ERROR
INSERT IGNORE INTO t1 VALUES (6, 'ENCODE_ERROR');
SHOW WARNINGS;

SELECT id, val, val IS NULL AS is_null FROM t1 ORDER BY id;

# Only the bad-value case depends on strictness.
SET @@session.sql_mode = '';
INSERT INTO t1 VALUES (7, 'ENCODE_NULL');
SHOW WARNINGS;
INSERT INTO t1 VALUES (8, 'ENCODE_WARN');
SHOW WARNINGS;
--error ER_VILLAGESQL_GENERIC_ERROR
INSERT INTO t1 VALUES (9, 'ENCODE_ERROR');
SHOW WARNINGS;
SELECT id, val, val IS NULL AS is_null FROM t1 WHERE id >= 7 ORDER BY id;
SET @@session.sql_mode = DEFAULT;

# UPDATE reaches the encode through a different caller.
INSERT INTO t1 VALUES (10, 'OK ten');
UPDATE t1 SET val = 'ENCODE_NULL' WHERE id = 10;
SELECT id, val, val IS NULL AS is_null FROM t1 WHERE id = 10;

# A NOT NULL column rejects set_null() as it would an explicit NULL.
CREATE TABLE t2 (
  id INT PRIMARY KEY,
  val vsql_test_only.FAULT_BLOB NOT NULL
);
--error ER_BAD_NULL_ERROR
INSERT INTO t2 VALUES (1, 'ENCODE_NULL');
SELECT COUNT(*) AS rows_in_t2 FROM t2;

DROP TABLE t1;
DROP TABLE t2;
UNINSTALL EXTENSION vsql_test_only;
