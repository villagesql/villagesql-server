# A VDF with prerun state, used in a generated column or a CHECK constraint.
# The expression is resolved once, when the table is opened, and reused by
# every statement on the table. Each statement must still see the prerun
# state: state_probe(x) returns x when the state is there (i.e. not nullptr)
# and -1 when not.

--let $veb_dir = $MYSQLTEST_VARDIR/veb
--exec mkdir -p $veb_dir
--replace_result $MYSQLTEST_VARDIR MYSQLTEST_VARDIR
--let $restart_parameters = restart: --veb-dir=$veb_dir
--source include/restart_mysqld.inc

--let $extension_name = test_gcol_state
--let $extension_version = 1.0.0
--let $extension_source = $MYSQL_TEST_DIR/suite/villagesql/std_data/vdf_gcol_prerun_state.cc
--source include/villagesql/create_extension_sdk.inc

INSTALL EXTENSION test_gcol_state;

--echo # Outside a table, every statement gets its own prerun
SELECT test_gcol_state.state_probe(7) AS v;
SELECT test_gcol_state.state_probe(8) AS v;

--echo # STORED generated column, one INSERT per statement
CREATE TABLE ts (id INT PRIMARY KEY, a INT,
                 g INT AS (test_gcol_state.state_probe(a)) STORED);
INSERT INTO ts (id, a) VALUES (1, 10);
INSERT INTO ts (id, a) VALUES (2, 20);
INSERT INTO ts (id, a) VALUES (3, 30);
UPDATE ts SET a = 40 WHERE id = 3;
SELECT id, a, g FROM ts ORDER BY id;

--echo # VIRTUAL generated column, read by several statements
CREATE TABLE tv (id INT PRIMARY KEY, a INT,
                 g INT AS (test_gcol_state.state_probe(a)) VIRTUAL);
INSERT INTO tv (id, a) VALUES (1, 10), (2, 20);
SELECT id, a, g FROM tv ORDER BY id;
SELECT id, a, g FROM tv ORDER BY id;

--echo # CHECK constraint, one INSERT per statement
CREATE TABLE tc (id INT PRIMARY KEY, a INT,
                 CHECK (test_gcol_state.state_probe(a) >= 0));
INSERT INTO tc VALUES (1, 10);
INSERT INTO tc VALUES (2, 20);
INSERT INTO tc VALUES (3, 30);
SELECT id, a FROM tc ORDER BY id;

--echo # A statement in a stored procedure is also reused by every CALL
CREATE PROCEDURE p() SELECT test_gcol_state.state_probe(5) AS v;
CALL p();
CALL p();
DROP PROCEDURE p;

SELECT test_gcol_state.prerun_count() AS prerun,
       test_gcol_state.postrun_count() AS postrun;

DROP TABLE ts, tv, tc;
UNINSTALL EXTENSION test_gcol_state;
