# Test that INSTALL EXTENSION fails when the .so does not export the required
# VEF entry point functions (vef_register and vef_unregister).

--echo # Test Missing VEF Entry Points

--let $veb_dir = $MYSQLTEST_VARDIR/veb
--exec mkdir -p $veb_dir

call mtr.add_suppression("Orphaned expansion directory found but not removed");
call mtr.add_suppression("Failed to load VEF extension");
--replace_result $MYSQLTEST_VARDIR MYSQLTEST_VARDIR
--let $restart_parameters = restart: --veb-dir=$veb_dir
--source include/restart_mysqld.inc

# Build a VEB whose .so exports no VEF symbols
--let $extension_name = no_entry_points
--let $extension_version = 1.0.0
--let $extension_source = $MYSQL_TEST_DIR/suite/villagesql/std_data/no_entry_points_extension.cc
--source include/villagesql/create_extension_sdk.inc

--echo # Attempt to install (should fail: vef_register not found)
--replace_regex /: error [0-9]+ .+//
--error ER_VILLAGESQL_GENERIC_ERROR
INSTALL EXTENSION no_entry_points;

--echo # Verify extension was NOT installed
SELECT * FROM INFORMATION_SCHEMA.EXTENSIONS;

