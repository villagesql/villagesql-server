# Test that only deterministic VDFs are allowed in CHECK constraints.
# Deterministic VDFs (declared with .deterministic() in the SDK) are permitted.
# Non-deterministic VDFs are rejected with ER_CHECK_CONSTRAINT_NAMED_FUNCTION_IS_NOT_ALLOWED.

--let $veb_dir = $MYSQLTEST_VARDIR/veb
--exec mkdir -p $veb_dir

call mtr.add_suppression("Orphaned expansion directory found but not removed");
--replace_result $MYSQLTEST_VARDIR MYSQLTEST_VARDIR
--let $restart_parameters = restart: --veb-dir=$veb_dir
--source include/restart_mysqld.inc

--let $extension_name = vdf_determinism_test
--let $extension_version = 1.0.0
--let $extension_source = $MYSQL_TEST_DIR/suite/villagesql/std_data/determinism_funcs.cc
--source include/villagesql/create_extension_sdk.inc

INSTALL EXTENSION vdf_determinism_test;

--echo # Deterministic VDF is allowed in a CHECK constraint
CREATE TABLE t1 (id INT PRIMARY KEY, val INT, CHECK (vdf_determinism_test.deterministic_inc(val) > 0));
DROP TABLE t1;

--echo # Non-deterministic VDF is rejected in a CHECK constraint
--error ER_CHECK_CONSTRAINT_NAMED_FUNCTION_IS_NOT_ALLOWED
CREATE TABLE t1 (id INT PRIMARY KEY, val INT, CHECK (vdf_determinism_test.nondeterministic_func(val) > 0));

UNINSTALL EXTENSION vdf_determinism_test;
