# Test encode and decode failure behavior for custom types.
#
# Uses the vsql_test_only extension's FAULT_BLOB type, whose behavior is
# controlled by a sentinel prefix in the input string:
#
#   "OK <payload>"  - encodes and decodes successfully
#   "DECODE_FAIL"   - encodes successfully but decode fails on read
#   "DECODE_THROW"  - encodes successfully but decode fails on read
#   "ENCODE_FAIL"   - encode fails immediately, value is never stored
#   "ENCODE_THROW"  - encode fails immediately, value is never stored
#   "HASH_THROW"    - GROUP BY causes throw, currently only logged
#   "COMPARE_THROW" - ORDER BY causes throw, currently only logged
#
# Test coverage:
#   1. Normal INSERT/SELECT round-trip with "OK" values.
#   2. "DECODE_FAIL" rows: SELECT returns an error and logs the failure.
#   3. "DECODE_THROW" rows: SELECT returns an error and logs the failure.
#   4. Mixing healthy and decode-failing rows in the same query: error on the bad row.
#   5. UPDATE overwriting a DECODE_FAIL row with a good value: row becomes readable.
#   6. UPDATE overwriting a DECODE_THROW row with a good value: row becomes readable.
#   7. Test GROUP BY before and after adding HASH_THROW row
#   8. Test ORDER BY before and after adding COMPARE_THROW row
#   9. UPDATE overwriting a good row with DECODE_FAIL: value is stored, SELECT returns error.
#  10. "ENCODE_FAIL": INSERT is rejected with an error.
#  11. "ENCODE_THROW": INSERT is rejected with an error.

INSTALL EXTENSION vsql_test_only;

call mtr.add_suppression("VillageSQL.*Invalid value in column.*FAULT_BLOB");
call mtr.add_suppression("VillageSQL.*Extension error decoding column.*FAULT_BLOB");
call mtr.add_suppression("VillageSQL.*VDF threw an exception.*throw");

--echo # Verify extension is installed
SELECT extension_name, extension_version FROM INFORMATION_SCHEMA.EXTENSIONS;

--echo # Create a table with a FAULT_BLOB column
CREATE TABLE t1 (
  id INT PRIMARY KEY,
  val vsql_test_only.FAULT_BLOB
);

--echo # Insert healthy values
INSERT INTO t1 VALUES (1, 'OK hello');
INSERT INTO t1 VALUES (2, 'OK world');
INSERT INTO t1 VALUES (3, 'OK abc');

--echo # Normal SELECT round-trip: decode succeeds, values are readable
SELECT id, val FROM t1 ORDER BY id;

--echo # Insert a value that will fail on decode
INSERT INTO t1 VALUES (4, 'DECODE_FAIL');

--echo # Insert a value that will throw on decode
INSERT INTO t1 VALUES (5, 'DECODE_THROW');

# Record log file position before first decode failure.
--source include/villagesql/decode_failure_log_init.inc

--echo # SELECT the decode-failing row alone: returns an error
--error ER_VILLAGESQL_GENERIC_ERROR
SELECT id, val FROM t1 WHERE id = 4;

--echo # Verify the failure was logged
--source include/villagesql/decode_failure_log_print.inc

--echo # SELECT the decode-throw row alone: returns an error
--error ER_VILLAGESQL_GENERIC_ERROR
SELECT id, val FROM t1 WHERE id = 5;

--echo # Verify the failure was logged
--replace_result fault_blob_decode "fault blob decode"
--source include/villagesql/decode_failure_log_print.inc

--echo # UPDATE: overwrite the DECODE_THROW row with a good value
UPDATE t1 SET val = 'OK fixed' WHERE id = 5;

--echo # SELECT all rows: healthy rows decode fine, DECODE_FAIL row causes an error
--error ER_VILLAGESQL_GENERIC_ERROR
SELECT id, val FROM t1 ORDER BY id;

--echo # Verify the failure was logged
--source include/villagesql/decode_failure_log_print.inc

--echo # UPDATE: overwrite the DECODE_FAIL row with a good value
UPDATE t1 SET val = 'OK fixed' WHERE id = 4;

--echo # The previously-failing row should now decode successfully
SELECT id, val FROM t1 ORDER BY id;

--echo # First show weird hash function works
SELECT sum(id), val FROM t1 GROUP BY val ORDER BY val;

--echo # Second insert throw row and retest
INSERT INTO t1 VALUES (6, 'HASH_THROW');
SELECT sum(id), val FROM t1 GROUP BY val ORDER BY val;

--echo # Verify the failure was logged (two ERRORs)
--replace_result fault_blob_hash "fault blob hash"
--source include/villagesql/decode_failure_log_print.inc

--echo # Insert a value that will throw on compare
INSERT INTO t1 VALUES (7, 'COMPARE_THROW');

# TODO(villagesql-general): no error reported to client
SELECT id, val FROM t1 ORDER BY val;

# TODO(villagesql-general): three log lines written, need test
--replace_result fault_blob_compare "fault blob compare"
--source include/villagesql/decode_failure_log_print.inc

--echo # UPDATE: overwrite a good row with a DECODE_FAIL value
UPDATE t1 SET val = 'DECODE_FAIL' WHERE id = 1;

--echo # The updated row now causes an error on SELECT
--error ER_VILLAGESQL_GENERIC_ERROR
SELECT id, val FROM t1 ORDER BY id;

--echo # Verify the failure was logged
--source include/villagesql/decode_failure_log_print.inc

--echo # Clean up
DROP TABLE t1;

--echo # ENCODE_FAIL: INSERT is rejected with an error, nothing is stored
CREATE TABLE t2 (
  id INT PRIMARY KEY,
  val vsql_test_only.FAULT_BLOB
);

INSERT INTO t2 VALUES (1, 'OK good');
--error ER_TRUNCATED_WRONG_VALUE_FOR_FIELD
INSERT INTO t2 VALUES (2, 'ENCODE_FAIL');

--echo # Only the successful row was stored
SELECT id, val FROM t2 ORDER BY id;

--replace_result fault_blob_encode "fault blob encode"
--error 3219
INSERT INTO t2 VALUES (3, 'ENCODE_THROW');

DROP TABLE t2;

--remove_file $MYSQLTEST_VARDIR/tmp/decode_fail_log_pos.txt
UNINSTALL EXTENSION vsql_test_only;

--echo # Verify extension was removed
SELECT extension_name, extension_version FROM INFORMATION_SCHEMA.EXTENSIONS;
