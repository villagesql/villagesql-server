# A REAL-returning VDF keeps its fraction whatever the arguments are.
#
# A VDF that declares REAL produces a plain DOUBLE: the result scale comes from
# the declared return type, not from the arguments. An INT argument, or no
# argument at all, carries no scale of its own, so these are the cases where an
# argument-derived scale would round the fraction away.

INSTALL EXTENSION vsql_test_only;

--echo # Scalar VDF over an INT argument: the fraction survives
SELECT vsql_test_only.real_sqrt(2) AS v;
SELECT vsql_test_only.real_sqrt(2) > 1.4 AS gt;
SELECT vsql_test_only.real_sqrt(2) * 1000 AS scaled;

--echo # Scalar VDF with no arguments at all
SELECT vsql_test_only.real_half_pi() AS v;

--echo # The declared result type is DOUBLE, not DOUBLE(22,0)
CREATE TABLE t1 AS SELECT vsql_test_only.real_sqrt(2) AS a,
                          vsql_test_only.real_half_pi() AS b;
SHOW CREATE TABLE t1;
SELECT * FROM t1;
DROP TABLE t1;

--echo # A REAL argument
SELECT vsql_test_only.real_sqrt(CAST(2 AS DOUBLE)) AS v;

--echo # NULL in, NULL out
SELECT vsql_test_only.real_sqrt(NULL) AS v;

--echo # Aggregate VDF over an INT column keeps its fraction too
CREATE TABLE t2 (g INT, n INT);
INSERT INTO t2 VALUES (1,1),(1,2),(2,10),(2,11),(2,12);
SELECT vsql_test_only.real_avg(n) AS v FROM t2;
SELECT g, vsql_test_only.real_avg(n) AS v FROM t2 GROUP BY g ORDER BY g;

--echo # The aggregate's declared result type is DOUBLE as well
CREATE TABLE t3 AS SELECT vsql_test_only.real_avg(n) AS a FROM t2;
SHOW CREATE TABLE t3;
SELECT * FROM t3;
DROP TABLE t3;
DROP TABLE t2;

UNINSTALL EXTENSION vsql_test_only;
