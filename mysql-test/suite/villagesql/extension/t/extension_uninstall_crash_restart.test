# The server must restart after it is killed inside UNINSTALL EXTENSION, after
# the villagesql.extensions row is deleted and before the delete commits.
#
# Startup reads villagesql.extensions in VictionaryClient::init(), which runs
# before ha_post_recover() rolls back the transactions recovered from the
# redo log. The read must not wait on the killed UNINSTALL's row lock, and
# must see the row the rollback restores.
#
# UNINSTALL EXTENSION parks at uninstall_extension_before_commit. A committed
# write from another connection then flushes the redo log, which includes
# the parked transaction's changes, and the server is killed. The restart
# uses a short innodb_lock_wait_timeout so a waiting read fails quickly.
#
# Expected: the server restarts, the extension is still installed and its
# types and VDFs work, and it can be uninstalled.

--source include/have_debug_sync.inc
--source include/not_valgrind.inc

--let $veb_dir = `SELECT @@veb_dir`
CREATE TABLE t1 (a INT);
INSTALL EXTENSION vsql_simple;

connect (con_uninstall,localhost,root,,);
--echo # con_uninstall: park UNINSTALL EXTENSION after it deletes its row
SET DEBUG_SYNC = 'uninstall_extension_before_commit SIGNAL deleted WAIT_FOR never';
--send UNINSTALL EXTENSION vsql_simple

connection default;
SET DEBUG_SYNC = 'now WAIT_FOR deleted';

--echo # Commit a write so the redo log reaches disk, then kill the server
INSERT INTO t1 VALUES (1);
--source include/kill_mysqld.inc

connection con_uninstall;
--error CR_SERVER_LOST
--reap
disconnect con_uninstall;

connection default;
--echo # Restart
--replace_result $MYSQLTEST_VARDIR MYSQLTEST_VARDIR
--let $restart_parameters = restart: --veb-dir=$veb_dir --innodb-lock-wait-timeout=5
--source include/start_mysqld.inc

--echo # The interrupted uninstall was rolled back
SELECT extension_name FROM INFORMATION_SCHEMA.EXTENSIONS
WHERE extension_name = 'vsql_simple';

--echo # The extension's types and VDFs work
CREATE TABLE t2 (id INT PRIMARY KEY, data BYTEARRAY);
INSERT INTO t2 VALUES (1, 'hello');
SELECT id, CONCAT("'", vsql_simple.bytearray::to_string(vsql_simple.rot13(data)), "'") AS rotated FROM t2;
DROP TABLE t2;

--echo # The extension can be uninstalled
UNINSTALL EXTENSION vsql_simple;
SELECT extension_name FROM INFORMATION_SCHEMA.EXTENSIONS
WHERE extension_name = 'vsql_simple';

DROP TABLE t1;
