# This test installs extensions with the same type COMPLEX and shows
# that only the methods of the specified type are listed.

INSTALL EXTENSION vsql_complex;
INSTALL EXTENSION vsql_type_test;

--echo # Test 1: Error — unknown method name
--error ER_VILLAGESQL_GENERIC_ERROR
SELECT vsql_complex.COMPLEX::nonexistent('(1,2)') AS result;

--error ER_VILLAGESQL_GENERIC_ERROR
SELECT COMPLEX::nonexistent('(1,2)') AS result;

--echo # Test 2: Mixed-case method lookup, qualified and unqualified
SELECT vsql_complex.COMPLEX::Magnitude(vsql_complex.COMPLEX::from_string('(3,4)')) AS result;
SELECT vsql_complex.COMPLEX::magnitude(vsql_complex.COMPLEX::from_string('(3,4)')) AS result;
SELECT COMPLEX::Magnitude(vsql_complex.COMPLEX::from_string('(3,4)')) AS result;
SELECT COMPLEX::magnitude(vsql_complex.COMPLEX::from_string('(3,4)')) AS result;

UNINSTALL EXTENSION vsql_complex;
UNINSTALL EXTENSION vsql_type_test;
