INSTALL EXTENSION vsql_mysql_services_session_test;

connect (no_schema, localhost, root,, *NO-ONE*);
--error ER_CANT_INITIALIZE_UDF
SELECT vsql_mysql_services_session_test.session_schema();
SELECT vsql_mysql_services_session_test.session_priv_user() AS user_without_schema;
disconnect no_schema;
--source include/wait_until_disconnected.inc
connection default;

SELECT vsql_mysql_services_session_test.session_schema() AS session_schema,
       DATABASE() AS db,
       vsql_mysql_services_session_test.session_priv_user() AS session_priv_user,
       CURRENT_USER() AS current_user_;

SELECT vsql_mysql_services_session_test.session_priv_user() AS per_row
  FROM (VALUES ROW(1), ROW(2), ROW(3)) AS t;

CREATE DATABASE db2;
USE db2;
SELECT vsql_mysql_services_session_test.session_schema() AS after_use;
USE test;

PREPARE stmt FROM 'SELECT vsql_mysql_services_session_test.session_schema() AS ps_schema';
EXECUTE stmt;
USE db2;
EXECUTE stmt;
USE test;
DEALLOCATE PREPARE stmt;

CREATE USER definer_u@localhost, caller_u@localhost;
GRANT EXECUTE ON test.* TO definer_u@localhost, caller_u@localhost;
GRANT SELECT ON db2.* TO caller_u@localhost;

CREATE DEFINER = definer_u@localhost FUNCTION test.definer_user()
  RETURNS VARCHAR(300) READS SQL DATA SQL SECURITY DEFINER
  RETURN vsql_mysql_services_session_test.session_priv_user();
CREATE DEFINER = definer_u@localhost FUNCTION test.invoker_user()
  RETURNS VARCHAR(300) READS SQL DATA SQL SECURITY INVOKER
  RETURN vsql_mysql_services_session_test.session_priv_user();
CREATE DEFINER = definer_u@localhost FUNCTION test.routine_schema()
  RETURNS VARCHAR(300) READS SQL DATA SQL SECURITY DEFINER
  RETURN vsql_mysql_services_session_test.session_schema();

connect (caller, localhost, caller_u,, test);
SELECT test.definer_user() AS definer_call, test.invoker_user() AS invoker_call;
SELECT test.definer_user() AS definer_second_call;
USE db2;
SELECT test.routine_schema() AS routine_schema,
       vsql_mysql_services_session_test.session_schema() AS caller_schema;
disconnect caller;
--source include/wait_until_disconnected.inc
connection default;

DROP FUNCTION test.definer_user;
DROP FUNCTION test.invoker_user;
DROP FUNCTION test.routine_schema;
DROP USER definer_u@localhost, caller_u@localhost;
DROP DATABASE db2;

UNINSTALL EXTENSION vsql_mysql_services_session_test;
