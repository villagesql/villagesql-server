# con1: Create temporary table with COMPLEX type
CREATE TEMPORARY TABLE t1 (id INT PRIMARY KEY, val COMPLEX);
INSERT INTO t1 VALUES (1, '(3.0,4.0)');
# con2: Create temporary table with same name and column but TVECTOR type
CREATE TEMPORARY TABLE t1 (id INT PRIMARY KEY, val TVECTOR(2));
INSERT INTO t1 VALUES (1, '[1.0, 2.0]');
# con2: Reads its own TVECTOR values
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TEMPORARY TABLE `t1` (
  `id` int NOT NULL,
  `val` vsql_tvector.TVECTOR DEFAULT NULL,
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
SELECT id, val FROM t1;
id	val
1	[1,2]
# con1: Reads its own COMPLEX values
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TEMPORARY TABLE `t1` (
  `id` int NOT NULL,
  `val` vsql_complex.COMPLEX DEFAULT NULL,
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
SELECT id, val FROM t1;
id	val
1	(3,4)
# con1: Drop temporary table
DROP TEMPORARY TABLE t1;
# con2: Drop temporary table
DROP TEMPORARY TABLE t1;
