# Custom types are only supported with InnoDB. A temporary table is no
# exception, even though its custom columns are never recorded in the
# victionary.
--source include/villagesql/install_complex_extension.inc

--echo #
--echo # CREATE TEMPORARY TABLE with an explicit non-InnoDB engine.
--echo #
--error ER_VILLAGESQL_GENERIC_ERROR
CREATE TEMPORARY TABLE t1 (id INT PRIMARY KEY, c COMPLEX) ENGINE=MEMORY;

--error ER_NO_SUCH_TABLE
SHOW CREATE TABLE t1;

--error ER_VILLAGESQL_GENERIC_ERROR
CREATE TEMPORARY TABLE t1 (id INT PRIMARY KEY, c COMPLEX) ENGINE=MyISAM;

--error ER_NO_SUCH_TABLE
SHOW CREATE TABLE t1;

--echo #
--echo # CREATE TEMPORARY TABLE ... SELECT.
--echo #
CREATE TABLE p (id INT PRIMARY KEY, c COMPLEX) ENGINE=InnoDB;
INSERT INTO p VALUES (1, '(3,4)');

--error ER_VILLAGESQL_GENERIC_ERROR
CREATE TEMPORARY TABLE t1 ENGINE=MEMORY AS SELECT * FROM p;

--error ER_NO_SUCH_TABLE
SHOW CREATE TABLE t1;

--echo #
--echo # default_tmp_storage_engine is honored the same way. CREATE TEMPORARY
--echo # TABLE ... LIKE inherits the source table's engine instead, it is
--echo # allowed (source table has to be INNODB engine if it contains custom
--echo # types).
--echo #
SET SESSION default_tmp_storage_engine = MEMORY;

--error ER_VILLAGESQL_GENERIC_ERROR
CREATE TEMPORARY TABLE t1 (id INT PRIMARY KEY, c COMPLEX);

CREATE TEMPORARY TABLE t1 LIKE p;
SHOW CREATE TABLE t1;
DROP TEMPORARY TABLE t1;

SET SESSION default_tmp_storage_engine = DEFAULT;

--echo #
--echo # InnoDB temporary tables still work.
--echo #
CREATE TEMPORARY TABLE t1 (id INT PRIMARY KEY, c COMPLEX) ENGINE=InnoDB;
INSERT INTO t1 VALUES (1, '(3,4)');
SELECT id, c, complex_abs(c) FROM t1;

--echo #
--echo # ALTER TABLE cannot move a temporary table off InnoDB.
--echo #
--error ER_VILLAGESQL_GENERIC_ERROR
ALTER TABLE t1 ENGINE=MEMORY;

--error ER_VILLAGESQL_GENERIC_ERROR
ALTER TABLE t1 ENGINE=MyISAM;

SELECT id, c, complex_abs(c) FROM t1;

--echo #
--echo # ALTER TABLE cannot add a custom column to a non-InnoDB temporary table.
--echo #
CREATE TEMPORARY TABLE t2 (id INT PRIMARY KEY) ENGINE=MEMORY;

--error ER_VILLAGESQL_GENERIC_ERROR
ALTER TABLE t2 ADD COLUMN c COMPLEX;

SHOW CREATE TABLE t2;

--echo #
--echo # An ALTER that keeps the temporary table on InnoDB is unaffected.
--echo #
ALTER TABLE t1 ADD COLUMN d COMPLEX;
ALTER TABLE t1 ENGINE=InnoDB;
SELECT id, c, d FROM t1;

DROP TEMPORARY TABLE t1, t2;
DROP TABLE p;

--source include/villagesql/uninstall_complex_extension.inc
