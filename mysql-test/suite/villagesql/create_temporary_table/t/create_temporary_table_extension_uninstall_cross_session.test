# Test that uninstalling an extension is blocked while a session holds a
# temporary table that uses a type from that extension, and succeeds once
# the temporary table is dropped.

--source include/villagesql/install_complex_extension.inc
--source include/count_sessions.inc

--echo #
--echo # Test Case 1: UNINSTALL blocked while another session has a temp table
--echo #

connect (con1,localhost,root);
--echo # con1: Create temporary table using COMPLEX type
CREATE TEMPORARY TABLE t1 (id INT PRIMARY KEY, val COMPLEX);
INSERT INTO t1 VALUES (1, '(3.0,4.0)');
SELECT * FROM t1;

connection default;
--echo # default: UNINSTALL should fail - con1 holds a reference via temp table
--error ER_VILLAGESQL_GENERIC_ERROR
UNINSTALL EXTENSION vsql_complex;

--echo #
--echo # Test Case 2: UNINSTALL succeeds after temp table is dropped
--echo #

connection con1;
--echo # con1: Drop the temporary table, releasing the reference
DROP TEMPORARY TABLE t1;

disconnect con1;
connection default;
--source include/wait_until_count_sessions.inc

--echo # default: UNINSTALL should now succeed
--source include/villagesql/uninstall_complex_extension.inc
