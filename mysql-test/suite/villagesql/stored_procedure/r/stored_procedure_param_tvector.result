CREATE TABLE t (id INT PRIMARY KEY, v TVECTOR(3));
INSERT INTO t VALUES (1, '[1,2,3]'), (2, '[4,5,6]');
CREATE FUNCTION f(x TVECTOR(3)) RETURNS TVECTOR(3) DETERMINISTIC
BEGIN
RETURN x;
END//
CREATE PROCEDURE p(IN x TVECTOR(3))
BEGIN
SELECT x;
END//
CREATE PROCEDURE p_local()
BEGIN
DECLARE y TVECTOR(3) DEFAULT '[7,8,9]';
SELECT y;
END//
# The function
SELECT id, f(v) FROM t ORDER BY id;
id	f(v)
1	[1,2,3]
2	[4,5,6]
SELECT id FROM t WHERE f(v) = v ORDER BY id;
id
1
2
# The function result stored into a column
CREATE TABLE t3 (id INT PRIMARY KEY, v TVECTOR(3));
INSERT INTO t3 SELECT id, f(v) FROM t;
SELECT id, v FROM t3 ORDER BY id;
id	v
1	[1,2,3]
2	[4,5,6]
CREATE TABLE t4 (id INT PRIMARY KEY, v TVECTOR(4));
INSERT INTO t4 SELECT id, f(v) FROM t;
ERROR HY000: Incorrect TVECTOR value: cannot implicitly cast string expression. Use explicit conversion for column 'v' at row 1
# The procedure
CALL p((SELECT v FROM t WHERE id = 1));
x
[1,2,3]
# A local variable
CALL p_local();
y
[7,8,9]
# The stored definitions
SHOW CREATE FUNCTION f;
