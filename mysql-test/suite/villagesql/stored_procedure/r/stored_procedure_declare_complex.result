CREATE TABLE t1 (val COMPLEX);
CREATE PROCEDURE p1()
BEGIN
DECLARE v1 COMPLEX DEFAULT '(0.0,0.0)';
DECLARE v2 COMPLEX;
SET v2 = '(1.0,2.0)';
INSERT INTO t1 VALUES (v1);
INSERT INTO t1 VALUES (v2);
END//
CALL p1();
SELECT * FROM t1;
val
(0,0)
(1,2)
DROP PROCEDURE p1;
DROP TABLE t1;
