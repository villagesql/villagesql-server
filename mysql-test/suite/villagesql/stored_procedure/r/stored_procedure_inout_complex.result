CREATE PROCEDURE p1(INOUT val COMPLEX)
BEGIN
SET val = vsql_complex.complex_add(val, '(1.0,1.0)');
END//
SET @my_val = '(1.0,2.0)';
CALL p1(@my_val);
SELECT @my_val;
@my_val
(2,3)
SET @my_val = NULL;
DROP PROCEDURE p1;
