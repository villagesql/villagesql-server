CREATE PROCEDURE p1(IN x COMPLEX, OUT y COMPLEX)
BEGIN
SET y = x;
END//
CREATE FUNCTION f1(x COMPLEX) RETURNS COMPLEX DETERMINISTIC
BEGIN
RETURN x;
END//
# restart
CALL p1('(1.0,2.0)', @out);
SELECT @out;
@out
(1,2)
SELECT f1('(3.0,4.0)');
f1('(3.0,4.0)')
(3,4)
DROP PROCEDURE p1;
DROP FUNCTION f1;
SET @out = NULL;
