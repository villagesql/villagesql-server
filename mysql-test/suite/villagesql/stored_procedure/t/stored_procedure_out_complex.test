# Test Stored Procedure with OUT parameter of COMPLEX type
# Grammar: CREATE PROCEDURE ... (OUT name COMPLEX) ...

--source include/villagesql/install_complex_extension.inc
--source include/villagesql/binlog_check_begin.inc

delimiter //;
CREATE PROCEDURE p1(OUT output_val COMPLEX)
BEGIN
  SET output_val = '(3.0,4.0)';
END//
delimiter ;//

CALL p1(@res);
SELECT @res;

DROP PROCEDURE p1;

# Clear the user variable so the TypeContext ref is released before UNINSTALL.
SET @res = NULL;

--source include/villagesql/binlog_check_end.inc
--source include/villagesql/uninstall_complex_extension.inc
