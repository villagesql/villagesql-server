# ABI v5 Binary Compatibility Test
Found VillageSQL SDK paths
# Building test extension against stable v5 SDK
# Verify VEB was created
# Copy VEB to server's VEB directory
# Install the extension
INSTALL EXTENSION abi_v5_test;
# Verify extension is installed
SELECT extension_name, extension_version FROM INFORMATION_SCHEMA.EXTENSIONS
WHERE extension_name = 'abi_v5_test';
EXTENSION_NAME	EXTENSION_VERSION
abi_v5_test	0.0.1
# FAULT_BLOB type: encode/decode round-trip via type-method VDFs (v3)
# Round-trip via type-method syntax (v3: :: works for named VDF types)
SELECT abi_v5_test.FAULT_BLOB::to_string(
abi_v5_test.FAULT_BLOB::from_string('OK hello')) AS roundtrip;
roundtrip
OK hello
# test_result_kind VDF: exercises VEF_RESULT_WARNING vs VEF_RESULT_ERROR
# Normal result
SELECT abi_v5_test.test_result_kind('anything') AS result;
result
42
# WARNING result
SELECT abi_v5_test.test_result_kind('WARN something went sideways') AS result;
result
NULL
Warnings:
Warning	3200	VDF error in function 'test_result_kind': something went sideways
# ERROR result
SELECT abi_v5_test.test_result_kind('ERROR fatal problem') AS result;
ERROR HY000: VDF error in function 'test_result_kind': fatal problem
# NULL input -> NULL output (IntResult::set_null)
SELECT abi_v5_test.test_result_kind(NULL) AS result;
result
NULL
# real_double VDF: RealArg, RealResult, .deterministic()
# Doubles the input value
SELECT abi_v5_test.real_double(1.5) AS result;
result
3
# NULL input -> NULL output (RealResult::set_null)
SELECT abi_v5_test.real_double(NULL) AS result;
result
NULL
# answer VDF: zero-arity, .no_params()
SELECT abi_v5_test.answer() AS result;
result
42
# FAULT_BLOB::hash: TypeHashFunc via type builder .hash()
# Hash used implicitly by COUNT(DISTINCT) on a custom type column
CREATE TABLE t_hash (v FAULT_BLOB);
INSERT INTO t_hash VALUES ('OK a'), ('OK b'), ('OK a');
SELECT COUNT(DISTINCT v) AS distinct_count FROM t_hash;
distinct_count
2
DROP TABLE t_hash;
# PVEC type, int_sum_all varargs VDF, pvec_norm_sq aggregate VDF
# Varargs: sum any number of INT arguments
SELECT abi_v5_test.int_sum_all(1, 2, 3) AS total;
total
6
SELECT abi_v5_test.int_sum_all(10) AS total;
total
10
SELECT abi_v5_test.int_sum_all(1, 2, 3, 4, 5) AS total;
total
15
# Varargs prerun rejects zero arguments
SELECT abi_v5_test.int_sum_all();
ERROR HY000: Can't initialize function 'int_sum_all'; int_sum_all requires at least one argument
# Varargs prerun rejects non-INT arguments
SELECT abi_v5_test.int_sum_all(1.5);
ERROR HY000: Can't initialize function 'int_sum_all'; int_sum_all: argument 0 must be INT
# Parameterized type: PVEC(N) column stores N int16 elements
CREATE TABLE t1 (
id INT PRIMARY KEY,
v PVEC(3)
);
INSERT INTO t1 VALUES (1, '[1,2,3]'), (2, '[4,5,6]'), (3, '[-1,0,1]');
SELECT id, v FROM t1 ORDER BY id;
id	v
1	[1,2,3]
2	[4,5,6]
3	[-1,0,1]
# Aggregate: per-group sum of squared elements
SELECT id, abi_v5_test.pvec_norm_sq(v) AS norm_sq FROM t1
GROUP BY id ORDER BY id;
id	norm_sq
1	14
2	77
3	2
# Aggregate: whole table, (1+4+9) + (16+25+36) + (1+0+1) = 93
SELECT abi_v5_test.pvec_norm_sq(v) AS total_norm_sq FROM t1;
total_norm_sq
93
# Aggregate with HAVING: exclude groups with norm_sq <= 10
SELECT id, abi_v5_test.pvec_norm_sq(v) AS norm_sq
FROM t1
GROUP BY id
HAVING abi_v5_test.pvec_norm_sq(v) > 10
ORDER BY id;
id	norm_sq
1	14
2	77
# Aggregate ORDER BY descending
SELECT id, abi_v5_test.pvec_norm_sq(v) AS norm_sq
FROM t1
GROUP BY id
ORDER BY abi_v5_test.pvec_norm_sq(v) DESC;
id	norm_sq
2	77
1	14
3	2
# NULL handling: accumulate skips NULL rows, so only [3,4] adds 25
CREATE TABLE t_nulls (
id INT,
v PVEC(2)
);
INSERT INTO t_nulls VALUES (1, '[3,4]'), (2, NULL);
SELECT abi_v5_test.pvec_norm_sq(v) AS norm_sq FROM t_nulls;
norm_sq
25
DROP TABLE t1, t_nulls;
# Protocol 5 features
# on_init ran at INSTALL EXTENSION
SELECT abi_v5_test.did_init() AS result;
result
1
# BINARY argument and result
SELECT HEX(abi_v5_test.bin_echo(UNHEX('00FF10'))) AS result;
result
00FF10
SELECT abi_v5_test.bin_echo(NULL) IS NULL AS result;
result
1
# A STRING argument arrives as utf8mb4, converted from its charset
SELECT abi_v5_test.str_hex(_latin1 0xE9) AS result;
result
C3A9
# const_args: the prerun admits a NULL literal, but not every STRING
SELECT abi_v5_test.int_or_null_sum(1, NULL, 2) AS total;
total
3
SELECT abi_v5_test.int_or_null_sum(1, 'a');
ERROR HY000: Can't initialize function 'int_or_null_sum'; int_or_null_sum: argument 1 must be INT or NULL
# bind_and_check_types: the hook rejects a constant string argument
CREATE TABLE t_str (s VARCHAR(8));
INSERT INTO t_str VALUES ('column');
SELECT abi_v5_test.str_no_const(s) AS result FROM t_str;
result
column
SELECT abi_v5_test.str_no_const('literal');
ERROR HY000: Cannot initialize function 'str_no_const': constant argument
DROP TABLE t_str;
# A VDF that throws returns an error to the statement
SELECT abi_v5_test.throws();
ERROR HY000: VDF error in function 'throws': VDF threw an exception (boom)
# from_binary and to_binary
CREATE TABLE t_bytes (id INT PRIMARY KEY, v BYTES8);
INSERT INTO t_bytes VALUES (1, 'text'), (2, 0x41FF), (3, _binary 'bin');
SELECT id, HEX(abi_v5_test.BYTES8::to_binary(v)) AS bytes FROM t_bytes
ORDER BY id;
id	bytes
1	74657874
2	41FF
3	62696E
SELECT HEX(abi_v5_test.BYTES8::to_binary(
abi_v5_test.BYTES8::from_binary(0x0102))) AS roundtrip;
roundtrip
0102
INSERT INTO t_bytes VALUES (4, 'too long!');
ERROR HY000: BYTES8: value longer than 8 bytes
INSERT INTO t_bytes VALUES (5, 0x010203040506070809);
ERROR HY000: BYTES8: value longer than 8 bytes
DROP TABLE t_bytes;
# A type without from_binary rejects a value in the binary charset
CREATE TABLE t_blob (v FAULT_BLOB);
INSERT INTO t_blob VALUES (_binary 'OK binary');
ERROR HY000: Type 'abi_v5_test.FAULT_BLOB' has no binary form; pass the value as a character string
DROP TABLE t_blob;
# A variable-length type stores each value at its own length
CREATE TABLE t_var (id INT PRIMARY KEY, v VARTEXT);
INSERT INTO t_var VALUES (1, 'a'), (2, 'abcdefghij'), (3, 'abc');
SELECT id, v, abi_v5_test.vartext_len(v) AS len FROM t_var ORDER BY id;
id	v	len
1	a	1
2	abcdefghij	10
3	abc	3
INSERT INTO t_var VALUES (4, 'abcdefghijklmnopqrstuvwxyz0123456');
ERROR HY000: VARTEXT: value longer than 32 bytes
DROP TABLE t_var;
# Uninstall extension
UNINSTALL EXTENSION abi_v5_test;
# Verify extension was removed
SELECT extension_name FROM INFORMATION_SCHEMA.EXTENSIONS
WHERE extension_name = 'abi_v5_test';
EXTENSION_NAME
INSTALL EXTENSION abi_v5_test;
SELECT NEGOTIATED_PROTOCOL FROM INFORMATION_SCHEMA.EXTENSION_REGISTRATION
WHERE EXTENSION_NAME = 'abi_v5_test';
NEGOTIATED_PROTOCOL
5
UNINSTALL EXTENSION abi_v5_test;
# Cleanup
include/rpl/deprecated/show_binlog_events.inc
