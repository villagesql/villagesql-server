CREATE TABLE t (id INT PRIMARY KEY, a INT, b INT, c INT, d INT, e INT);
# --- CREATE INDEX: unqualified type, no params ---
CREATE INDEX idx_dummy_index_type ON t (a) USING EXTENDED(dummy_index_type);
