# Pre-check: a type present in the installed version but absent from the
# target version cannot be dropped while a column or stored-procedure
# parameter still depends on it. v1.2.0 omits COUNTER entirely; the
# existing column t.val.update_test.COUNTER blocks the update.

INSTALL EXTENSION update_test VERSION '1.0.0';
CREATE TABLE t (id INT PRIMARY KEY, val update_test.COUNTER);

--error ER_VILLAGESQL_GENERIC_ERROR
ALTER EXTENSION update_test VERSION '1.2.0' AT RESTART;

DROP TABLE t;
UNINSTALL EXTENSION update_test;
