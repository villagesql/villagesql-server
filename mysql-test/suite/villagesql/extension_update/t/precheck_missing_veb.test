# Pre-check: ALTER EXTENSION ... AT RESTART that names a target version
# whose .veb file does not exist must fail at VEB resolution. The error
# originates inside the VEB loader, before any pre-check logic runs.

call mtr.add_suppression("Failed to load VEF extension");

INSTALL EXTENSION update_test VERSION '1.0.0';

--error ER_VILLAGESQL_GENERIC_ERROR
ALTER EXTENSION update_test VERSION '9.9.9' AT RESTART;

UNINSTALL EXTENSION update_test;
