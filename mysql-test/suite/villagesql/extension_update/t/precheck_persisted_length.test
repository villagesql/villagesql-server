# Pre-check: a retained type whose persisted_length differs between the
# installed and target registrations must be rejected. v1.0.0 declares
# COUNTER as 4 bytes; v1.1.0 declares it as 8 bytes. Existing on-disk
# values would be misinterpreted, so the update must not proceed.

INSTALL EXTENSION update_test VERSION '1.0.0';

--error ER_VILLAGESQL_GENERIC_ERROR
ALTER EXTENSION update_test VERSION '1.1.0' AT RESTART;

UNINSTALL EXTENSION update_test;
