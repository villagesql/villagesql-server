# Pre-check: a target package that passes all pre-checks should not yet
# succeed -- the remainder of the update path (durable pending-update
# storage, restart-time apply) lands in subsequent slices. The handler
# reports "not yet implemented" once the pre-checks have passed.

INSTALL EXTENSION update_test VERSION '1.0.0';

--error ER_VILLAGESQL_GENERIC_ERROR
ALTER EXTENSION update_test VERSION '2.0.0' AT RESTART;

UNINSTALL EXTENSION update_test;
