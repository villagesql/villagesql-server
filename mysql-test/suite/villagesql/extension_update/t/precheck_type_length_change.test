# Pre-check: a retained type must keep its storage length across an update.
# Every existing column of a type has a backing field whose length was fixed
# at CREATE TABLE, so the update is rejected when the target version:
#   - shrinks a variable-length type's max_persisted_length (v1.1.0),
#   - grows a variable-length type's max_persisted_length (v1.2.0),
#   - turns a fixed-length type variable-length (v1.3.0),
#   - turns a variable-length type fixed-length (v1.4.0).
# v1.0.0 declares FIX as fixed-length 8 bytes and VAR as variable-length with
# max_persisted_length 64.

INSTALL EXTENSION update_length_test VERSION '1.0.0';

--echo # variable-length shrink
--error ER_VILLAGESQL_GENERIC_ERROR
ALTER EXTENSION update_length_test VERSION '1.1.0' AT RESTART;

--echo # variable-length grow
--error ER_VILLAGESQL_GENERIC_ERROR
ALTER EXTENSION update_length_test VERSION '1.2.0' AT RESTART;

--echo # fixed-length to variable-length
--error ER_VILLAGESQL_GENERIC_ERROR
ALTER EXTENSION update_length_test VERSION '1.3.0' AT RESTART;

--echo # variable-length to fixed-length
--error ER_VILLAGESQL_GENERIC_ERROR
ALTER EXTENSION update_length_test VERSION '1.4.0' AT RESTART;

UNINSTALL EXTENSION update_length_test;
