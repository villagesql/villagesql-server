# `ALTER EXTENSION ... VERSION 'X' AT RESTART` is rejected when a pending
# update for the extension already exists. The operator must clear it
# first by re-issuing the current installed version.

INSTALL EXTENSION update_test VERSION '1.0.0';

# Queue an update.
ALTER EXTENSION update_test VERSION '2.0.0' AT RESTART;
SELECT pending_version FROM INFORMATION_SCHEMA.EXTENSIONS
  WHERE extension_name = 'update_test';

# Trying to queue another (the same target counts; the row already has
# a pending action).
--error ER_VILLAGESQL_GENERIC_ERROR
ALTER EXTENSION update_test VERSION '2.0.0' AT RESTART;

# The original pending update is unchanged.
SELECT pending_version FROM INFORMATION_SCHEMA.EXTENSIONS
  WHERE extension_name = 'update_test';

UNINSTALL EXTENSION update_test;
