# At lower_case_table_names=2 statements are lowercased while the data dictionary
# keeps the CREATE-time case, so I_S.CUSTOM_INDEXES must join
# villagesql.custom_indexes case-insensitively -- and must report the DD's case,
# not the lower-cased form villagesql stores. Reporting the stored form would
# disagree with I_S.COLUMNS and I_S.STATISTICS for the same table and would break
# the documented join between them.
#
# Companion to i_s_columns_lctn2.test and i_s_statistics_lctn2.test.

# TODO(villagesql-indexing): Remove have_debug.inc and the debug flag below once
# custom index execution is fully implemented and the guard in
# PT_custom_index_type::do_contextualize() is removed.
--source include/have_debug.inc
--source include/have_case_insensitive_file_system.inc
--source include/have_lowercase2.inc

SET PERSIST vsql_allow_preview_extensions = ON;
INSTALL EXTENSION vsql_index_test;
SET SESSION debug='+d,villagesql_custom_index_proceed';

CREATE DATABASE MixedDb;
USE MixedDb;

CREATE TABLE MixedTab (
  id INT PRIMARY KEY,
  a dummy_type_vector,
  b dummy_type_vector,
  INDEX MixedIdx (a) USING EXTENDED(dummy_index_hnsw)
);

--echo # --- Stored rows: db and table names lower-cased, index name as entered ---
--source include/villagesql/query_custom_indexes.inc

--echo # --- CUSTOM_INDEXES reports the CREATE-time case, not the stored case ---
SELECT TABLE_SCHEMA, TABLE_NAME, INDEX_NAME, INDEX_TYPE_NAME
FROM INFORMATION_SCHEMA.CUSTOM_INDEXES
WHERE TABLE_SCHEMA = 'mixeddb'
ORDER BY INDEX_NAME;

--echo # --- CUSTOM_INDEX_COLUMNS join ---
SELECT i.TABLE_SCHEMA, i.TABLE_NAME, i.INDEX_NAME,
       c.SEQ_IN_INDEX, c.COLUMN_NAME, c.PROFILE_NAME
FROM INFORMATION_SCHEMA.CUSTOM_INDEXES i
JOIN INFORMATION_SCHEMA.CUSTOM_INDEX_COLUMNS c USING (INDEX_ID)
WHERE i.TABLE_SCHEMA = 'mixeddb'
ORDER BY i.INDEX_NAME, c.SEQ_IN_INDEX;

--echo # --- and agrees with I_S.COLUMNS on the same table ---
SELECT TABLE_SCHEMA, TABLE_NAME FROM INFORMATION_SCHEMA.COLUMNS
WHERE TABLE_SCHEMA = 'mixeddb' AND COLUMN_NAME = 'a';

--echo # --- so the documented join to STATISTICS still matches ---
SELECT s.TABLE_SCHEMA, s.TABLE_NAME, s.INDEX_NAME, s.INDEX_TYPE,
       c.PROFILE_NAME
FROM INFORMATION_SCHEMA.STATISTICS s
JOIN INFORMATION_SCHEMA.CUSTOM_INDEXES i
  USING (TABLE_SCHEMA, TABLE_NAME, INDEX_NAME)
JOIN INFORMATION_SCHEMA.CUSTOM_INDEX_COLUMNS c
  ON c.INDEX_ID = i.INDEX_ID AND c.SEQ_IN_INDEX = s.SEQ_IN_INDEX
WHERE s.TABLE_SCHEMA = 'mixeddb'
ORDER BY s.INDEX_NAME;

--echo # --- Index added by a statement spelled in a different case ---
# Note ALTER at lctn=2 rewrites the data dictionary's stored case for the table,
# so TABLE_NAME below reads 'mixedtab'. That is upstream behaviour -- STATISTICS
# reports the same -- and is pinned here rather than papered over.
ALTER TABLE mixeddb.mixedtab
  ADD INDEX MixedIdx2 (b) USING EXTENDED(dummy_index_hnsw);
SELECT TABLE_SCHEMA, TABLE_NAME, INDEX_NAME
FROM INFORMATION_SCHEMA.CUSTOM_INDEXES
WHERE TABLE_SCHEMA = 'mixeddb'
ORDER BY INDEX_NAME;

--echo #
--echo # Column names: the third convention
--echo #
# Column names are not lowercased.
CREATE TABLE MixedCols (
  id INT PRIMARY KEY,
  VecOne dummy_type_vector,
  VecTwo dummy_type_vector,
  INDEX MixedColIdx (VecOne, VecTwo) USING EXTENDED(dummy_index_hnsw)
);

--echo # --- Stored rows: column names keep their declared case, unlike db/table ---
# Both tables are listed, so the contrast is visible in one place: db_name and
# table_name are lowercase on every row, while MixedColIdx and VecOne/VecTwo are
# not.
--source include/villagesql/query_custom_indexes.inc

--echo # --- CUSTOM_INDEX_COLUMNS reports the declared case ---
SELECT i.TABLE_NAME, i.INDEX_NAME, c.SEQ_IN_INDEX, c.COLUMN_NAME
FROM INFORMATION_SCHEMA.CUSTOM_INDEXES i
JOIN INFORMATION_SCHEMA.CUSTOM_INDEX_COLUMNS c USING (INDEX_ID)
WHERE i.TABLE_SCHEMA = 'mixeddb' AND i.TABLE_NAME = 'MixedCols'
ORDER BY c.SEQ_IN_INDEX;

--echo # --- Cleanup ---
DROP DATABASE MixedDb;

SET SESSION debug='-d,villagesql_custom_index_proceed';
UNINSTALL EXTENSION vsql_index_test;
SET PERSIST vsql_allow_preview_extensions = OFF;
RESET PERSIST vsql_allow_preview_extensions;
