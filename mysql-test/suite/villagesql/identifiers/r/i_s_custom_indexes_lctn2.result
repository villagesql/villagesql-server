SET PERSIST vsql_allow_preview_extensions = ON;
INSTALL EXTENSION vsql_index_test;
SET SESSION debug='+d,villagesql_custom_index_proceed';
CREATE DATABASE MixedDb;
USE MixedDb;
CREATE TABLE MixedTab (
id INT PRIMARY KEY,
a dummy_type_vector,
b dummy_type_vector,
INDEX MixedIdx (a) USING EXTENDED(dummy_index_hnsw)
);
# --- Stored rows: db and table names lower-cased, index name as entered ---
db_name	table_name	index_name	extension_name	extension_version	index_type_name	index_type_parameters
mixeddb	mixedtab	MixedIdx	vsql_index_test	0.0.1	dummy_index_hnsw	{}
table_name	index_name	key_position	column_name	extension_name	extension_version	profile_name
mixedtab	MixedIdx	0	a	vsql_index_test	0.0.1	dummy_profile_hnsw_l2
# --- CUSTOM_INDEXES reports the CREATE-time case, not the stored case ---
SELECT TABLE_SCHEMA, TABLE_NAME, INDEX_NAME, INDEX_TYPE_NAME
FROM INFORMATION_SCHEMA.CUSTOM_INDEXES
WHERE TABLE_SCHEMA = 'mixeddb'
ORDER BY INDEX_NAME;
TABLE_SCHEMA	TABLE_NAME	INDEX_NAME	INDEX_TYPE_NAME
MixedDb	MixedTab	MixedIdx	dummy_index_hnsw
# --- CUSTOM_INDEX_COLUMNS join ---
SELECT i.TABLE_SCHEMA, i.TABLE_NAME, i.INDEX_NAME,
c.SEQ_IN_INDEX, c.COLUMN_NAME, c.PROFILE_NAME
FROM INFORMATION_SCHEMA.CUSTOM_INDEXES i
JOIN INFORMATION_SCHEMA.CUSTOM_INDEX_COLUMNS c USING (INDEX_ID)
WHERE i.TABLE_SCHEMA = 'mixeddb'
ORDER BY i.INDEX_NAME, c.SEQ_IN_INDEX;
TABLE_SCHEMA	TABLE_NAME	INDEX_NAME	SEQ_IN_INDEX	COLUMN_NAME	PROFILE_NAME
MixedDb	MixedTab	MixedIdx	1	a	dummy_profile_hnsw_l2
# --- and agrees with I_S.COLUMNS on the same table ---
SELECT TABLE_SCHEMA, TABLE_NAME FROM INFORMATION_SCHEMA.COLUMNS
WHERE TABLE_SCHEMA = 'mixeddb' AND COLUMN_NAME = 'a';
TABLE_SCHEMA	TABLE_NAME
MixedDb	MixedTab
# --- so the documented join to STATISTICS still matches ---
SELECT s.TABLE_SCHEMA, s.TABLE_NAME, s.INDEX_NAME, s.INDEX_TYPE,
c.PROFILE_NAME
FROM INFORMATION_SCHEMA.STATISTICS s
JOIN INFORMATION_SCHEMA.CUSTOM_INDEXES i
USING (TABLE_SCHEMA, TABLE_NAME, INDEX_NAME)
JOIN INFORMATION_SCHEMA.CUSTOM_INDEX_COLUMNS c
ON c.INDEX_ID = i.INDEX_ID AND c.SEQ_IN_INDEX = s.SEQ_IN_INDEX
WHERE s.TABLE_SCHEMA = 'mixeddb'
ORDER BY s.INDEX_NAME;
TABLE_SCHEMA	TABLE_NAME	INDEX_NAME	INDEX_TYPE	PROFILE_NAME
MixedDb	MixedTab	MixedIdx	DUMMY_INDEX_HNSW	dummy_profile_hnsw_l2
# --- Index added by a statement spelled in a different case ---
ALTER TABLE mixeddb.mixedtab
ADD INDEX MixedIdx2 (b) USING EXTENDED(dummy_index_hnsw);
SELECT TABLE_SCHEMA, TABLE_NAME, INDEX_NAME
FROM INFORMATION_SCHEMA.CUSTOM_INDEXES
WHERE TABLE_SCHEMA = 'mixeddb'
ORDER BY INDEX_NAME;
TABLE_SCHEMA	TABLE_NAME	INDEX_NAME
MixedDb	mixedtab	MixedIdx
MixedDb	mixedtab	MixedIdx2
#
# Column names: the third convention
#
CREATE TABLE MixedCols (
id INT PRIMARY KEY,
VecOne dummy_type_vector,
VecTwo dummy_type_vector,
INDEX MixedColIdx (VecOne, VecTwo) USING EXTENDED(dummy_index_hnsw)
);
# --- Stored rows: column names keep their declared case, unlike db/table ---
db_name	table_name	index_name	extension_name	extension_version	index_type_name	index_type_parameters
mixeddb	mixedcols	MixedColIdx	vsql_index_test	0.0.1	dummy_index_hnsw	{}
mixeddb	mixedtab	MixedIdx	vsql_index_test	0.0.1	dummy_index_hnsw	{}
mixeddb	mixedtab	MixedIdx2	vsql_index_test	0.0.1	dummy_index_hnsw	{}
table_name	index_name	key_position	column_name	extension_name	extension_version	profile_name
mixedcols	MixedColIdx	0	VecOne	vsql_index_test	0.0.1	dummy_profile_hnsw_l2
mixedcols	MixedColIdx	1	VecTwo	vsql_index_test	0.0.1	dummy_profile_hnsw_l2
mixedtab	MixedIdx	0	a	vsql_index_test	0.0.1	dummy_profile_hnsw_l2
mixedtab	MixedIdx2	0	b	vsql_index_test	0.0.1	dummy_profile_hnsw_l2
# --- CUSTOM_INDEX_COLUMNS reports the declared case ---
SELECT i.TABLE_NAME, i.INDEX_NAME, c.SEQ_IN_INDEX, c.COLUMN_NAME
FROM INFORMATION_SCHEMA.CUSTOM_INDEXES i
JOIN INFORMATION_SCHEMA.CUSTOM_INDEX_COLUMNS c USING (INDEX_ID)
WHERE i.TABLE_SCHEMA = 'mixeddb' AND i.TABLE_NAME = 'MixedCols'
ORDER BY c.SEQ_IN_INDEX;
TABLE_NAME	INDEX_NAME	SEQ_IN_INDEX	COLUMN_NAME
MixedCols	MixedColIdx	1	VecOne
MixedCols	MixedColIdx	2	VecTwo
# --- Cleanup ---
DROP DATABASE MixedDb;
SET SESSION debug='-d,villagesql_custom_index_proceed';
UNINSTALL EXTENSION vsql_index_test;
SET PERSIST vsql_allow_preview_extensions = OFF;
RESET PERSIST vsql_allow_preview_extensions;
