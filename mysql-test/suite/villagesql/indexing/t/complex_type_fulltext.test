# FULLTEXT indexes on tables that also have a custom-type (complex) column.
#
#   COMPLEX     - stored inline in the clustered index.

# FTS build paths exercised for each: ALTER TABLE ADD FULLTEXT (rebuilds the
# table to add FTS_DOC_ID), OPTIMIZE TABLE (recreate), and FULLTEXT declared at
# CREATE TABLE.
#
# Each part also asserts that the custom-type column itself cannot be part of a
# FULLTEXT index.

--source include/villagesql/install_complex_extension.inc

CREATE TABLE t1 (id INT PRIMARY KEY, val COMPLEX, txt TEXT);
INSERT INTO t1 VALUES (1, '(1.0,2.0)', 'hello fulltext world');
INSERT INTO t1 VALUES (2, '(3.0,4.0)', 'innodb custom column store');
INSERT INTO t1 VALUES (3, '(0.0,0.0)', 'another fulltext row here');

--echo # ALTER ADD FULLTEXT: rebuilds the table to add FTS_DOC_ID
ALTER TABLE t1 ADD FULLTEXT(txt);
SELECT id, val FROM t1 ORDER BY id;
SELECT id FROM t1 WHERE MATCH(txt) AGAINST ('fulltext') ORDER BY id;

--echo # OPTIMIZE: recreate with both the FTS index and the custom column
OPTIMIZE TABLE t1;
SELECT id, val FROM t1 ORDER BY id;
SELECT id FROM t1 WHERE MATCH(txt) AGAINST ('custom') ORDER BY id;

--echo # FULLTEXT declared at CREATE TABLE
CREATE TABLE t2 (id INT PRIMARY KEY, val COMPLEX, txt TEXT, FULLTEXT(txt));
INSERT INTO t2 SELECT * FROM t1;
INSERT INTO t2 VALUES (4, '(5.0,6.0)', 'inline fulltext definition');
SELECT id, val FROM t2 WHERE MATCH(txt) AGAINST ('inline');

--echo # The custom-type column itself cannot be FULLTEXT-indexed
--error ER_BAD_FT_COLUMN
ALTER TABLE t1 ADD FULLTEXT(val);
--error ER_BAD_FT_COLUMN
CREATE TABLE t3 (id INT PRIMARY KEY, val COMPLEX, FULLTEXT(val));

--echo # Rejected even when a valid TEXT column is indexed alongside it
--error ER_BAD_FT_COLUMN
CREATE TABLE t3 (id INT PRIMARY KEY, val COMPLEX, txt TEXT, FULLTEXT(txt, val));

DROP TABLE t1;
DROP TABLE t2;

--source include/villagesql/uninstall_complex_extension.inc
