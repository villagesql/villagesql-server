CREATE TABLE t1 (id INT PRIMARY KEY, val COMPLEX, txt TEXT);
INSERT INTO t1 VALUES (1, '(1.0,2.0)', 'hello fulltext world');
INSERT INTO t1 VALUES (2, '(3.0,4.0)', 'innodb custom column store');
INSERT INTO t1 VALUES (3, '(0.0,0.0)', 'another fulltext row here');
# ALTER ADD FULLTEXT: rebuilds the table to add FTS_DOC_ID
ALTER TABLE t1 ADD FULLTEXT(txt);
Warnings:
Warning	124	InnoDB rebuilding table to add column FTS_DOC_ID
SELECT id, val FROM t1 ORDER BY id;
id	val
1	(1,2)
2	(3,4)
3	(0,0)
SELECT id FROM t1 WHERE MATCH(txt) AGAINST ('fulltext') ORDER BY id;
id
1
3
# OPTIMIZE: recreate with both the FTS index and the custom column
OPTIMIZE TABLE t1;
Table	Op	Msg_type	Msg_text
test.t1	optimize	note	Table does not support optimize, doing recreate + analyze instead
test.t1	optimize	status	OK
SELECT id, val FROM t1 ORDER BY id;
id	val
1	(1,2)
2	(3,4)
3	(0,0)
SELECT id FROM t1 WHERE MATCH(txt) AGAINST ('custom') ORDER BY id;
id
2
# FULLTEXT declared at CREATE TABLE
CREATE TABLE t2 (id INT PRIMARY KEY, val COMPLEX, txt TEXT, FULLTEXT(txt));
INSERT INTO t2 SELECT * FROM t1;
INSERT INTO t2 VALUES (4, '(5.0,6.0)', 'inline fulltext definition');
SELECT id, val FROM t2 WHERE MATCH(txt) AGAINST ('inline');
id	val
4	(5,6)
# The custom-type column itself cannot be FULLTEXT-indexed
ALTER TABLE t1 ADD FULLTEXT(val);
ERROR HY000: Column 'val' cannot be part of FULLTEXT index
CREATE TABLE t3 (id INT PRIMARY KEY, val COMPLEX, FULLTEXT(val));
ERROR HY000: Column 'val' cannot be part of FULLTEXT index
# Rejected even when a valid TEXT column is indexed alongside it
CREATE TABLE t3 (id INT PRIMARY KEY, val COMPLEX, txt TEXT, FULLTEXT(txt, val));
ERROR HY000: Column 'val' cannot be part of FULLTEXT index
DROP TABLE t1;
DROP TABLE t2;
