CREATE TABLE t1 (id INT PRIMARY KEY, val COMPLEX, name VARCHAR(50));
INSERT INTO t1 VALUES
(1, '(1,2)', 'first'),
(2, '(3,4)', 'second'),
(3, '(1,2)', 'third'),
(4, '(5,6)', 'fourth');
CREATE VIEW v_filtered AS
SELECT id, val, name FROM t1 WHERE val = '(1,2)';
SHOW CREATE VIEW v_filtered;
View	Create View	character_set_client	collation_connection
v_filtered	CREATE ALGORITHM=UNDEFINED DEFINER=`root`@`localhost` SQL SECURITY DEFINER VIEW `v_filtered` AS select `t1`.`id` AS `id`,`t1`.`val` AS `val`,`t1`.`name` AS `name` from `t1` where (`t1`.`val` = '(1,2)')	utf8mb4	utf8mb4_0900_ai_ci
SELECT * FROM v_filtered ORDER BY id;
id	val	name
1	(1,2)	first
3	(1,2)	third
DROP VIEW v_filtered;
DROP TABLE t1;
