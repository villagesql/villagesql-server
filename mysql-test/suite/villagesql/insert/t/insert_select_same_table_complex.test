# INSERT ... SELECT reading the table it writes, with COMPLEX values passed
# through, transformed by a VDF, and folded back with ON DUPLICATE KEY UPDATE.

--source include/villagesql/install_complex_extension.inc

CREATE TABLE t1 (id INT PRIMARY KEY, val COMPLEX);
INSERT INTO t1 VALUES (1, '(1,2)'), (2, '(-3,1)'), (3, NULL);

# Each source row is read once, before any new row is visible.
INSERT INTO t1 SELECT id + 10, val FROM t1;
INSERT INTO t1 SELECT id + 100, vsql_complex.complex_conjugate(val) FROM t1 WHERE id < 10;
SELECT * FROM t1 ORDER BY id;

# Aggregate over the same table.
INSERT INTO t1 SELECT 1000, vsql_complex.complex_sum(val) FROM t1;
SELECT * FROM t1 WHERE id = 1000;

# Same-table ODKU: every row conflicts with itself and is doubled.
DELETE FROM t1 WHERE id >= 10;
INSERT INTO t1 SELECT * FROM t1 AS s
  ON DUPLICATE KEY UPDATE val = vsql_complex.complex_add(t1.val, s.val);
SELECT * FROM t1 ORDER BY id;

DROP TABLE t1;

--source include/villagesql/uninstall_complex_extension.inc
