call mtr.add_suppression("VillageSQL.*Invalid value in column.*COMPLEX");
CREATE TABLE t (id INT PRIMARY KEY, c COMPLEX);
INSERT INTO t VALUES (1, '(3,4)');
INSERT INTO t VALUES (100, 'not a complex');
ERROR HY000: Incorrect COMPLEX value: 'not a complex' for column 'c' at row 1
PREPARE strict_s FROM 'INSERT INTO t VALUES (?, ?)';
SET @id = 101, @v = 'not a complex';
EXECUTE strict_s USING @id, @v;
ERROR HY000: Incorrect COMPLEX value: 'not a complex' for column 'c' at row 1
DEALLOCATE PREPARE strict_s;
SELECT COUNT(*) AS rows_from_strict_inserts FROM t WHERE id >= 100;
rows_from_strict_inserts
0
CREATE TABLE t_nn (id INT PRIMARY KEY, c COMPLEX NOT NULL);
INSERT INTO t_nn VALUES (1, 'not a complex');
ERROR HY000: Incorrect COMPLEX value: 'not a complex' for column 'c' at row 1
SELECT COUNT(*) AS rows_in_t_nn FROM t_nn;
rows_in_t_nn
0
DROP TABLE t_nn;
INSERT IGNORE INTO t VALUES (2, 'not a complex');
