CREATE TABLE t_multi (
id INT PRIMARY KEY,
val INT NOT NULL,
val_double DOUBLE NOT NULL,
val_complex COMPLEX NOT NULL
);
INSERT IGNORE INTO t_multi VALUES
(1, NULL,  NULL,  NULL),
(2, 42,    3.14,  '(1.0,2.0)'),
(3, NULL,  1.0,   '(3.0,4.0)'),
(4, 7,     NULL,  '(5.0,6.0)'),
(5, 8,     2.0,   NULL);
Warnings:
Warning	1048	Column 'val' cannot be null
Warning	1048	Column 'val_double' cannot be null
Warning	1048	Column 'val_complex' cannot be null
SELECT * FROM t_multi ORDER BY id;
id	val	val_double	val_complex
1	0	0	(0,0)
2	42	3.14	(1,2)
3	0	1	(3,4)
4	7	0	(5,6)
5	8	2	(0,0)
DROP TABLE t_multi;
CREATE TABLE t_multi_complex (
