CREATE TABLE t_src (id INT PRIMARY KEY, grp INT, val COMPLEX);
INSERT INTO t_src VALUES
(1, 1, '(1,2)'),
(2, 1, '(3,-4)'),
(3, 2, '(0.5,0.5)'),
(4, 2, NULL),
(5, 3, NULL),
(6, 4, '(-1,-1)'),
(7, 4, '(1,1)');
CREATE TABLE t_sum (grp INT PRIMARY KEY, total COMPLEX, n INT);
INSERT INTO t_sum
SELECT grp, vsql_complex.complex_sum(val), SUM(val IS NOT NULL) FROM t_src GROUP BY grp;
SELECT * FROM t_sum ORDER BY grp;
grp	total	n
1	(4,-2)	2
2	(0.5,0.5)	1
3	NULL	0
4	(0,0)	2
DELETE FROM t_sum;
INSERT INTO t_sum
SELECT grp, vsql_complex.complex_sum(val), COUNT(*) FROM t_src
GROUP BY grp HAVING vsql_complex.complex_abs(vsql_complex.complex_sum(val)) > 1;
SELECT * FROM t_sum ORDER BY grp;
grp	total	n
1	(4,-2)	2
INSERT INTO t_sum SELECT 0, vsql_complex.complex_sum(val), SUM(val IS NOT NULL) FROM t_src;
SELECT * FROM t_sum ORDER BY grp;
grp	total	n
0	(4.5,-1.5)	5
1	(4,-2)	2
INSERT INTO t_src VALUES (8, 1, '(10,10)'), (9, 5, '(7,0)');
INSERT INTO t_sum
SELECT * FROM (SELECT grp, vsql_complex.complex_sum(val) AS s, SUM(val IS NOT NULL) AS c
FROM t_src WHERE id >= 8 GROUP BY grp) AS d
ON DUPLICATE KEY UPDATE total = vsql_complex.complex_add(t_sum.total, d.s),
n = t_sum.n + d.c;
SELECT * FROM t_sum ORDER BY grp;
grp	total	n
0	(4.5,-1.5)	5
1	(14,8)	3
5	(7,0)	1
DROP TABLE t_src, t_sum;
