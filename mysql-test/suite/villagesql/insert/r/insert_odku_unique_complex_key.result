CREATE TABLE t2 (
id INT AUTO_INCREMENT PRIMARY KEY,
grp INT NOT NULL,
val COMPLEX NOT NULL,
cnt INT NOT NULL DEFAULT 1,
UNIQUE KEY uk_grp_val (grp, val)
);
INSERT INTO t2 (grp, val) VALUES (1, '(1,1)'), (2, '(1,1)');
INSERT INTO t2 (grp, val) VALUES (1, '(1,1)') ON DUPLICATE KEY UPDATE cnt = cnt + 1;
INSERT INTO t2 (grp, val) VALUES (1, '(1,-1)') ON DUPLICATE KEY UPDATE cnt = cnt + 1;
INSERT INTO t2 (grp, val) VALUES (3, '(1,1)') ON DUPLICATE KEY UPDATE cnt = cnt + 1;
SELECT grp, val, cnt FROM t2 ORDER BY grp, val;
grp	val	cnt
1	(1,-1)	1
1	(1,1)	2
2	(1,1)	1
3	(1,1)	1
DROP TABLE t2;
