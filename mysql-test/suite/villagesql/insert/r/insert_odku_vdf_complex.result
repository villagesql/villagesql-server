CREATE TABLE t1 (
id INT PRIMARY KEY,
val COMPLEX NOT NULL,
mag DOUBLE
);
INSERT INTO t1 (id, val) VALUES (1, '(1,1)'), (2, '(2,-2)');
INSERT INTO t1 (id, val) VALUES (1, '(10,0)'), (2, '(0,10)'), (3, '(5,5)')
ON DUPLICATE KEY UPDATE val = vsql_complex.complex_add(val, VALUES(val));
Warnings:
Warning	1287	'VALUES function' is deprecated and will be removed in a future release. Please use an alias (INSERT INTO ... VALUES (...) AS alias) and replace VALUES(col) in the ON DUPLICATE KEY UPDATE clause with alias.col instead
SELECT * FROM t1 ORDER BY id;
id	val	mag
1	(11,1)	NULL
2	(2,8)	NULL
3	(5,5)	NULL
INSERT INTO t1 (id, val) VALUES (1, '(0,1)'), (3, '(-5,-5)') AS n
ON DUPLICATE KEY UPDATE val = vsql_complex.complex_multiply(t1.val, n.val),
mag = vsql_complex.complex_abs(t1.val);
SELECT * FROM t1 ORDER BY id;
id	val	mag
1	(-1,11)	11.045361017187261
2	(2,8)	NULL
3	(0,-50)	50
INSERT INTO t1 SET id = 2, val = '(1,0)' AS n
ON DUPLICATE KEY UPDATE val = vsql_complex.complex_conjugate(t1.val);
SELECT * FROM t1 ORDER BY id;
id	val	mag
1	(-1,11)	11.045361017187261
2	(2,-8)	NULL
3	(0,-50)	50
INSERT IGNORE INTO t1 (id, val) VALUES (1, '(0,0)') AS n
ON DUPLICATE KEY UPDATE val = vsql_complex.complex_divide(t1.val, n.val);
Warnings:
Warning	3200	VDF error in function 'complex_divide': division by 0
Warning	1048	Column 'val' cannot be null
SELECT * FROM t1 ORDER BY id;
id	val	mag
1	(0,0)	11.045361017187261
2	(2,-8)	NULL
3	(0,-50)	50
DROP TABLE t1;
