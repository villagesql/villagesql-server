# RETURNING ... INTO a custom-type variable whose type declares no collect
# aggregate (vsql_complex.COMPLEX): more than one row is ER_TOO_MANY_ROWS, the
# message names the variable and its type, and the statement rolls back.
--source include/villagesql/install_complex_extension.inc

CREATE TABLE t (id INT PRIMARY KEY, c vsql_complex.COMPLEX) ENGINE=InnoDB;
INSERT INTO t VALUES (1, '(1,2)'), (2, '(3,4)');

delimiter //;
CREATE PROCEDURE p_many()
BEGIN
  DECLARE z vsql_complex.COMPLEX;
  UPDATE t SET id = id + 10 RETURNING c INTO z;
  SELECT z;
END//
CREATE PROCEDURE p_one()
BEGIN
  DECLARE z vsql_complex.COMPLEX;
  UPDATE t SET id = id + 10 WHERE id = 1 RETURNING c INTO z;
  SELECT z;
END//
delimiter ;//

--echo # Two rows into a COMPLEX variable: refused, with the type named.
--error ER_TOO_MANY_ROWS
CALL p_many();
--echo # The statement rolled back: the ids are unchanged.
SELECT id FROM t ORDER BY id;

--echo # One row still works.
CALL p_one();
SELECT id FROM t ORDER BY id;

DROP PROCEDURE p_many;
DROP PROCEDURE p_one;
DROP TABLE t;
--source include/villagesql/uninstall_complex_extension.inc
