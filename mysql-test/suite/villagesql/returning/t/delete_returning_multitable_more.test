# More multi-table DELETE ... RETURNING cases (see delete_returning_multitable):
# triggers, FK cascade, DELETE IGNORE with FK errors, MyISAM, EXPLAIN, a view
# as target, an error after some rows were sent. The hypergraph optimizer
# cases are in delete_returning_multitable_hypergraph.

CREATE TABLE t1 (id INT PRIMARY KEY, d INT, v INT);
CREATE TABLE t2 (id INT, w INT, KEY (id));
CREATE TABLE trlog (seq INT AUTO_INCREMENT PRIMARY KEY, what VARCHAR(10), id INT);

--echo # --- BEFORE and AFTER DELETE triggers on the returned table
CREATE TRIGGER t1_bd BEFORE DELETE ON t1 FOR EACH ROW
  INSERT INTO trlog (what, id) VALUES ('before', OLD.id);
CREATE TRIGGER t1_ad AFTER DELETE ON t1 FOR EACH ROW
  INSERT INTO trlog (what, id) VALUES ('after', OLD.id);
INSERT INTO t1 VALUES (1, 1, 10), (2, 1, 20), (3, 2, 30), (4, 2, 40);
INSERT INTO t2 VALUES (1, 0), (2, 0), (2, 1), (3, 0);
--echo # immediate delete (t1 first)
--sorted_result
DELETE /*+ JOIN_ORDER(t1, t2) */ t1 FROM t1 JOIN t2 ON t1.id = t2.id
  WHERE t1.d = 1 RETURNING t1.id, t1.v;
SELECT ROW_COUNT();
SELECT what, id FROM trlog ORDER BY id, seq;
--echo # buffered delete (t1 second)
DELETE FROM trlog;
--sorted_result
DELETE /*+ JOIN_ORDER(t2, t1) */ t1 FROM t1 JOIN t2 ON t1.id = t2.id
  RETURNING t1.id, t1.v;
SELECT ROW_COUNT();
SELECT what, id FROM trlog ORDER BY id, seq;
SELECT * FROM t1 ORDER BY id;

--echo # --- Error after some rows: trigger SIGNAL on the 2nd row
DROP TRIGGER t1_ad;
DROP TRIGGER t1_bd;
DELETE FROM trlog; DELETE FROM t1; DELETE FROM t2;
DELIMITER |;
CREATE TRIGGER t1_bd BEFORE DELETE ON t1 FOR EACH ROW
BEGIN
  INSERT INTO trlog (what, id) VALUES ('before', OLD.id);
  IF OLD.id = 2 THEN
    SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'no delete of id 2';
  END IF;
END|
DELIMITER ;|
INSERT INTO t1 VALUES (1, 1, 10), (2, 1, 20), (3, 1, 30);
INSERT INTO t2 VALUES (1, 0), (2, 0), (3, 0);
--echo # immediate delete
--error ER_SIGNAL_EXCEPTION
DELETE /*+ JOIN_ORDER(t1, t2) */ t1 FROM t1 JOIN t2 ON t1.id = t2.id
  RETURNING t1.id;
--echo # whole statement rolled back (rows and trigger log)
SELECT * FROM t1 ORDER BY id;
SELECT COUNT(*) FROM trlog;
--echo # buffered delete
--error ER_SIGNAL_EXCEPTION
DELETE /*+ JOIN_ORDER(t2, t1) */ t1 FROM t1 JOIN t2 ON t1.id = t2.id
  RETURNING t1.id;
SELECT * FROM t1 ORDER BY id;
SELECT COUNT(*) FROM trlog;
--echo # INTO JSON: variable not assigned
SET @j = 'unchanged';
--error ER_SIGNAL_EXCEPTION
DELETE t1 FROM t1 JOIN t2 ON t1.id = t2.id RETURNING t1.id INTO JSON @j;
SELECT @j;
SELECT COUNT(*) FROM t1;
--echo # the connection still works for the next RETURNING statement
--sorted_result
DELETE t1 FROM t1 JOIN t2 ON t1.id = t2.id WHERE t1.id <> 2 RETURNING t1.id;
SELECT * FROM t1 ORDER BY id;
DROP TRIGGER t1_bd;

--echo # --- FK ON DELETE CASCADE: child rows deleted, not returned
CREATE TABLE par (id INT PRIMARY KEY, v INT);
CREATE TABLE chi (cid INT PRIMARY KEY, pid INT,
  FOREIGN KEY (pid) REFERENCES par (id) ON DELETE CASCADE);
INSERT INTO par VALUES (1, 10), (2, 20), (3, 30);
INSERT INTO chi VALUES (100, 1), (101, 1), (200, 2), (300, 3);
DELETE FROM t2; INSERT INTO t2 VALUES (1, 0), (2, 0);
--sorted_result
DELETE par FROM par JOIN t2 ON par.id = t2.id RETURNING par.id, par.v;
SELECT ROW_COUNT();
SELECT * FROM par ORDER BY id;
SELECT * FROM chi ORDER BY cid;
DROP TABLE chi, par;

--echo # --- DELETE IGNORE with FK violations: skipped rows not returned
CREATE TABLE par (id INT PRIMARY KEY, v INT);
CREATE TABLE chi (cid INT PRIMARY KEY, pid INT,
  FOREIGN KEY (pid) REFERENCES par (id) ON DELETE RESTRICT);
INSERT INTO par VALUES (1, 10), (2, 20), (3, 30), (4, 40);
INSERT INTO chi VALUES (200, 2), (400, 4);
DELETE FROM t2; INSERT INTO t2 VALUES (1, 0), (2, 0), (3, 0), (4, 0);
--echo # without IGNORE: error, nothing deleted
--error ER_ROW_IS_REFERENCED_2
DELETE par FROM par JOIN t2 ON par.id = t2.id RETURNING par.id;
SELECT * FROM par ORDER BY id;
--echo # with IGNORE: ids 1 and 3 deleted and returned, 2 and 4 skipped
DELETE IGNORE /*+ JOIN_ORDER(par, t2) */ par FROM par JOIN t2 ON par.id = t2.id
  RETURNING par.id, par.v;
SELECT * FROM par ORDER BY id;
--echo # same, buffered (par second in the join), INTO JSON
DELETE FROM chi; DELETE FROM par;
INSERT INTO par VALUES (1, 10), (2, 20), (3, 30), (4, 40);
INSERT INTO chi VALUES (200, 2), (400, 4);
DELETE IGNORE /*+ JOIN_ORDER(t2, par) */ par FROM par JOIN t2 ON par.id = t2.id
  RETURNING par.id INTO JSON @j;
SELECT JSON_LENGTH(@j) AS n, @j;
SELECT * FROM par ORDER BY id;
--echo # single-table DELETE IGNORE ... RETURNING (same row-sending code)
DELETE FROM chi; DELETE FROM par;
INSERT INTO par VALUES (1, 10), (2, 20), (3, 30), (4, 40);
INSERT INTO chi VALUES (200, 2), (400, 4);
DELETE IGNORE FROM par ORDER BY id RETURNING id, v;
SELECT * FROM par ORDER BY id;
DROP TABLE chi, par;

--echo # --- MyISAM target (non-transactional)
CREATE TABLE m1 (id INT PRIMARY KEY, v INT) ENGINE = MyISAM;
INSERT INTO m1 VALUES (1, 10), (2, 20), (3, 30);
DELETE FROM t2; INSERT INTO t2 VALUES (1, 0), (3, 0), (3, 1);
--sorted_result
DELETE m1 FROM m1 JOIN t2 ON m1.id = t2.id RETURNING m1.id, m1.v;
SELECT ROW_COUNT();
SELECT * FROM m1 ORDER BY id;
--echo # MyISAM, error after the first row: rows already deleted stay deleted
--echo # (fresh table so the scan order is 4, 5)
DROP TABLE m1;
CREATE TABLE m1 (id INT PRIMARY KEY, v INT) ENGINE = MyISAM;
DELIMITER |;
CREATE TRIGGER m1_bd BEFORE DELETE ON m1 FOR EACH ROW
BEGIN
  IF OLD.id = 5 THEN
    SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'no delete of id 5';
  END IF;
END|
DELIMITER ;|
INSERT INTO m1 VALUES (2, 20), (4, 40), (5, 50);
DELETE FROM t2; INSERT INTO t2 VALUES (4, 0), (5, 0);
--error ER_SIGNAL_EXCEPTION
DELETE /*+ JOIN_ORDER(m1, t2) */ m1 FROM m1 JOIN t2 ON m1.id = t2.id
  RETURNING m1.id;
SELECT * FROM m1 ORDER BY id;
DROP TABLE m1;

--echo # --- A view as target
DELETE FROM t1;
INSERT INTO t1 VALUES (1, 1, 10), (2, 1, 20), (3, 2, 30);
DELETE FROM t2; INSERT INTO t2 VALUES (1, 0), (3, 0);
CREATE VIEW v1 AS SELECT id, d, v FROM t1;
--sorted_result
DELETE v1 FROM v1 JOIN t2 ON v1.id = t2.id RETURNING v1.id, v1.v;
SELECT * FROM t1 ORDER BY id;
--echo # non-updatable view
CREATE VIEW v2 AS SELECT d, COUNT(*) AS c FROM t1 GROUP BY d;
--error ER_NON_UPDATABLE_TABLE
DELETE v2 FROM v2 JOIN t2 ON v2.d = t2.id RETURNING v2.d;
DROP VIEW v1, v2;

--echo # --- EXPLAIN of a multi-table DELETE ... RETURNING
DELETE FROM t1;
INSERT INTO t1 VALUES (1, 1, 10), (2, 1, 20), (3, 2, 30);
--replace_column 10 # 11 #
EXPLAIN DELETE /*+ JOIN_ORDER(t1, t2) */ t1 FROM t1 JOIN t2 ON t1.id = t2.id
  RETURNING t1.id, t1.v;
--replace_regex /cost=[0-9.e+]+/cost=#/ /rows=[0-9.e+]+/rows=#/
EXPLAIN FORMAT=TREE DELETE /*+ JOIN_ORDER(t1, t2) */ t1 FROM t1 JOIN t2
  ON t1.id = t2.id RETURNING t1.id, t1.v;
--replace_column 10 # 11 #
EXPLAIN DELETE FROM t1 WHERE id IN (SELECT id FROM t2) RETURNING id;
--echo # EXPLAIN does not delete
SELECT * FROM t1 ORDER BY id;
--echo # EXPLAIN ANALYZE: plan only, no RETURNING rows; it deletes nothing
--echo # (server behaviour for every DELETE, with or without RETURNING)
--disable_result_log
EXPLAIN ANALYZE DELETE t1 FROM t1 JOIN t2 ON t1.id = t2.id RETURNING t1.id;
--enable_result_log
SELECT * FROM t1 ORDER BY id;

DROP TABLE t1, t2, trlog;
