# Multi-table DELETE ... RETURNING (DELETE t1 FROM t1 JOIN ... and
# DELETE FROM t1 USING ...). RETURNING may refer to columns of exactly one
# deleted table; each deleted row of that table is returned once.
# Also covers a single-table DELETE whose IN (subquery) makes the server use
# the multi-table executor: it must return the deleted rows.

INSTALL EXTENSION vsql_array;

CREATE TABLE t1 (id INT PRIMARY KEY, d INT, v INT);
CREATE TABLE t2 (id INT, w INT, KEY (id));
CREATE TABLE t3 (id INT PRIMARY KEY);

--echo # --- Joined DELETE, result set; t1 first in the join (immediate delete)
INSERT INTO t1 VALUES (1, 1, 10), (2, 1, 20), (3, 2, 30), (4, 2, 40);
INSERT INTO t2 VALUES (1, 100), (2, 200), (4, 400);
--sorted_result
DELETE /*+ JOIN_ORDER(t1, t2) */ t1 FROM t1 JOIN t2 ON t1.id = t2.id
  WHERE t1.d = 1 RETURNING t1.id, t1.v;
SELECT ROW_COUNT();
SELECT * FROM t1 ORDER BY id;

--echo # --- Joined DELETE, result set; t1 second in the join (buffered delete)
DELETE FROM t1;
INSERT INTO t1 VALUES (1, 1, 10), (2, 1, 20), (3, 2, 30), (4, 2, 40);
--sorted_result
DELETE /*+ JOIN_ORDER(t2, t1) */ t1 FROM t1 JOIN t2 ON t1.id = t2.id
  WHERE t1.d = 1 RETURNING t1.id, t1.v * 2 AS v2;
SELECT ROW_COUNT();
SELECT * FROM t1 ORDER BY id;

--echo # --- Duplicate join matches: each deleted row returned once
DELETE FROM t1; DELETE FROM t2;
INSERT INTO t1 VALUES (1, 1, 10), (2, 1, 20), (3, 2, 30);
INSERT INTO t2 VALUES (1, 1), (1, 2), (1, 3), (2, 1), (2, 2);
--sorted_result
DELETE /*+ JOIN_ORDER(t1, t2) */ t1 FROM t1 JOIN t2 ON t1.id = t2.id
  RETURNING t1.id;
SELECT ROW_COUNT();
DELETE FROM t1;
INSERT INTO t1 VALUES (1, 1, 10), (2, 1, 20), (3, 2, 30);
--sorted_result
DELETE /*+ JOIN_ORDER(t2, t1) */ t1 FROM t1 JOIN t2 ON t1.id = t2.id
  RETURNING t1.id;
SELECT ROW_COUNT();
SELECT * FROM t1 ORDER BY id;

--echo # --- USING form
DELETE FROM t1; DELETE FROM t2;
INSERT INTO t1 VALUES (1, 1, 10), (2, 1, 20), (3, 2, 30);
INSERT INTO t2 VALUES (2, 0), (3, 0);
--sorted_result
DELETE FROM t1 USING t1, t2 WHERE t1.id = t2.id RETURNING t1.id, t1.d;
SELECT * FROM t1 ORDER BY id;

--echo # --- Zero rows: empty result set, INTO JSON gives []
--sorted_result
DELETE t1 FROM t1 JOIN t2 ON t1.id = t2.id RETURNING t1.id;
SELECT ROW_COUNT();
SET @j = 'old';
DELETE t1 FROM t1 JOIN t2 ON t1.id = t2.id RETURNING t1.id INTO JSON @j;
SELECT @j;

--echo # --- INTO JSON
DELETE FROM t1; DELETE FROM t2;
INSERT INTO t1 VALUES (1, 1, 10), (2, 1, 20), (3, 2, 30);
INSERT INTO t2 VALUES (1, 0), (2, 0);
DELETE /*+ JOIN_ORDER(t1, t2) */ t1 FROM t1 JOIN t2 ON t1.id = t2.id
  RETURNING t1.id, t1.v INTO JSON @j;
SELECT @j;
SELECT * FROM t1 ORDER BY id;

--echo # --- INTO scalar (one row)
DELETE FROM t2; INSERT INTO t2 VALUES (3, 0);
DELETE t1 FROM t1 JOIN t2 ON t1.id = t2.id RETURNING t1.v INTO @s;
SELECT @s;

--echo # --- INTO TABLE
DELETE FROM t1; DELETE FROM t2;
INSERT INTO t1 VALUES (1, 1, 10), (2, 1, 20), (3, 2, 30);
INSERT INTO t2 VALUES (1, 0), (3, 0);
CREATE TEMPORARY TABLE cap (id INT, v INT);
DELETE t1 FROM t1 JOIN t2 ON t1.id = t2.id RETURNING t1.id, t1.v INTO TABLE cap;
SELECT * FROM cap ORDER BY id;
DROP TEMPORARY TABLE cap;

--echo # --- INTO array variables (stored procedure)
DELIMITER |;
CREATE PROCEDURE p_arr()
BEGIN
  DECLARE ids vsql_array.ARRAY('type=int64,max_size=8');
  DECLARE vs vsql_array.ARRAY('type=int32,max_size=8');
  DELETE /*+ JOIN_ORDER(t1, t2) */ t1 FROM t1 JOIN t2 ON t1.id = t2.id
    RETURNING t1.id, t1.v INTO ids, vs;
  SELECT vsql_array.array_length(ids) AS n, ids, vs;
END|
DELIMITER ;|
DELETE FROM t1; DELETE FROM t2;
INSERT INTO t1 VALUES (1, 1, 10), (2, 1, 20), (3, 2, 30);
INSERT INTO t2 VALUES (1, 0), (2, 0), (2, 1);
CALL p_arr();
--echo # zero rows: empty arrays
CALL p_arr();
DROP PROCEDURE p_arr;

--echo # --- RETURNING columns of two tables: error
DELETE FROM t1; DELETE FROM t2;
INSERT INTO t1 VALUES (1, 1, 10);
INSERT INTO t2 VALUES (1, 0);
--error ER_NOT_SUPPORTED_YET
DELETE t1 FROM t1 JOIN t2 ON t1.id = t2.id RETURNING t1.id, t2.w;
--error ER_NOT_SUPPORTED_YET
DELETE t1, t2 FROM t1 JOIN t2 ON t1.id = t2.id RETURNING t1.id, t2.w;
--error ER_NOT_SUPPORTED_YET
DELETE t1, t2 FROM t1 JOIN t2 ON t1.id = t2.id RETURNING 1;
--echo # nothing deleted by the failed statements
SELECT COUNT(*) FROM t1;
SELECT COUNT(*) FROM t2;
--echo # --- Two deleted tables, RETURNING columns of one of them: allowed
--sorted_result
DELETE t1, t2 FROM t1 JOIN t2 ON t1.id = t2.id RETURNING t2.id, t2.w;
SELECT COUNT(*) FROM t1;
SELECT COUNT(*) FROM t2;

--echo # --- Single-table DELETE with (a, b) IN (subquery): rows are returned
DELETE FROM t1; DELETE FROM t2;
INSERT INTO t1 VALUES (1, 1, 10), (2, 1, 20), (3, 2, 30), (4, 2, 40);
INSERT INTO t2 VALUES (1, 1), (2, 1), (4, 2);
--sorted_result
DELETE FROM t1 WHERE (id, d) IN (SELECT id, w FROM t2) RETURNING id, v;
SELECT ROW_COUNT();
SELECT * FROM t1 ORDER BY id;
DELETE FROM t1;
INSERT INTO t1 VALUES (1, 1, 10), (2, 1, 20), (3, 2, 30), (4, 2, 40);
SET @j = NULL;
DELETE FROM t1 WHERE (id, d) IN (SELECT id, w FROM t2) RETURNING id, v
  INTO JSON @j;
SELECT JSON_LENGTH(@j), @j;
DELETE FROM t1;
INSERT INTO t1 VALUES (1, 1, 10), (2, 1, 20), (3, 2, 30), (4, 2, 40);
DELIMITER |;
CREATE PROCEDURE p_in(IN dd INT)
BEGIN
  DECLARE deleted JSON;
  DELETE FROM t1 WHERE d = dd AND id IN (SELECT id FROM t2)
    RETURNING id INTO JSON deleted;
  SELECT deleted;
END|
DELIMITER ;|
CALL p_in(1);
CALL p_in(2);
CALL p_in(2);
DROP PROCEDURE p_in;
--echo # zero rows through the subquery path
--sorted_result
DELETE FROM t1 WHERE id IN (SELECT id FROM t3) RETURNING id;

--echo # --- Prepared statement executed twice
DELETE FROM t1; DELETE FROM t2;
INSERT INTO t1 VALUES (1, 1, 10), (2, 1, 20), (3, 2, 30);
INSERT INTO t2 VALUES (1, 0), (3, 0);
PREPARE ps FROM 'DELETE t1 FROM t1 JOIN t2 ON t1.id = t2.id WHERE t1.d = ? RETURNING t1.id';
SET @d = 1;
EXECUTE ps USING @d;
SET @d = 2;
EXECUTE ps USING @d;
DEALLOCATE PREPARE ps;
SELECT * FROM t1 ORDER BY id;

DROP TABLE t1, t2, t3;
UNINSTALL EXTENSION vsql_array;
