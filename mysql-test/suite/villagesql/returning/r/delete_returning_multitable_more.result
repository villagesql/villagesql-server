CREATE TABLE t1 (id INT PRIMARY KEY, d INT, v INT);
CREATE TABLE t2 (id INT, w INT, KEY (id));
CREATE TABLE trlog (seq INT AUTO_INCREMENT PRIMARY KEY, what VARCHAR(10), id INT);
# --- BEFORE and AFTER DELETE triggers on the returned table
CREATE TRIGGER t1_bd BEFORE DELETE ON t1 FOR EACH ROW
INSERT INTO trlog (what, id) VALUES ('before', OLD.id);
CREATE TRIGGER t1_ad AFTER DELETE ON t1 FOR EACH ROW
INSERT INTO trlog (what, id) VALUES ('after', OLD.id);
INSERT INTO t1 VALUES (1, 1, 10), (2, 1, 20), (3, 2, 30), (4, 2, 40);
INSERT INTO t2 VALUES (1, 0), (2, 0), (2, 1), (3, 0);
# immediate delete (t1 first)
DELETE /*+ JOIN_ORDER(t1, t2) */ t1 FROM t1 JOIN t2 ON t1.id = t2.id
WHERE t1.d = 1 RETURNING t1.id, t1.v;
id	v
1	10
2	20
SELECT ROW_COUNT();
ROW_COUNT()
-1
SELECT what, id FROM trlog ORDER BY id, seq;
what	id
before	1
after	1
before	2
after	2
# buffered delete (t1 second)
DELETE FROM trlog;
DELETE /*+ JOIN_ORDER(t2, t1) */ t1 FROM t1 JOIN t2 ON t1.id = t2.id
RETURNING t1.id, t1.v;
id	v
3	30
SELECT ROW_COUNT();
ROW_COUNT()
-1
SELECT what, id FROM trlog ORDER BY id, seq;
what	id
before	3
after	3
SELECT * FROM t1 ORDER BY id;
id	d	v
4	2	40
# --- Error after some rows: trigger SIGNAL on the 2nd row
DROP TRIGGER t1_ad;
DROP TRIGGER t1_bd;
DELETE FROM trlog;
DELETE FROM t1;
DELETE FROM t2;
CREATE TRIGGER t1_bd BEFORE DELETE ON t1 FOR EACH ROW
BEGIN
INSERT INTO trlog (what, id) VALUES ('before', OLD.id);
IF OLD.id = 2 THEN
SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'no delete of id 2';
END IF;
END|
INSERT INTO t1 VALUES (1, 1, 10), (2, 1, 20), (3, 1, 30);
INSERT INTO t2 VALUES (1, 0), (2, 0), (3, 0);
# immediate delete
DELETE /*+ JOIN_ORDER(t1, t2) */ t1 FROM t1 JOIN t2 ON t1.id = t2.id
RETURNING t1.id;
ERROR 45000: no delete of id 2
# whole statement rolled back (rows and trigger log)
SELECT * FROM t1 ORDER BY id;
id	d	v
1	1	10
2	1	20
3	1	30
SELECT COUNT(*) FROM trlog;
COUNT(*)
0
# buffered delete
DELETE /*+ JOIN_ORDER(t2, t1) */ t1 FROM t1 JOIN t2 ON t1.id = t2.id
RETURNING t1.id;
ERROR 45000: no delete of id 2
SELECT * FROM t1 ORDER BY id;
id	d	v
1	1	10
2	1	20
3	1	30
SELECT COUNT(*) FROM trlog;
COUNT(*)
0
# INTO JSON: variable not assigned
SET @j = 'unchanged';
DELETE t1 FROM t1 JOIN t2 ON t1.id = t2.id RETURNING t1.id INTO JSON @j;
ERROR 45000: no delete of id 2
SELECT @j;
@j
unchanged
SELECT COUNT(*) FROM t1;
COUNT(*)
3
# the connection still works for the next RETURNING statement
DELETE t1 FROM t1 JOIN t2 ON t1.id = t2.id WHERE t1.id <> 2 RETURNING t1.id;
id
1
3
SELECT * FROM t1 ORDER BY id;
id	d	v
2	1	20
DROP TRIGGER t1_bd;
# --- FK ON DELETE CASCADE: child rows deleted, not returned
CREATE TABLE par (id INT PRIMARY KEY, v INT);
CREATE TABLE chi (cid INT PRIMARY KEY, pid INT,
FOREIGN KEY (pid) REFERENCES par (id) ON DELETE CASCADE);
INSERT INTO par VALUES (1, 10), (2, 20), (3, 30);
INSERT INTO chi VALUES (100, 1), (101, 1), (200, 2), (300, 3);
DELETE FROM t2;
INSERT INTO t2 VALUES (1, 0), (2, 0);
DELETE par FROM par JOIN t2 ON par.id = t2.id RETURNING par.id, par.v;
id	v
1	10
2	20
SELECT ROW_COUNT();
ROW_COUNT()
-1
SELECT * FROM par ORDER BY id;
id	v
3	30
SELECT * FROM chi ORDER BY cid;
cid	pid
300	3
DROP TABLE chi, par;
# --- DELETE IGNORE with FK violations: skipped rows not returned
CREATE TABLE par (id INT PRIMARY KEY, v INT);
CREATE TABLE chi (cid INT PRIMARY KEY, pid INT,
FOREIGN KEY (pid) REFERENCES par (id) ON DELETE RESTRICT);
INSERT INTO par VALUES (1, 10), (2, 20), (3, 30), (4, 40);
INSERT INTO chi VALUES (200, 2), (400, 4);
DELETE FROM t2;
INSERT INTO t2 VALUES (1, 0), (2, 0), (3, 0), (4, 0);
# without IGNORE: error, nothing deleted
DELETE par FROM par JOIN t2 ON par.id = t2.id RETURNING par.id;
ERROR 23000: Cannot delete or update a parent row: a foreign key constraint fails (`test`.`chi`, CONSTRAINT `chi_ibfk_1` FOREIGN KEY (`pid`) REFERENCES `par` (`id`) ON DELETE RESTRICT)
SELECT * FROM par ORDER BY id;
id	v
1	10
2	20
3	30
4	40
# with IGNORE: ids 1 and 3 deleted and returned, 2 and 4 skipped
DELETE IGNORE /*+ JOIN_ORDER(par, t2) */ par FROM par JOIN t2 ON par.id = t2.id
RETURNING par.id, par.v;
id	v
1	10
3	30
Warnings:
Warning	1451	Cannot delete or update a parent row: a foreign key constraint fails (`test`.`chi`, CONSTRAINT `chi_ibfk_1` FOREIGN KEY (`pid`) REFERENCES `par` (`id`) ON DELETE RESTRICT)
Warning	1451	Cannot delete or update a parent row: a foreign key constraint fails (`test`.`chi`, CONSTRAINT `chi_ibfk_1` FOREIGN KEY (`pid`) REFERENCES `par` (`id`) ON DELETE RESTRICT)
SELECT * FROM par ORDER BY id;
id	v
2	20
4	40
# same, buffered (par second in the join), INTO JSON
DELETE FROM chi;
DELETE FROM par;
INSERT INTO par VALUES (1, 10), (2, 20), (3, 30), (4, 40);
INSERT INTO chi VALUES (200, 2), (400, 4);
DELETE IGNORE /*+ JOIN_ORDER(t2, par) */ par FROM par JOIN t2 ON par.id = t2.id
RETURNING par.id INTO JSON @j;
Warnings:
Warning	1451	Cannot delete or update a parent row: a foreign key constraint fails (`test`.`chi`, CONSTRAINT `chi_ibfk_1` FOREIGN KEY (`pid`) REFERENCES `par` (`id`) ON DELETE RESTRICT)
Warning	1451	Cannot delete or update a parent row: a foreign key constraint fails (`test`.`chi`, CONSTRAINT `chi_ibfk_1` FOREIGN KEY (`pid`) REFERENCES `par` (`id`) ON DELETE RESTRICT)
SELECT JSON_LENGTH(@j) AS n, @j;
n	@j
2	[{"id": 1}, {"id": 3}]
SELECT * FROM par ORDER BY id;
id	v
2	20
4	40
# single-table DELETE IGNORE ... RETURNING (same row-sending code)
DELETE FROM chi;
DELETE FROM par;
INSERT INTO par VALUES (1, 10), (2, 20), (3, 30), (4, 40);
INSERT INTO chi VALUES (200, 2), (400, 4);
DELETE IGNORE FROM par ORDER BY id RETURNING id, v;
id	v
1	10
3	30
Warnings:
Warning	1451	Cannot delete or update a parent row: a foreign key constraint fails (`test`.`chi`, CONSTRAINT `chi_ibfk_1` FOREIGN KEY (`pid`) REFERENCES `par` (`id`) ON DELETE RESTRICT)
Warning	1451	Cannot delete or update a parent row: a foreign key constraint fails (`test`.`chi`, CONSTRAINT `chi_ibfk_1` FOREIGN KEY (`pid`) REFERENCES `par` (`id`) ON DELETE RESTRICT)
SELECT * FROM par ORDER BY id;
id	v
2	20
4	40
DROP TABLE chi, par;
# --- MyISAM target (non-transactional)
CREATE TABLE m1 (id INT PRIMARY KEY, v INT) ENGINE = MyISAM;
INSERT INTO m1 VALUES (1, 10), (2, 20), (3, 30);
DELETE FROM t2;
INSERT INTO t2 VALUES (1, 0), (3, 0), (3, 1);
DELETE m1 FROM m1 JOIN t2 ON m1.id = t2.id RETURNING m1.id, m1.v;
id	v
1	10
3	30
SELECT ROW_COUNT();
ROW_COUNT()
-1
SELECT * FROM m1 ORDER BY id;
id	v
2	20
# MyISAM, error after the first row: rows already deleted stay deleted
# (fresh table so the scan order is 4, 5)
DROP TABLE m1;
CREATE TABLE m1 (id INT PRIMARY KEY, v INT) ENGINE = MyISAM;
CREATE TRIGGER m1_bd BEFORE DELETE ON m1 FOR EACH ROW
BEGIN
IF OLD.id = 5 THEN
SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'no delete of id 5';
END IF;
END|
INSERT INTO m1 VALUES (2, 20), (4, 40), (5, 50);
DELETE FROM t2;
INSERT INTO t2 VALUES (4, 0), (5, 0);
DELETE /*+ JOIN_ORDER(m1, t2) */ m1 FROM m1 JOIN t2 ON m1.id = t2.id
RETURNING m1.id;
ERROR 45000: no delete of id 5
SELECT * FROM m1 ORDER BY id;
id	v
2	20
5	50
DROP TABLE m1;
# --- A view as target
DELETE FROM t1;
INSERT INTO t1 VALUES (1, 1, 10), (2, 1, 20), (3, 2, 30);
DELETE FROM t2;
INSERT INTO t2 VALUES (1, 0), (3, 0);
CREATE VIEW v1 AS SELECT id, d, v FROM t1;
DELETE v1 FROM v1 JOIN t2 ON v1.id = t2.id RETURNING v1.id, v1.v;
id	v
1	10
3	30
SELECT * FROM t1 ORDER BY id;
id	d	v
2	1	20
# non-updatable view
CREATE VIEW v2 AS SELECT d, COUNT(*) AS c FROM t1 GROUP BY d;
DELETE v2 FROM v2 JOIN t2 ON v2.d = t2.id RETURNING v2.d;
ERROR HY000: The target table v2 of the DELETE is not updatable
DROP VIEW v1, v2;
# --- EXPLAIN of a multi-table DELETE ... RETURNING
DELETE FROM t1;
INSERT INTO t1 VALUES (1, 1, 10), (2, 1, 20), (3, 2, 30);
EXPLAIN DELETE /*+ JOIN_ORDER(t1, t2) */ t1 FROM t1 JOIN t2 ON t1.id = t2.id
RETURNING t1.id, t1.v;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	DELETE	t1	NULL	ALL	PRIMARY	NULL	NULL	NULL	#	#	NULL
1	SIMPLE	t2	NULL	ref	id	id	5	test.t1.id	#	#	Using index
Warnings:
Note	1003	delete /*+ JOIN_ORDER(@`select#1` `t1`,`t2`) */ `test`.`t1` from `test`.`t1` join `test`.`t2` where (`test`.`t2`.`id` = `test`.`t1`.`id`)
EXPLAIN FORMAT=TREE DELETE /*+ JOIN_ORDER(t1, t2) */ t1 FROM t1 JOIN t2
ON t1.id = t2.id RETURNING t1.id, t1.v;
EXPLAIN
-> Delete from t1 (immediate)  (cost=# rows=#)
    -> Nested loop inner join  (cost=# rows=#)
        -> Table scan on t1  (cost=# rows=#)
        -> Covering index lookup on t2 using id (id=t1.id)  (cost=# rows=#)

EXPLAIN DELETE FROM t1 WHERE id IN (SELECT id FROM t2) RETURNING id;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t2	NULL	index	id	id	5	NULL	#	#	Using where; Using index; LooseScan
1	DELETE	t1	NULL	eq_ref	PRIMARY	PRIMARY	4	test.t2.id	#	#	NULL
Warnings:
Note	1003	delete from `test`.`t1` where (`test`.`t1`.`id` = `test`.`t2`.`id`)
# EXPLAIN does not delete
SELECT * FROM t1 ORDER BY id;
id	d	v
1	1	10
2	1	20
3	2	30
# EXPLAIN ANALYZE: plan only, no RETURNING rows; it deletes nothing
# (server behaviour for every DELETE, with or without RETURNING)
EXPLAIN ANALYZE DELETE t1 FROM t1 JOIN t2 ON t1.id = t2.id RETURNING t1.id;
SELECT * FROM t1 ORDER BY id;
id	d	v
1	1	10
2	1	20
3	2	30
DROP TABLE t1, t2, trlog;
