#
# Setup: prepare VEB directory and init-file
#
#
# Test: install extension via --init-file during server startup
#
# restart: --init-file=MYSQL_TMP_DIR/init_install_extension.sql
# Verify extension was installed by the init-file
SELECT extension_name, extension_version FROM INFORMATION_SCHEMA.EXTENSIONS;
EXTENSION_NAME	EXTENSION_VERSION
vsql_complex	0.0.1
# Verify extension is functional: create table with COMPLEX type
CREATE TABLE init_ext_test (id INT, c COMPLEX);
INSERT INTO init_ext_test VALUES (1, '(3.14,2.71)');
INSERT INTO init_ext_test VALUES (2, '(1,2)');
SELECT id, c FROM init_ext_test ORDER BY id;
id	c
1	(3.14,2.71)
2	(1,2)
#
# Cleanup
#
DROP TABLE init_ext_test;
# restart:
