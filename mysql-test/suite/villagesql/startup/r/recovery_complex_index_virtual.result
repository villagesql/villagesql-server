#
# Test crash recovery with uncommitted transactions on indexed COMPLEX columns
# with VIRTUAL columns (tests column index mapping)
#
# restart
#
# Test crash recovery with uncommitted transactions on indexed COMPLEX columns
#
CREATE TABLE test_complex_index_recovery (
id INT PRIMARY KEY,
name VARCHAR(50),
complex_val COMPLEX NOT NULL,
INDEX idx_complex (complex_val)
) ENGINE=InnoDB ;
# Adding virtual columns before and after complex column
ALTER TABLE test_complex_index_recovery
ADD COLUMN virtual_before VARCHAR(100) AS (CONCAT('virtual_', name)) VIRTUAL AFTER name,
ADD COLUMN virtual_after INT AS (id * 10) VIRTUAL AFTER complex_val;
INSERT INTO test_complex_index_recovery(id, name, complex_val) VALUES
(1, 'Initial 1', '(1,1)'),
(2, 'Initial 2', '(2,2)'),
(3, 'Initial 3', '(3,3)');
SELECT id, name, virtual_before, vsql_complex.COMPLEX::to_string(complex_val) AS complex_val, virtual_after
FROM test_complex_index_recovery
ORDER BY id;
id	name	virtual_before	complex_val	virtual_after
1	Initial 1	virtual_Initial 1	(1,1)	10
2	Initial 2	virtual_Initial 2	(2,2)	20
3	Initial 3	virtual_Initial 3	(3,3)	30
SHOW INDEXES FROM test_complex_index_recovery;
Table	Non_unique	Key_name	Seq_in_index	Column_name	Collation	Cardinality	Sub_part	Packed	Null	Index_type	Comment	Index_comment	Visible	Expression
test_complex_index_recovery	0	PRIMARY	1	id	A	#	NULL	NULL		BTREE			YES	NULL
test_complex_index_recovery	1	idx_complex	1	complex_val	A	#	NULL	NULL		BTREE			YES	NULL
# Starting transaction without commit
START TRANSACTION;
INSERT INTO test_complex_index_recovery(id, name, complex_val) VALUES
(4, 'Uncommitted Insert 1', '(4,4)'),
(5, 'Uncommitted Insert 2', '(5,5)');
UPDATE test_complex_index_recovery
SET complex_val = '(99,99)',
name = 'Uncommitted Update'
WHERE id = 2;
DELETE FROM test_complex_index_recovery WHERE id = 3;
# Transaction started but not committed - data should be visible in current session
SELECT id, name, virtual_before, vsql_complex.COMPLEX::to_string(complex_val) AS complex_val, virtual_after
FROM test_complex_index_recovery
ORDER BY id;
id	name	virtual_before	complex_val	virtual_after
1	Initial 1	virtual_Initial 1	(1,1)	10
2	Uncommitted Update	virtual_Uncommitted Update	(99,99)	20
4	Uncommitted Insert 1	virtual_Uncommitted Insert 1	(4,4)	40
5	Uncommitted Insert 2	virtual_Uncommitted Insert 2	(5,5)	50
# Query using index to find specific value
SELECT id, name, vsql_complex.COMPLEX::to_string(complex_val) AS complex_val
FROM test_complex_index_recovery FORCE INDEX (idx_complex)
WHERE complex_val = '(4,4)';
id	name	complex_val
4	Uncommitted Insert 1	(4,4)
# Shutting down server with innodb_fast_shutdown=1 (without commit)
SET GLOBAL innodb_fast_shutdown=1;
# Kill and restart
# Server restarted - checking if uncommitted changes were rolled back
# COMPLEX extension persists across restart
# Verify COMPLEX type and index are still recognized
SHOW CREATE TABLE test_complex_index_recovery;
Table	Create Table
test_complex_index_recovery	CREATE TABLE `test_complex_index_recovery` (
  `id` int NOT NULL,
  `name` varchar(50) DEFAULT NULL,
  `virtual_before` varchar(100) GENERATED ALWAYS AS (concat(_utf8mb4'virtual_',`name`)) VIRTUAL,
  `complex_val` vsql_complex.COMPLEX NOT NULL,
  `virtual_after` int GENERATED ALWAYS AS ((`id` * 10)) VIRTUAL,
  PRIMARY KEY (`id`),
  KEY `idx_complex` (`complex_val`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
# Verify index still exists after restart
SHOW INDEXES FROM test_complex_index_recovery;
Table	Non_unique	Key_name	Seq_in_index	Column_name	Collation	Cardinality	Sub_part	Packed	Null	Index_type	Comment	Index_comment	Visible	Expression
test_complex_index_recovery	0	PRIMARY	1	id	A	#	NULL	NULL		BTREE			YES	NULL
test_complex_index_recovery	1	idx_complex	1	complex_val	A	#	NULL	NULL		BTREE			YES	NULL
# Check table integrity after recovery
CHECK TABLE test_complex_index_recovery;
Table	Op	Msg_type	Msg_text
test.test_complex_index_recovery	check	status	OK
# After crash recovery - only committed data should remain
# Uncommitted INSERT, UPDATE, DELETE should be rolled back
SELECT id, name, virtual_before, vsql_complex.COMPLEX::to_string(complex_val) AS complex_val, virtual_after
FROM test_complex_index_recovery
ORDER BY id;
id	name	virtual_before	complex_val	virtual_after
1	Initial 1	virtual_Initial 1	(1,1)	10
2	Initial 2	virtual_Initial 2	(2,2)	20
3	Initial 3	virtual_Initial 3	(3,3)	30
# Test index functionality after recovery - query by indexed column
SELECT id, name, vsql_complex.COMPLEX::to_string(complex_val) AS complex_val
FROM test_complex_index_recovery
WHERE complex_val = '(2,2)';
id	name	complex_val
2	Initial 2	(2,2)
# Verify counts
SELECT COUNT(*) AS total_rows FROM test_complex_index_recovery;
total_rows
3
# Verify row 2 was not updated (should still have (2,2))
SELECT id, name, vsql_complex.COMPLEX::to_string(complex_val) AS complex_val
FROM test_complex_index_recovery
WHERE id = 2;
id	name	complex_val
2	Initial 2	(2,2)
# Verify row 3 was not deleted
SELECT id, name, vsql_complex.COMPLEX::to_string(complex_val) AS complex_val
FROM test_complex_index_recovery
WHERE id = 3;
id	name	complex_val
3	Initial 3	(3,3)
# Verify rows 4 and 5 were not inserted
SELECT COUNT(*) AS count_row_4 FROM test_complex_index_recovery WHERE id = 4;
count_row_4
0
SELECT COUNT(*) AS count_row_5 FROM test_complex_index_recovery WHERE id = 5;
count_row_5
0
# Test completed - uncommitted transactions correctly rolled back and index preserved
DROP TABLE test_complex_index_recovery;
