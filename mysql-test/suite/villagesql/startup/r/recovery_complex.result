# restart
#
# Test crash recovery with uncommitted transactions on COMPLEX columns
#
CREATE TABLE test_complex_recovery (
id INT PRIMARY KEY,
name VARCHAR(50),
complex_val COMPLEX NOT NULL DEFAULT '(0,0)'
) ENGINE=InnoDB;
INSERT INTO test_complex_recovery VALUES
(1, 'Initial 1', '(1,1)'),
(2, 'Initial 2', '(2,2)'),
(3, 'Initial 3', '(3,3)');
SELECT id, name, vsql_complex.COMPLEX::to_string(complex_val) AS complex_val
FROM test_complex_recovery
ORDER BY id;
id	name	complex_val
1	Initial 1	(1,1)
2	Initial 2	(2,2)
3	Initial 3	(3,3)
# Starting transaction without commit
START TRANSACTION;
INSERT INTO test_complex_recovery VALUES
(4, 'Uncommitted Insert 1', '(4,4)'),
(5, 'Uncommitted Insert 2', '(5,5)');
UPDATE test_complex_recovery
SET complex_val = '(99,99)',
name = 'Uncommitted Update'
WHERE id = 2;
DELETE FROM test_complex_recovery WHERE id = 3;
# Transaction started but not committed - data should be visible in current session
SELECT id, name, vsql_complex.COMPLEX::to_string(complex_val) AS complex_val
FROM test_complex_recovery
ORDER BY id;
id	name	complex_val
1	Initial 1	(1,1)
2	Uncommitted Update	(99,99)
4	Uncommitted Insert 1	(4,4)
5	Uncommitted Insert 2	(5,5)
# Shutting down server with innodb_fast_shutdown=1 (without commit)
SET GLOBAL innodb_fast_shutdown=1;
# Kill and restart
# Server restarted - checking if uncommitted changes were rolled back
# COMPLEX extension persists across restart
# Verify COMPLEX type is still recognized
SHOW CREATE TABLE test_complex_recovery;
Table	Create Table
test_complex_recovery	CREATE TABLE `test_complex_recovery` (
  `id` int NOT NULL,
  `name` varchar(50) DEFAULT NULL,
  `complex_val` vsql_complex.COMPLEX NOT NULL DEFAULT '(0,0)',
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
# Check table integrity after recovery
CHECK TABLE test_complex_recovery;
Table	Op	Msg_type	Msg_text
test.test_complex_recovery	check	status	OK
# After crash recovery - only committed data should remain
# Uncommitted INSERT, UPDATE, DELETE should be rolled back
SELECT id, name, vsql_complex.COMPLEX::to_string(complex_val) AS complex_val
FROM test_complex_recovery
ORDER BY id;
id	name	complex_val
1	Initial 1	(1,1)
2	Initial 2	(2,2)
3	Initial 3	(3,3)
# Verify counts
SELECT COUNT(*) AS total_rows FROM test_complex_recovery;
total_rows
3
# Verify row 2 was not updated (should still have (2,2))
SELECT id, name, vsql_complex.COMPLEX::to_string(complex_val) AS complex_val
FROM test_complex_recovery
WHERE id = 2;
id	name	complex_val
2	Initial 2	(2,2)
# Verify row 3 was not deleted
SELECT id, name, vsql_complex.COMPLEX::to_string(complex_val) AS complex_val
FROM test_complex_recovery
WHERE id = 3;
id	name	complex_val
3	Initial 3	(3,3)
# Verify rows 4 and 5 were not inserted
SELECT COUNT(*) AS count_row_4 FROM test_complex_recovery WHERE id = 4;
count_row_4
0
SELECT COUNT(*) AS count_row_5 FROM test_complex_recovery WHERE id = 5;
count_row_5
0
# Test completed - uncommitted transactions correctly rolled back
DROP TABLE test_complex_recovery;
