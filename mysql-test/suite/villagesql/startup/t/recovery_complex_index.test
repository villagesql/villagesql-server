# Start from a freshly (gracefully) restarted server so this test's crash does
# not discard information (like gcov test coverage) accumulated by preceding
# tests sharing this mysqld.
--source include/restart_mysqld.inc

--echo #
--echo # Test crash recovery with uncommitted transactions on indexed COMPLEX columns
--echo #

--source include/villagesql/install_complex_extension.inc

# Create a table with COMPLEX column and index
let $partition_clause = ;
if ($partition)
{
  let $partition_clause = PARTITION BY KEY(id) PARTITIONS 4;
}

eval CREATE TABLE test_complex_index_recovery (
    id INT PRIMARY KEY,
    name VARCHAR(50),
    complex_val COMPLEX NOT NULL,
    INDEX idx_complex (complex_val)
) ENGINE=InnoDB $partition_clause;

# Add virtual columns if requested (to test column index mapping)
if ($virtual)
{
  --echo # Adding virtual columns before and after complex column
  ALTER TABLE test_complex_index_recovery
    ADD COLUMN virtual_before VARCHAR(100) AS (CONCAT('virtual_', name)) VIRTUAL AFTER name,
    ADD COLUMN virtual_after INT AS (id * 10) VIRTUAL AFTER complex_val;
}

# Insert some initial committed data
INSERT INTO test_complex_index_recovery(id, name, complex_val) VALUES
    (1, 'Initial 1', '(1,1)'),
    (2, 'Initial 2', '(2,2)'),
    (3, 'Initial 3', '(3,3)');

# Verify initial data
if ($virtual)
{
  SELECT id, name, virtual_before, vsql_complex.COMPLEX::to_string(complex_val) AS complex_val, virtual_after
  FROM test_complex_index_recovery
  ORDER BY id;
}
if (!$virtual)
{
  SELECT id, name, vsql_complex.COMPLEX::to_string(complex_val) AS complex_val
  FROM test_complex_index_recovery
  ORDER BY id;
}

if ($partition)
{
  --echo # Show data distribution across partitions
  SELECT 'Partition p0' AS partition_name;
  SELECT id, name, vsql_complex.COMPLEX::to_string(complex_val) AS complex_val
  FROM test_complex_index_recovery PARTITION (p0)
  ORDER BY id;

  SELECT 'Partition p1' AS partition_name;
  SELECT id, name, vsql_complex.COMPLEX::to_string(complex_val) AS complex_val
  FROM test_complex_index_recovery PARTITION (p1)
  ORDER BY id;

  SELECT 'Partition p2' AS partition_name;
  SELECT id, name, vsql_complex.COMPLEX::to_string(complex_val) AS complex_val
  FROM test_complex_index_recovery PARTITION (p2)
  ORDER BY id;

  SELECT 'Partition p3' AS partition_name;
  SELECT id, name, vsql_complex.COMPLEX::to_string(complex_val) AS complex_val
  FROM test_complex_index_recovery PARTITION (p3)
  ORDER BY id;
}

# Verify index exists
--replace_column 7 #
SHOW INDEXES FROM test_complex_index_recovery;

--echo # Starting transaction without commit
START TRANSACTION;

# Uncommitted inserts
INSERT INTO test_complex_index_recovery(id, name, complex_val) VALUES
    (4, 'Uncommitted Insert 1', '(4,4)'),
    (5, 'Uncommitted Insert 2', '(5,5)');

# Uncommitted updates
UPDATE test_complex_index_recovery
SET complex_val = '(99,99)',
    name = 'Uncommitted Update'
WHERE id = 2;

# Uncommitted delete
DELETE FROM test_complex_index_recovery WHERE id = 3;

--echo # Transaction started but not committed - data should be visible in current session
if ($virtual)
{
  SELECT id, name, virtual_before, vsql_complex.COMPLEX::to_string(complex_val) AS complex_val, virtual_after
  FROM test_complex_index_recovery
  ORDER BY id;
}
if (!$virtual)
{
  SELECT id, name, vsql_complex.COMPLEX::to_string(complex_val) AS complex_val
  FROM test_complex_index_recovery
  ORDER BY id;
}

if ($partition)
{
  --echo # Show uncommitted data distribution across partitions
  SELECT 'Partition p0' AS partition_name;
  SELECT id, name, vsql_complex.COMPLEX::to_string(complex_val) AS complex_val
  FROM test_complex_index_recovery PARTITION (p0)
  ORDER BY id;

  SELECT 'Partition p1' AS partition_name;
  SELECT id, name, vsql_complex.COMPLEX::to_string(complex_val) AS complex_val
  FROM test_complex_index_recovery PARTITION (p1)
  ORDER BY id;

  SELECT 'Partition p2' AS partition_name;
  SELECT id, name, vsql_complex.COMPLEX::to_string(complex_val) AS complex_val
  FROM test_complex_index_recovery PARTITION (p2)
  ORDER BY id;

  SELECT 'Partition p3' AS partition_name;
  SELECT id, name, vsql_complex.COMPLEX::to_string(complex_val) AS complex_val
  FROM test_complex_index_recovery PARTITION (p3)
  ORDER BY id;
}

--echo # Query using index to find specific value
SELECT id, name, vsql_complex.COMPLEX::to_string(complex_val) AS complex_val
FROM test_complex_index_recovery FORCE INDEX (idx_complex)
WHERE complex_val = '(4,4)';

--echo # Shutting down server with innodb_fast_shutdown=1 (without commit)
SET GLOBAL innodb_fast_shutdown=1;

--source include/kill_and_restart_mysqld.inc

--echo # Server restarted - checking if uncommitted changes were rolled back
--echo # COMPLEX extension persists across restart

--echo # Verify COMPLEX type and index are still recognized
SHOW CREATE TABLE test_complex_index_recovery;

--echo # Verify index still exists after restart
--replace_column 7 #
SHOW INDEXES FROM test_complex_index_recovery;

--echo # Check table integrity after recovery
CHECK TABLE test_complex_index_recovery;

--echo # After crash recovery - only committed data should remain
--echo # Uncommitted INSERT, UPDATE, DELETE should be rolled back
if ($virtual)
{
  SELECT id, name, virtual_before, vsql_complex.COMPLEX::to_string(complex_val) AS complex_val, virtual_after
  FROM test_complex_index_recovery
  ORDER BY id;
}
if (!$virtual)
{
  SELECT id, name, vsql_complex.COMPLEX::to_string(complex_val) AS complex_val
  FROM test_complex_index_recovery
  ORDER BY id;
}

if ($partition)
{
  --echo # Show data distribution across partitions after recovery
  SELECT 'Partition p0' AS partition_name;
  SELECT id, name, vsql_complex.COMPLEX::to_string(complex_val) AS complex_val
  FROM test_complex_index_recovery PARTITION (p0)
  ORDER BY id;

  SELECT 'Partition p1' AS partition_name;
  SELECT id, name, vsql_complex.COMPLEX::to_string(complex_val) AS complex_val
  FROM test_complex_index_recovery PARTITION (p1)
  ORDER BY id;

  SELECT 'Partition p2' AS partition_name;
  SELECT id, name, vsql_complex.COMPLEX::to_string(complex_val) AS complex_val
  FROM test_complex_index_recovery PARTITION (p2)
  ORDER BY id;

  SELECT 'Partition p3' AS partition_name;
  SELECT id, name, vsql_complex.COMPLEX::to_string(complex_val) AS complex_val
  FROM test_complex_index_recovery PARTITION (p3)
  ORDER BY id;
}

--echo # Test index functionality after recovery - query by indexed column
SELECT id, name, vsql_complex.COMPLEX::to_string(complex_val) AS complex_val
FROM test_complex_index_recovery
WHERE complex_val = '(2,2)';

--echo # Verify counts
SELECT COUNT(*) AS total_rows FROM test_complex_index_recovery;

--echo # Verify row 2 was not updated (should still have (2,2))
SELECT id, name, vsql_complex.COMPLEX::to_string(complex_val) AS complex_val
FROM test_complex_index_recovery
WHERE id = 2;

--echo # Verify row 3 was not deleted
SELECT id, name, vsql_complex.COMPLEX::to_string(complex_val) AS complex_val
FROM test_complex_index_recovery
WHERE id = 3;

--echo # Verify rows 4 and 5 were not inserted
SELECT COUNT(*) AS count_row_4 FROM test_complex_index_recovery WHERE id = 4;
SELECT COUNT(*) AS count_row_5 FROM test_complex_index_recovery WHERE id = 5;

--echo # Test completed - uncommitted transactions correctly rolled back and index preserved

# Cleanup
DROP TABLE test_complex_index_recovery;

--source include/villagesql/uninstall_complex_extension.inc
