INSTALL EXTENSION vsql_test_only;
call mtr.add_suppression("VillageSQL.*Invalid value in column.*FAULT_BLOB");
CREATE TABLE t (id INT PRIMARY KEY, val vsql_test_only.FAULT_BLOB);
LOAD XML INFILE 'MYSQLTEST_VARDIR/tmp/xml_missing.xml' INTO TABLE t ROWS IDENTIFIED BY '<row>';
SHOW WARNINGS;
Level	Code	Message
SELECT id, val, val IS NULL AS is_null FROM t ORDER BY id;
id	val	is_null
1	OK one	0
2	NULL	1
3	OK three	0
DROP TABLE t;
CREATE TABLE t (id INT PRIMARY KEY, val vsql_test_only.FAULT_BLOB NOT NULL);
LOAD XML INFILE 'MYSQLTEST_VARDIR/tmp/xml_missing.xml' INTO TABLE t ROWS IDENTIFIED BY '<row>';
ERROR 22004: Column set to default value; NULL supplied to NOT NULL column 'val' at row 2
SHOW WARNINGS;
Level	Code	Message
Error	1263	Column set to default value; NULL supplied to NOT NULL column 'val' at row 2
SELECT COUNT(*) AS rows_loaded FROM t;
rows_loaded
0
DROP TABLE t;
