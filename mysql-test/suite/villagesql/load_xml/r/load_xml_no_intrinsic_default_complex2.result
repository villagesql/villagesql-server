SET @saved_sql_mode = @@sql_mode;
SET sql_mode = '';
CREATE TABLE t1 (id INT, val COMPLEX2 NOT NULL);
LOAD XML INFILE 'MYSQLTEST_VARDIR/tmp/complex2_bad.xml' INTO TABLE t1 ROWS IDENTIFIED BY '<row>';
ERROR HY000: Column 'val' has no intrinsic default for type 'COMPLEX2'
SELECT * FROM t1 ORDER BY id;
id	val
DROP TABLE t1;
SET sql_mode = @saved_sql_mode;
CREATE TABLE t2 (id INT, val COMPLEX2 NOT NULL);
LOAD XML INFILE 'MYSQLTEST_VARDIR/tmp/complex2_bad_ignore.xml' IGNORE INTO TABLE t2 ROWS IDENTIFIED BY '<row>';
ERROR HY000: Column 'val' has no intrinsic default for type 'COMPLEX2'
SELECT * FROM t2 ORDER BY id;
id	val
DROP TABLE t2;
