INSTALL EXTENSION vsql_tvector;
INSTALL EXTENSION vdf_postrun_leak;
CREATE TABLE t (id INT PRIMARY KEY, v TVECTOR(3));
INSERT INTO t VALUES (1, '[1,2,3]'), (2, '[4,5,6]');
#
# A comparison with from_string(?): good, bad, good, no match
#
PREPARE s FROM 'SELECT id FROM t WHERE v = TVECTOR::from_string(?)';
SET @v = '[1,2,3]';
EXECUTE s USING @v;
id
1
SET @v = '[1,2]';
EXECUTE s USING @v;
ERROR HY000: Cannot compare types vsql_tvector.TVECTOR(3) and vsql_tvector.TVECTOR(2) in =
SET @v = '[4,5,6]';
EXECUTE s USING @v;
id
2
SET @v = '[9,9,9]';
EXECUTE s USING @v;
id
reprepares
4
DEALLOCATE PREPARE s;
#
# UNION ALL with a column: good, bad, good
#
PREPARE s FROM 'SELECT TVECTOR::to_string(u) AS u FROM
                  (SELECT v AS u FROM t WHERE id = 1
                   UNION ALL SELECT TVECTOR::from_string(?)) d';
SET @v = '[7,8,9]';
EXECUTE s USING @v;
u
[1,2,3]
[7,8,9]
SET @v = '[7,8]';
EXECUTE s USING @v;
ERROR HY000: Cannot use UNION with different custom types 'vsql_tvector.TVECTOR(3)' and 'vsql_tvector.TVECTOR(2)'
SET @v = '[1,1,1]';
EXECUTE s USING @v;
u
[1,2,3]
[1,1,1]
reprepares
3
DEALLOCATE PREPARE s;
#
# A derived table: each EXECUTE takes its own dimension
#
PREPARE s FROM 'SELECT TVECTOR::to_string(d.x) AS d
                FROM (SELECT TVECTOR::from_string(?) AS x) d';
SET @v = '[1,2,3,4]';
EXECUTE s USING @v;
d
[1,2,3,4]
SET @v = '[1,2]';
EXECUTE s USING @v;
d
[1,2]
SET @v = '[1,2,3,4,5,6]';
EXECUTE s USING @v;
d
[1,2,3,4,5,6]
reprepares
3
DEALLOCATE PREPARE s;
#
# CASE with a column and from_string(?): good, bad, good
#
PREPARE s FROM 'SELECT id, TVECTOR::to_string(CASE WHEN id = 1 THEN v
                                ELSE TVECTOR::from_string(?) END) AS c
                FROM t ORDER BY id';
SET @v = '[0,0,0]';
EXECUTE s USING @v;
id	c
1	[1,2,3]
2	[0,0,0]
SET @v = '[0,0]';
EXECUTE s USING @v;
ERROR HY000: Cannot compare values of incompatible types 'vsql_tvector.TVECTOR(3)' and 'vsql_tvector.TVECTOR(2)'
SET @v = '[9,9,9]';
EXECUTE s USING @v;
id	c
1	[1,2,3]
2	[9,9,9]
reprepares
3
DEALLOCATE PREPARE s;
