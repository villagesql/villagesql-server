#
# A generated column and a CHECK constraint calling VDFs, fixed when the
# table is first opened, by a PREPARE
#
CREATE TABLE tg (id INT PRIMARY KEY, v TVECTOR(3),
d INT AS (tvector_dim(v)),
m DOUBLE AS (tvector_max_element(v)) STORED,
CHECK (tvector_max_element(v) < 10));
FLUSH TABLES;
PREPARE s FROM 'INSERT INTO tg (id, v) VALUES (?, ?)';
SET @id = 1, @v = '[1,2,3]';
EXECUTE s USING @id, @v;
SET @id = 2, @v = '[4,5,6]';
EXECUTE s USING @id, @v;
SET @id = 3, @v = '[1,2,30]';
EXECUTE s USING @id, @v;
ERROR HY000: Check constraint 'tg_chk_1' is violated.
SET @id = 4, @v = '[1,2]';
EXECUTE s USING @id, @v;
ERROR HY000: Incorrect TVECTOR value: '[1,2]' for column 'v' at row 1
SET @id = 5, @v = '[7,8,9]';
EXECUTE s USING @id, @v;
reprepares
0
DEALLOCATE PREPARE s;
SELECT id, TVECTOR::to_string(v) AS v, d, m FROM tg ORDER BY id;
id	v	d	m
1	[1,2,3]	3	3
2	[4,5,6]	3	6
5	[7,8,9]	3	9
FLUSH TABLES;
PREPARE s FROM 'UPDATE tg SET v = ? WHERE id = ?';
SET @v = '[0,0,1]', @id = 1;
EXECUTE s USING @v, @id;
SET @v = '[0,0,99]', @id = 2;
EXECUTE s USING @v, @id;
ERROR HY000: Check constraint 'tg_chk_1' is violated.
SET @v = '[0,2,0]', @id = 2;
EXECUTE s USING @v, @id;
DEALLOCATE PREPARE s;
SELECT id, TVECTOR::to_string(v) AS v, d, m FROM tg ORDER BY id;
id	v	d	m
1	[0,0,1]	3	1
2	[0,2,0]	3	2
5	[7,8,9]	3	9
DROP TABLE tg;
#
# prerun and postrun stay balanced when a reprepare fails after a VDF's
# prerun ran: hooked_probe(?) is resolved before the WHERE that fails
#
# Baseline
SELECT vdf_postrun_leak.prerun_count() - vdf_postrun_leak.postrun_count() AS unbalanced, vdf_postrun_leak.live_state_count() AS live;
unbalanced	live
0	0
PREPARE s FROM 'SELECT id, vdf_postrun_leak.hooked_probe(?) AS r FROM t
                WHERE v = TVECTOR::from_string(?) ORDER BY id';
SET @a = 'a', @v = '[1,2,3]';
EXECUTE s USING @a, @v;
id	r
1	1:a
SET @a = 'b', @v = '[1,2]';
EXECUTE s USING @a, @v;
ERROR HY000: Cannot compare types vsql_tvector.TVECTOR(3) and vsql_tvector.TVECTOR(2) in =
# After the failed EXECUTE
SELECT vdf_postrun_leak.prerun_count() - vdf_postrun_leak.postrun_count() AS unbalanced, vdf_postrun_leak.live_state_count() AS live;
unbalanced	live
0	0
SET @a = 'c', @v = '[4,5,6]';
EXECUTE s USING @a, @v;
id	r
2	1:c
reprepares
3
DEALLOCATE PREPARE s;
# After DEALLOCATE: every prerun has had its postrun
SELECT vdf_postrun_leak.prerun_count() - vdf_postrun_leak.postrun_count() AS unbalanced, vdf_postrun_leak.live_state_count() AS live;
unbalanced	live
0	0
SET @v = NULL, @w = NULL, @a = NULL, @id = NULL;
DROP TABLE t;
UNINSTALL EXTENSION vdf_postrun_leak;
UNINSTALL EXTENSION vsql_tvector;
