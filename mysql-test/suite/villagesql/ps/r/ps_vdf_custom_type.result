#
# Setup test data
#
CREATE TABLE t1 (id INT PRIMARY KEY, val COMPLEX NOT NULL);
INSERT INTO t1 VALUES (1, '(1.5,-2.5)'), (2, '(3.0,4.0)');
#
# Test 1: a parameter, and the same call with a string constant
#
SELECT complex_real('(1.5,-2.5)') AS re;
re
1.5
PREPARE stmt1 FROM 'SELECT complex_real(?) AS re';
SET @val = '(1.5,-2.5)';
EXECUTE stmt1 USING @val;
re
1.5
# Re-executed with a different value
SET @val = '(3.0,4.0)';
EXECUTE stmt1 USING @val;
re
3
DEALLOCATE PREPARE stmt1;
#
# Test 2: a parameter alongside a column of the same custom type
#
PREPARE stmt2 FROM 'SELECT id, complex_real(complex_add(val, ?)) AS re FROM t1 ORDER BY id';
SET @val = '(1.0,1.0)';
EXECUTE stmt2 USING @val;
id	re
1	2.5
2	4
SET @val = '(10.0,0.0)';
EXECUTE stmt2 USING @val;
id	re
1	11.5
2	13
DEALLOCATE PREPARE stmt2;
#
# Test 3: parameters in every custom-type argument of one call
#
PREPARE stmt3 FROM 'SELECT complex_real(complex_add(?, ?)) AS re';
SET @a = '(1.0,2.0)';
SET @b = '(3.0,4.0)';
EXECUTE stmt3 USING @a, @b;
re
4
DEALLOCATE PREPARE stmt3;
#
# Test 4: an invalid value is rejected at EXECUTE, not at PREPARE
#
PREPARE stmt4 FROM 'SELECT complex_real(?) AS re';
SET @val = 'not a complex';
EXECUTE stmt4 USING @val;
ERROR HY000: Incorrect vsql_complex.COMPLEX value: 'not a complex' for parameter '?'
# The statement still works with a valid value after
SET @val = '(7.0,8.0)';
EXECUTE stmt4 USING @val;
re
7
DEALLOCATE PREPARE stmt4;
#
# Test 5: a NULL parameter
#
PREPARE stmt5 FROM 'SELECT complex_real(?) AS re';
SET @val = NULL;
EXECUTE stmt5 USING @val;
re
NULL
DEALLOCATE PREPARE stmt5;
#
# Cleanup
#
DROP TABLE t1;
