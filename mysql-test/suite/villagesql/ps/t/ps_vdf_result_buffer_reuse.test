# A statement calling a VDF that is resolved once and run many times: a
# prepared statement over several EXECUTEs, and a stored function or procedure
# over several calls. Each run returns results of other sizes than the last,
# some larger than the VDF's result buffer, so the buffer grows at row time.

--source include/no_ps_protocol.inc

--let $extension_name = rlen_ext
--let $extension_version = 1.0.0
--let $extension_source = $MYSQL_TEST_DIR/suite/villagesql/std_data/vdf_result_length.cc
--source include/villagesql/create_extension_sdk.inc

INSTALL EXTENSION rlen_ext;

--echo #
--echo # A prepared statement, a large result, then smaller ones
--echo #

PREPARE s FROM 'SELECT LENGTH(rlen_ext.unbounded_str(?)) AS len, rlen_ext.unbounded_str(?) = REPEAT(''y'', ?) AS intact';
--let $before = query_get_value(SHOW SESSION STATUS LIKE 'Com_stmt_reprepare', Value, 1)
SET @n = 5000;
EXECUTE s USING @n, @n, @n;
SET @n = 3000;
EXECUTE s USING @n, @n, @n;
SET @n = 10;
EXECUTE s USING @n, @n, @n;
SET @n = 4000;
EXECUTE s USING @n, @n, @n;
--let $after = query_get_value(SHOW SESSION STATUS LIKE 'Com_stmt_reprepare', Value, 1)
--disable_query_log
--eval SELECT $after - $before AS reprepares
--enable_query_log
DEALLOCATE PREPARE s;

--echo #
--echo # A stored function, called once per row
--echo #

CREATE TABLE n (id INT PRIMARY KEY, n INT);
INSERT INTO n VALUES (1, 10), (2, 5000), (3, 3000), (4, 20), (5, 4000), (6, 1);

CREATE FUNCTION f(k INT) RETURNS LONGTEXT RETURN rlen_ext.unbounded_str(k);
SELECT id, LENGTH(f(n)) AS len, f(n) = REPEAT('y', n) AS intact FROM n ORDER BY id;
SELECT id, LENGTH(f(n)) AS len, f(n) = REPEAT('y', n) AS intact FROM n ORDER BY id;

--echo #
--echo # A stored procedure, called several times
--echo #

CREATE PROCEDURE p(k INT)
  SELECT LENGTH(rlen_ext.unbounded_str(k)) AS len,
         rlen_ext.unbounded_str(k) = REPEAT('y', k) AS intact;
CALL p(5000);
CALL p(3000);
CALL p(10);
CALL p(4000);

DROP PROCEDURE p;
DROP FUNCTION f;
DROP TABLE n;
SET @n = NULL;
UNINSTALL EXTENSION rlen_ext;
