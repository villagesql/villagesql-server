# DDL on a custom type column, run as a prepared statement.

--source include/no_ps_protocol.inc
--source include/villagesql/install_complex_extension.inc

PREPARE s FROM 'CREATE TABLE t1 (id INT PRIMARY KEY, val COMPLEX)';
EXECUTE s;
DROP TABLE t1;
EXECUTE s;
DEALLOCATE PREPARE s;
SHOW CREATE TABLE t1;

CREATE TABLE t2 (id INT PRIMARY KEY);
PREPARE s FROM 'ALTER TABLE t2 ADD COLUMN val COMPLEX';
EXECUTE s;
DEALLOCATE PREPARE s;
SHOW CREATE TABLE t2;

INSERT INTO t1 VALUES (1, '(1.0,2.0)');
INSERT INTO t2 VALUES (1, '(3.0,4.0)');
SELECT id, complex_real(val) AS r FROM t1;
SELECT id, complex_real(val) AS r FROM t2;

DROP TABLE t1, t2;

# Each statement below runs several times, with other prepared statements run
# in between.

PREPARE other FROM 'SELECT COUNT(*) AS n, MAX(LENGTH(table_name)) AS l FROM information_schema.tables WHERE table_schema = ''mysql''';

PREPARE s FROM 'CREATE TABLE t1 (id INT PRIMARY KEY, val COMPLEX)';
EXECUTE s;
--disable_result_log
EXECUTE other;
--enable_result_log
DROP TABLE t1;
EXECUTE s;
INSERT INTO t1 VALUES (1, '(1.0,2.0)');
DROP TABLE t1;
--disable_result_log
EXECUTE other;
--enable_result_log
EXECUTE s;
DROP TABLE t1;
EXECUTE s;
INSERT INTO t1 VALUES (2, '(5.0,6.0)');
SELECT id, complex_real(val) AS r FROM t1;
DROP TABLE t1;
DEALLOCATE PREPARE s;

CREATE TABLE t2 (id INT PRIMARY KEY);
PREPARE s FROM 'ALTER TABLE t2 ADD COLUMN val COMPLEX';
EXECUTE s;
ALTER TABLE t2 DROP COLUMN val;
--disable_result_log
EXECUTE other;
--enable_result_log
EXECUTE s;
ALTER TABLE t2 DROP COLUMN val;
EXECUTE s;
INSERT INTO t2 VALUES (1, '(7.0,8.0)');
SELECT id, complex_real(val) AS r FROM t2;
DROP TABLE t2;
DEALLOCATE PREPARE s;

# DROP DATABASE of a database with a routine taking a COMPLEX and a table with
# a COMPLEX column.
PREPARE s FROM 'DROP DATABASE d1';
let $i = 3;
while ($i)
{
  CREATE DATABASE d1;
  CREATE PROCEDURE d1.p(IN c COMPLEX) SELECT complex_real(c) AS r;
  CREATE TABLE d1.t (id INT PRIMARY KEY, val COMPLEX);
  --disable_result_log
  EXECUTE other;
  --enable_result_log
  EXECUTE s;
  dec $i;
}
SHOW DATABASES LIKE 'd1';
DEALLOCATE PREPARE s;

CREATE TABLE t1 (id INT PRIMARY KEY, val COMPLEX);
PREPARE s FROM 'DROP TABLE t1';
EXECUTE s;
CREATE TABLE t1 (id INT PRIMARY KEY, val COMPLEX);
--disable_result_log
EXECUTE other;
--enable_result_log
EXECUTE s;
CREATE TABLE t1 (id INT PRIMARY KEY, val COMPLEX);
EXECUTE s;
SHOW TABLES LIKE 't1';
DEALLOCATE PREPARE s;

CREATE TABLE t1 (id INT PRIMARY KEY, val COMPLEX);
PREPARE s FROM 'RENAME TABLE t1 TO t2';
PREPARE s_back FROM 'RENAME TABLE t2 TO t1';
EXECUTE s;
--disable_result_log
EXECUTE other;
--enable_result_log
EXECUTE s_back;
EXECUTE s;
EXECUTE s_back;
EXECUTE s;
INSERT INTO t2 VALUES (1, '(2.0,3.0)');
SELECT id, complex_real(val) AS r FROM t2;
DROP TABLE t2;
DEALLOCATE PREPARE s;
DEALLOCATE PREPARE s_back;

# CREATE TABLE ... SELECT, with no source table and with one.
PREPARE s FROM 'CREATE TABLE t3 AS SELECT COMPLEX::from_string(''(1.0,2.0)'') AS c';
EXECUTE s;
DROP TABLE t3;
--disable_result_log
EXECUTE other;
--enable_result_log
EXECUTE s;
DROP TABLE t3;
EXECUTE s;
SELECT complex_real(c) AS r FROM t3;
DROP TABLE t3;
DEALLOCATE PREPARE s;

CREATE TABLE src (id INT PRIMARY KEY, val COMPLEX);
INSERT INTO src VALUES (1, '(6.0,1.0)');
PREPARE s FROM 'CREATE TABLE t3 SELECT id, val FROM src';
EXECUTE s;
DROP TABLE t3;
--disable_result_log
EXECUTE other;
--enable_result_log
EXECUTE s;
DROP TABLE t3;
EXECUTE s;
SELECT id, complex_real(val) AS r FROM t3;
DROP TABLE t3, src;
DEALLOCATE PREPARE s;
DEALLOCATE PREPARE other;

# Several statements sent in one query.
PREPARE s FROM 'CREATE TABLE t1 (id INT PRIMARY KEY, val COMPLEX)';
delimiter |;
EXECUTE s; DROP TABLE t1; EXECUTE s|
DROP TABLE t1; EXECUTE s; DEALLOCATE PREPARE s|
delimiter ;|
INSERT INTO t1 VALUES (3, '(4.0,5.0)');
SELECT id, complex_real(val) AS r FROM t1;
DROP TABLE t1;

# The same statements in a stored procedure, called several times.
delimiter |;
CREATE PROCEDURE p_ddl()
BEGIN
  CREATE TABLE t1 (id INT PRIMARY KEY, val COMPLEX);
  ALTER TABLE t1 ADD COLUMN val2 COMPLEX;
  DROP TABLE t1;
  CREATE TABLE t3 AS SELECT COMPLEX::from_string('(1.0,2.0)') AS c;
  DROP TABLE t3;
  CREATE DATABASE d1;
  CREATE TABLE d1.t (id INT PRIMARY KEY, val COMPLEX);
  DROP DATABASE d1;
END|
delimiter ;|
CALL p_ddl();
CALL p_ddl();
CALL p_ddl();
DROP PROCEDURE p_ddl;

--source include/villagesql/uninstall_complex_extension.inc
