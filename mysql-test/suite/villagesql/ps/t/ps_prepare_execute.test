# Test PREPARE/EXECUTE/DEALLOCATE mechanics with custom types

--source include/villagesql/install_complex_extension.inc

--echo #
--echo # Setup test data
--echo #

CREATE TABLE t1 (id INT PRIMARY KEY, val COMPLEX);
INSERT INTO t1 VALUES (1, '(1.0,2.0)'), (2, '(3.0,4.0)'), (3, '(5.0,6.0)');

--echo #
--echo # Test 1: PREPARE from string literal
--echo #

PREPARE stmt1 FROM 'SELECT id, val FROM t1';
EXECUTE stmt1;
DEALLOCATE PREPARE stmt1;

--echo #
--echo # Test 2: PREPARE from user variable
--echo #

SET @sql = 'SELECT id, val FROM t1 ORDER BY id';
PREPARE stmt2 FROM @sql;
EXECUTE stmt2;
DEALLOCATE PREPARE stmt2;

--echo #
--echo # Test 3: Multiple EXECUTE calls on same statement
--echo #

PREPARE stmt3 FROM 'SELECT COUNT(*) FROM t1 WHERE id <= ?';
SET @limit = 1;
EXECUTE stmt3 USING @limit;
SET @limit = 2;
EXECUTE stmt3 USING @limit;
SET @limit = 3;
EXECUTE stmt3 USING @limit;
DEALLOCATE PREPARE stmt3;

--echo #
--echo # Test 4: Re-prepare same statement name
--echo #

PREPARE stmt4 FROM 'SELECT id FROM t1';
EXECUTE stmt4;
PREPARE stmt4 FROM 'SELECT val FROM t1';
EXECUTE stmt4;
DEALLOCATE PREPARE stmt4;

--echo #
--echo # Cleanup
--echo #

DROP TABLE t1;

--source include/villagesql/uninstall_complex_extension.inc
