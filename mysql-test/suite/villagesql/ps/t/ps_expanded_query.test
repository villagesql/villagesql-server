# EXECUTE builds an expanded copy of a prepared statement's text, with each
# ? replaced by its value formatted as a literal (Item_param::query_val_str),
# only when something reads that copy: the general log, the slow log, or the
# binary log for a statement-based update. Otherwise the statement runs with
# its prepared text, and no parameter value is formatted. For a large
# parameter, such as a vector bound as 3 KB of binary, formatting it means
# escaping every byte on every EXECUTE.
#
# Each case's statement reads its own processlist INFO, which is the text the
# statement runs with: the prepared text with its ? when nothing needs the
# expanded copy, and the expanded text when a log does.

--source include/no_ps_protocol.inc
--source include/have_log_bin.inc

SET @saved_general_log = @@global.general_log;
SET @saved_slow_query_log = @@global.slow_query_log;
SET GLOBAL general_log = OFF;
SET GLOBAL slow_query_log = OFF;

--echo #
--echo # No log open: the statement runs with its prepared text
--echo #

PREPARE s FROM 'SELECT INFO FROM performance_schema.processlist WHERE ID = CONNECTION_ID() AND ? = ''marker''';
SET @p = 'marker';
EXECUTE s USING @p;
EXECUTE s USING @p;
DEALLOCATE PREPARE s;

--echo #
--echo # No log open, binary parameter: the statement runs with its prepared text
--echo #

PREPARE s FROM 'SELECT INFO FROM performance_schema.processlist WHERE ID = CONNECTION_ID() AND LENGTH(?) = 4';
SET @p = _binary X'0000803F';
EXECUTE s USING @p;
DEALLOCATE PREPARE s;

--echo #
--echo # No log open, statement with RAND(): the parameter still takes the
--echo # value bound to it
--echo #

PREPARE s FROM 'SELECT ?, RAND() IS NOT NULL';
SET @p = 'ab';
EXECUTE s USING @p;
SET @p = 42;
EXECUTE s USING @p;
DEALLOCATE PREPARE s;

--echo #
--echo # General log open: the statement runs with the expanded text
--echo #

SET GLOBAL general_log = ON;
PREPARE s FROM 'SELECT INFO FROM performance_schema.processlist WHERE ID = CONNECTION_ID() AND ? = ''marker''';
SET @p = 'marker';
EXECUTE s USING @p;
DEALLOCATE PREPARE s;
SET GLOBAL general_log = OFF;

--echo #
--echo # Slow log open: the statement runs with the expanded text
--echo #

SET GLOBAL slow_query_log = ON;
PREPARE s FROM 'SELECT INFO FROM performance_schema.processlist WHERE ID = CONNECTION_ID() AND ? = ''marker''';
SET @p = 'marker';
EXECUTE s USING @p;
DEALLOCATE PREPARE s;
SET GLOBAL slow_query_log = OFF;

--echo #
--echo # General log opened after PREPARE: EXECUTE writes the expanded text
--echo #

SET @saved_log_output = @@global.log_output;
SET GLOBAL log_output = 'TABLE';
TRUNCATE TABLE mysql.general_log;
PREPARE s FROM 'SELECT ? AS v';
SET GLOBAL general_log = ON;
SET @p = 'marker';
EXECUTE s USING @p;
SET GLOBAL general_log = OFF;
SELECT argument FROM mysql.general_log WHERE command_type = 'Execute';
DEALLOCATE PREPARE s;
TRUNCATE TABLE mysql.general_log;
SET GLOBAL log_output = @saved_log_output;

--echo #
--echo # Statement-based binary log chosen after PREPARE: EXECUTE writes the
--echo # expanded text
--echo #

CREATE TABLE t (id INT PRIMARY KEY, v VARCHAR(10));
SET @saved_binlog_format = @@session.binlog_format;
SET SESSION binlog_format = 'ROW';
PREPARE s FROM 'INSERT INTO t VALUES (?, ?)';
SET SESSION binlog_format = 'STATEMENT';
--source include/rpl/save_binlog_file_position.inc
SET @id = 1, @p = 'marker';
EXECUTE s USING @id, @p;
--let $binlog_start = $binlog_position
--source include/rpl/deprecated/show_binlog_events.inc
DEALLOCATE PREPARE s;
SET SESSION binlog_format = @saved_binlog_format;
DROP TABLE t;

--echo #
--echo # performance_schema: an EXECUTE has the same statement text and digest
--echo # whether or not the expanded text is built
--echo #

PREPARE s FROM 'SELECT ? AS v';
SET @p = 'marker';
TRUNCATE TABLE performance_schema.events_statements_history;
EXECUTE s USING @p;
SET GLOBAL general_log = ON;
EXECUTE s USING @p;
SET GLOBAL general_log = OFF;
SELECT EVENT_NAME, SQL_TEXT, DIGEST_TEXT
  FROM performance_schema.events_statements_history
  WHERE THREAD_ID = PS_CURRENT_THREAD_ID()
    AND EVENT_NAME = 'statement/sql/execute_sql'
  ORDER BY EVENT_ID;
SELECT COUNT(*) AS executes, COUNT(DISTINCT DIGEST) AS digests
  FROM performance_schema.events_statements_history
  WHERE THREAD_ID = PS_CURRENT_THREAD_ID()
    AND EVENT_NAME = 'statement/sql/execute_sql';
SELECT SQL_TEXT, COUNT_EXECUTE
  FROM performance_schema.prepared_statements_instances
  WHERE STATEMENT_NAME = 's' AND OWNER_THREAD_ID = PS_CURRENT_THREAD_ID();
DEALLOCATE PREPARE s;

SET @id = NULL, @p = NULL;
SET GLOBAL general_log = @saved_general_log;
SET GLOBAL slow_query_log = @saved_slow_query_log;
