# A prepared-statement parameter ('?') inside an expression passed to a VDF,
# e.g. tvector_dim(CONCAT(?, '')), rather than passed directly.
#
# At PREPARE the parameter has no value yet. The expression around it is
# constant for the execution, so the bind_and_check_types hook should not
# read it at PREPARE.

call mtr.add_suppression("VillageSQL.*Invalid value in column.*TVECTOR.*TVECTOR has no dimension");

INSTALL EXTENSION vsql_tvector;

--echo #
--echo # bind_and_check_types hook, parameter inside CONCAT
--echo #
--error ER_VILLAGESQL_GENERIC_ERROR
SELECT vsql_tvector.tvector_dim(CONCAT('[1,2,', '3]')) AS d;
SET @v = '[1,2,3]';
--error ER_VILLAGESQL_GENERIC_ERROR
SELECT vsql_tvector.tvector_dim(CONCAT(@v, '')) AS d;
--error ER_VILLAGESQL_GENERIC_ERROR
PREPARE s FROM 'SELECT vsql_tvector.tvector_dim(CONCAT(?, '''')) AS d';

--echo #
--echo # Other expressions around the parameter
--echo #
--error ER_VILLAGESQL_GENERIC_ERROR
PREPARE s FROM 'SELECT vsql_tvector.tvector_dim(TRIM(?)) AS d';
--error ER_VILLAGESQL_GENERIC_ERROR
PREPARE s FROM 'SELECT vsql_tvector.tvector_dim(CAST(? AS CHAR)) AS d';
--error ER_VILLAGESQL_GENERIC_ERROR
PREPARE s FROM 'SELECT vsql_tvector.tvector_dim(COALESCE(?, ''[0]'')) AS d';
--echo # A parameter inside a subquery
--error ER_VILLAGESQL_GENERIC_ERROR
PREPARE s FROM 'SELECT vsql_tvector.tvector_dim((SELECT CONCAT(?, ''''))) AS d';

--echo #
--echo # Varargs hook
--echo #
--error ER_VILLAGESQL_GENERIC_ERROR
SELECT vsql_tvector.tvector_concat_all(CONCAT(@v, ''), '[4]') AS c;
--error ER_VILLAGESQL_GENERIC_ERROR
PREPARE s FROM
  'SELECT vsql_tvector.tvector_concat_all(CONCAT(?, ''''), ''[4]'') AS c';
--echo # With a direct parameter next to it
--error ER_VILLAGESQL_GENERIC_ERROR
PREPARE s FROM
  'SELECT vsql_tvector.tvector_concat_all(CONCAT(?, ''''), ?) AS c';

--echo #
--echo # from_string inference, parameter inside CONCAT
--echo #
--echo # from_string cannot find the dimension of a CONCAT result, so this
--echo # fails also without a prepared statement.
--error ER_VILLAGESQL_GENERIC_ERROR
SELECT TVECTOR::from_string(CONCAT(@v, '')) AS v;
PREPARE s FROM 'SELECT TVECTOR::from_string(CONCAT(?, '''')) AS v';
--error ER_VILLAGESQL_GENERIC_ERROR
EXECUTE s USING @v;
DEALLOCATE PREPARE s;

CREATE TABLE t (id INT PRIMARY KEY, v TVECTOR(3));
--error ER_VILLAGESQL_GENERIC_ERROR
INSERT INTO t VALUES (1, TVECTOR::from_string(CONCAT(@v, '')));
PREPARE s FROM
  'INSERT INTO t VALUES (2, TVECTOR::from_string(CONCAT(?, '''')))';
--error ER_VILLAGESQL_GENERIC_ERROR
EXECUTE s USING @v;
DEALLOCATE PREPARE s;
SELECT id, v FROM t ORDER BY id;
DROP TABLE t;

SET @v = NULL;

UNINSTALL EXTENSION vsql_tvector;
