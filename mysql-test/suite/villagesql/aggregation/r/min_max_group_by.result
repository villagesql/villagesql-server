CREATE TABLE complex_test (
id INT PRIMARY KEY,
value vsql_complex.COMPLEX,
category VARCHAR(20)
);
INSERT INTO complex_test VALUES
(1, '(3.0, 4.0)', 'A'),
(2, '(1.0, 2.0)', 'A'),
(3, '(5.0, 1.0)', 'B'),
(4, '(2.0, 3.0)', 'B'),
(5, '(4.0, 5.0)', 'A'),
(6, '(6.0, 2.0)', 'B');
# Test with GROUP BY
SELECT category, MAX(value) as max_val, MIN(value) as min_val
FROM complex_test
GROUP BY category
ORDER BY category;
category	max_val	min_val
A	(4,5)	(1,2)
B	(6,2)	(2,3)
# Test with HAVING clause on aggregate
SELECT category, MAX(value) as max_val
FROM complex_test
GROUP BY category
HAVING MAX(value) > '(2.5, 0)'
ORDER BY category;
category	max_val
A	(4,5)
B	(6,2)
# Test with ORDER BY on aggregate
SELECT category, MAX(value) as max_val
FROM complex_test
GROUP BY category
ORDER BY MAX(value);
category	max_val
A	(4,5)
B	(6,2)
# Test MIN/MAX with CASE in GROUP BY
SELECT
CASE WHEN category = 'A' THEN 'Group1' ELSE 'Group2' END as grp,
MAX(value) as max_val,
MIN(value) as min_val
FROM complex_test
GROUP BY grp
ORDER BY grp;
grp	max_val	min_val
Group1	(4,5)	(1,2)
Group2	(6,2)	(2,3)
# Test MIN/MAX with HAVING on MIN
SELECT category, MAX(value) as max_val, MIN(value) as min_val
FROM complex_test
GROUP BY category
HAVING MIN(value) < '(2.0, 0.0)'
ORDER BY category;
category	max_val	min_val
A	(4,5)	(1,2)
# Test MIN/MAX with aggregate comparison
SELECT category, MAX(value) as max_val, MIN(value) as min_val
FROM complex_test
GROUP BY category
HAVING MAX(value) > MIN(value)
ORDER BY category;
category	max_val	min_val
A	(4,5)	(1,2)
B	(6,2)	(2,3)
# Test MIN/MAX with multiple aggregates
SELECT category,
COUNT(*) as cnt,
MIN(value) as min_val,
MAX(value) as max_val
FROM complex_test
GROUP BY category
ORDER BY category;
category	cnt	min_val	max_val
A	3	(1,2)	(4,5)
B	3	(2,3)	(6,2)
DROP TABLE complex_test;
