CREATE TABLE complex_test (
id INT PRIMARY KEY,
value vsql_complex.COMPLEX,
category VARCHAR(20)
);
INSERT INTO complex_test VALUES
(1, '(1.0, 2.0)', 'A'),
(2, '(3.0, 4.0)', 'A'),
(3, '(10.0, 20.0)', 'B'),
(4, '(5.0, 1.0)', 'B'),
(5, '(0.5, 0.5)', 'B');
SELECT category, vsql_complex.complex_sum(value) AS total
FROM complex_test
GROUP BY category
ORDER BY category;
category	total
A	(4,6)
B	(15.5,21.5)
SELECT vsql_complex.complex_sum(value) AS total
FROM complex_test;
total
(19.5,27.5)
CREATE TABLE complex_empty (id INT PRIMARY KEY, value vsql_complex.COMPLEX);
SELECT vsql_complex.complex_sum(value) AS total
FROM complex_empty;
total
NULL
DROP TABLE complex_empty;
CREATE TABLE complex_nulls (
id INT PRIMARY KEY,
value vsql_complex.COMPLEX,
category VARCHAR(20)
);
INSERT INTO complex_nulls VALUES
(1, '(1.0, 2.0)', 'A'),
(2, NULL, 'A'),
(3, '(3.0, 4.0)', 'A'),
(4, NULL, 'B'),
(5, NULL, 'B');
SELECT category, vsql_complex.complex_sum(value) AS total
FROM complex_nulls
GROUP BY category
ORDER BY category;
category	total
A	(4,6)
B	NULL
DROP TABLE complex_nulls;
DROP TABLE complex_test;
