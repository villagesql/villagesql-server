# Test MIN() and MAX() with GROUP BY variations

--source include/villagesql/install_complex_extension.inc

CREATE TABLE complex_test (
  id INT PRIMARY KEY,
  value vsql_complex.COMPLEX,
  category VARCHAR(20)
);

INSERT INTO complex_test VALUES
  (1, '(3.0, 4.0)', 'A'),
  (2, '(1.0, 2.0)', 'A'),
  (3, '(5.0, 1.0)', 'B'),
  (4, '(2.0, 3.0)', 'B'),
  (5, '(4.0, 5.0)', 'A'),
  (6, '(6.0, 2.0)', 'B');

--echo # Test with GROUP BY
SELECT category, MAX(value) as max_val, MIN(value) as min_val
FROM complex_test
GROUP BY category
ORDER BY category;

--echo # Test with HAVING clause on aggregate
SELECT category, MAX(value) as max_val
FROM complex_test
GROUP BY category
HAVING MAX(value) > '(2.5, 0)'
ORDER BY category;

--echo # Test with ORDER BY on aggregate
SELECT category, MAX(value) as max_val
FROM complex_test
GROUP BY category
ORDER BY MAX(value);

--echo # Test MIN/MAX with CASE in GROUP BY
SELECT
  CASE WHEN category = 'A' THEN 'Group1' ELSE 'Group2' END as grp,
  MAX(value) as max_val,
  MIN(value) as min_val
FROM complex_test
GROUP BY grp
ORDER BY grp;

--echo # Test MIN/MAX with HAVING on MIN
SELECT category, MAX(value) as max_val, MIN(value) as min_val
FROM complex_test
GROUP BY category
HAVING MIN(value) < '(2.0, 0.0)'
ORDER BY category;

--echo # Test MIN/MAX with aggregate comparison
SELECT category, MAX(value) as max_val, MIN(value) as min_val
FROM complex_test
GROUP BY category
HAVING MAX(value) > MIN(value)
ORDER BY category;

--echo # Test MIN/MAX with multiple aggregates
SELECT category,
  COUNT(*) as cnt,
  MIN(value) as min_val,
  MAX(value) as max_val
FROM complex_test
GROUP BY category
ORDER BY category;

DROP TABLE complex_test;

--source include/villagesql/uninstall_complex_extension.inc
