# Test MIN() and MAX() aggregate functions on COMPLEX custom type - Basic functionality

--source include/villagesql/install_complex_extension.inc

CREATE TABLE complex_test (
  id INT PRIMARY KEY,
  value vsql_complex.COMPLEX
);

# COMPLEX type format: (real, imaginary)
# Comparison is by real part first, then imaginary part
INSERT INTO complex_test VALUES
  (1, '(3.0, 4.0)'),
  (2, '(1.0, 2.0)'),
  (3, '(5.0, 1.0)'),
  (4, '(2.0, 3.0)');

--echo # Test comparison operators first to verify compare function
SELECT value FROM complex_test WHERE id = 2 AND value < '(2.0, 3.0)';
SELECT value FROM complex_test WHERE id = 4 AND value > '(1.0, 2.0)';
SELECT value FROM complex_test WHERE id = 2 AND value = '(1.0, 2.0)';

--echo # Basic MAX and MIN
SELECT MAX(value) FROM complex_test;
SELECT MIN(value) FROM complex_test;
SELECT MIN(value) AS min_val, MAX(value) AS max_val FROM complex_test;

--echo # Test with NULL values
INSERT INTO complex_test VALUES (5, NULL);
SELECT MAX(value) FROM complex_test;
SELECT MIN(value) FROM complex_test;

--echo # Test empty result set
DELETE FROM complex_test;
SELECT MAX(value) FROM complex_test;
SELECT MIN(value) FROM complex_test;

--echo # Test with all NULL values
INSERT INTO complex_test (id, value) VALUES (1, NULL), (2, NULL);
SELECT MAX(value) FROM complex_test;
SELECT MIN(value) FROM complex_test;

DROP TABLE complex_test;

--source include/villagesql/uninstall_complex_extension.inc
