# Test UPDATE triggers with custom types

--source include/villagesql/install_complex_extension.inc

CREATE TABLE t1 (
  id INT PRIMARY KEY,
  name VARCHAR(50),
  val COMPLEX
);

delimiter //;

# BEFORE UPDATE trigger reading OLD and NEW custom columns
CREATE TRIGGER tr_before_update BEFORE UPDATE ON t1
FOR EACH ROW
BEGIN
  SET @old_val = OLD.val;
  SET @new_val = NEW.val;
END//

# BEFORE UPDATE trigger modifying custom column
CREATE TRIGGER tr_modify_custom BEFORE UPDATE ON t1
FOR EACH ROW
BEGIN
  IF NEW.name = 'double' THEN
    SET NEW.val = '(10.0,20.0)';
  END IF;
END//

delimiter ;//

# Insert test data
INSERT INTO t1 VALUES (1, 'test', '(1.0,2.0)');

# Verify UPDATE trigger - reading OLD and NEW
UPDATE t1 SET val = '(3.0,4.0)' WHERE id = 1;
SELECT @old_val, @new_val;
SELECT * FROM t1 WHERE id = 1;

# Verify UPDATE trigger - modifying custom column
UPDATE t1 SET name = 'double' WHERE id = 1;
SELECT * FROM t1 WHERE id = 1;

# Cleanup
DROP TRIGGER tr_before_update;
DROP TRIGGER tr_modify_custom;
DROP TABLE t1;

# Clear user variables
SET @old_val = NULL;
SET @new_val = NULL;

--source include/villagesql/uninstall_complex_extension.inc
