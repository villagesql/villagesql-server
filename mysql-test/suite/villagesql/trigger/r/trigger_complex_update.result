CREATE TABLE t1 (
id INT PRIMARY KEY,
name VARCHAR(50),
val COMPLEX
);
CREATE TRIGGER tr_before_update BEFORE UPDATE ON t1
FOR EACH ROW
BEGIN
SET @old_val = OLD.val;
SET @new_val = NEW.val;
END//
CREATE TRIGGER tr_modify_custom BEFORE UPDATE ON t1
FOR EACH ROW
BEGIN
IF NEW.name = 'double' THEN
SET NEW.val = '(10.0,20.0)';
END IF;
END//
INSERT INTO t1 VALUES (1, 'test', '(1.0,2.0)');
UPDATE t1 SET val = '(3.0,4.0)' WHERE id = 1;
SELECT @old_val, @new_val;
@old_val	@new_val
(1,2)	(3,4)
SELECT * FROM t1 WHERE id = 1;
id	name	val
1	test	(3,4)
UPDATE t1 SET name = 'double' WHERE id = 1;
SELECT * FROM t1 WHERE id = 1;
id	name	val
1	double	(10,20)
DROP TRIGGER tr_before_update;
DROP TRIGGER tr_modify_custom;
DROP TABLE t1;
SET @old_val = NULL;
SET @new_val = NULL;
