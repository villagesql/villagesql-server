CREATE TABLE t1 (
id INT PRIMARY KEY,
name VARCHAR(50),
val COMPLEX
);
CREATE TRIGGER tr_before_insert BEFORE INSERT ON t1
FOR EACH ROW
BEGIN
SET @trigger_count = IFNULL(@trigger_count, 0) + 1;
SET @last_val = NEW.val;
SET @last_id = NEW.id;
END//
SET @trigger_count = 0;
INSERT INTO t1 VALUES (1, 'first', '(1.0,1.0)'), (2, 'second', '(2.0,2.0)'), (3, 'third', '(3.0,3.0)');
SELECT @trigger_count, @last_id, @last_val;
@trigger_count	@last_id	@last_val
3	3	(3,3)
SELECT * FROM t1 ORDER BY id;
id	name	val
1	first	(1,1)
2	second	(2,2)
3	third	(3,3)
CREATE TRIGGER tr_before_update BEFORE UPDATE ON t1
FOR EACH ROW
BEGIN
SET @update_count = IFNULL(@update_count, 0) + 1;
SET @update_old = OLD.val;
SET @update_new = NEW.val;
END//
SET @update_count = 0;
UPDATE t1 SET val = '(10.0,10.0)' WHERE id IN (1, 2);
SELECT @update_count;
@update_count
2
SELECT * FROM t1 ORDER BY id;
id	name	val
1	first	(10,10)
2	second	(10,10)
3	third	(3,3)
CREATE TRIGGER tr_before_delete BEFORE DELETE ON t1
FOR EACH ROW
BEGIN
SET @delete_count = IFNULL(@delete_count, 0) + 1;
SET @deleted_val = OLD.val;
END//
SET @delete_count = 0;
DELETE FROM t1 WHERE id IN (1, 3);
SELECT @delete_count;
@delete_count
2
SELECT * FROM t1;
id	name	val
2	second	(10,10)
DROP TRIGGER tr_before_insert;
DROP TRIGGER tr_before_update;
DROP TRIGGER tr_before_delete;
DROP TABLE t1;
SET @trigger_count = NULL;
SET @last_val = NULL;
SET @last_id = NULL;
SET @update_count = NULL;
SET @update_old = NULL;
SET @update_new = NULL;
SET @delete_count = NULL;
SET @deleted_val = NULL;
