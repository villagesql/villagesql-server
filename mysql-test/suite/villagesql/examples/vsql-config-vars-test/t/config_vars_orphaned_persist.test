# Test behavior when a persisted config variable is orphaned on restart.
# Scenario: persist a variable, uninstall the extension, restart the server
# without the extension installed. The persisted value in mysqld-auto.cnf has
# no corresponding variable (extension is gone). Verify the server starts
# cleanly and the orphaned entry is simply ignored.

--echo # Install extension and persist a variable
INSTALL EXTENSION vsql_config_vars_test;
SET PERSIST vsql_config_vars_test.max_items = 42;

--echo # Uninstall extension while persisted value remains in mysqld-auto.cnf
CALL mtr.add_suppression("Currently unknown variable 'vsql_config_vars_test");
UNINSTALL EXTENSION vsql_config_vars_test;

--echo # Restart without extension installed
--let $veb_dir = `SELECT @@veb_dir`
--replace_result $MYSQLTEST_VARDIR MYSQLTEST_VARDIR
--let $restart_parameters = restart: --veb-dir=$veb_dir
--source include/restart_mysqld.inc

--echo # Server should have started cleanly; orphaned persisted value is ignored
--error ER_UNKNOWN_SYSTEM_VARIABLE
SELECT @@global.vsql_config_vars_test.max_items;

--echo # Clean up orphaned persisted value
--error 0, ER_VAR_DOES_NOT_EXIST
RESET PERSIST vsql_config_vars_test.max_items;

--echo # Install extension again; should get default value, not the old persisted one
INSTALL EXTENSION vsql_config_vars_test;
SELECT @@global.vsql_config_vars_test.max_items;
UNINSTALL EXTENSION vsql_config_vars_test;
