CREATE TABLE measurements (
measurement_id INT PRIMARY KEY,
raw_signal COMPLEX,
magnitude_key DOUBLE GENERATED ALWAYS AS (COMPLEX_ABS(raw_signal)) STORED
);
CREATE TABLE magnitude_categories (
magnitude DOUBLE PRIMARY KEY,
category_name VARCHAR(50)
);
INSERT INTO magnitude_categories VALUES (5.0, 'Medium'), (10.0, 'High');
CREATE TABLE classified_signals (
id INT PRIMARY KEY,
measurement_ref INT,
category_magnitude DOUBLE,
complex_value COMPLEX,
FOREIGN KEY (measurement_ref) REFERENCES measurements(measurement_id),
FOREIGN KEY (category_magnitude) REFERENCES magnitude_categories(magnitude)
);
SHOW CREATE TABLE classified_signals;
Table	Create Table
classified_signals	CREATE TABLE `classified_signals` (
  `id` int NOT NULL,
  `measurement_ref` int DEFAULT NULL,
  `category_magnitude` double DEFAULT NULL,
  `complex_value` vsql_complex.COMPLEX DEFAULT NULL,
  PRIMARY KEY (`id`),
  KEY `measurement_ref` (`measurement_ref`),
  KEY `category_magnitude` (`category_magnitude`),
  CONSTRAINT `classified_signals_ibfk_1` FOREIGN KEY (`measurement_ref`) REFERENCES `measurements` (`measurement_id`),
  CONSTRAINT `classified_signals_ibfk_2` FOREIGN KEY (`category_magnitude`) REFERENCES `magnitude_categories` (`magnitude`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
INSERT INTO measurements (measurement_id, raw_signal) VALUES (1, '(3.0,4.0)');
INSERT INTO classified_signals VALUES (1, 1, 5.0, '(3.0,4.0)');
SELECT * FROM classified_signals;
id	measurement_ref	category_magnitude	complex_value
1	1	5	(3,4)
DROP TABLE classified_signals;
DROP TABLE magnitude_categories;
DROP TABLE measurements;
