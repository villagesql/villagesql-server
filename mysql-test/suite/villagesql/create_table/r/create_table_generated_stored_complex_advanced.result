CREATE TABLE t1 (
id INT PRIMARY KEY,
val COMPLEX,
magnitude DOUBLE GENERATED ALWAYS AS (COMPLEX_ABS(val)) STORED
);
INSERT INTO t1 (id, val) VALUES (1, NULL);
SELECT id, val, magnitude FROM t1;
id	val	magnitude
1	NULL	NULL
DROP TABLE t1;
CREATE TABLE t1 (
id INT PRIMARY KEY,
val COMPLEX,
magnitude DOUBLE GENERATED ALWAYS AS (COMPLEX_ABS(val)) STORED
);
INSERT INTO t1 (id, val) VALUES (1, '(3.0,4.0)');
SELECT id, magnitude FROM t1;
id	magnitude
1	5
UPDATE t1 SET val = '(5.0,12.0)' WHERE id = 1;
SELECT id, magnitude FROM t1;
id	magnitude
1	13
UPDATE t1 SET val = NULL WHERE id = 1;
SELECT id, magnitude FROM t1;
id	magnitude
1	NULL
DROP TABLE t1;
CREATE TABLE t1 (
id INT PRIMARY KEY,
val COMPLEX,
magnitude DOUBLE GENERATED ALWAYS AS (COMPLEX_ABS(val)) STORED,
real_part DOUBLE GENERATED ALWAYS AS (COMPLEX_REAL(val)) STORED
);
INSERT INTO t1 (id, val) VALUES (1, '(3.0,4.0)');
INSERT INTO t1 (id, val) VALUES (2, '(5.0,12.0)');
SELECT * FROM t1;
id	val	magnitude	real_part
1	(3,4)	5	3
2	(5,12)	13	5
DROP TABLE t1;
CREATE TABLE t1 (
id INT PRIMARY KEY,
val COMPLEX,
magnitude DOUBLE GENERATED ALWAYS AS (COMPLEX_ABS(val)) STORED,
INDEX idx_magnitude (magnitude)
);
INSERT INTO t1 (id, val) VALUES (1, '(3.0,4.0)');
INSERT INTO t1 (id, val) VALUES (2, '(5.0,12.0)');
INSERT INTO t1 (id, val) VALUES (3, '(8.0,6.0)');
SELECT id, magnitude FROM t1 WHERE magnitude > 9 ORDER BY magnitude;
id	magnitude
3	10
2	13
DROP TABLE t1;
CREATE TABLE t1 (
id INT PRIMARY KEY,
val COMPLEX,
magnitude DOUBLE GENERATED ALWAYS AS (COMPLEX_ABS(val)) STORED
);
INSERT INTO t1 (id, val) VALUES (1, '(3.0,4.0)');
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `id` int NOT NULL,
  `val` vsql_complex.COMPLEX DEFAULT NULL,
  `magnitude` double GENERATED ALWAYS AS (vsql_complex.complex_abs(`val`)) STORED,
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
DROP TABLE t1;
