ERROR HY000: Check constraint 't1_chk_2' is violated.
INSERT INTO t1 VALUES (6, '(5.0,5.0)', '(50.0,100.0)');
ERROR HY000: Check constraint 't1_chk_4' is violated.
DROP TABLE t1;
