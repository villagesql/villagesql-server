CREATE TABLE t1 (
id INT PRIMARY KEY,
input_signal COMPLEX,
output_signal COMPLEX,
CHECK (COMPLEX_ABS(input_signal) <= 100.0),
CHECK (COMPLEX_ABS(output_signal) <= 200.0),
CHECK (COMPLEX_REAL(input_signal) >= 0.0),
CHECK (COMPLEX_IMAG(output_signal) BETWEEN -50.0 AND 50.0)
);
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `id` int NOT NULL,
  `input_signal` vsql_complex.COMPLEX DEFAULT NULL,
  `output_signal` vsql_complex.COMPLEX DEFAULT NULL,
  PRIMARY KEY (`id`),
  CONSTRAINT `t1_chk_1` CHECK ((vsql_complex.complex_abs(`input_signal`) <= 100.0)),
  CONSTRAINT `t1_chk_2` CHECK ((vsql_complex.complex_abs(`output_signal`) <= 200.0)),
  CONSTRAINT `t1_chk_3` CHECK ((vsql_complex.complex_real(`input_signal`) >= 0.0)),
  CONSTRAINT `t1_chk_4` CHECK ((vsql_complex.complex_imag(`output_signal`) between -(50.0) and 50.0))
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
INSERT INTO t1 VALUES (1, '(10.0,20.0)', '(50.0,30.0)');
INSERT INTO t1 VALUES (2, '(5.0,0.0)', '(100.0,-25.0)');
SELECT * FROM t1;
