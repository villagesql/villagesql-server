CREATE TABLE signal_analysis (
measurement_id INT AUTO_INCREMENT PRIMARY KEY,
raw_signal COMPLEX NOT NULL,
reference_signal COMPLEX DEFAULT '(1.0,0.0)',
secondary_signal COMPLEX COMMENT 'Secondary measurement',
# Generated columns with COMPLEX functions
real_component DOUBLE GENERATED ALWAYS AS (COMPLEX_REAL(raw_signal)) VIRTUAL,
magnitude DOUBLE GENERATED ALWAYS AS (COMPLEX_ABS(raw_signal)) STORED,
# Functional indexes on computed values
INDEX idx_magnitude ((COMPLEX_ABS(raw_signal))),
INDEX idx_real_part ((COMPLEX_REAL(raw_signal))),
# Constraints on COMPLEX functions
CHECK (COMPLEX_ABS(raw_signal) > 0.0),
CHECK (COMPLEX_REAL(raw_signal) BETWEEN -1000.0 AND 1000.0)
) COMMENT='Comprehensive COMPLEX type test table';
SHOW CREATE TABLE signal_analysis;
Table	Create Table
signal_analysis	CREATE TABLE `signal_analysis` (
  `measurement_id` int NOT NULL AUTO_INCREMENT,
  `raw_signal` vsql_complex.COMPLEX NOT NULL,
  `reference_signal` vsql_complex.COMPLEX DEFAULT '(1,0)',
  `secondary_signal` vsql_complex.COMPLEX DEFAULT NULL COMMENT 'Secondary measurement',
  `real_component` double GENERATED ALWAYS AS (vsql_complex.complex_real(`raw_signal`)) VIRTUAL,
  `magnitude` double GENERATED ALWAYS AS (vsql_complex.complex_abs(`raw_signal`)) STORED,
  PRIMARY KEY (`measurement_id`),
  KEY `idx_magnitude` ((vsql_complex.complex_abs(`raw_signal`))),
  KEY `idx_real_part` ((vsql_complex.complex_real(`raw_signal`))),
  CONSTRAINT `signal_analysis_chk_1` CHECK ((vsql_complex.complex_abs(`raw_signal`) > 0.0)),
  CONSTRAINT `signal_analysis_chk_2` CHECK ((vsql_complex.complex_real(`raw_signal`) between -(1000.0) and 1000.0))
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci COMMENT='Comprehensive COMPLEX type test table'
