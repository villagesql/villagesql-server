ERROR HY000: Check constraint 'signal_analysis_chk_1' is violated.
SELECT measurement_id, raw_signal, magnitude,
COMPLEX_REAL(secondary_signal) as secondary_real
FROM signal_analysis
WHERE magnitude > 5.0;
measurement_id	raw_signal	magnitude	secondary_real
2	(5,12)	13	2
DROP TABLE signal_analysis;
