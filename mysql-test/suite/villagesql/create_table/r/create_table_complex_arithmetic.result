CREATE TABLE t1 (
id INT PRIMARY KEY,
input_a COMPLEX,
input_b COMPLEX,
sum_result COMPLEX GENERATED ALWAYS AS (COMPLEX_ADD(input_a, input_b)) VIRTUAL,
product_result COMPLEX GENERATED ALWAYS AS (COMPLEX_MULTIPLY(input_a, input_b)) VIRTUAL,
difference COMPLEX GENERATED ALWAYS AS (COMPLEX_SUBTRACT(input_a, input_b)) STORED,
quotient COMPLEX GENERATED ALWAYS AS (COMPLEX_DIVIDE(input_a, input_b)) STORED
);
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `id` int NOT NULL,
  `input_a` vsql_complex.COMPLEX DEFAULT NULL,
  `input_b` vsql_complex.COMPLEX DEFAULT NULL,
  `sum_result` vsql_complex.COMPLEX GENERATED ALWAYS AS (vsql_complex.complex_add(`input_a`,`input_b`)) VIRTUAL,
  `product_result` vsql_complex.COMPLEX GENERATED ALWAYS AS (vsql_complex.complex_multiply(`input_a`,`input_b`)) VIRTUAL,
  `difference` vsql_complex.COMPLEX GENERATED ALWAYS AS (vsql_complex.complex_subtract(`input_a`,`input_b`)) STORED,
  `quotient` vsql_complex.COMPLEX GENERATED ALWAYS AS (vsql_complex.complex_divide(`input_a`,`input_b`)) STORED,
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
INSERT INTO t1 (id, input_a, input_b) VALUES (1, '(2.0,3.0)', '(1.0,1.0)');
INSERT INTO t1 (id, input_a, input_b) VALUES (2, '(4.0,0.0)', '(2.0,0.0)');
INSERT INTO t1 (id, input_a, input_b) VALUES (3, '(0.0,0.0)', '(2.0,1.0)');
INSERT INTO t1 (id, input_a, input_b) VALUES (4, '(-1.0,0.0)', '(2.0,-1.0)');
SELECT * FROM t1 ORDER BY id;
id	input_a	input_b	sum_result	product_result	difference	quotient
1	(2,3)	(1,1)	(3,4)	(-1,5)	(1,2)	(2.5,0.5)
2	(4,0)	(2,0)	(6,0)	(8,0)	(2,0)	(2,0)
3	(0,0)	(2,1)	(2,1)	(0,0)	(-2,-1)	(0,0)
4	(-1,0)	(2,-1)	(1,-1)	(-2,1)	(-3,1)	(-0.4,-0.2)
UPDATE t1
SET input_a = '(-3.0,1.0)',
input_b = '(0.0,1.0)'
WHERE id = 1;
SELECT id, input_a, input_b, sum_result, product_result FROM t1 ORDER BY id;
