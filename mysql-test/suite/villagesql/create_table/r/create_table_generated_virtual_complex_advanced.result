CREATE TABLE t1 (
id INT PRIMARY KEY,
val COMPLEX,
real_part DOUBLE GENERATED ALWAYS AS (COMPLEX_REAL(val)) VIRTUAL
);
INSERT INTO t1 (id, val) VALUES (1, NULL);
SELECT id, val, real_part FROM t1;
id	val	real_part
1	NULL	NULL
DROP TABLE t1;
CREATE TABLE t1 (
id INT PRIMARY KEY,
val COMPLEX,
real_part DOUBLE GENERATED ALWAYS AS (COMPLEX_REAL(val)) VIRTUAL
);
INSERT INTO t1 (id, val) VALUES (1, '(3.0,4.0)');
SELECT id, real_part FROM t1;
id	real_part
1	3
UPDATE t1 SET val = '(5.0,12.0)' WHERE id = 1;
SELECT id, real_part FROM t1;
id	real_part
1	5
UPDATE t1 SET val = NULL WHERE id = 1;
SELECT id, real_part FROM t1;
id	real_part
1	NULL
DROP TABLE t1;
CREATE TABLE t1 (
id INT PRIMARY KEY,
val COMPLEX,
real_part DOUBLE GENERATED ALWAYS AS (COMPLEX_REAL(val)) VIRTUAL,
magnitude DOUBLE GENERATED ALWAYS AS (COMPLEX_ABS(val)) VIRTUAL
);
INSERT INTO t1 (id, val) VALUES (1, '(3.0,4.0)');
INSERT INTO t1 (id, val) VALUES (2, '(5.0,12.0)');
SELECT * FROM t1;
id	val	real_part	magnitude
1	(3,4)	3	5
2	(5,12)	5	13
DROP TABLE t1;
CREATE TABLE t1 (
id INT PRIMARY KEY,
val COMPLEX,
real_part DOUBLE GENERATED ALWAYS AS (COMPLEX_REAL(val)) VIRTUAL
);
INSERT INTO t1 (id, val) VALUES (1, '(3.0,4.0)');
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `id` int NOT NULL,
  `val` vsql_complex.COMPLEX DEFAULT NULL,
  `real_part` double GENERATED ALWAYS AS (vsql_complex.complex_real(`val`)) VIRTUAL,
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
DROP TABLE t1;
