# Advanced tests for stored generated columns with COMPLEX type
# Challenges: NULL handling, UPDATE recomputation, index usage,
# multiple generated columns, ALTER TABLE adding generated column,
# and SHOW CREATE TABLE round-trip.

--source include/villagesql/install_complex_extension.inc

# ---------------------------------------------------------------
# NULL handling: stored generated column on NULL input must be NULL
# ---------------------------------------------------------------
CREATE TABLE t1 (
    id INT PRIMARY KEY,
    val COMPLEX,
    magnitude DOUBLE GENERATED ALWAYS AS (COMPLEX_ABS(val)) STORED
);

INSERT INTO t1 (id, val) VALUES (1, NULL);
SELECT id, val, magnitude FROM t1;
DROP TABLE t1;

# ---------------------------------------------------------------
# UPDATE recomputation: stored value must reflect updated source
# ---------------------------------------------------------------
CREATE TABLE t1 (
    id INT PRIMARY KEY,
    val COMPLEX,
    magnitude DOUBLE GENERATED ALWAYS AS (COMPLEX_ABS(val)) STORED
);

INSERT INTO t1 (id, val) VALUES (1, '(3.0,4.0)');
SELECT id, magnitude FROM t1;

UPDATE t1 SET val = '(5.0,12.0)' WHERE id = 1;
SELECT id, magnitude FROM t1;

UPDATE t1 SET val = NULL WHERE id = 1;
SELECT id, magnitude FROM t1;

DROP TABLE t1;

# ---------------------------------------------------------------
# Multiple stored generated columns on the same source column
# ---------------------------------------------------------------
CREATE TABLE t1 (
    id INT PRIMARY KEY,
    val COMPLEX,
    magnitude DOUBLE GENERATED ALWAYS AS (COMPLEX_ABS(val)) STORED,
    real_part DOUBLE GENERATED ALWAYS AS (COMPLEX_REAL(val)) STORED
);

INSERT INTO t1 (id, val) VALUES (1, '(3.0,4.0)');
INSERT INTO t1 (id, val) VALUES (2, '(5.0,12.0)');
SELECT * FROM t1;

DROP TABLE t1;

# ---------------------------------------------------------------
# Index on stored generated column: range query uses stored value
# ---------------------------------------------------------------
CREATE TABLE t1 (
    id INT PRIMARY KEY,
    val COMPLEX,
    magnitude DOUBLE GENERATED ALWAYS AS (COMPLEX_ABS(val)) STORED,
    INDEX idx_magnitude (magnitude)
);

INSERT INTO t1 (id, val) VALUES (1, '(3.0,4.0)');
INSERT INTO t1 (id, val) VALUES (2, '(5.0,12.0)');
INSERT INTO t1 (id, val) VALUES (3, '(8.0,6.0)');

SELECT id, magnitude FROM t1 WHERE magnitude > 9 ORDER BY magnitude;

DROP TABLE t1;

# ---------------------------------------------------------------
# SHOW CREATE TABLE round-trip: re-execute the stored DDL
# ---------------------------------------------------------------
CREATE TABLE t1 (
    id INT PRIMARY KEY,
    val COMPLEX,
    magnitude DOUBLE GENERATED ALWAYS AS (COMPLEX_ABS(val)) STORED
);

INSERT INTO t1 (id, val) VALUES (1, '(3.0,4.0)');

SHOW CREATE TABLE t1;

DROP TABLE t1;

--source include/villagesql/uninstall_complex_extension.inc
