# Advanced tests for virtual generated columns with COMPLEX type
# Challenges: NULL handling, UPDATE recomputation, multiple generated
# columns, and SHOW CREATE TABLE round-trip.

--source include/villagesql/install_complex_extension.inc

# ---------------------------------------------------------------
# NULL handling: virtual generated column on NULL input must be NULL
# ---------------------------------------------------------------
CREATE TABLE t1 (
    id INT PRIMARY KEY,
    val COMPLEX,
    real_part DOUBLE GENERATED ALWAYS AS (COMPLEX_REAL(val)) VIRTUAL
);

INSERT INTO t1 (id, val) VALUES (1, NULL);
SELECT id, val, real_part FROM t1;
DROP TABLE t1;

# ---------------------------------------------------------------
# UPDATE recomputation: virtual value must reflect updated source
# ---------------------------------------------------------------
CREATE TABLE t1 (
    id INT PRIMARY KEY,
    val COMPLEX,
    real_part DOUBLE GENERATED ALWAYS AS (COMPLEX_REAL(val)) VIRTUAL
);

INSERT INTO t1 (id, val) VALUES (1, '(3.0,4.0)');
SELECT id, real_part FROM t1;

UPDATE t1 SET val = '(5.0,12.0)' WHERE id = 1;
SELECT id, real_part FROM t1;

UPDATE t1 SET val = NULL WHERE id = 1;
SELECT id, real_part FROM t1;

DROP TABLE t1;

# ---------------------------------------------------------------
# Multiple virtual generated columns on the same source column
# ---------------------------------------------------------------
CREATE TABLE t1 (
    id INT PRIMARY KEY,
    val COMPLEX,
    real_part DOUBLE GENERATED ALWAYS AS (COMPLEX_REAL(val)) VIRTUAL,
    magnitude DOUBLE GENERATED ALWAYS AS (COMPLEX_ABS(val)) VIRTUAL
);

INSERT INTO t1 (id, val) VALUES (1, '(3.0,4.0)');
INSERT INTO t1 (id, val) VALUES (2, '(5.0,12.0)');
SELECT * FROM t1;

DROP TABLE t1;

# ---------------------------------------------------------------
# SHOW CREATE TABLE round-trip
# ---------------------------------------------------------------
CREATE TABLE t1 (
    id INT PRIMARY KEY,
    val COMPLEX,
    real_part DOUBLE GENERATED ALWAYS AS (COMPLEX_REAL(val)) VIRTUAL
);

INSERT INTO t1 (id, val) VALUES (1, '(3.0,4.0)');
SHOW CREATE TABLE t1;
DROP TABLE t1;

--source include/villagesql/uninstall_complex_extension.inc
