# Percona's COLUMN_FORMAT COMPRESSED must be rejected on custom-typed columns.
#
# Why: the persisted bytes of a custom column are the extension's encoded form,
# not a plain string. For a type with extension-managed storage the clustered
# index record holds only an opaque 8-byte reference
# (vef_storage_col_ref_t) and the payload lives in the extension's arena,
# resolved on read by Custom_column::fetch(). Percona's column compression
# rewrites that same value in the same branch of
# row_sel_field_store_in_mysql_format_func (storage/innobase/include/row0sel.ic),
# so combining the two would compress -- or decompress -- something other than
# the column data. Neither combination has ever been tested.
#
# A custom type presents its extension-declared implementation_type() as
# sql_type, so a VARCHAR/BLOB/JSON-backed custom type would otherwise pass
# Percona's compressibility whitelist in mysql_prepare_create_table() and reach
# that branch. The rejection reuses Percona's existing error for
# non-compressible column types, ER_UNSUPPORTED_COMPRESSED_COLUMN_TYPE.
#
# This is currently a blanket restriction on all custom types -- see the
# TODO(villagesql) at the check in sql/sql_table.cc.

--source include/villagesql/install_complex_extension.inc

--echo #
--echo # CREATE TABLE must reject COLUMN_FORMAT COMPRESSED on a custom-typed column
--echo #
--error ER_UNSUPPORTED_COMPRESSED_COLUMN_TYPE
CREATE TABLE t1 (id INT PRIMARY KEY, value COMPLEX COLUMN_FORMAT COMPRESSED);

--echo # ... and with an explicit compression dictionary. The dictionary is
--echo # created for real, so this asserts the column-type rejection rather than
--echo # relying on ER_COMPRESSION_DICTIONARY_DOES_NOT_EXIST firing first.
CREATE COMPRESSION_DICTIONARY d1('blah');
--error ER_UNSUPPORTED_COMPRESSED_COLUMN_TYPE
CREATE TABLE t1 (id INT PRIMARY KEY,
                 value COMPLEX COLUMN_FORMAT COMPRESSED WITH COMPRESSION_DICTIONARY d1);

--echo #
--echo # The same column without COMPRESSED is still accepted, and a compressed
--echo # VARCHAR alongside it still works -- the restriction is scoped to custom
--echo # types, not to the table.
--echo #
CREATE TABLE t1 (id INT PRIMARY KEY,
                 value COMPLEX,
                 c VARCHAR(200) COLUMN_FORMAT COMPRESSED);
SHOW CREATE TABLE t1;
INSERT INTO t1 VALUES (1, '(1.0,2.0)', REPEAT('abc', 40));
SELECT id, value, LENGTH(c) FROM t1 ORDER BY id;

--echo #
--echo # ALTER TABLE ADD COLUMN must reject it too
--echo #
--error ER_UNSUPPORTED_COMPRESSED_COLUMN_TYPE
ALTER TABLE t1 ADD COLUMN v2 COMPLEX COLUMN_FORMAT COMPRESSED;

--echo #
--echo # ALTER TABLE MODIFY must not be able to add COMPRESSED to an existing
--echo # custom-typed column
--echo #
--error ER_UNSUPPORTED_COMPRESSED_COLUMN_TYPE
ALTER TABLE t1 MODIFY value COMPLEX COLUMN_FORMAT COMPRESSED;

--echo #
--echo # The reverse direction -- converting an already-COMPRESSED column into a
--echo # custom type -- is already blocked, by a stricter pre-existing VillageSQL
--echo # rule that forbids converting any existing column to a custom type
--echo # (villagesql/sql/metadata_modifier.cc). So it never reaches the
--echo # compression check. Asserted here to pin that down: if that rule is ever
--echo # relaxed, this case must start returning
--echo # ER_UNSUPPORTED_COMPRESSED_COLUMN_TYPE instead of silently succeeding.
--echo #
--error ER_VILLAGESQL_GENERIC_ERROR
ALTER TABLE t1 MODIFY c COMPLEX;

--echo # The pre-existing compressed VARCHAR is unaffected by the failed ALTERs
SHOW CREATE TABLE t1;
UPDATE t1 SET c = REPEAT('xyz', 50) WHERE id = 1;
SELECT id, value, LENGTH(c) FROM t1 ORDER BY id;

--echo #
--echo # A VARIABLE-length custom type is the decisive case. COMPLEX is
--echo # fixed-length (persisted_length), so it may fall outside Percona's
--echo # compressible type list on its own. TARRAY is variable-length, so it is
--echo # the case that actually exercises the custom-type guard rather than the
--echo # type list.
--echo #
INSTALL EXTENSION vsql_tarray_test;

--error ER_UNSUPPORTED_COMPRESSED_COLUMN_TYPE
CREATE TABLE t2 (id INT PRIMARY KEY,
                 a vsql_tarray_test.TARRAY(4) COLUMN_FORMAT COMPRESSED);

--echo # Accepted without COMPRESSED
CREATE TABLE t2 (id INT PRIMARY KEY, a vsql_tarray_test.TARRAY(4));

--error ER_UNSUPPORTED_COMPRESSED_COLUMN_TYPE
ALTER TABLE t2 ADD COLUMN b vsql_tarray_test.TARRAY(4) COLUMN_FORMAT COMPRESSED;

--error ER_UNSUPPORTED_COMPRESSED_COLUMN_TYPE
ALTER TABLE t2 MODIFY a vsql_tarray_test.TARRAY(4) COLUMN_FORMAT COMPRESSED;

DROP TABLE t2;
UNINSTALL EXTENSION vsql_tarray_test;

--echo # Cleanup
DROP TABLE t1;
DROP COMPRESSION_DICTIONARY d1;

--source include/villagesql/uninstall_complex_extension.inc
