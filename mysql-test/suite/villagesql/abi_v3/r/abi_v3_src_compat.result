# ABI v3 Source Compatibility Test
Found VillageSQL SDK paths
# Building test extension against current SDK
# Verify VEB was created
# Copy VEB to server's VEB directory
# Install the extension
INSTALL EXTENSION abi_v3_test;
# Verify extension is installed
SELECT extension_name, extension_version FROM INFORMATION_SCHEMA.EXTENSIONS
WHERE extension_name = 'abi_v3_test';
EXTENSION_NAME	EXTENSION_VERSION
abi_v3_test	0.0.1
# FAULT_BLOB type: encode/decode round-trip via type-method VDFs (v3 feature)
# Round-trip via type-method syntax (v3: :: syntax works for named VDF types)
SELECT abi_v3_test.FAULT_BLOB::to_string(abi_v3_test.FAULT_BLOB::from_string('OK hello')) AS roundtrip;
roundtrip
OK hello
# test_result_kind VDF: exercises VEF_RESULT_WARNING vs VEF_RESULT_ERROR
# Normal result
SELECT abi_v3_test.test_result_kind('anything') AS result;
result
42
# WARNING result
SELECT abi_v3_test.test_result_kind('WARN something went sideways') AS result;
result
NULL
Warnings:
Warning	3200	VDF error in function 'test_result_kind': something went sideways
# ERROR result
SELECT abi_v3_test.test_result_kind('ERROR fatal problem') AS result;
ERROR HY000: VDF error in function 'test_result_kind': fatal problem
# NULL input -> NULL output (IntResult::set_null)
SELECT abi_v3_test.test_result_kind(NULL) AS result;
result
NULL
# real_double VDF: RealArg, RealResult, .deterministic()
# Doubles the input value
SELECT abi_v3_test.real_double(1.5) AS result;
result
3.0
# NULL input -> NULL output (RealResult::set_null)
SELECT abi_v3_test.real_double(NULL) AS result;
result
NULL
# answer VDF: zero-arity, .no_params()
SELECT abi_v3_test.answer() AS result;
result
42
# FAULT_BLOB::hash: TypeHashFunc via type builder .hash()
# Hash used implicitly by COUNT(DISTINCT) on a custom type column
CREATE TABLE t_hash (v FAULT_BLOB);
INSERT INTO t_hash VALUES ('OK a'), ('OK b'), ('OK a');
SELECT COUNT(DISTINCT v) AS distinct_count FROM t_hash;
distinct_count
2
DROP TABLE t_hash;
# PVEC type, int_sum_all varargs VDF, pvec_norm_sq aggregate VDF
# Varargs: sum any number of INT arguments
SELECT abi_v3_test.int_sum_all(1, 2, 3) AS total;
total
6
SELECT abi_v3_test.int_sum_all(10) AS total;
total
10
SELECT abi_v3_test.int_sum_all(1, 2, 3, 4, 5) AS total;
total
15
# Varargs prerun rejects zero arguments
SELECT abi_v3_test.int_sum_all();
ERROR HY000: Can't initialize function 'int_sum_all'; int_sum_all requires at least one argument
# Varargs prerun rejects non-INT arguments
SELECT abi_v3_test.int_sum_all(1.5);
ERROR HY000: Can't initialize function 'int_sum_all'; int_sum_all: argument 0 must be INT
# Parameterized type: PVEC(N) column stores N int16 elements
CREATE TABLE t1 (
id INT PRIMARY KEY,
v PVEC(3)
);
INSERT INTO t1 VALUES (1, '[1,2,3]'), (2, '[4,5,6]'), (3, '[-1,0,1]');
SELECT id, v FROM t1 ORDER BY id;
id	v
1	[1,2,3]
2	[4,5,6]
3	[-1,0,1]
# Aggregate: per-group sum of squared elements
SELECT id, abi_v3_test.pvec_norm_sq(v) AS norm_sq FROM t1 GROUP BY id ORDER BY id;
id	norm_sq
1	14
2	77
3	2
# Aggregate: whole-table (1^2+2^2+3^2) + (4^2+5^2+6^2) + ((-1)^2+0^2+1^2) = 93
SELECT abi_v3_test.pvec_norm_sq(v) AS total_norm_sq FROM t1;
total_norm_sq
93
# Aggregate with HAVING: exclude groups with norm_sq <= 10
SELECT id, abi_v3_test.pvec_norm_sq(v) AS norm_sq
FROM t1
GROUP BY id
HAVING abi_v3_test.pvec_norm_sq(v) > 10
ORDER BY id;
id	norm_sq
1	14
2	77
# Aggregate ORDER BY descending
SELECT id, abi_v3_test.pvec_norm_sq(v) AS norm_sq
FROM t1
GROUP BY id
ORDER BY abi_v3_test.pvec_norm_sq(v) DESC;
id	norm_sq
2	77
1	14
3	2
# NULL handling: NULL rows are skipped by accumulate; only [3,4] contributes 25
CREATE TABLE t_nulls (
id INT,
v PVEC(2)
);
INSERT INTO t_nulls VALUES (1, '[3,4]'), (2, NULL);
SELECT abi_v3_test.pvec_norm_sq(v) AS norm_sq FROM t_nulls;
norm_sq
25
DROP TABLE t1, t_nulls;
# Uninstall extension
UNINSTALL EXTENSION abi_v3_test;
# Verify extension was removed
SELECT extension_name FROM INFORMATION_SCHEMA.EXTENSIONS
WHERE extension_name = 'abi_v3_test';
EXTENSION_NAME
# Cleanup
include/rpl/deprecated/show_binlog_events.inc
