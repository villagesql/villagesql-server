# A protocol 3 extension built against the stable SDK sees a NULL literal in
# its prerun as STRING, as it did when it was built.
#
# Requires: cmake in PATH, C++ compiler in PATH

--let $veb_dir = `SELECT @@veb_dir`
--let $test_dir = $MYSQLTEST_VARDIR/tmp/abi_v3_null_literal

--exec mkdir -p $MYSQLTEST_VARDIR/tmp
--source abi_v3_find_sdk.inc

--exec rm -rf $test_dir
--exec mkdir -p $test_dir/build
# unset LD_PRELOAD for the sanitizer builds; see abi_v3_bin_compat.test.
--exec sh -c "unset LD_PRELOAD && stable_sdk=\$(cat $MYSQLTEST_VARDIR/tmp/vsql_stable_sdk.txt) && cmake -S $MYSQL_TEST_DIR/suite/villagesql/abi_v3/std_data/abi_v3_null -B $test_dir/build -DCMAKE_PREFIX_PATH=\$stable_sdk > $test_dir/cmake_out.txt 2>&1"
--exec sh -c "unset LD_PRELOAD && cmake --build $test_dir/build > $test_dir/make_out.txt 2>&1"
--exec cp $test_dir/build/abi_v3_null.veb $veb_dir/

INSTALL EXTENSION abi_v3_null;
SELECT NEGOTIATED_PROTOCOL FROM INFORMATION_SCHEMA.EXTENSION_REGISTRATION
WHERE EXTENSION_NAME = 'abi_v3_null';

SELECT abi_v3_null.int_or_null_sum(1, NULL, 2) AS total;
SELECT abi_v3_null.int_or_null_sum(NULL) AS total;

UNINSTALL EXTENSION abi_v3_null;

--exec rm -rf $test_dir
--exec rm -f $veb_dir/abi_v3_null.veb
--exec rm -f $MYSQLTEST_VARDIR/tmp/vsql_source_dir.txt
--exec rm -f $MYSQLTEST_VARDIR/tmp/vsql_stable_sdk.txt
--exec rm -f $MYSQLTEST_VARDIR/tmp/vsql_dev_sdk_include.txt
