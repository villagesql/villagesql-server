#    ss COMPLEX
#);

#ALTER TABLE custom_type_columns_alter ADD COLUMN (ß COMPLEX);

#DROP TABLE custom_type_columns_alter;

DROP DATABASE test_collation;

--source include/villagesql/uninstall_complex_extension.inc
