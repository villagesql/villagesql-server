# Test UPDATE IGNORE with NULL on a NOT NULL COMPLEX2 column.
# COMPLEX2 has no intrinsic default registered, so this is a hard error.

--source include/villagesql/install_complex_extension.inc

CREATE TABLE t (
    id INT PRIMARY KEY,
    val COMPLEX2 NOT NULL
);

INSERT INTO t VALUES (1, '(3.0,4.0)');
--error ER_VILLAGESQL_GENERIC_ERROR
UPDATE IGNORE t SET val = NULL WHERE id = 1;
SELECT * FROM t;
DROP TABLE t;

--source include/villagesql/uninstall_complex_extension.inc
