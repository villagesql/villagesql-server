# Test UPDATE IGNORE with COMPLEX type
#
# This test verifies that when UPDATE IGNORE tries to set a NOT NULL COMPLEX
# column to NULL, it stores the implicit default value (0,0) instead of an
# invalid empty value. This behavior matches MySQL's handling of built-in types.

--source include/villagesql/install_complex_extension.inc

# Test implicit default behavior: UPDATE IGNORE with NULL on NOT NULL columns
# Compare DOUBLE vs COMPLEX side-by-side to verify consistent behavior
CREATE TABLE t_implicit_default (
    id INT PRIMARY KEY,
    val_double DOUBLE NOT NULL,
    val_complex COMPLEX NOT NULL
);

INSERT INTO t_implicit_default VALUES (1, 3.14, '(1.0,2.0)');

# Both should store their implicit defaults: 0 for DOUBLE, (0,0) for COMPLEX
UPDATE IGNORE t_implicit_default SET val_double = NULL, val_complex = NULL WHERE id = 1;
SELECT * FROM t_implicit_default;
DROP TABLE t_implicit_default;

# Now test UPDATE IGNORE with COMPLEX columns in more detail

CREATE TABLE t1 (
    id INT PRIMARY KEY,
    val COMPLEX NOT NULL,
    name VARCHAR(50)
);

INSERT INTO t1 VALUES
    (1, '(1.0,2.0)', 'one'),
    (2, '(0,0)', 'two'),
    (3, '(-3.5,4.5)', 'three'),
    (4, '(5.0,-6.0)', 'four'),
    (5, '(7.0,8.0)', 'five'),
    (6, '(9.0,10.0)', 'six');

# First verify UPDATE without IGNORE fails with NOT NULL violation
--error 1048
UPDATE t1 SET val = NULL WHERE id = 1;

# Verify no change occurred
SELECT * FROM t1 ORDER BY id;

# Now try UPDATE IGNORE - should store implicit default (0,0) like DOUBLE stores 0
UPDATE IGNORE t1 SET val = NULL WHERE id = 1;

# Verify the value was updated to implicit default (0,0)
SELECT * FROM t1 ORDER BY id;

# Test that nullable column can still be set to NULL
UPDATE IGNORE t1 SET name = NULL WHERE id = 1;
SELECT * FROM t1 ORDER BY id;

# Try to update multiple rows to NULL with IGNORE
UPDATE IGNORE t1 SET val = NULL WHERE id IN (3, 4);

# Verify they were updated to implicit default
SELECT * FROM t1 ORDER BY id;

# Test UPDATE IGNORE attempting to set all rows to NULL
UPDATE IGNORE t1 SET val = NULL;

# Verify all rows were updated to implicit default
SELECT * FROM t1 ORDER BY id;

DROP TABLE t1;

--source include/villagesql/uninstall_complex_extension.inc
