CREATE TABLE t_complex (id INT PRIMARY KEY, val COMPLEX NOT NULL);
INSERT INTO t_complex VALUES (1, '(1.0,2.0)');
UPDATE t_complex SET val = (SELECT '(7.0,7.0)') WHERE id = 1;
SELECT val FROM t_complex WHERE id = 1;
val
(7,7)
UPDATE t_complex SET val = (SELECT 'string_result') WHERE id = 1;
ERROR HY000: Incorrect COMPLEX value: 'string_result' for column 'val' at row 1
DROP TABLE t_complex;
