CREATE TABLE t_indexed (
id INT PRIMARY KEY,
val COMPLEX NOT NULL,
INDEX idx_val (val)
);
INSERT INTO t_indexed VALUES
(1, '(1.0,2.0)'),
(2, '(3.0,4.0)'),
(3, '(5.0,6.0)');
UPDATE IGNORE t_indexed SET val = NULL WHERE id = 2;
Warnings:
Warning	1048	Column 'val' cannot be null
SELECT * FROM t_indexed ORDER BY id;
id	val
1	(1,2)
2	(0,0)
3	(5,6)
SELECT * FROM t_indexed WHERE val = '(0,0)';
id	val
2	(0,0)
SELECT * FROM t_indexed WHERE val = '(3.0,4.0)';
id	val
DROP TABLE t_indexed;
CREATE TABLE t1 (
id INT PRIMARY KEY,
val COMPLEX NOT NULL
);
INSERT INTO t1 VALUES (1, '(1.0,2.0)'), (2, '(3.0,4.0)'), (3, '(5.0,6.0)');
UPDATE IGNORE t1 SET val = (SELECT NULL) WHERE id = 1;
Warnings:
Warning	1048	Column 'val' cannot be null
SELECT * FROM t1 ORDER BY id;
id	val
1	(0,0)
2	(3,4)
3	(5,6)
DROP TABLE t1;
CREATE TABLE t_mixed (
id INT PRIMARY KEY,
val COMPLEX NOT NULL,
score DOUBLE NOT NULL,
name VARCHAR(50)
);
INSERT INTO t_mixed VALUES
(1, '(1.0,2.0)', 9.9, 'alpha'),
(2, '(3.0,4.0)', 7.7, 'beta'),
(3, '(5.0,6.0)', 5.5, 'gamma');
UPDATE IGNORE t_mixed SET val = NULL, score = NULL, name = NULL WHERE id = 1;
Warnings:
Warning	1048	Column 'val' cannot be null
Warning	1048	Column 'score' cannot be null
SELECT * FROM t_mixed ORDER BY id;
id	val	score	name
1	(0,0)	0	NULL
2	(3,4)	7.7	beta
3	(5,6)	5.5	gamma
UPDATE IGNORE t_mixed SET val = NULL, score = 1.23, name = 'updated' WHERE id = 2;
Warnings:
Warning	1048	Column 'val' cannot be null
SELECT * FROM t_mixed ORDER BY id;
id	val	score	name
1	(0,0)	0	NULL
2	(0,0)	1.23	updated
3	(5,6)	5.5	gamma
DROP TABLE t_mixed;
CREATE TABLE t_main (
id INT PRIMARY KEY,
val COMPLEX NOT NULL
);
CREATE TABLE t_flags (
id INT PRIMARY KEY,
should_null TINYINT
);
INSERT INTO t_main VALUES (1, '(1.0,2.0)'), (2, '(3.0,4.0)'), (3, '(5.0,6.0)');
INSERT INTO t_flags VALUES (1, 1), (2, 0), (3, 1);
UPDATE IGNORE t_main
JOIN t_flags ON t_main.id = t_flags.id
SET t_main.val = NULL
WHERE t_flags.should_null = 1;
Warnings:
Warning	1048	Column 'val' cannot be null
Warning	1048	Column 'val' cannot be null
SELECT * FROM t_main ORDER BY id;
id	val
1	(0,0)
2	(3,4)
3	(0,0)
DROP TABLE t_main;
DROP TABLE t_flags;
