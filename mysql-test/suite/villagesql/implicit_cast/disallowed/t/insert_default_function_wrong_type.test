# Test INSERT with DEFAULT() function for wrong type

--source include/villagesql/install_complex_extension.inc

CREATE TABLE t_complex_default (
    id INT,
    complex_col COMPLEX DEFAULT '(0.0,0.0)',
    string_col VARCHAR(100) DEFAULT 'default_string'
);

--error ER_TRUNCATED_WRONG_VALUE_FOR_FIELD
INSERT INTO t_complex_default (id, complex_col, string_col) VALUES (1, DEFAULT(string_col), 'test');

DROP TABLE t_complex_default;

--source include/villagesql/uninstall_complex_extension.inc
