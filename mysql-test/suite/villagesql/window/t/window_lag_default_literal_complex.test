# LAG/LEAD with a string literal default for a COMPLEX value.
# Today the literal is not encoded to COMPLEX and the query fails with
# ER_INVALID_FIELD_VALUE (3219) "Invalid value in column 'lag_s'".

--source include/villagesql/not_implemented.inc

--source include/villagesql/install_complex_extension.inc

CREATE TABLE t1 (id INT PRIMARY KEY, val COMPLEX);
INSERT INTO t1 VALUES (1, '(1,1)'), (2, '(-2,3)'), (3, NULL);

SELECT id, val,
  LAG(val, 1, '(9,9)') OVER (ORDER BY id) AS lag_s,
  LEAD(val, 1, '(-9,9)') OVER (ORDER BY id) AS lead_s
FROM t1 ORDER BY id;

DROP TABLE t1;

--source include/villagesql/uninstall_complex_extension.inc
