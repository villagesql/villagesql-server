# Views whose definition uses window functions over COMPLEX.
--source include/villagesql/install_complex_extension.inc

CREATE TABLE t1 (id INT PRIMARY KEY, grp INT, val COMPLEX);
INSERT INTO t1 VALUES
  (1, 1, '(2,1)'), (2, 1, '(-3,0)'), (3, 1, '(2,1)'), (4, 1, '(2,-5)'),
  (5, 2, '(-1,-1)'), (6, 2, NULL), (7, 2, '(10,0)'), (8, 2, '(-1,-1)');

CREATE VIEW v1 AS
  SELECT id, grp, val,
    RANK() OVER (PARTITION BY grp ORDER BY val) AS rnk,
    LAG(val) OVER w AS lag_v
  FROM t1 WINDOW w AS (ORDER BY id);

SHOW CREATE VIEW v1;
SELECT * FROM v1 ORDER BY id;
# Filtering on the view must not be pushed below the window.
SELECT id, val, lag_v FROM v1 WHERE grp = 2 ORDER BY id;
SELECT id, rnk FROM v1 WHERE lag_v > '(0,0)' ORDER BY id;

CREATE VIEW v2 AS SELECT id, val FROM t1 WHERE val IS NOT NULL;
SELECT id, val, DENSE_RANK() OVER (ORDER BY val) AS drnk FROM v2 ORDER BY id;

# Value and aggregate window functions in a view.
CREATE VIEW v3 AS
  SELECT id, val,
    NTH_VALUE(val, 2) OVER (PARTITION BY grp ORDER BY val, id) AS nth,
    MIN(val) OVER (PARTITION BY grp) AS mn
  FROM t1;
SELECT * FROM v3 ORDER BY id;

DROP VIEW v1, v2, v3;
DROP TABLE t1;

--source include/villagesql/uninstall_complex_extension.inc
