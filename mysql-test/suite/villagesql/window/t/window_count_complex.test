# COUNT(col) as a window function over a COMPLEX column.
# Today CheckCustomTypeUsage rejects plain COUNT on custom types (only
# COUNT(DISTINCT) is allowed), failing with ER_WRONG_USAGE.

--source include/villagesql/not_implemented.inc

--source include/villagesql/install_complex_extension.inc

CREATE TABLE t1 (id INT PRIMARY KEY, grp INT, val COMPLEX);
INSERT INTO t1 VALUES
  (1, 1, '(2,1)'), (2, 1, '(-3,0)'), (3, 1, NULL), (4, 1, '(2,-5)'),
  (5, 2, '(-1,-1)'), (6, 2, '(10,0)');

SELECT id, grp, val,
  COUNT(val) OVER (PARTITION BY grp) AS cnt,
  COUNT(val) OVER (ORDER BY id ROWS BETWEEN 1 PRECEDING AND CURRENT ROW) AS cnt2
FROM t1 ORDER BY id;

DROP TABLE t1;

--source include/villagesql/uninstall_complex_extension.inc
