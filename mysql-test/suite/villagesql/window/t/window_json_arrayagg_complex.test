# JSON_ARRAYAGG over a COMPLEX column is rejected, as a window function and as
# a plain aggregate (CheckCustomTypeUsage does not allow it).
--source include/villagesql/install_complex_extension.inc

CREATE TABLE t1 (id INT PRIMARY KEY, grp INT, val COMPLEX);
INSERT INTO t1 VALUES
  (1, 1, '(2,1)'), (2, 1, '(-3,0)'), (3, 1, NULL), (4, 2, '(0,-5)');

--error ER_WRONG_USAGE
SELECT id, grp,
  JSON_ARRAYAGG(val) OVER (PARTITION BY grp ORDER BY id
    ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING) AS arr
FROM t1 ORDER BY id;

--error ER_WRONG_USAGE
SELECT JSON_ARRAYAGG(val) AS arr FROM t1 WHERE grp = 1;

DROP TABLE t1;

--source include/villagesql/uninstall_complex_extension.inc
