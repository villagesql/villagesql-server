# Window frames over COMPLEX values: sliding ROWS, RANGE peers, and RANGE
# offsets, which need a numeric or temporal ORDER BY.
--source include/villagesql/install_complex_extension.inc

CREATE TABLE t1 (id INT PRIMARY KEY, val COMPLEX);
INSERT INTO t1 VALUES
  (1, '(2,1)'), (2, '(-3,0)'), (3, '(2,1)'), (4, '(2,-5)'), (5, NULL);

SELECT id, val,
  FIRST_VALUE(val) OVER w AS fv,
  LAST_VALUE(val) OVER w AS lv,
  MAX(val) OVER w AS mx
FROM t1 WINDOW w AS (ORDER BY id ROWS BETWEEN 1 PRECEDING AND 1 FOLLOWING)
ORDER BY id;

# Empty frame at the end of the partition.
SELECT id, val,
  FIRST_VALUE(val) OVER (ORDER BY id ROWS BETWEEN 1 FOLLOWING AND 2 FOLLOWING)
    AS fv_next
FROM t1 ORDER BY id;

# RANGE CURRENT ROW spans exactly the peers of the COMPLEX value.
SELECT id, val,
  COUNT(*) OVER (ORDER BY val RANGE BETWEEN CURRENT ROW AND CURRENT ROW) AS peers,
  COUNT(*) OVER (ORDER BY val RANGE BETWEEN CURRENT ROW
                 AND UNBOUNDED FOLLOWING) AS ge
FROM t1 ORDER BY id;

--error ER_WINDOW_RANGE_FRAME_ORDER_TYPE
SELECT id, COUNT(*) OVER (ORDER BY val RANGE BETWEEN 1 PRECEDING AND CURRENT ROW)
FROM t1;

DROP TABLE t1;

--source include/villagesql/uninstall_complex_extension.inc
