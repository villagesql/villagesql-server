# Window ORDER BY on a COMPLEX column: ASC/DESC, NULL placement, and peer
# groups under the default RANGE frame.
--source include/villagesql/install_complex_extension.inc

CREATE TABLE t1 (id INT PRIMARY KEY, grp INT, val COMPLEX);
INSERT INTO t1 VALUES
  (1, 1, '(2,1)'), (2, 1, '(-3,0)'), (3, 1, '(2,1)'), (4, 1, '(2,-5)'),
  (5, 2, '(-1,-1)'), (6, 2, NULL), (7, 2, '(10,0)'), (8, 2, '(-1,-1)');

SELECT id, val, ROW_NUMBER() OVER (ORDER BY val, id) AS rn
FROM t1 ORDER BY rn;

SELECT id, val, ROW_NUMBER() OVER (ORDER BY val DESC, id) AS rn
FROM t1 ORDER BY rn;

# Default frame is RANGE UNBOUNDED PRECEDING, so peers share a value.
SELECT id, val,
  COUNT(*) OVER (ORDER BY val) AS cnt,
  SUM(id) OVER (ORDER BY val) AS sum_id
FROM t1 ORDER BY id;

SELECT id, val,
  FIRST_VALUE(val) OVER (ORDER BY val DESC) AS fv,
  LAST_VALUE(val) OVER (ORDER BY val DESC) AS lv
FROM t1 ORDER BY id;

SELECT id, grp, val,
  ROW_NUMBER() OVER (PARTITION BY grp ORDER BY val DESC, id) AS rn
FROM t1 ORDER BY id;

DROP TABLE t1;

--source include/villagesql/uninstall_complex_extension.inc
