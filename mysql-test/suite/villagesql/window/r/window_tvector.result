CREATE TABLE t1 (id INT PRIMARY KEY, grp INT, vec TVECTOR(3));
INSERT INTO t1 VALUES
(1, 1, '[1,2,3]'), (2, 1, '[-1,0,0]'), (3, 1, '[1,2,3]'),
(4, 2, '[1,2,-3]'), (5, 2, NULL);
SELECT id, vec,
RANK() OVER (ORDER BY vec) AS rnk,
COUNT(*) OVER (PARTITION BY vec) AS same_vec
FROM t1 ORDER BY id;
id	vec	rnk	same_vec
1	[1,2,3]	4	2
2	[-1,0,0]	2	1
3	[1,2,3]	4	2
4	[1,2,-3]	3	1
5	NULL	1	1
SELECT id, grp, vec,
LAG(vec) OVER (PARTITION BY grp ORDER BY id) AS lag_v,
FIRST_VALUE(vec) OVER (PARTITION BY grp ORDER BY vec DESC) AS fv,
MAX(vec) OVER (PARTITION BY grp) AS mx
FROM t1 ORDER BY id;
id	grp	vec	lag_v	fv	mx
1	1	[1,2,3]	NULL	[1,2,3]	[1,2,3]
2	1	[-1,0,0]	[1,2,3]	[1,2,3]	[1,2,3]
3	1	[1,2,3]	[-1,0,0]	[1,2,3]	[1,2,3]
4	2	[1,2,-3]	NULL	[1,2,-3]	[1,2,-3]
5	2	NULL	[1,2,-3]	[1,2,-3]	[1,2,-3]
DROP TABLE t1;
