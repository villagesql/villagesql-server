CREATE TABLE t1 (id INT PRIMARY KEY, grp INT, val COMPLEX);
INSERT INTO t1 VALUES
(1, 1, '(2,1)'), (2, 1, '(-3,0)'), (3, 1, '(2,1)'), (4, 1, '(2,-5)'),
(5, 2, '(-1,-1)'), (6, 2, NULL), (7, 2, '(10,0)'), (8, 2, '(-1,-1)');
SELECT id, val, ROW_NUMBER() OVER (ORDER BY val, id) AS rn
FROM t1 ORDER BY rn;
id	val	rn
6	NULL	1
2	(-3,0)	2
5	(-1,-1)	3
8	(-1,-1)	4
4	(2,-5)	5
1	(2,1)	6
3	(2,1)	7
7	(10,0)	8
SELECT id, val, ROW_NUMBER() OVER (ORDER BY val DESC, id) AS rn
FROM t1 ORDER BY rn;
id	val	rn
7	(10,0)	1
1	(2,1)	2
3	(2,1)	3
4	(2,-5)	4
5	(-1,-1)	5
8	(-1,-1)	6
2	(-3,0)	7
6	NULL	8
SELECT id, val,
COUNT(*) OVER (ORDER BY val) AS cnt,
SUM(id) OVER (ORDER BY val) AS sum_id
FROM t1 ORDER BY id;
id	val	cnt	sum_id
1	(2,1)	7	29
2	(-3,0)	2	8
3	(2,1)	7	29
4	(2,-5)	5	25
5	(-1,-1)	4	21
6	NULL	1	6
7	(10,0)	8	36
8	(-1,-1)	4	21
SELECT id, val,
FIRST_VALUE(val) OVER (ORDER BY val DESC) AS fv,
LAST_VALUE(val) OVER (ORDER BY val DESC) AS lv
FROM t1 ORDER BY id;
id	val	fv	lv
1	(2,1)	(10,0)	(2,1)
2	(-3,0)	(10,0)	(-3,0)
3	(2,1)	(10,0)	(2,1)
4	(2,-5)	(10,0)	(2,-5)
5	(-1,-1)	(10,0)	(-1,-1)
6	NULL	(10,0)	NULL
7	(10,0)	(10,0)	(10,0)
8	(-1,-1)	(10,0)	(-1,-1)
SELECT id, grp, val,
ROW_NUMBER() OVER (PARTITION BY grp ORDER BY val DESC, id) AS rn
FROM t1 ORDER BY id;
id	grp	val	rn
1	1	(2,1)	1
2	1	(-3,0)	4
3	1	(2,1)	2
4	1	(2,-5)	3
5	2	(-1,-1)	2
6	2	NULL	4
7	2	(10,0)	1
8	2	(-1,-1)	3
DROP TABLE t1;
