CREATE TABLE t1 (id INT PRIMARY KEY, grp INT, val COMPLEX);
INSERT INTO t1 VALUES
(1, 1, '(2,1)'), (2, 1, '(-3,0)'), (3, 1, NULL), (4, 1, '(2,-5)'),
(5, 2, '(-1,-1)'), (6, 2, '(10,0)');
SELECT id, grp, val,
MIN(val) OVER (PARTITION BY grp) AS mn,
MAX(val) OVER (PARTITION BY grp) AS mx
FROM t1 ORDER BY id;
id	grp	val	mn	mx
1	1	(2,1)	(-3,0)	(2,1)
2	1	(-3,0)	(-3,0)	(2,1)
3	1	NULL	(-3,0)	(2,1)
4	1	(2,-5)	(-3,0)	(2,1)
5	2	(-1,-1)	(-1,-1)	(10,0)
6	2	(10,0)	(-1,-1)	(10,0)
SELECT id, val,
MIN(val) OVER (ORDER BY id) AS run_min,
MAX(val) OVER (ORDER BY id) AS run_max
FROM t1 ORDER BY id;
id	val	run_min	run_max
1	(2,1)	(2,1)	(2,1)
2	(-3,0)	(-3,0)	(2,1)
3	NULL	(-3,0)	(2,1)
4	(2,-5)	(-3,0)	(2,1)
5	(-1,-1)	(-3,0)	(2,1)
6	(10,0)	(-3,0)	(10,0)
SELECT id, SUM(val) OVER () FROM t1;
ERROR HY000: Incorrect usage of sum and COMPLEX
SELECT id, AVG(val) OVER (PARTITION BY grp) FROM t1;
ERROR HY000: Incorrect usage of avg and COMPLEX
DROP TABLE t1;
