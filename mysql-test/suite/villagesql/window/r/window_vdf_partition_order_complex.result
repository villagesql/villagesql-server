CREATE TABLE t1 (id INT PRIMARY KEY, val COMPLEX);
INSERT INTO t1 VALUES
(1, '(3,4)'), (2, '(-3,-4)'), (3, '(0,5)'), (4, '(1,1)'), (5, '(3,-4)'),
(6, NULL);
SELECT id, val,
RANK() OVER (ORDER BY vsql_complex.complex_abs(val)) AS rnk_abs,
COUNT(*) OVER (PARTITION BY vsql_complex.complex_abs(val)) AS same_abs
FROM t1 ORDER BY id;
id	val	rnk_abs	same_abs
1	(3,4)	3	4
2	(-3,-4)	3	4
3	(0,5)	3	4
4	(1,1)	2	1
5	(3,-4)	3	4
6	NULL	1	1
SELECT id, val,
ROW_NUMBER() OVER (ORDER BY vsql_complex.complex_conjugate(val), id) AS rn
FROM t1 ORDER BY id;
id	val	rn
1	(3,4)	5
2	(-3,-4)	2
3	(0,5)	3
4	(1,1)	4
5	(3,-4)	6
6	NULL	1
SELECT id, val,
COUNT(*) OVER (PARTITION BY vsql_complex.complex_real(val)) AS same_re,
FIRST_VALUE(val) OVER (PARTITION BY vsql_complex.complex_real(val)
ORDER BY val DESC) AS fv
FROM t1 ORDER BY id;
id	val	same_re	fv
1	(3,4)	2	(3,4)
2	(-3,-4)	1	(-3,-4)
3	(0,5)	1	(0,5)
4	(1,1)	1	(1,1)
5	(3,-4)	2	(3,4)
6	NULL	1	NULL
SELECT id, val,
COUNT(*) OVER (PARTITION BY vsql_complex.complex_multiply(val, val)) AS sq
FROM t1 ORDER BY id;
id	val	sq
1	(3,4)	2
2	(-3,-4)	2
3	(0,5)	1
4	(1,1)	1
5	(3,-4)	1
6	NULL	1
DROP TABLE t1;
