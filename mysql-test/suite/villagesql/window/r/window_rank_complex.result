CREATE TABLE t1 (id INT PRIMARY KEY, grp INT, val COMPLEX);
INSERT INTO t1 VALUES
(1, 1, '(2,1)'), (2, 1, '(-3,0)'), (3, 1, '(2,1)'), (4, 1, '(2,-5)'),
(5, 2, '(-1,-1)'), (6, 2, NULL), (7, 2, '(10,0)'), (8, 2, '(-1,-1)');
SELECT id, val,
RANK() OVER w AS rnk,
DENSE_RANK() OVER w AS drnk,
PERCENT_RANK() OVER w AS prnk,
CUME_DIST() OVER w AS cdist
FROM t1 WINDOW w AS (ORDER BY val)
ORDER BY id;
id	val	rnk	drnk	prnk	cdist
1	(2,1)	6	5	0.7142857142857143	0.875
2	(-3,0)	2	2	0.14285714285714285	0.25
3	(2,1)	6	5	0.7142857142857143	0.875
4	(2,-5)	5	4	0.5714285714285714	0.625
5	(-1,-1)	3	3	0.2857142857142857	0.5
6	NULL	1	1	0	0.125
7	(10,0)	8	6	1	1
8	(-1,-1)	3	3	0.2857142857142857	0.5
SELECT id, val,
RANK() OVER (ORDER BY val DESC) AS rnk,
DENSE_RANK() OVER (ORDER BY val DESC) AS drnk
FROM t1 ORDER BY id;
id	val	rnk	drnk
1	(2,1)	2	2
2	(-3,0)	7	5
3	(2,1)	2	2
4	(2,-5)	4	3
5	(-1,-1)	5	4
6	NULL	8	6
7	(10,0)	1	1
8	(-1,-1)	5	4
SELECT id, grp, val,
RANK() OVER (PARTITION BY grp ORDER BY val) AS rnk,
DENSE_RANK() OVER (PARTITION BY grp ORDER BY val) AS drnk
FROM t1 ORDER BY id;
id	grp	val	rnk	drnk
1	1	(2,1)	3	3
2	1	(-3,0)	1	1
3	1	(2,1)	3	3
4	1	(2,-5)	2	2
5	2	(-1,-1)	2	2
6	2	NULL	1	1
7	2	(10,0)	4	3
8	2	(-1,-1)	2	2
SELECT id, val, NTILE(3) OVER (ORDER BY val, id) AS bucket
FROM t1 ORDER BY id;
id	val	bucket
1	(2,1)	2
2	(-3,0)	1
3	(2,1)	3
4	(2,-5)	2
5	(-1,-1)	1
6	NULL	1
7	(10,0)	3
8	(-1,-1)	2
SELECT id, val, RANK() OVER (PARTITION BY val ORDER BY id) AS rnk
FROM t1 ORDER BY id;
id	val	rnk
1	(2,1)	1
2	(-3,0)	1
3	(2,1)	2
4	(2,-5)	1
5	(-1,-1)	1
6	NULL	1
7	(10,0)	1
8	(-1,-1)	2
DROP TABLE t1;
