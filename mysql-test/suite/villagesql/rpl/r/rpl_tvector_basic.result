CREATE TABLE t1 (
id INT PRIMARY KEY,
vec TVECTOR(3)
);
INSERT INTO t1 VALUES (1, '[1.0,2.0,3.0]'), (2, '[4.5,5.5,6.5]'), (3, '[-1.0,0.0,1.0]');
SELECT * FROM t1 ORDER BY id;
id	vec
1	[1,2,3]
2	[4.5,5.5,6.5]
3	[-1,0,1]
include/rpl/sync_to_replica.inc
SELECT * FROM t1 ORDER BY id;
id	vec
1	[1,2,3]
2	[4.5,5.5,6.5]
3	[-1,0,1]
include/diff_tables.inc [master:t1, slave:t1]
UPDATE t1 SET vec = '[7.0,8.0,9.0]' WHERE id = 1;
