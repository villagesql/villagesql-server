# A statement that fails part way is rolled back on its own: the index entries
# of the rows it had already inserted or updated are undone, and the
# transaction's earlier statements are kept.

INSTALL EXTENSION vsql_knn_index_test;
--source suite/knn_review/include/knn_table.inc
START TRANSACTION;
UPDATE t SET v = '[9,9,9,9]' WHERE id = 6;
--echo # A multi-row INSERT that fails on its last row
--error ER_DUP_ENTRY
INSERT INTO t VALUES (9, 1, 'i', '[1,0,0.1,0]'), (10, 1, 'j', '[1,0,0,0.2]'), (1, 1, 'a', '[1,0,0,0]');
SELECT id FROM t ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]') LIMIT 8;
--echo # A multi-row UPDATE of the vector that fails on its fifth row
--error ER_DATA_TOO_LONG
UPDATE t SET v = '[9,9,9,8]', pay = IF(id = 5, 'xxxxxxxxxxxxxxxx', pay) ORDER BY id;
SELECT id FROM t ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]') LIMIT 8;
COMMIT;
SELECT id FROM t ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]') LIMIT 8;
SELECT COUNT(*) FROM t;
DROP TABLE t;
UNINSTALL EXTENSION vsql_knn_index_test;
