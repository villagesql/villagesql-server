# ROLLBACK TO SAVEPOINT undoes the changes after the savepoint and keeps those
# before it; a full rollback then undoes the rest.

INSTALL EXTENSION vsql_knn_index_test;
--source suite/knn_review/include/knn_table.inc
START TRANSACTION;
UPDATE t SET v = '[9,9,9,9]' WHERE id = 1;
SAVEPOINT s;
DELETE FROM t WHERE id = 4;
INSERT INTO t VALUES (9, 1, 'i', '[1,0,0.1,0]');
UPDATE t SET v = '[0,0,0,0.5]' WHERE id = 7;
ROLLBACK TO SAVEPOINT s;
SELECT id FROM t ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]') LIMIT 8;
ROLLBACK;
SELECT id FROM t ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]') LIMIT 8;
DROP TABLE t;
UNINSTALL EXTENSION vsql_knn_index_test;
