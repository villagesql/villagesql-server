# A prepared XA transaction that changed an HNSW index (vsql-vector) survives a
# kill and restart: XA RECOVER lists it, KNN reads see the table without its
# changes, and its rows stay locked. XA ROLLBACK then undoes the changes and
# XA COMMIT makes them visible. The changes are an insert, a delete and a vector
# update.

--disable_query_log
call mtr.add_suppression("Found 1 prepared XA transactions");
--enable_query_log

INSTALL EXTENSION vsql_vector;
CREATE TABLE t (id INT PRIMARY KEY, grp INT, pay VARCHAR(10), v SVECTOR(4), KEY k_grp (grp));
CREATE INDEX idx_v ON t (v) USING EXTENDED(vsql_vector.hnsw);
INSERT INTO t VALUES (1, 1, 'a', '[1,0,0,0]'), (2, 1, 'b', '[0,1,0,0]'), (3, 2, 'c', '[0,0,2,0]'), (4, 2, 'd', '[1,1,0,0]'), (5, 3, 'e', '[2.5,0,0,0]'), (6, 3, 'f', '[4,0,0,0]'), (7, 1, 'g', '[0,0,0,3]'), (8, 2, 'h', '[1,0,1.2,0]');
--echo # XA ROLLBACK after the restart
XA START 'x1';
INSERT INTO t VALUES (9, 1, 'i', '[1,0,0,0.1]');
DELETE FROM t WHERE id = 4;
UPDATE t SET v = '[9,9,9,9]' WHERE id = 1;
XA END 'x1';
XA PREPARE 'x1';
--source include/kill_and_restart_mysqld.inc
XA RECOVER;
SELECT COUNT(*) AS n FROM t;
SELECT id FROM t ORDER BY vsql_vector.l2_distance(v, '[1,0,0,0]') LIMIT 8;
--error ER_LOCK_NOWAIT
SELECT id FROM t WHERE id = 1 FOR UPDATE NOWAIT;
XA ROLLBACK 'x1';
SELECT COUNT(*) AS n FROM t;
SELECT id FROM t ORDER BY vsql_vector.l2_distance(v, '[1,0,0,0]') LIMIT 8;
SET SESSION TRANSACTION ISOLATION LEVEL READ COMMITTED;
START TRANSACTION;
SELECT id FROM t ORDER BY vsql_vector.l2_distance(v, '[1,0,0,0]') LIMIT 3 FOR UPDATE;
SELECT id FROM t ORDER BY vsql_vector.l2_distance(v, '[1,0,0,0]') LIMIT 8 FOR UPDATE;
COMMIT;
SET SESSION TRANSACTION ISOLATION LEVEL REPEATABLE READ;
--echo # XA COMMIT after the restart
XA START 'x2';
INSERT INTO t VALUES (9, 1, 'i', '[1,0,0,0.1]');
DELETE FROM t WHERE id = 4;
UPDATE t SET v = '[9,9,9,9]' WHERE id = 1;
XA END 'x2';
XA PREPARE 'x2';
--source include/kill_and_restart_mysqld.inc
XA RECOVER;
SELECT COUNT(*) AS n FROM t;
SELECT id FROM t ORDER BY vsql_vector.l2_distance(v, '[1,0,0,0]') LIMIT 8;
--error ER_LOCK_NOWAIT
SELECT id FROM t WHERE id = 1 FOR UPDATE NOWAIT;
XA COMMIT 'x2';
SELECT COUNT(*) AS n FROM t;
SELECT id FROM t ORDER BY vsql_vector.l2_distance(v, '[1,0,0,0]') LIMIT 8;
DROP TABLE t;
UNINSTALL EXTENSION vsql_vector;
