# The same as snapshot_delete, with an index type that advertises MVCC_VISIBILITY (it
# filters entries by the reader's view itself).

--let $knn_issue = NYI-1 DELETE on a table with a KNN index is not implemented yet
--source suite/knn_review/include/known_issue.inc

--source include/count_sessions.inc

INSTALL EXTENSION vsql_knn_index_test;
--let $knn_index_type = kvec_l2_mvcc
--let $knn_profile = kvec_profile_l2_mvcc
--source suite/knn_review/include/require_index_type.inc
CREATE TABLE t (id INT PRIMARY KEY, v KVECTOR);
CREATE INDEX idx_v ON t (v kvec_profile_l2_mvcc) USING EXTENDED(vsql_knn_index_test.kvec_l2_mvcc);
INSERT INTO t VALUES (1, '[1,0,0,0]'), (4, '[1,1,0,0]'), (8, '[1,0,1.2,0]');
START TRANSACTION WITH CONSISTENT SNAPSHOT;
--connect (con1, localhost, root,,)
DELETE FROM t WHERE id = 4;
--connection default
SELECT id FROM t ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]') LIMIT 3;
COMMIT;
SELECT id FROM t ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]') LIMIT 3;
--disconnect con1
DROP TABLE t;
UNINSTALL EXTENSION vsql_knn_index_test;
--source include/wait_until_count_sessions.inc
