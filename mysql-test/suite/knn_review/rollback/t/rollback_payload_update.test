# A transaction sees its own uncommitted payload update, KNN results are
# unchanged by it, and a rollback restores the old value.

INSTALL EXTENSION vsql_knn_index_test;
--source suite/knn_review/include/knn_table.inc
START TRANSACTION;
UPDATE t SET pay = 'zz' WHERE id = 1;
SELECT pay FROM t WHERE id = 1;
SELECT id, pay FROM t ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]') LIMIT 3;
ROLLBACK;
SELECT id, pay FROM t ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]') LIMIT 3;
DROP TABLE t;
UNINSTALL EXTENSION vsql_knn_index_test;
