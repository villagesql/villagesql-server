# Changes of a transaction that is still open when the server is killed are
# rolled back at restart, in the HNSW index (vsql-vector) too: an insert, a
# delete and a vector update. KNN reads afterwards return the table as it was
# before the transaction.

--let $knn_issue = KNN-25 Restart after a crash asserts in redo recovery on a PK mapping B-tree record
--source suite/knn_review/include/known_issue.inc

INSTALL EXTENSION vsql_vector;
CREATE TABLE t (id INT PRIMARY KEY, grp INT, pay VARCHAR(10), v SVECTOR(4), KEY k_grp (grp));
CREATE INDEX idx_v ON t (v) USING EXTENDED(vsql_vector.hnsw);
INSERT INTO t VALUES (1, 1, 'a', '[1,0,0,0]'), (2, 1, 'b', '[0,1,0,0]'), (3, 2, 'c', '[0,0,2,0]'), (4, 2, 'd', '[1,1,0,0]'), (5, 3, 'e', '[2.5,0,0,0]'), (6, 3, 'f', '[4,0,0,0]'), (7, 1, 'g', '[0,0,0,3]'), (8, 2, 'h', '[1,0,1.2,0]');
--connect (con1, localhost, root,,)
START TRANSACTION;
INSERT INTO t VALUES (9, 1, 'i', '[1,0,0,0.1]');
DELETE FROM t WHERE id = 4;
UPDATE t SET v = '[9,9,9,9]' WHERE id = 1;
--connection default
--source include/kill_and_restart_mysqld.inc
--disconnect con1
--let $wait_timeout = 60
--let $wait_condition = SELECT COUNT(*) = 0 FROM information_schema.innodb_trx
--source include/wait_condition.inc
SELECT COUNT(*) AS n FROM t;
SELECT id FROM t ORDER BY vsql_vector.l2_distance(v, '[1,0,0,0]') LIMIT 8;
SELECT id FROM t ORDER BY vsql_vector.l2_distance(v, '[1,0,0,0]') LIMIT 3;
SET SESSION TRANSACTION ISOLATION LEVEL READ COMMITTED;
START TRANSACTION;
SELECT id FROM t ORDER BY vsql_vector.l2_distance(v, '[1,0,0,0]') LIMIT 3 FOR UPDATE;
COMMIT;
SET SESSION TRANSACTION ISOLATION LEVEL REPEATABLE READ;
--echo # The index takes new changes after recovery
INSERT INTO t VALUES (9, 1, 'i', '[1,0,0,0.1]');
DELETE FROM t WHERE id = 4;
SELECT id FROM t ORDER BY vsql_vector.l2_distance(v, '[1,0,0,0]') LIMIT 3;
DROP TABLE t;
UNINSTALL EXTENSION vsql_vector;
