# Another session's uncommitted insert and payload update are invisible to KNN
# reads at READ COMMITTED and REPEATABLE READ, and visible once committed.

--source include/count_sessions.inc

INSTALL EXTENSION vsql_knn_index_test;
--source suite/knn_review/include/knn_table.inc
--connect (con1, localhost, root,,)
START TRANSACTION;
INSERT INTO t VALUES (9, 1, 'i', '[1,0,0.1,0]');
UPDATE t SET pay = 'zz' WHERE id = 1;
--connection default
SET SESSION TRANSACTION ISOLATION LEVEL READ COMMITTED;
SELECT id FROM t ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]') LIMIT 3;
SET SESSION TRANSACTION ISOLATION LEVEL REPEATABLE READ;
SELECT id FROM t ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]') LIMIT 3;
--connection con1
COMMIT;
--disconnect con1
--connection default
SELECT id FROM t ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]') LIMIT 3;
DROP TABLE t;
UNINSTALL EXTENSION vsql_knn_index_test;
--source include/wait_until_count_sessions.inc
