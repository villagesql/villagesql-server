START TRANSACTION;
# Insert rows 1001 to 3000, apart from the others (first coordinate + 1000)
DELETE FROM t WHERE id % 3 = 0;
UPDATE t SET grp = 2 WHERE id % 7 = 0;
# Move the vectors of rows 101 to 120 to [4000 + id,0,0,0]
UPDATE t SET id = id + 100000 WHERE id BETWEEN 501 AND 520;
# Kill and restart
# Right after the restart; the rollback may still be running
SELECT COUNT(*) AS n, SUM(id) AS sid, SUM(grp) AS sgrp FROM t;
n	sid	sgrp
1000	500500	1000
