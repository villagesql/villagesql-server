SET SESSION TRANSACTION ISOLATION LEVEL READ COMMITTED;
START TRANSACTION;
SELECT id FROM t ORDER BY vsql_vector.l2_distance(v, '[45.24,55.98,92.42,46.57]') LIMIT 5 FOR UPDATE;
id
790
582
968
965
664
COMMIT;
SET SESSION TRANSACTION ISOLATION LEVEL REPEATABLE READ;
# The index takes new changes after recovery
INSERT INTO t VALUES (9000, 1, 'x', '[23.81,54.42,37,60.39]');
DELETE FROM t WHERE id = 2;
SELECT COUNT(*) AS n, SUM(id) AS sid, SUM(grp) AS sgrp FROM t;
n	sid	sgrp
1000	509498	1000
