INSTALL EXTENSION vsql_vector;
CREATE TABLE t (id INT PRIMARY KEY, grp INT, pay VARCHAR(10), v SVECTOR(4), KEY k_grp (grp));
CREATE INDEX idx_v ON t (v) USING EXTENDED(vsql_vector.hnsw);
# Insert rows 1 to 1500
SET GLOBAL innodb_log_checkpoint_now = ON;
SET GLOBAL innodb_page_cleaner_disabled_debug = ON;
SET GLOBAL innodb_checkpoint_disabled = ON;
# Insert rows 1501 to 3000
START TRANSACTION;
DELETE FROM t WHERE id % 10 = 0;
UPDATE t SET grp = 2 WHERE id % 7 = 0;
# Move the vectors of rows 101 to 120 to [4000 + id,0,0,0]
UPDATE t SET id = id + 100000 WHERE id BETWEEN 501 AND 520;
COMMIT;
SELECT COUNT(*) AS n, SUM(id) AS sid, SUM(grp) AS sgrp FROM t;
n	sid	sgrp
2700	5850000	3086
