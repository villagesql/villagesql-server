INSTALL EXTENSION vsql_knn_index_test;
START TRANSACTION;
UPDATE t SET v = '[9,9,9,9]' WHERE id = 1;
START TRANSACTION;
INSERT INTO t VALUES (20, 1, 'p', '[7,7,7,7]'), (21, 1, 'q', '[7,7,7,8]'), (22, 1, 'r', '[7,7,8,7]');
UPDATE t SET v = '[8,8,8,8]' WHERE id = 4;
UPDATE t SET pay = 'x' WHERE id = 4;
UPDATE t SET pay = 'y' WHERE id = 1;
ERROR 40001: Deadlock found when trying to get lock; try restarting transaction
COMMIT;
