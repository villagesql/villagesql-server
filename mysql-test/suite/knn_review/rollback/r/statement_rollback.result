INSTALL EXTENSION vsql_knn_index_test;
START TRANSACTION;
UPDATE t SET v = '[9,9,9,9]' WHERE id = 6;
# A multi-row INSERT that fails on its last row
INSERT INTO t VALUES (9, 1, 'i', '[1,0,0.1,0]'), (10, 1, 'j', '[1,0,0,0.2]'), (1, 1, 'a', '[1,0,0,0]');
ERROR 23000: Duplicate entry '1' for key 't.PRIMARY'
SELECT id FROM t ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]') LIMIT 8;
id
1
4
8
2
5
3
7
6
# A multi-row UPDATE of the vector that fails on its fifth row
UPDATE t SET v = '[9,9,9,8]', pay = IF(id = 5, 'xxxxxxxxxxxxxxxx', pay) ORDER BY id;
ERROR 22001: Data too long for column 'pay' at row 5
SELECT id FROM t ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]') LIMIT 8;
id
1
4
8
2
5
3
7
6
COMMIT;
SELECT id FROM t ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]') LIMIT 8;
id
1
4
8
2
5
3
7
6
SELECT COUNT(*) FROM t;
COUNT(*)
8
DROP TABLE t;
UNINSTALL EXTENSION vsql_knn_index_test;
