INSTALL EXTENSION vsql_vector;
CREATE TABLE t (id INT PRIMARY KEY, grp INT, pay VARCHAR(10), v SVECTOR(4), KEY k_grp (grp));
CREATE INDEX idx_v ON t (v) USING EXTENDED(vsql_vector.hnsw);
INSERT INTO t VALUES (1, 1, 'a', '[1,0,0,0]'), (2, 1, 'b', '[0,1,0,0]'), (3, 2, 'c', '[0,0,2,0]'), (4, 2, 'd', '[1,1,0,0]'), (5, 3, 'e', '[2.5,0,0,0]'), (6, 3, 'f', '[4,0,0,0]'), (7, 1, 'g', '[0,0,0,3]'), (8, 2, 'h', '[1,0,1.2,0]');
# XA ROLLBACK after the restart
XA START 'x1';
INSERT INTO t VALUES (9, 1, 'i', '[1,0,0,0.1]');
DELETE FROM t WHERE id = 4;
UPDATE t SET v = '[9,9,9,9]' WHERE id = 1;
XA END 'x1';
XA PREPARE 'x1';
# Kill and restart
XA RECOVER;
formatID	gtrid_length	bqual_length	data
1	2	0	x1
SELECT COUNT(*) AS n FROM t;
