INSTALL EXTENSION vsql_knn_index_test;
CREATE TABLE nv (id INT PRIMARY KEY, v KVECTOR);
CREATE INDEX idx_v ON nv (v) USING EXTENDED(vsql_knn_index_test.kvec_l2);
INSERT INTO nv VALUES (1, '[1,0,0,0]'), (2, NULL), (3, '[2,0,0,0]');
SELECT id, v IS NULL AS is_null FROM nv ORDER BY id;
id	is_null
1	0
2	1
3	0
SELECT id FROM nv IGNORE INDEX (idx_v) WHERE v IS NOT NULL ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]') LIMIT 3;
id
1
3
SELECT id FROM nv WHERE v IS NOT NULL ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]') LIMIT 3;
id
1
3
SELECT id FROM nv IGNORE INDEX (idx_v) ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]') LIMIT 3;
ERROR HY000: VDF error in function 'kvec_l2_distance': kvec_l2_distance: operand must not be NULL
DROP TABLE nv;
UNINSTALL EXTENSION vsql_knn_index_test;
