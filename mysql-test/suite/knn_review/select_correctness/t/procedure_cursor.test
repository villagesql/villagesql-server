# A stored procedure that fetches a KNN query through a cursor gets the nearest
# rows in order, on each call and after the table changes.

INSTALL EXTENSION vsql_knn_index_test;
--source suite/knn_review/include/knn_table.inc
--disable_query_log
--delimiter |
CREATE PROCEDURE knn_ids() BEGIN
  DECLARE done INT DEFAULT 0;
  DECLARE x INT;
  DECLARE s VARCHAR(100) DEFAULT NULL;
  DECLARE c CURSOR FOR SELECT id FROM t ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]') LIMIT 3;
  DECLARE CONTINUE HANDLER FOR NOT FOUND SET done = 1;
  OPEN c;
  l: LOOP
    FETCH c INTO x;
    IF done THEN LEAVE l; END IF;
    SET s = CONCAT_WS(',', s, x);
  END LOOP;
  CLOSE c;
  SELECT s AS ids;
END|
--delimiter ;
--enable_query_log
CALL knn_ids();
CALL knn_ids();
UPDATE t SET v = '[9,9,9,9]' WHERE id = 1;
CALL knn_ids();
DROP PROCEDURE knn_ids;
DROP TABLE t;
UNINSTALL EXTENSION vsql_knn_index_test;
