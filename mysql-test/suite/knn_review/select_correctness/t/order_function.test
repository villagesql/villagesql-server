# A KNN scan ranks by the ORDER BY function the query uses. kvec_profile_multi
# binds two: kvec_l2_distance and kvec_cos_distance.
# From [1,0,0,0]: L2 order is 2 4 3 1, cosine order is 4 1 2 3.

--let $knn_issue = KNN-5 A KNN scan ranks by the first ORDER function of the profile
--source suite/knn_review/include/known_issue.inc

INSTALL EXTENSION vsql_knn_index_test;
--let $knn_index_type = kvec_multi
--let $knn_profile = kvec_profile_multi
--source suite/knn_review/include/require_index_type.inc
CREATE TABLE t (id INT PRIMARY KEY, v KVECTOR);
CREATE INDEX idx_v ON t (v kvec_profile_multi) USING EXTENDED(vsql_knn_index_test.kvec_multi);
INSERT INTO t VALUES (1, '[10,1,0,0]'), (2, '[0.5,0.5,0,0]'), (3, '[0,1,0,0]'), (4, '[2,0,0,0]');
SELECT id FROM t IGNORE INDEX (idx_v) ORDER BY vsql_knn_index_test.kvec_cos_distance(v, '[1,0,0,0]') LIMIT 2;
SELECT id FROM t ORDER BY vsql_knn_index_test.kvec_cos_distance(v, '[1,0,0,0]') LIMIT 2;
SELECT id FROM t ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]') LIMIT 2;
DROP TABLE t;
UNINSTALL EXTENSION vsql_knn_index_test;
