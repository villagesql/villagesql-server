# Index hints on a KNN query do not change its rows: FORCE INDEX and IGNORE
# INDEX on the KNN index, and FORCE INDEX on the primary key.

INSTALL EXTENSION vsql_knn_index_test;
--source suite/knn_review/include/knn_table.inc
SELECT id FROM t FORCE INDEX (idx_v) ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]') LIMIT 3;
SELECT id FROM t IGNORE INDEX (idx_v) ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]') LIMIT 3;
SELECT id FROM t FORCE INDEX (PRIMARY) ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]') LIMIT 3;
SELECT id FROM t USE INDEX (idx_v) ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]') LIMIT 3;
DROP TABLE t;
UNINSTALL EXTENSION vsql_knn_index_test;
