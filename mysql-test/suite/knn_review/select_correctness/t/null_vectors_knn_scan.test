# The same KNN query over a NULL vector gives the same result through the index
# as with it ignored: kvec_l2_distance rejects the NULL operand, so both fail
# with the function's error.

--let $knn_issue = KNN-4 A KNN scan skips NULL vectors the plain query fails on
--source suite/knn_review/include/known_issue.inc

INSTALL EXTENSION vsql_knn_index_test;
CREATE TABLE nv (id INT PRIMARY KEY, v KVECTOR);
CREATE INDEX idx_v ON nv (v) USING EXTENDED(vsql_knn_index_test.kvec_l2);
INSERT INTO nv VALUES (1, '[1,0,0,0]'), (2, NULL), (3, '[2,0,0,0]');
--error ER_UDF_ERROR
SELECT id FROM nv IGNORE INDEX (idx_v) ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]') LIMIT 3;
--error ER_UDF_ERROR
SELECT id FROM nv ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]') LIMIT 3;
DROP TABLE nv;
UNINSTALL EXTENSION vsql_knn_index_test;
