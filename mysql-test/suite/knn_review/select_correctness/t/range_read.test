# A custom index advertising RANGE_SCAN serves an ordinary keyed read, not only
# KNN ORDER BY.

INSTALL EXTENSION vsql_knn_index_test;
--let $knn_index_type = kvec_range
--let $knn_profile = kvec_profile_range
--source suite/knn_review/include/require_index_type.inc
CREATE TABLE t (id INT PRIMARY KEY, v KVECTOR);
CREATE INDEX idx_v ON t (v kvec_profile_range) USING EXTENDED(vsql_knn_index_test.kvec_range);
INSERT INTO t VALUES (1, '[1,0,0,0]'), (2, '[0,1,0,0]'), (3, '[0,0,2,0]');
SELECT id FROM t FORCE INDEX (idx_v) WHERE v = '[0,1,0,0]';
DROP TABLE t;
UNINSTALL EXTENSION vsql_knn_index_test;
