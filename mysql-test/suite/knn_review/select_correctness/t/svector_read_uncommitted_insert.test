# A READ UNCOMMITTED session reads the SVECTOR values (vsql-vector column
# storage, no index) of a table while another session inserts rows. InnoDB
# writes the clustered record before the column store value and its
# reference, so the reader can meet a row whose value is not stored yet. It
# must skip the row, as it does for an InnoDB BLOB not written yet, and the
# server keeps running.

--let $knn_issue = KNN-33 A READ UNCOMMITTED read of a row being inserted fetches its SVECTOR from an unset reference
--source suite/knn_review/include/known_issue.inc

--source include/count_sessions.inc

INSTALL EXTENSION vsql_vector;
CREATE TABLE t (id INT AUTO_INCREMENT PRIMARY KEY, v SVECTOR(8) NOT NULL);
delimiter //;
CREATE PROCEDURE ins(n INT)
BEGIN
  WHILE n > 0 DO
    INSERT INTO t (v) VALUES ('[1,0,-1,2,0.5,-0.5,3,-3]'), ('[0,0,0,0,0,0,0,0.001]'), ('[-4,4,-4,4,-4,4,-4,4]');
    SET n = n - 1;
  END WHILE;
END//
CREATE PROCEDURE rd(n INT)
BEGIN
  WHILE n > 0 DO
    SELECT SUM(VECTOR_NORM(v)) INTO @s FROM t;
    SET n = n - 1;
  END WHILE;
END//
delimiter ;//
--connect (con1, localhost, root,,)
--send CALL ins(400)
--connection default
SET SESSION TRANSACTION ISOLATION LEVEL READ UNCOMMITTED;
CALL rd(2000);
SET SESSION TRANSACTION ISOLATION LEVEL REPEATABLE READ;
--connection con1
--reap
--disconnect con1
--connection default
SELECT COUNT(*) AS n FROM t;
DROP PROCEDURE ins;
DROP PROCEDURE rd;
DROP TABLE t;
UNINSTALL EXTENSION vsql_vector;
--source include/wait_until_count_sessions.inc
