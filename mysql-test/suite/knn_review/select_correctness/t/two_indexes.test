# Two KNN indexes on one column, L2 and cosine. Each metric's query returns its
# own order, and dropping one index leaves the other working. A cosine query on
# a table with only the L2 index is still answered in cosine order.
# From [1,0,0,0]: L2 order is 1 3 4 2; cosine order is 1 and 2 (both 0), 3, 4.

INSTALL EXTENSION vsql_knn_index_test;
CREATE TABLE t (id INT PRIMARY KEY, v KVECTOR);
CREATE INDEX idx_l2 ON t (v) USING EXTENDED(vsql_knn_index_test.kvec_l2);
CREATE INDEX idx_cos ON t (v kvec_profile_cos) USING EXTENDED(vsql_knn_index_test.kvec_cos);
INSERT INTO t VALUES (1, '[1,0,0,0]'), (2, '[10,0,0,0]'), (3, '[1,1,0,0]'), (4, '[0,1,0,0]');
SELECT id FROM t ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]') LIMIT 4;
--sorted_result
SELECT id FROM t ORDER BY vsql_knn_index_test.kvec_cos_distance(v, '[1,0,0,0]') LIMIT 2;
SELECT id FROM t ORDER BY vsql_knn_index_test.kvec_cos_distance(v, '[1,0,0,0]'), id LIMIT 4;
DROP INDEX idx_cos ON t;
SELECT id FROM t ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]') LIMIT 4;
SELECT id FROM t ORDER BY vsql_knn_index_test.kvec_cos_distance(v, '[1,0,0,0]'), id LIMIT 4;
DROP TABLE t;
UNINSTALL EXTENSION vsql_knn_index_test;
