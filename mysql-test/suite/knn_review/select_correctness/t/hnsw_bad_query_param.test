# A KNN query on an HNSW index (vsql-vector) whose query point is a prepared
# statement parameter fails with the parameter's error when the value is not a
# valid SVECTOR(4), as it does with the index ignored. A valid value gives the
# same rows both ways.

--let $knn_issue = KNN-30 A KNN scan crashes on a prepared statement parameter that is not a valid SVECTOR
--source suite/knn_review/include/known_issue.inc

INSTALL EXTENSION vsql_vector;
CREATE TABLE t (id INT PRIMARY KEY, grp INT, pay VARCHAR(10), v SVECTOR(4), KEY k_grp (grp));
CREATE INDEX idx_v ON t (v) USING EXTENDED(vsql_vector.hnsw);
INSERT INTO t VALUES (1, 1, 'a', '[1,0,0,0]'), (2, 1, 'b', '[0,1,0,0]'), (3, 2, 'c', '[0,0,2,0]'), (4, 2, 'd', '[1,1,0,0]'), (5, 3, 'e', '[2.5,0,0,0]'), (6, 3, 'f', '[4,0,0,0]'), (7, 1, 'g', '[0,0,0,3]'), (8, 2, 'h', '[1,0,1.2,0]');
PREPARE p FROM 'SELECT id FROM t IGNORE INDEX (idx_v) ORDER BY vsql_vector.l2_distance(v, ?) LIMIT 3';
SET @v = '[1,0,0,0]';
EXECUTE p USING @v;
SET @v = '[1,2,3]';
--error ER_VILLAGESQL_GENERIC_ERROR
EXECUTE p USING @v;
SET @v = 'not a vector';
--error ER_VILLAGESQL_GENERIC_ERROR
EXECUTE p USING @v;
DEALLOCATE PREPARE p;
PREPARE p FROM 'SELECT id FROM t ORDER BY vsql_vector.l2_distance(v, ?) LIMIT 3';
SET @v = '[1,0,0,0]';
EXECUTE p USING @v;
SET @v = '[1,2,3]';
--error ER_VILLAGESQL_GENERIC_ERROR
EXECUTE p USING @v;
SET @v = 'not a vector';
--error ER_VILLAGESQL_GENERIC_ERROR
EXECUTE p USING @v;
DEALLOCATE PREPARE p;
DROP TABLE t;
UNINSTALL EXTENSION vsql_vector;
