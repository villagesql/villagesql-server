# A window under an outer KNN ORDER BY ... LIMIT with an HNSW index
# (vsql-vector): window functions are computed over every row before the ORDER
# BY and LIMIT apply, so COUNT(*) OVER () counts all 8 rows, also with an
# OFFSET. The same queries with the index ignored give the same rows.

--let $knn_issue = KNN-7 A window under a KNN ORDER BY LIMIT sees only LIMIT rows
--source suite/knn_review/include/known_issue.inc

INSTALL EXTENSION vsql_vector;
CREATE TABLE t (id INT PRIMARY KEY, grp INT, pay VARCHAR(10), v SVECTOR(4), KEY k_grp (grp));
CREATE INDEX idx_v ON t (v) USING EXTENDED(vsql_vector.hnsw);
INSERT INTO t VALUES (1, 1, 'a', '[1,0,0,0]'), (2, 1, 'b', '[0,1,0,0]'), (3, 2, 'c', '[0,0,2,0]'), (4, 2, 'd', '[1,1,0,0]'), (5, 3, 'e', '[2.5,0,0,0]'), (6, 3, 'f', '[4,0,0,0]'), (7, 1, 'g', '[0,0,0,3]'), (8, 2, 'h', '[1,0,1.2,0]');
SELECT id, COUNT(*) OVER () AS total FROM t ORDER BY vsql_vector.l2_distance(v, '[1,0,0,0]') LIMIT 2;
SELECT id, COUNT(*) OVER () AS total FROM t ORDER BY vsql_vector.l2_distance(v, '[1,0,0,0]') LIMIT 2 OFFSET 1;
SELECT id, COUNT(*) OVER () AS total FROM t IGNORE INDEX (idx_v) ORDER BY vsql_vector.l2_distance(v, '[1,0,0,0]') LIMIT 2;
SELECT id, COUNT(*) OVER () AS total FROM t IGNORE INDEX (idx_v) ORDER BY vsql_vector.l2_distance(v, '[1,0,0,0]') LIMIT 2 OFFSET 1;
DROP TABLE t;
UNINSTALL EXTENSION vsql_vector;
