# After ALTER TABLE ... RENAME TO, also to another database, the KNN index keeps
# working under the new name, and dropping the table frees the extension.

--let $knn_issue = KNN-12 After RENAME TABLE a KNN query fails (index_init called for a KNN scan)
--source suite/knn_review/include/known_issue.inc

INSTALL EXTENSION vsql_knn_index_test;
--source suite/knn_review/include/knn_table.inc
ALTER TABLE t RENAME TO t2;
SELECT id FROM t2 ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]') LIMIT 3;
CREATE DATABASE d2;
ALTER TABLE t2 RENAME TO d2.t3;
SELECT id FROM d2.t3 ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]') LIMIT 3;
DROP DATABASE d2;
UNINSTALL EXTENSION vsql_knn_index_test;
