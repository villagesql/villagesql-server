# Changing the primary key of a table with a custom index is refused, and the
# index keeps working.

--let $knn_issue = KNN-11 Building a KNN index from existing rows crashes (custom_column.cc:1109)
--source suite/knn_review/include/known_issue.inc

INSTALL EXTENSION vsql_knn_index_test;
CREATE TABLE pk (id INT PRIMARY KEY, k INT NOT NULL, v KVECTOR);
CREATE INDEX idx_v ON pk (v) USING EXTENDED(vsql_knn_index_test.kvec_l2);
INSERT INTO pk VALUES (1, 30, '[1,0,0,0]'), (2, 20, '[0,1,0,0]'), (3, 10, '[2,0,0,0]');
--error ER_VILLAGESQL_GENERIC_ERROR
ALTER TABLE pk DROP PRIMARY KEY, ADD PRIMARY KEY (k);
SELECT id FROM pk ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]') LIMIT 3;
DROP TABLE pk;
UNINSTALL EXTENSION vsql_knn_index_test;
