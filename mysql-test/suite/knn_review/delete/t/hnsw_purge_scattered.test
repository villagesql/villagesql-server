# With an HNSW index (vsql-vector), KNN reads return the nearest rows after
# scattered deletes (every 10th row), before and after purge removes their
# entries. Purge is stopped (debug build) until the second check. Once with rows
# on a line, v = [id,0,0,0], and once with random 4-dimensional vectors.

--let $knn_issue = KNN-27 With HNSW, after purge of scattered deletes a KNN query on collinear rows returns wrong rows
--source suite/knn_review/include/known_issue.inc

--source include/have_debug.inc

INSTALL EXTENSION vsql_vector;
--echo # Rows: line
CREATE TABLE t (id INT PRIMARY KEY, grp INT, pay VARCHAR(10), v SVECTOR(4), KEY k_grp (grp));
CREATE INDEX idx_v ON t (v) USING EXTENDED(vsql_vector.hnsw);
--echo # Insert 3000 rows
--disable_query_log
