INSTALL EXTENSION vsql_knn_index_test;
CREATE TABLE arch (id INT PRIMARY KEY, v KVECTOR);
CREATE INDEX idx_v ON arch (v) USING EXTENDED(vsql_knn_index_test.kvec_l2);
CREATE TRIGGER bi BEFORE INSERT ON t FOR EACH ROW SET NEW.v = '[1,0,0,0.3]';
CREATE TRIGGER ad AFTER DELETE ON t FOR EACH ROW INSERT INTO arch VALUES (OLD.id, OLD.v);
INSERT INTO t VALUES (9, 1, 'i', '[9,9,9,9]');
SELECT id FROM t ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]') LIMIT 3;
id
1
9
4
DELETE FROM t WHERE id IN (4, 6);
SELECT id FROM arch ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]') LIMIT 3;
id
4
6
DROP TRIGGER bi;
DROP TRIGGER ad;
DROP TABLE arch;
DROP TABLE t;
UNINSTALL EXTENSION vsql_knn_index_test;
