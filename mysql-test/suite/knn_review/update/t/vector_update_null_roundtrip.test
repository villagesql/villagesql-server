# A vector set to NULL leaves KNN results, and comes back when set to a value
# again.

INSTALL EXTENSION vsql_knn_index_test;
--source suite/knn_review/include/knn_table.inc
UPDATE t SET v = NULL WHERE id = 2;
SELECT id FROM t WHERE v IS NOT NULL ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]') LIMIT 8;
UPDATE t SET v = '[1,0,0,0.5]' WHERE id = 2;
SELECT id FROM t ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]') LIMIT 8;
DROP TABLE t;
UNINSTALL EXTENSION vsql_knn_index_test;
