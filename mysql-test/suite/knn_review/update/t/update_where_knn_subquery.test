# An UPDATE or DELETE whose WHERE takes the nearest rows from a KNN subquery on
# the same table changes exactly those rows.

INSTALL EXTENSION vsql_knn_index_test;
--source suite/knn_review/include/knn_table.inc
UPDATE t SET pay = 'x' WHERE id IN (SELECT id FROM (SELECT id FROM t ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]') LIMIT 2) AS s);
SELECT id FROM t WHERE pay = 'x' ORDER BY id;
UPDATE t SET v = '[9,9,9,9]' WHERE id IN (SELECT id FROM (SELECT id FROM t ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]') LIMIT 2) AS s);
SELECT id FROM t ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]') LIMIT 6;
DELETE FROM t WHERE id IN (SELECT id FROM (SELECT id FROM t ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]') LIMIT 1) AS s);
SELECT id FROM t ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]') LIMIT 5;
DROP TABLE t;
UNINSTALL EXTENSION vsql_knn_index_test;
