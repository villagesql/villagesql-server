# A READ COMMITTED locking KNN read waits for the lock on a row another session
# has moved away from the query point; when that session rolls back, the read returns the nearest rows as
# they were, with the row at its original place.

--source include/count_sessions.inc

INSTALL EXTENSION vsql_knn_index_test;
--source suite/knn_review/include/knn_table.inc
--connect (con1, localhost, root,,)
START TRANSACTION;
UPDATE t SET v = '[9,9,9,9]' WHERE id = 1;
--connection default
SET SESSION TRANSACTION ISOLATION LEVEL READ COMMITTED;
START TRANSACTION;
--send SELECT id FROM t ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]') LIMIT 3 FOR UPDATE
--connection con1
--let $wait_condition = SELECT COUNT(*) = 1 FROM information_schema.innodb_trx WHERE trx_state = 'LOCK WAIT'
--source include/wait_condition.inc
ROLLBACK;
--connection default
--reap
COMMIT;
SET SESSION TRANSACTION ISOLATION LEVEL REPEATABLE READ;
--disconnect con1
DROP TABLE t;
UNINSTALL EXTENSION vsql_knn_index_test;
--source include/wait_until_count_sessions.inc
