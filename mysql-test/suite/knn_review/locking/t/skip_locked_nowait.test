# A locking KNN read with SKIP LOCKED returns the nearest rows that are not
# locked by another transaction; with NOWAIT it fails at once on a locked one.

--source include/count_sessions.inc

INSTALL EXTENSION vsql_knn_index_test;
--source suite/knn_review/include/knn_table.inc
--connect (con1, localhost, root,,)
START TRANSACTION;
SELECT id FROM t WHERE id = 1 FOR UPDATE;
--connection default
SET SESSION TRANSACTION ISOLATION LEVEL READ COMMITTED;
START TRANSACTION;
SELECT id FROM t ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]') LIMIT 3 FOR UPDATE SKIP LOCKED;
SELECT id FROM t ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]') LIMIT 3 FOR SHARE SKIP LOCKED;
--error ER_LOCK_NOWAIT
SELECT id FROM t ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]') LIMIT 3 FOR UPDATE NOWAIT;
COMMIT;
SET SESSION TRANSACTION ISOLATION LEVEL REPEATABLE READ;
START TRANSACTION;
SELECT id FROM t ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]') LIMIT 3 FOR UPDATE SKIP LOCKED;
SELECT id FROM t ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]') LIMIT 3 FOR SHARE SKIP LOCKED;
--error ER_LOCK_NOWAIT
SELECT id FROM t ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]') LIMIT 3 FOR UPDATE NOWAIT;
COMMIT;
SET SESSION TRANSACTION ISOLATION LEVEL REPEATABLE READ;
--connection con1
COMMIT;
--disconnect con1
--connection default
DROP TABLE t;
UNINSTALL EXTENSION vsql_knn_index_test;
--source include/wait_until_count_sessions.inc
