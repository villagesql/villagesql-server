# READ COMMITTED locking KNN reads after a committed vector UPDATE skip the old
# index entry of the moved row and find it at its new place, in this session's
# transaction and after it (the index stores the primary key).

INSTALL EXTENSION vsql_knn_index_test;
--source suite/knn_review/include/knn_table.inc
SET SESSION TRANSACTION ISOLATION LEVEL READ COMMITTED;
UPDATE t SET v = '[9,9,9,9]' WHERE id = 1;
START TRANSACTION;
SELECT id FROM t ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]') LIMIT 3 FOR UPDATE;
UPDATE t SET v = '[1,0,0,0.1]' WHERE id = 6;
SELECT id FROM t ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]') LIMIT 3 FOR UPDATE;
SELECT id FROM t ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]') LIMIT 8 FOR SHARE;
COMMIT;
SELECT id FROM t ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]') LIMIT 8 FOR UPDATE;
SET SESSION TRANSACTION ISOLATION LEVEL REPEATABLE READ;
DROP TABLE t;
UNINSTALL EXTENSION vsql_knn_index_test;
