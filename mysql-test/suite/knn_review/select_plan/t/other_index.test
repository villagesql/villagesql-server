# A WHERE clause another index can serve. The index plan wins and the rows are
# sorted (no KNN scan), unless the query names the KNN index itself or ignores
# the other index.
# Each line shows whether EXPLAIN plans a KNN scan, whether executing the query
# ran one, and the query's error number.

INSTALL EXTENSION vsql_knn_index_test;
--source suite/knn_review/include/knn_table.inc
--echo # Primary key
--let $knn_query = SELECT id FROM t WHERE id = 4 ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]') LIMIT 3
--source suite/knn_review/include/plan_check.inc
--let $knn_query = SELECT id FROM t WHERE id > 2 ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]') LIMIT 3
--source suite/knn_review/include/plan_check.inc
--let $knn_query = SELECT id FROM t WHERE id BETWEEN 2 AND 5 ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]') LIMIT 2
--source suite/knn_review/include/plan_check.inc
--echo # Secondary index
--let $knn_query = SELECT id FROM t WHERE grp = 2 ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]') LIMIT 2
--source suite/knn_review/include/plan_check.inc
--let $knn_query = SELECT id FROM t WHERE grp >= 2 ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]') LIMIT 3
--source suite/knn_review/include/plan_check.inc
--echo # The other index ignored, or the KNN index forced
--let $knn_query = SELECT id FROM t IGNORE INDEX (PRIMARY) WHERE id > 2 ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]') LIMIT 3
--source suite/knn_review/include/plan_check.inc
--let $knn_query = SELECT id FROM t IGNORE INDEX (k_grp) WHERE grp = 2 ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]') LIMIT 2
--source suite/knn_review/include/plan_check.inc
--let $knn_query = SELECT id FROM t FORCE INDEX (idx_v) WHERE grp = 2 ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]') LIMIT 2
--source suite/knn_review/include/plan_check.inc
DROP TABLE t;
UNINSTALL EXTENSION vsql_knn_index_test;
