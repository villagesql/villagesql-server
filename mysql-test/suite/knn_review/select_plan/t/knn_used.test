# Queries that should run as a KNN scan: a distance ORDER BY with LIMIT on a
# table whose WHERE clause, if any, no other index can serve.
# Each line shows whether EXPLAIN plans a KNN scan, whether executing the query
# ran one, and the query's error number.

INSTALL EXTENSION vsql_knn_index_test;
--source suite/knn_review/include/knn_table.inc
--let $knn_query = SELECT id FROM t ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]') LIMIT 3
--source suite/knn_review/include/plan_check.inc
--let $knn_query = SELECT id FROM t ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]') LIMIT 2 OFFSET 3
--source suite/knn_review/include/plan_check.inc
--let $knn_query = SELECT id, v FROM t ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]') LIMIT 3
--source suite/knn_review/include/plan_check.inc
--let $knn_query = SELECT id, vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]') AS d FROM t ORDER BY d LIMIT 3
--source suite/knn_review/include/plan_check.inc
--let $knn_query = SELECT id FROM t WHERE pay IN ('b','c','h') ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]') LIMIT 3
--source suite/knn_review/include/plan_check.inc
--let $knn_query = SELECT id FROM t WHERE id + 0 IN (2,3,8) ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]') LIMIT 3
--source suite/knn_review/include/plan_check.inc
--let $knn_query = SELECT id FROM t ORDER BY vsql_knn_index_test.kvec_l2_distance(v, (SELECT v FROM t WHERE id = 1)) LIMIT 3
--source suite/knn_review/include/plan_check.inc
CREATE VIEW vw AS SELECT id, v FROM t;
--let $knn_query = SELECT id FROM vw ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]') LIMIT 3
--source suite/knn_review/include/plan_check.inc
DROP VIEW vw;
CREATE TABLE c (k INT PRIMARY KEY, q KVECTOR);
INSERT INTO c VALUES (1, '[1,0,0,0]');
--let $knn_query = SELECT t.id FROM c, t WHERE c.k = 1 ORDER BY vsql_knn_index_test.kvec_l2_distance(t.v, c.q) LIMIT 3
--source suite/knn_review/include/plan_check.inc
DROP TABLE c;
CREATE TABLE e (id INT PRIMARY KEY, v KVECTOR);
CREATE INDEX idx_v ON e (v) USING EXTENDED(vsql_knn_index_test.kvec_l2);
--let $knn_query = SELECT id FROM e ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]') LIMIT 3
--source suite/knn_review/include/plan_check.inc
DROP TABLE e;
DROP TABLE t;
UNINSTALL EXTENSION vsql_knn_index_test;
