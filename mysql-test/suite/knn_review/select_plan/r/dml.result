INSTALL EXTENSION vsql_knn_index_test;
DELETE FROM t ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]') LIMIT 1;
SELECT vsql_knn_index_test.kvec_scan_begin_count() > 0 AS knn_scan_ran;
knn_scan_ran
1
UPDATE t SET pay = 'x' ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[1,0,0,0]') LIMIT 2;
SELECT vsql_knn_index_test.kvec_scan_begin_count() > 0 AS knn_scan_ran;
knn_scan_ran
1
