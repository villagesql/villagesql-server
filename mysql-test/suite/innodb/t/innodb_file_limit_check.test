--source include/big_test.inc

# The test sets innodb_open_files=1000000 and expects a warning that it exceeds
# open_files_limit. On systems with high ulimits (e.g. macOS), open_files_limit
# ends up >= 1000000 so the warning never fires. Skip in that case.
# This is likely an upstream MySQL issue (not VillageSQL-specific) since the
# hardcoded value comes from upstream. Check during rebase if upstream has fixed it.
# TODO(villagesql-rebase): Remove this workaround if upstream fixes it.
--disable_query_log
--exec ulimit -n > $MYSQL_TMP_DIR/osfileslimit.txt
CREATE TABLE t_ofl (c1 varchar(20));
eval LOAD DATA INFILE '$MYSQL_TMP_DIR/osfileslimit.txt' INTO TABLE t_ofl;
let $f_l=`SELECT c1 FROM t_ofl`;
--remove_file $MYSQL_TMP_DIR/osfileslimit.txt
DROP TABLE t_ofl;
--enable_query_log
if ($f_l == unlimited)
{
  skip ulimit is unlimited, cannot test innodb_open_files warning;
}
if ($f_l >= 1000000)
{
  skip ulimit ($f_l) is too high to test innodb_open_files warning;
}

CALL mtr.add_suppression("innodb_open_files should not be greater than the open_files_limit.");

CREATE TABLE t1 (a INT)ENGINE=INNODB PARTITION BY HASH(a) PARTITIONS
1024;

let $over_innodb_open_files_limit=`SELECT @@global.open_files_limit + 2000000`;

--echo # Setting innodb_open_files to a very high value to achieve synchronicity across various platforms
--replace_result $over_innodb_open_files_limit over_innodb_open_files_limit
let $restart_parameters = restart: --innodb_open_files=$over_innodb_open_files_limit;
-- source include/restart_mysqld.inc

let SEARCH_FILE= $MYSQLTEST_VARDIR/log/mysqld.1.err;
let SEARCH_PATTERN= \[Warning\] .*MY-\\d+.* innodb_open_files should not be greater than the open_files_limit.;
--source include/search_pattern.inc

SELECT 1 UNION SELECT * FROM t1  UNION SELECT * FROM t1  UNION
SELECT * FROM t1  UNION SELECT * FROM t1  UNION SELECT * FROM
t1;

DROP TABLE t1;
