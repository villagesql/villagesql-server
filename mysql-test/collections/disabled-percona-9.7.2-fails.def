#
# These hang to the 900s timeout on every platform.
# percona.coredump: with WITH_COREDUMPER=OFF (as in CI) it never finds the
# pattern it greps for; see villagesql/bld_tools/build_ci.sh.
# abort_during_startup: passes --mysql_native_password=OFF, which 9.x removed.
percona.coredump : BUG#0 VillageSQL - hangs when built WITH_COREDUMPER=OFF
component_audit_log_filter.abort_during_startup : BUG#0 VillageSQL - passes removed --mysql_native_password option, hangs
#
# Assumes 9.7 is LTS, but cmake/mysql_version.cmake forces
# MYSQL_VERSION_MATURITY_IS_LTS 0 (TODO(villagesql-production)).
rpl_gtid.rpl_replica_compatibility_rules_lts : BUG#0 VillageSQL - LTS maturity forced off in cmake/mysql_version.cmake
