# VillageSQL Server configuration.
#
# For the full reference see https://villagesql.com/docs
#
[mysqld]
user=mysql
datadir=/var/lib/mysql
socket=/var/run/mysqld/mysqld.sock
pid-file=/var/run/mysqld/mysqld.pid
log-error=/var/log/mysql/error.log

# Directory searched by INSTALL EXTENSION for .veb bundles. This matches the
# compiled-in default from INSTALL_VEBDIR in cmake/install_layout.cmake; it is
# stated explicitly so it is visible when auditing the install.
veb_dir=/usr/lib/mysql/veb

[client]
socket=/var/run/mysqld/mysqld.sock

!includedir /etc/mysql/conf.d/
