# RPM spec for VillageSQL Server.
#
# This is a purpose-built spec, deliberately NOT derived from
# packaging/rpm-oel/mysql.spec.in. That spec carries Oracle's cluster,
# commercial, router, MEB and compat-lib variants (3000+ lines) which do not
# apply here, and it is upstream-owned so edits fight every MySQL rebase.
# Keeping this file separate keeps packaging/rpm-* untouched at rebase time.
#
# VillageSQL is a drop-in replacement for MySQL: it ships the same binary
# names (mysqld, mysql), the same data directory, the same systemd unit name
# and the same default port. These packages therefore REPLACE a MySQL install
# rather than coexisting with one.

%global vsql_vendor       VillageSQL Contributors
%global mysqldatadir      /var/lib/mysql
%global mysqlkeyringdir   /var/lib/mysql-keyring
%global mysqlfilesdir     /var/lib/mysql-files
%global mysqld_user       mysql
%global mysqld_group      mysql

# Upstream MySQL base this fork tracks. Used for share/ paths that the build
# derives from MYSQL_BASE_VERSION, and reported in the package description.
%global mysql_base_version   @MYSQL_BASE_VERSION@
%global mysql_full_version   @MYSQL_NO_DASH_VERSION@
%global vsql_code_base       @VSQL_CODE_BASE@

%global src_dir              @VSQL_SRC_DIR@

# Bundled private libraries (protobuf, abseil) and plugin .so files must not
# leak into the RPM Provides/Requires sets, or dependency resolution will try
# to satisfy them from the distro.
%global __provides_exclude_from ^(%{_libdir}/mysql/plugin/.*\\.so|%{_libdir}/mysql/private/.*|%{_libdir}/mysql/veb/.*|%{_datadir}/mysql-test/.*)$
%global __requires_exclude ^(libprotobuf.*|libabsl.*)$

Name:           villagesql
Summary:        VillageSQL Server - an extensible drop-in replacement for MySQL
Group:          Applications/Databases
# Epoch is required, and permanent.
#
# Replacement of a MySQL install only fires when the VillageSQL package
# compares NEWER than what it obsoletes. VillageSQL versions independently of
# upstream (0.0.x) while MySQL is at 8.4.x, so a plain version comparison
# would make VillageSQL look older and the Obsoletes below would never take
# effect. Epoch 1 outranks the (absent, therefore 0) epoch of every MySQL,
# MariaDB and Percona package regardless of their version numbers.
#
# Once shipped, this can never be removed or lowered.
Epoch:          1
Version:        @VSQL_RPM_VERSION@
Release:        1%{?dist}
License:        GPLv2
URL:            https://villagesql.com
Source0:        %{src_dir}.tar.gz
Source1:        villagesql.logrotate

BuildRequires:  cmake >= 3.14.3
BuildRequires:  make

# EL8/EL9 base gcc (11.x) is rejected by cmake/CMakeLists.txt, which probes for
# /opt/rh/gcc-toolset-12 and fails hard when it is absent. No scl activation is
# needed: the tree auto-detects the toolset once it is installed. EL10 and
# other distros use the base compiler.
%if 0%{?rhel} == 8 || 0%{?rhel} == 9
BuildRequires:  gcc-toolset-12-gcc
BuildRequires:  gcc-toolset-12-gcc-c++
BuildRequires:  gcc-toolset-12-binutils
BuildRequires:  gcc-toolset-12-dwz
BuildRequires:  gcc-toolset-12-annobin-annocheck
BuildRequires:  gcc-toolset-12-annobin-plugin-gcc
# debuginfo extraction must use the matching strip, or the separated symbols
# are unusable.
%global __strip /opt/rh/gcc-toolset-12/root/usr/bin/strip
%else
BuildRequires:  gcc
BuildRequires:  gcc-c++
%endif
BuildRequires:  bison
BuildRequires:  openssl-devel
BuildRequires:  ncurses-devel
BuildRequires:  zlib-devel
BuildRequires:  libtirpc-devel
BuildRequires:  rpcgen
BuildRequires:  libcurl-devel
BuildRequires:  libaio-devel
BuildRequires:  systemd-devel
BuildRequires:  systemd
BuildRequires:  perl-interpreter
Requires:       villagesql-server = %{epoch}:%{version}-%{release}

%description
VillageSQL is an open-source tracking fork of upstream %{vsql_code_base} that
adds the VillageSQL Extension Framework (VEF), a runtime extension system for
custom SQL data types and functions. VillageSQL tracks several upstream code
bases; this package was built from %{vsql_code_base}.

This is the top-level metapackage; it pulls in villagesql-server.

# ----------------------------------------------------------------------------
# server
# ----------------------------------------------------------------------------
%package        server
Summary:        VillageSQL database server binary and configuration
Group:          Applications/Databases
Requires:       villagesql-common = %{epoch}:%{version}-%{release}
Requires:       villagesql-client = %{epoch}:%{version}-%{release}
Requires:       coreutils
Requires:       findutils
Requires:       grep
Requires(pre):  shadow-utils
%{?systemd_requires}

# Drop-in replacement: satisfy anything that depends on a MySQL server.
Provides:       mysql-server = %{mysql_full_version}
Provides:       mysql-server%{?_isa} = %{mysql_full_version}
Provides:       mysql = %{mysql_full_version}
Provides:       mysql%{?_isa} = %{mysql_full_version}
Provides:       virtual-mysql-server
Provides:       mysqld

# Take over an existing MySQL/MariaDB/Percona install. Epoch above guarantees
# these comparisons resolve in VillageSQL's favour.
Obsoletes:      mysql-community-server < %{epoch}:%{version}-%{release}
Obsoletes:      mysql-commercial-server < %{epoch}:%{version}-%{release}
Obsoletes:      mysql-server < %{epoch}:%{version}-%{release}
Obsoletes:      mysql-cluster-community-server < %{epoch}:%{version}-%{release}
Obsoletes:      community-mysql-server < %{epoch}:%{version}-%{release}
Obsoletes:      mariadb-server < %{epoch}:%{version}-%{release}
Obsoletes:      mariadb-server-galera < %{epoch}:%{version}-%{release}
Obsoletes:      percona-server-server < %{epoch}:%{version}-%{release}
Obsoletes:      Percona-Server-server-57 < %{epoch}:%{version}-%{release}

%description    server
The VillageSQL database server: the mysqld binary, the systemd unit, and the
server-side utilities.

VillageSQL is wire-, protocol- and on-disk-compatible with upstream
%{vsql_code_base}. It installs the same paths and the same systemd unit
name (mysqld.service) as MySQL, and therefore REPLACES an existing MySQL,
MariaDB or Percona Server installation rather than installing alongside it.

Beyond upstream MySQL it provides the VillageSQL Extension Framework (VEF):
extensions are packaged as .veb bundles, installed at runtime with
"INSTALL EXTENSION <name>", and loaded from %{_libdir}/mysql/veb.

# ----------------------------------------------------------------------------
# client
# ----------------------------------------------------------------------------
%package        client
Summary:        VillageSQL command line client and administration tools
Group:          Applications/Databases
Requires:       villagesql-common = %{epoch}:%{version}-%{release}

Provides:       mysql-client = %{mysql_full_version}
Provides:       mysql-client%{?_isa} = %{mysql_full_version}
Provides:       virtual-mysql-client
Obsoletes:      mysql-community-client < %{epoch}:%{version}-%{release}
Obsoletes:      mysql-commercial-client < %{epoch}:%{version}-%{release}
Obsoletes:      mysql-client < %{epoch}:%{version}-%{release}
Obsoletes:      community-mysql < %{epoch}:%{version}-%{release}
Obsoletes:      mariadb < %{epoch}:%{version}-%{release}
Obsoletes:      percona-server-client < %{epoch}:%{version}-%{release}

%description    client
The mysql command line client plus mysqladmin, mysqldump, mysqlimport,
mysqlshow, mysqlslap, mysqlbinlog and related administration tools.

# ----------------------------------------------------------------------------
# common
# ----------------------------------------------------------------------------
%package        common
Summary:        VillageSQL shared configuration, character sets and error messages
Group:          Applications/Databases

Provides:       mysql-common = %{mysql_full_version}
Obsoletes:      mysql-community-common < %{epoch}:%{version}-%{release}
Obsoletes:      mysql-commercial-common < %{epoch}:%{version}-%{release}
Obsoletes:      mysql-common < %{epoch}:%{version}-%{release}
Obsoletes:      community-mysql-common < %{epoch}:%{version}-%{release}
Obsoletes:      mariadb-common < %{epoch}:%{version}-%{release}
Obsoletes:      percona-server-shared < %{epoch}:%{version}-%{release}

%description    common
Files shared by the VillageSQL server and client packages: /etc/my.cnf,
character set definitions and localized error messages.

# ----------------------------------------------------------------------------
# libs
# ----------------------------------------------------------------------------
%package        libs
Summary:        Shared client library for VillageSQL
Group:          Applications/Databases
Requires:       villagesql-common = %{epoch}:%{version}-%{release}

Provides:       mysql-libs = %{mysql_full_version}
Provides:       mysql-libs%{?_isa} = %{mysql_full_version}
Provides:       libmysqlclient = %{mysql_full_version}
Obsoletes:      mysql-community-libs < %{epoch}:%{version}-%{release}
Obsoletes:      mysql-commercial-libs < %{epoch}:%{version}-%{release}
Obsoletes:      mysql-libs < %{epoch}:%{version}-%{release}
Obsoletes:      community-mysql-libs < %{epoch}:%{version}-%{release}
Obsoletes:      mariadb-libs < %{epoch}:%{version}-%{release}

%description    libs
The libmysqlclient shared library, used by client applications to connect to
a VillageSQL or MySQL server.

# ----------------------------------------------------------------------------
# devel
# ----------------------------------------------------------------------------
%package        devel
Summary:        Development headers and libraries for VillageSQL client applications
Group:          Applications/Databases
Requires:       villagesql-libs = %{epoch}:%{version}-%{release}

Provides:       mysql-devel = %{mysql_full_version}
Provides:       mysql-devel%{?_isa} = %{mysql_full_version}
Obsoletes:      mysql-community-devel < %{epoch}:%{version}-%{release}
Obsoletes:      mysql-commercial-devel < %{epoch}:%{version}-%{release}
Obsoletes:      mysql-devel < %{epoch}:%{version}-%{release}
Obsoletes:      community-mysql-devel < %{epoch}:%{version}-%{release}
Obsoletes:      mariadb-devel < %{epoch}:%{version}-%{release}

%description    devel
Headers, static libraries and mysql_config, for building client applications
against the VillageSQL client library.

This package is for CLIENT development. To build VillageSQL EXTENSIONS,
install villagesql-sdk instead.

# ----------------------------------------------------------------------------
# sdk  (no MySQL counterpart)
# ----------------------------------------------------------------------------
%package        sdk
Summary:        VillageSQL Extension Framework SDK
Group:          Development/Libraries

%description    sdk
Headers, CMake integration and a template project for building VillageSQL
extensions (.veb bundles) against the VillageSQL Extension Framework.

Two header trees are installed: the stable protocol under
%{_includedir}/mysql/villagesql, and the in-development protocol under
%{_includedir}/mysql-dev/villagesql. Build against the stable tree unless you
are developing the framework itself.

This package does not require villagesql-server: extensions are commonly
cross-built on a machine that does not run the database.

# ----------------------------------------------------------------------------
# extension-examples  (no MySQL counterpart)
# ----------------------------------------------------------------------------
%package        extension-examples
Summary:        Example VillageSQL extension bundles
Group:          Applications/Databases
Requires:       villagesql-server = %{epoch}:%{version}-%{release}
BuildArch:      noarch

%description    extension-examples
Reference extension bundles shipped with VillageSQL: vsql_simple (a minimal
custom type and function), vsql_complex (complex number arithmetic with custom
hash and serialization handlers) and vsql_tvector.

Installed into %{_libdir}/mysql/veb and enabled per-database with, for example,
"INSTALL EXTENSION vsql_complex;".

# ----------------------------------------------------------------------------
# test
# ----------------------------------------------------------------------------
%package        test
Summary:        VillageSQL test suite
Group:          Applications/Databases
Requires:       villagesql-server = %{epoch}:%{version}-%{release}
Requires:       villagesql-client = %{epoch}:%{version}-%{release}
Requires:       perl-interpreter

Provides:       mysql-test = %{mysql_full_version}
Obsoletes:      mysql-community-test < %{epoch}:%{version}-%{release}
Obsoletes:      mysql-commercial-test < %{epoch}:%{version}-%{release}
Obsoletes:      mysql-test < %{epoch}:%{version}-%{release}
Obsoletes:      community-mysql-test < %{epoch}:%{version}-%{release}
Obsoletes:      mariadb-test < %{epoch}:%{version}-%{release}

%description    test
The mysql-test-run.pl harness and the full regression suite, including the
VillageSQL-specific suites under mysql-test/suite/villagesql.

# ============================================================================

%prep
%setup -q -n %{src_dir}

%build
# NOTE: every '%' in a comment below is written '%%'. rpm expands macros inside
# '#' comments -- an unescaped %%cmake in a comment really does invoke the
# %%cmake macro, which silently runs a second, differently-configured cmake and
# makes the explicit invocation below dead code.
#
# cmake is invoked directly rather than via the %%cmake macro. %%cmake injects
# CMAKE_INSTALL_LIBDIR/BINDIR/etc, which collide with INSTALL_LAYOUT=RPM --
# the layout in cmake/install_layout.cmake already owns every install path,
# including INSTALL_VEBDIR. Upstream's spec calls cmake directly for the same
# reason. Do not "modernize" this to %%cmake without re-checking the resulting
# paths.
#
# Boost 1.84 is vendored in extra/boost, so nothing is downloaded at build time.
mkdir -p release
cd release
cmake .. \
    -DINSTALL_LAYOUT=RPM \
    -DCMAKE_INSTALL_PREFIX=%{_prefix} \
    -DCMAKE_BUILD_TYPE=RelWithDebInfo \
    -DBUILD_CONFIG=mysql_release \
    -DWITH_BOOST=%{_builddir}/%{src_dir}/extra/boost \
    -DWITH_SSL=system \
    -DWITH_ZLIB=bundled \
    -DWITH_SYSTEMD=1 \
    -DWITH_UNIT_TESTS=0 \
    -DFEATURE_SET=community \
    -DCOMPILATION_COMMENT="VillageSQL Server - GPL" \
    -DMYSQL_UNIX_ADDR=%{mysqldatadir}/mysql.sock \
    -DWITH_NDB=OFF \
    -DWITHOUT_NDBCLUSTER_STORAGE_ENGINE=1 \
    -DWITH_ROUTER=OFF

# WITH_ZLIB is bundled, not system, and that is deliberate for EL.
# cmake/zlib.cmake sets MIN_ZLIB_VERSION_REQUIRED=1.2.13; EL9 ships zlib
# 1.2.11, so -DWITH_ZLIB=system is a hard FATAL_ERROR there. Upstream's spec
# passes system because Oracle builds against a newer zlib than the base repo
# provides. Revisit when EL ships >= 1.2.13. The Debian packaging does use
# system zlib -- Ubuntu 24.04 has 1.3.

# NDB Cluster and MySQL Router both default to ON in this tree. Upstream ships
# them as separate products (mysql-cluster-community-*, mysql-router-community)
# and so does VillageSQL, so they are off here. Leaving them on costs a large
# amount of build time and then fails %%files with unpackaged ndbd/ndb_mgmd/
# ndbclient/mysqlrouter artifacts that no subpackage claims.
#
# Disabling NDB takes TWO flags, and the second one is easy to get wrong.
# WITH_NDB=OFF drops only the Cluster daemons and tooling. The ndbcluster
# storage-engine plugin is separate, defaults ON, and still drags in the whole
# ndbapi/ndbgeneral object tree.
#
# The plugin is gated on WITH_NDBCLUSTER_STORAGE_ENGINE, which MYSQL_ADD_PLUGIN
# derives (see cmake/plugin.cmake) -- NOT on WITH_NDBCLUSTER, which
# CMakeLists.txt deliberately unsets after parsing so it cannot interfere with
# that logic. Passing -DWITH_NDBCLUSTER=OFF therefore looks correct and does
# nothing. The documented off switch is -DWITHOUT_<plugin>_STORAGE_ENGINE=1.

make %{?_smp_mflags} VERBOSE=1

%install
cd release
make DESTDIR=%{buildroot} install

install -d -m 0755 %{buildroot}%{mysqldatadir}
install -d -m 0750 %{buildroot}%{mysqlkeyringdir}
# secure_file_priv is compiled in as /var/lib/mysql-files. mysqld calls
# realpath() on it during startup and REFUSES TO START if it is missing:
#   mysqld: Error on realpath() on '/var/lib/mysql-files' (Error 2 ...)
# The build does not create it, so the package must own it.
install -d -m 0750 %{buildroot}%{mysqlfilesdir}
install -d -m 0755 %{buildroot}%{_localstatedir}/log
install -d -m 0755 %{buildroot}%{_sysconfdir}/my.cnf.d
install -d -m 0755 %{buildroot}%{_libdir}/mysql/veb
install -d -m 0755 %{buildroot}/run/mysqld

install -D -m 0644 %{SOURCE1} %{buildroot}%{_sysconfdir}/logrotate.d/mysql
touch %{buildroot}%{_localstatedir}/log/mysqld.log

# The client library installs to %%{_libdir}/mysql, which is not on the default
# linker search path. Without this, anything linking -lmysqlclient fails to
# resolve at runtime. The build does not generate it, so write it here.
install -d -m 0755 %{buildroot}%{_sysconfdir}/ld.so.conf.d
echo "%{_libdir}/mysql" > %{buildroot}%{_sysconfdir}/ld.so.conf.d/villagesql-%{_arch}.conf
chmod 0644 %{buildroot}%{_sysconfdir}/ld.so.conf.d/villagesql-%{_arch}.conf

# The build installs a mysql.server SysV script and a bundled my.cnf under
# share/; neither belongs in a systemd-managed RPM.
rm -f %{buildroot}%{_datadir}/mysql-%{mysql_base_version}/mysql.server
rm -f %{buildroot}%{_datadir}/mysql-%{mysql_base_version}/mysqld_multi.server
rm -f %{buildroot}%{_sysconfdir}/my.cnf.d/client.cnf
rm -rf %{buildroot}%{_datadir}/mysql-%{mysql_base_version}/solaris

# Drop static archives; the client library ships as a shared object only.
rm -f %{buildroot}%{_libdir}/mysql/libmysqlclient.a
rm -f %{buildroot}%{_libdir}/mysql/libmysqlservices.a

# /etc/my.cnf: written here rather than taken from the build so the veb_dir
# default is explicit and greppable for anyone auditing the install.
install -d -m 0755 %{buildroot}%{_sysconfdir}
cat > %{buildroot}%{_sysconfdir}/my.cnf <<'EOF'
#
# VillageSQL Server configuration.
#
# For the full reference see https://villagesql.com/docs
#
[mysqld]
datadir=/var/lib/mysql
socket=/var/lib/mysql/mysql.sock

log-error=/var/log/mysqld.log
pid-file=/run/mysqld/mysqld.pid

# Directory searched by INSTALL EXTENSION for .veb bundles. This matches the
# compiled-in default; it is stated explicitly so it is visible in the config.
veb_dir=%{_libdir}/mysql/veb

!includedir /etc/my.cnf.d
EOF

%pre server
/usr/sbin/groupadd -g 27 -o -r mysql >/dev/null 2>&1 || :
/usr/sbin/useradd -M -N -g mysql -o -r -d %{mysqldatadir} -s /sbin/nologin \
    -c "VillageSQL Server" -u 27 mysql >/dev/null 2>&1 || :

%post server
[ -e %{_localstatedir}/log/mysqld.log ] || \
    install -m 0640 -o mysql -g mysql /dev/null %{_localstatedir}/log/mysqld.log >/dev/null 2>&1 || :
%systemd_post mysqld.service
if [ $1 -eq 1 ]; then
    /usr/bin/systemctl enable mysqld >/dev/null 2>&1 || :
fi
# On upgrade from MySQL/MariaDB the data directory is retained. Both the MySQL
# data dictionary and the VillageSQL victionary (villagesql.* system schema)
# are upgraded by the server itself on first start after the binary changes;
# mysqld_pre_systemd invokes that path. Nothing to do here beyond ensuring the
# unit is in place.

%preun server
%systemd_preun mysqld.service

%postun server
%systemd_postun_with_restart mysqld.service

%post libs -p /sbin/ldconfig
%postun libs -p /sbin/ldconfig

# ============================================================================

%files
# Metapackage: intentionally empty, pulls in villagesql-server via Requires.

%files server
%license LICENSE
%doc README.md
%config(noreplace) %{_sysconfdir}/my.cnf
%dir %{_sysconfdir}/my.cnf.d
%config(noreplace) %{_sysconfdir}/logrotate.d/mysql

%attr(755, root, root) %{_sbindir}/mysqld
%attr(755, root, root) %{_bindir}/ibd2sdi
%attr(755, root, root) %{_bindir}/innochecksum
%attr(755, root, root) %{_bindir}/my_print_defaults
%attr(755, root, root) %{_bindir}/myisam_ftdump
%attr(755, root, root) %{_bindir}/myisamchk
%attr(755, root, root) %{_bindir}/myisamlog
%attr(755, root, root) %{_bindir}/myisampack
%attr(755, root, root) %{_bindir}/mysql_migrate_keyring
%attr(755, root, root) %{_bindir}/mysql_secure_installation
%attr(755, root, root) %{_bindir}/mysql_tzinfo_to_sql
%attr(755, root, root) %{_bindir}/mysqld_pre_systemd
%attr(755, root, root) %{_bindir}/mysqld_safe
%attr(755, root, root) %{_bindir}/mysqldumpslow
%attr(755, root, root) %{_bindir}/perror

# Globbed rather than enumerated. The upstream spec lists every plugin and
# every bundled abseil/protobuf object by name, which breaks on each rebase
# when upstream adds or renames one. A glob cannot go stale, and rpmbuild
# still fails the build on any file that no subpackage claims.
%dir %{_libdir}/mysql
%dir %{_libdir}/mysql/plugin
# Glob is '*' not '*.so': the plugin dir also ships daemon_example.ini, and a
# .so-only glob leaves it unpackaged and fails the build.
%{_libdir}/mysql/plugin/*
%dir %{_libdir}/mysql/private
%{_libdir}/mysql/private/*

%dir %{_libdir}/mysql/veb

%{_unitdir}/mysqld.service
%{_unitdir}/mysqld@.service
%{_prefix}/lib/tmpfiles.d/mysql.conf

%dir %attr(751, mysql, mysql) %{mysqldatadir}
%dir %attr(750, mysql, mysql) %{mysqlkeyringdir}
%dir %attr(750, mysql, mysql) %{mysqlfilesdir}
%dir %attr(755, mysql, mysql) /run/mysqld
%attr(640, mysql, mysql) %ghost %config(noreplace, missingok) %{_localstatedir}/log/mysqld.log

%{_mandir}/man1/ibd2sdi.1*
%{_mandir}/man1/innochecksum.1*
%{_mandir}/man1/my_print_defaults.1*
%{_mandir}/man1/myisam_ftdump.1*
%{_mandir}/man1/myisamchk.1*
%{_mandir}/man1/myisamlog.1*
%{_mandir}/man1/myisampack.1*
%{_mandir}/man1/mysql_secure_installation.1*
%{_mandir}/man1/mysql_tzinfo_to_sql.1*
%{_mandir}/man1/mysqldumpslow.1*
%{_mandir}/man1/mysqlman.1*
%{_mandir}/man1/perror.1*
%{_mandir}/man8/mysqld.8*

%files client
%attr(755, root, root) %{_bindir}/mysql
%attr(755, root, root) %{_bindir}/mysqladmin
%attr(755, root, root) %{_bindir}/mysqlbinlog
%attr(755, root, root) %{_bindir}/mysqlcheck
%attr(755, root, root) %{_bindir}/mysqldump
%attr(755, root, root) %{_bindir}/mysqlimport
%attr(755, root, root) %{_bindir}/mysqlshow
%attr(755, root, root) %{_bindir}/mysqlslap
%attr(755, root, root) %{_bindir}/mysql_config_editor
%{_mandir}/man1/mysql.1*
%{_mandir}/man1/mysqladmin.1*
%{_mandir}/man1/mysqlbinlog.1*
%{_mandir}/man1/mysqlcheck.1*
%{_mandir}/man1/mysqldump.1*
%{_mandir}/man1/mysqlimport.1*
%{_mandir}/man1/mysqlshow.1*
%{_mandir}/man1/mysqlslap.1*
%{_mandir}/man1/mysql_config_editor.1*

%files common
%license LICENSE
%dir %{_datadir}/mysql-%{mysql_base_version}
%{_datadir}/mysql-%{mysql_base_version}/charsets/
# *.sql covers install_rewriter, uninstall_rewriter and villagesql_schema.
# There are no *.cnf files here despite upstream's spec listing them.
%{_datadir}/mysql-%{mysql_base_version}/*.sql
%{_datadir}/mysql-%{mysql_base_version}/*/errmsg.sys
%{_datadir}/mysql-%{mysql_base_version}/dictionary.txt
%{_datadir}/mysql-%{mysql_base_version}/messages_to_error_log.txt
%{_datadir}/mysql-%{mysql_base_version}/messages_to_clients.txt
%{_datadir}/mysql-%{mysql_base_version}/mysql-log-rotate

%files libs
%license LICENSE
%dir %{_libdir}/mysql
%{_libdir}/mysql/libmysqlclient.so.*
%config(noreplace) %{_sysconfdir}/ld.so.conf.d/villagesql-%{_arch}.conf

%files devel
%{_bindir}/mysql_config
%{_includedir}/mysql/
# The VEF stable headers install under %%{_includedir}/mysql/villagesql. They
# belong to villagesql-sdk, not to client development, so carve them out here
# and claim them there. Without the %%exclude both packages own the same paths.
%exclude %{_includedir}/mysql/villagesql
%{_libdir}/mysql/libmysqlclient.so
%{_libdir}/pkgconfig/*.pc
%{_datadir}/aclocal/mysql.m4
%{_mandir}/man1/mysql_config.1*

%files sdk
%license LICENSE
%doc villagesql/sdk/README.md villagesql/sdk/API_ABI.md
%{_bindir}/villagesql_config
%{_includedir}/mysql/villagesql
%{_includedir}/mysql-dev/
%{_libdir}/mysql/cmake/

%files extension-examples
%{_libdir}/mysql/veb/*.veb

%files test
%{_datadir}/mysql-test/
# Harness and developer-test binaries. These are built unconditionally and
# belong with the test suite, not with the server or client packages.
%attr(755, root, root) %{_bindir}/comp_err
%attr(755, root, root) %{_bindir}/mysql_client_test
%attr(755, root, root) %{_bindir}/mysql_keyring_encryption_test
%attr(755, root, root) %{_bindir}/mysql_test_event_tracking
%attr(755, root, root) %{_bindir}/mysqltest
%attr(755, root, root) %{_bindir}/mysqltest_safe_process
%attr(755, root, root) %{_bindir}/mysqlxtest
%{_mandir}/man1/comp_err.1*

