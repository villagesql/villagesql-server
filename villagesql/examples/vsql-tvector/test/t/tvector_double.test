# Install vsql-tvector extension
INSTALL EXTENSION vsql_tvector;

########################################################################
#
# Test: Basic TVECTOR with type=double DDL, DML, and queries
#
########################################################################

CREATE TABLE t (
    id INT AUTO_INCREMENT PRIMARY KEY,
    v TVECTOR('dimension=3,type=double')
);

# Insert valid vectors
INSERT INTO t (v) VALUES ('[1.0,2.0,3.0]');
INSERT INTO t (v) VALUES ('[4.5,5.5,6.5]');
INSERT INTO t (v) VALUES ('[0,0,0]');
INSERT INTO t (v) VALUES ('[-1.5,2.5,-3.5]');

SELECT id, v FROM t ORDER BY id;

########################################################################
#
# Test: Double precision is preserved (values beyond float32 range)
#
########################################################################

CREATE TABLE t_prec (
    id INT AUTO_INCREMENT PRIMARY KEY,
    v TVECTOR('dimension=2,type=double')
);

INSERT INTO t_prec (v) VALUES ('[1.23456789012345,9.87654321098765]');

SELECT id, v FROM t_prec ORDER BY id;

DROP TABLE t_prec;

########################################################################
#
# Test: NULL handling with double
#
########################################################################

CREATE TABLE t_nulls (
    id INT AUTO_INCREMENT PRIMARY KEY,
    v TVECTOR('dimension=3,type=double') DEFAULT NULL
);

INSERT INTO t_nulls (v) VALUES ('[1,2,3]');
INSERT INTO t_nulls (v) VALUES (NULL);
INSERT INTO t_nulls (v) VALUES ('[4,5,6]');

SELECT id, v FROM t_nulls ORDER BY id;
SELECT id, v FROM t_nulls WHERE v IS NULL;
SELECT id, v FROM t_nulls WHERE v IS NOT NULL ORDER BY id;

########################################################################
#
# Test: Equality comparison with double
#
########################################################################

SELECT id, v FROM t WHERE v = '[1,2,3]';

########################################################################
#
# Test: ORDER BY (lexicographic comparison) with double
#
########################################################################

SELECT id, v FROM t ORDER BY v;

########################################################################
#
# Test: Invalid format errors with double
#
########################################################################

--error ER_TRUNCATED_WRONG_VALUE_FOR_FIELD
INSERT INTO t (v) VALUES ('not a vector');

# Wrong dimension count
--error ER_TRUNCATED_WRONG_VALUE_FOR_FIELD
INSERT INTO t (v) VALUES ('[1,2]');

--error ER_TRUNCATED_WRONG_VALUE_FOR_FIELD
INSERT INTO t (v) VALUES ('[1,2,3,4]');

########################################################################
#
# Test: Explicit type=float matches TVECTOR(N) behavior
#
########################################################################

CREATE TABLE t_float (
    id INT AUTO_INCREMENT PRIMARY KEY,
    v TVECTOR('dimension=3,type=float')
);

INSERT INTO t_float (v) VALUES ('[1,2,3]');

SELECT id, v FROM t_float ORDER BY id;

DROP TABLE t_float;

########################################################################
#
# Test: Invalid type parameter value
#
########################################################################

--error ER_PARSE_ERROR
CREATE TABLE t_err (v TVECTOR('dimension=3,type=int'));

# An empty value never reaches TVECTOR's resolve_params: the server rejects a
# valueless parameter first, so the error is the generic one.
--error ER_PARSE_ERROR
CREATE TABLE t_err (v TVECTOR('dimension=3,type='));

########################################################################
#
# Test: tvector_as_double -- widening a float vector to double
#
########################################################################

CREATE TABLE f3 (id INT PRIMARY KEY, v TVECTOR(3));
INSERT INTO f3 VALUES (1, '[1.5,2.25,4]'), (2, NULL);

SELECT id, v, vsql_tvector.tvector_as_double(v) AS widened
FROM f3 ORDER BY id;

--echo # The dimension is carried over unchanged.
SELECT vsql_tvector.tvector_dim(vsql_tvector.tvector_as_double(v)) AS n
FROM f3 WHERE id = 1;

CREATE TABLE wide3 (v TVECTOR('dimension=3,type=double'));
INSERT INTO wide3 SELECT vsql_tvector.tvector_as_double(v) FROM f3 WHERE id = 1;
SELECT v FROM wide3;

--error ER_VILLAGESQL_GENERIC_ERROR
INSERT INTO f3 SELECT 9, vsql_tvector.tvector_as_double(v) FROM f3 WHERE id = 1;

--echo # Widening does not invent precision the float never had: 0.1 stored as
--echo # float and widened is the float value, not the double nearest 0.1.
INSERT INTO f3 VALUES (3, '[0.1,0,0]');
SELECT vsql_tvector.tvector_as_double(v) AS widened_tenth
FROM f3 WHERE id = 3;

--echo # A double argument passes through unchanged.
SELECT vsql_tvector.tvector_as_double(v) AS already_wide FROM t WHERE id = 1;

--echo # And from a bare literal, which the hook reads as float first.
SELECT vsql_tvector.tvector_as_double('[1.5,2.5]') AS widened;

--error ER_CANT_INITIALIZE_UDF
SELECT vsql_tvector.tvector_as_double('[]');

########################################################################
#
# Clean up
#
########################################################################

DROP TABLE wide3, f3;
DROP TABLE t, t_nulls;

UNINSTALL EXTENSION vsql_tvector;
