INSTALL EXTENSION vsql_tvector;
CREATE TABLE v3 (id INT PRIMARY KEY, v TVECTOR(3));
CREATE TABLE v2 (id INT PRIMARY KEY, v TVECTOR(2));
CREATE TABLE d2 (id INT PRIMARY KEY, v TVECTOR('dimension=2,type=double'));
INSERT INTO v3 VALUES (1, '[1,2,3]');
INSERT INTO v2 VALUES (1, '[10,20]');
INSERT INTO d2 VALUES (1, '[100,200]');
SELECT vsql_tvector.tvector_sum_all(v) AS vector_only FROM v3;
vector_only
6
SELECT vsql_tvector.tvector_sum_all(7) AS int_only;
int_only
7
SELECT vsql_tvector.tvector_sum_all(2.5e0) AS real_only;
real_only
2.5
SELECT vsql_tvector.tvector_sum_all('[4,5]') AS literal_only;
literal_only
9
# 2.5e0 above is a REAL, but a bare 2.5 is a DECIMAL, and the server has
# no VEF type for decimals: an extension is handed one as a string. So
# the hook sees a string that is not a vector literal and refuses it.
# Writing 2.5e0, or CAST(2.5 AS DOUBLE), makes it a REAL.
SELECT vsql_tvector.tvector_sum_all(2.5) AS decimal_literal;
ERROR HY000: Cannot initialize function 'tvector_sum_all': argument 1 is not a vector literal
SELECT vsql_tvector.tvector_sum_all(CAST(2.5 AS DOUBLE)) AS decimal_cast;
decimal_cast
2.5
SELECT vsql_tvector.tvector_sum_all(v, 100) AS vector_and_int FROM v3;
vector_and_int
106
SELECT vsql_tvector.tvector_sum_all(v, '[4,5]') AS vector_and_literal FROM v3;
vector_and_literal
15
SELECT vsql_tvector.tvector_sum_all(7, '[4,5]') AS int_and_literal;
int_and_literal
16
# All three kinds at once: 1+2+3, then 100, then 4+5, then 0.5
SELECT vsql_tvector.tvector_sum_all(v, 100, '[4,5]', 0.5e0) AS all_three FROM v3;
all_three
115.5
SELECT vsql_tvector.tvector_sum_all(v, 100, '[4,5]') AS order_a FROM v3;
order_a
115
SELECT vsql_tvector.tvector_sum_all('[4,5]', v, 100) AS order_b FROM v3;
order_b
115
SELECT vsql_tvector.tvector_sum_all(100, '[4,5]', v) AS order_c FROM v3;
order_c
115
SELECT vsql_tvector.tvector_sum_all(a.v, b.v, c.v) AS float_and_double
FROM v3 a, v2 b, d2 c;
float_and_double
336
SELECT vsql_tvector.tvector_sum_all(c.v, '[1,2]', 1) AS double_literal_int
FROM d2 c;
double_literal_int
304
# A lone literal has nothing to inherit an element width from, so it is
# read as float, the same width tvector_from_string infers.
SELECT vsql_tvector.tvector_sum_all('[1.5,2.5]') AS lone_literal;
lone_literal
4
# The return really is a REAL, not a custom type: it takes part in
# ordinary arithmetic and comparison.
SELECT vsql_tvector.tvector_sum_all(v) / 2 AS halved FROM v3;
halved
3
SELECT vsql_tvector.tvector_sum_all(v) > 5 AS gt_five FROM v3;
gt_five
1
SELECT vsql_tvector.tvector_sum_all(
vsql_tvector.tvector_concat(a.v, b.v),
'[4,5]',
a.v,
vsql_tvector.TVECTOR::from_string('[7,8]'),
100) AS every_route
FROM v3 a, v2 b;
every_route
166
CREATE TABLE s (id INT PRIMARY KEY, t VARCHAR(64));
INSERT INTO s VALUES (1,'[1,2,3]'),(2,'[10,20]'),(3,'[5]');
SELECT id, vsql_tvector.tvector_sum_all(vsql_tvector.TVECTOR::from_string(t))
AS unknown_params
FROM s ORDER BY id;
ERROR HY000: Cannot initialize function 'tvector_sum_all': argument 1 is a TVECTOR with unknown type parameters
DROP TABLE s;
INSERT INTO v3 VALUES (2, NULL);
SELECT id, vsql_tvector.tvector_sum_all(v, 1) AS s FROM v3 ORDER BY id;
id	s
1	7
2	NULL
# A NULL *literal* is refused, though, and the hook has no way to allow
# it: a hook is shown types, not values, so the literal NULL and a
# non-constant string look identical to it, both being a string with no
# constant value. The NULL column above is a different thing: it carries a
# TypeContext, so it is a TVECTOR that happens to be NULL this row.
SELECT vsql_tvector.tvector_sum_all(v, NULL) AS null_literal FROM v3 WHERE id = 1;
ERROR HY000: Cannot initialize function 'tvector_sum_all': argument 2 must be a TVECTOR or a constant vector literal
SELECT vsql_tvector.tvector_sum_all() AS none;
ERROR HY000: Cannot initialize function 'tvector_sum_all': requires at least one argument
# A string that is not a vector literal.
SELECT vsql_tvector.tvector_sum_all(v, 'nope') AS c FROM v3;
ERROR HY000: Cannot initialize function 'tvector_sum_all': argument 2 is not a vector literal
SELECT vsql_tvector.tvector_sum_all(v, '[]') AS c FROM v3;
ERROR HY000: Cannot initialize function 'tvector_sum_all': argument 2 is empty; a TVECTOR must have at least one element
# Too many elements. The hook counts them.
# At the limit: 4096 elements, each 1.
at_limit
4096
# One over: refused, naming the argument and the limit.
ERROR HY000: Cannot initialize function 'tvector_sum_all': argument 1 has 4097 elements; the maximum is 4096
# A constant expression is not the same as a literal.
SELECT vsql_tvector.tvector_sum_all(v, CONCAT('[1,', '2]')) AS c FROM v3;
ERROR HY000: Cannot initialize function 'tvector_sum_all': argument 2 must be a custom type or string constant
SELECT vsql_tvector.tvector_sum_all(v, id) AS with_int_column FROM v3 WHERE id = 1;
with_int_column
7
# Malformed literals. The hook parses each element while counting them,
# so all of these are refused at resolution time, before any row is read
# and whatever else the call contains.
SELECT vsql_tvector.tvector_sum_all('[x,2,4]') AS bad_first;
ERROR HY000: Cannot initialize function 'tvector_sum_all': argument 1 is not a vector literal
SELECT vsql_tvector.tvector_sum_all('[1,x,4]') AS bad_middle;
ERROR HY000: Cannot initialize function 'tvector_sum_all': argument 1 is not a vector literal
SELECT vsql_tvector.tvector_sum_all('[1,,2]') AS empty_element;
ERROR HY000: Cannot initialize function 'tvector_sum_all': argument 1 is not a vector literal
SELECT vsql_tvector.tvector_sum_all('[1,2') AS unterminated;
ERROR HY000: Cannot initialize function 'tvector_sum_all': argument 1 is not a vector literal
SELECT vsql_tvector.tvector_sum_all('[1,2]x') AS trailing_junk;
ERROR HY000: Cannot initialize function 'tvector_sum_all': argument 1 is not a vector literal
SELECT vsql_tvector.tvector_sum_all('[ ]') AS whitespace_only;
ERROR HY000: Cannot initialize function 'tvector_sum_all': argument 1 is empty; a TVECTOR must have at least one element
# Quoted elements, as someone used to JSON might write.
# sees ['x',2] and ["x",2].
SELECT vsql_tvector.tvector_sum_all('[''x'',2]') AS single_quoted_element;
ERROR HY000: Cannot initialize function 'tvector_sum_all': argument 1 is not a vector literal
SELECT vsql_tvector.tvector_sum_all('["x",2]') AS double_quoted_element;
ERROR HY000: Cannot initialize function 'tvector_sum_all': argument 1 is not a vector literal
# Quoting a number does not help either: it is the quote that stops the
# parse, not the thing inside it.
SELECT vsql_tvector.tvector_sum_all('[''1'',2]') AS quoted_number;
ERROR HY000: Cannot initialize function 'tvector_sum_all': argument 1 is not a vector literal
# A bad literal is refused even when a perfectly good column sits beside
# it, since the hook has to settle every argument before any of them.
SELECT vsql_tvector.tvector_sum_all(v, '[x,2,4]') AS bad_with_column FROM v3;
ERROR HY000: Cannot initialize function 'tvector_sum_all': argument 2 is not a vector literal
# Values the vector cannot hold. These are well-formed literals, so the
# message says what is wrong with the value rather than calling the
# whole thing unparseable. The width matters: these are refused here
# because a literal in this function is read as float.
SELECT vsql_tvector.tvector_sum_all('[1e400]') AS beyond_double;
ERROR HY000: Cannot initialize function 'tvector_sum_all': argument 1 has an element that is not a finite float value
SELECT vsql_tvector.tvector_sum_all('[1e300]') AS beyond_float;
ERROR HY000: Cannot initialize function 'tvector_sum_all': argument 1 has an element that is not a finite float value
SELECT vsql_tvector.tvector_sum_all('[-1e300]') AS beyond_float_negative;
ERROR HY000: Cannot initialize function 'tvector_sum_all': argument 1 has an element that is not a finite float value
# strtod and strtof accept these spellings, so without the check a
# single one of them would quietly poison every sum it took part in.
SELECT vsql_tvector.tvector_sum_all('[nan,1]') AS not_a_number;
ERROR HY000: Cannot initialize function 'tvector_sum_all': argument 1 has an element that is not a finite float value
SELECT vsql_tvector.tvector_sum_all('[inf]') AS infinity;
ERROR HY000: Cannot initialize function 'tvector_sum_all': argument 1 has an element that is not a finite float value
# Underflow is not an error. An element too small for a float becomes
# zero, which is ordinary floating point rather than a value the vector
# cannot hold.
SELECT vsql_tvector.tvector_sum_all('[1e-50,1]') AS underflow;
underflow
1
DROP TABLE v3;
DROP TABLE v2;
DROP TABLE d2;
UNINSTALL EXTENSION vsql_tvector;
