INSTALL EXTENSION vsql_tvector;
CREATE TABLE v3 (id INT PRIMARY KEY, v TVECTOR(3));
INSERT INTO v3 VALUES (1, '[3,9,4]'), (2, '[-5,-1,-7]');
CREATE TABLE d3 (id INT PRIMARY KEY, v TVECTOR('dimension=3,type=double'));
INSERT INTO d3 VALUES (1, '[1.5,9.25,3.5]');
SELECT id, v, vsql_tvector.tvector_dim(v) AS n FROM v3 ORDER BY id;
id	v	n
1	[3,9,4]	3
2	[-5,-1,-7]	3
SELECT vsql_tvector.tvector_dim(v) AS from_double_column FROM d3;
from_double_column
3
SELECT vsql_tvector.tvector_dim('[1,2,3,4,5]') AS from_literal;
from_literal
5
SELECT vsql_tvector.tvector_dim('[7]') AS one_element;
one_element
1
SELECT vsql_tvector.tvector_dim(TVECTOR::from_string('[1,2]')) AS from_ctor;
from_ctor
2
SELECT vsql_tvector.tvector_dim(
vsql_tvector.tvector_concat(v, '[1,2]')) AS after_concat
FROM v3 WHERE id = 1;
after_concat
5
SELECT vsql_tvector.tvector_dim(
vsql_tvector.tvector_max_as_vector(v)) AS after_reduce
FROM v3 WHERE id = 1;
after_reduce
1
SELECT vsql_tvector.tvector_dim('not a vector');
ERROR HY000: Can't initialize function 'tvector_dim'; tvector_dim: argument 1 is not a vector literal
SELECT vsql_tvector.tvector_dim('[]');
ERROR HY000: Can't initialize function 'tvector_dim'; tvector_dim: argument 1 is empty; a TVECTOR must have at least one element
CREATE TABLE texts (t VARCHAR(32));
INSERT INTO texts VALUES ('[1,2]');
# Not constant, so there is no value to count at resolution time.
SELECT vsql_tvector.tvector_dim(t) FROM texts;
ERROR HY000: Can't initialize function 'tvector_dim'; tvector_dim: argument 1 must be a TVECTOR or a constant vector literal
INSERT INTO v3 VALUES (3, NULL);
SELECT id, vsql_tvector.tvector_dim(v) IS NULL AS is_null
FROM v3 ORDER BY id;
id	is_null
1	0
2	0
3	1
DROP TABLE texts;
DROP TABLE d3;
DROP TABLE v3;
UNINSTALL EXTENSION vsql_tvector;
