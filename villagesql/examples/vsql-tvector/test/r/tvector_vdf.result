INSTALL EXTENSION vsql_tvector;
CREATE TABLE t (
id INT AUTO_INCREMENT PRIMARY KEY,
v TVECTOR(3)
);
INSERT INTO t (v) VALUES ('[1,2,3]');
INSERT INTO t (v) VALUES ('[4,5,6]');
INSERT INTO t (v) VALUES ('[0,0,0]');
INSERT INTO t (v) VALUES ('[-1,-2,-3]');
SELECT vsql_tvector.tvector_dot_product(
(SELECT v FROM t WHERE id=1),
(SELECT v FROM t WHERE id=1)) AS dot_self;
dot_self
14
SELECT vsql_tvector.tvector_dot_product(
(SELECT v FROM t WHERE id=1),
(SELECT v FROM t WHERE id=2)) AS dot_12;
dot_12
32
SELECT vsql_tvector.tvector_dot_product(
(SELECT v FROM t WHERE id=1),
(SELECT v FROM t WHERE id=3)) AS dot_zero;
dot_zero
0
SELECT vsql_tvector.tvector_dot_product(
(SELECT v FROM t WHERE id=1),
(SELECT v FROM t WHERE id=4)) AS dot_neg;
dot_neg
-14
CREATE TABLE t_double (
id INT AUTO_INCREMENT PRIMARY KEY,
v TVECTOR('dimension=3,type=double')
);
INSERT INTO t_double (v) VALUES ('[1.5,2.5,3.5]');
INSERT INTO t_double (v) VALUES ('[2.0,4.0,6.0]');
SELECT vsql_tvector.tvector_dot_product(
(SELECT v FROM t_double WHERE id=1),
(SELECT v FROM t_double WHERE id=2)) AS dot_double;
dot_double
34
CREATE TABLE t_nulls (
id INT AUTO_INCREMENT PRIMARY KEY,
v TVECTOR(3) DEFAULT NULL
);
INSERT INTO t_nulls (v) VALUES ('[1,2,3]');
INSERT INTO t_nulls (v) VALUES (NULL);
SELECT vsql_tvector.tvector_dot_product(
(SELECT v FROM t_nulls WHERE id=1),
(SELECT v FROM t_nulls WHERE id=2)) AS dot_null_right;
dot_null_right
NULL
SELECT vsql_tvector.tvector_dot_product(
(SELECT v FROM t_nulls WHERE id=2),
(SELECT v FROM t_nulls WHERE id=1)) AS dot_null_left;
dot_null_left
NULL
SELECT vsql_tvector.tvector_dot_product(
(SELECT v FROM t_nulls WHERE id=2),
(SELECT v FROM t_nulls WHERE id=2)) AS dot_null_both;
dot_null_both
NULL
DROP TABLE t, t_double, t_nulls;
UNINSTALL EXTENSION vsql_tvector;
