INSTALL EXTENSION vsql_tvector;
CREATE TABLE v3 (id INT PRIMARY KEY, v TVECTOR(3));
INSERT INTO v3 VALUES (1, '[3,9,4]'), (2, '[-5,-1,-7]');
CREATE TABLE d3 (id INT PRIMARY KEY, v TVECTOR('dimension=3,type=double'));
INSERT INTO d3 VALUES (1, '[1.5,9.25,3.5]');
SELECT id, v, vsql_tvector.tvector_dim(v) AS n FROM v3 ORDER BY id;
id	v	n
1	[3,9,4]	3
2	[-5,-1,-7]	3
SELECT vsql_tvector.tvector_dim('[1,2,3,4,5]') AS from_literal;
from_literal
5
SELECT vsql_tvector.tvector_dim(TVECTOR::from_string('[1,2]')) AS from_ctor;
from_ctor
2
SELECT vsql_tvector.tvector_dim(v) AS from_double_column FROM d3;
from_double_column
3
# It reports the dimension tvector_concat's hook computed.
SELECT vsql_tvector.tvector_dim(
vsql_tvector.tvector_concat(v, '[1,2]')) AS n
FROM v3 WHERE id = 1;
n
5
SELECT id,
vsql_tvector.tvector_max_as_vector(v) AS mx,
vsql_tvector.tvector_min_as_vector(v) AS mn
FROM v3 ORDER BY id;
id	mx	mn
1	[9]	[3]
2	[-1]	[-7]
SELECT vsql_tvector.tvector_dim(vsql_tvector.tvector_max_as_vector(v)) AS n
FROM v3 WHERE id = 1;
n
1
# The result is TVECTOR(1) and stores into a matching column.
CREATE TABLE peaks (id INT PRIMARY KEY, p TVECTOR(1));
INSERT INTO peaks SELECT id, vsql_tvector.tvector_max_as_vector(v) FROM v3;
SELECT id, p FROM peaks ORDER BY id;
id	p
1	[9]
2	[-1]
# A REAL cannot go the same route -- this is why the _as_vector forms
# exist at all.
INSERT INTO peaks VALUES (99, 9);
ERROR HY000: Incorrect TVECTOR value: '9' for column 'p' at row 1
# The element type is inherited, so a double vector yields
# TVECTOR('dimension=1,type=double') and needs a matching column.
SELECT vsql_tvector.tvector_max_as_vector(v) AS mx FROM d3;
mx
[9.25]
CREATE TABLE dpeaks (p TVECTOR('dimension=1,type=double'));
INSERT INTO dpeaks SELECT vsql_tvector.tvector_max_as_vector(v) FROM d3;
SELECT p FROM dpeaks;
p
[9.25]
INSERT INTO peaks VALUES (98, vsql_tvector.tvector_max_as_vector(
(SELECT v FROM d3 LIMIT 1)));
ERROR HY000: Cannot implicitly cast from vsql_tvector.TVECTOR('dimension=1,type=double') to vsql_tvector.TVECTOR(1) for column 'p' at row 2
# From a bare literal too.
SELECT vsql_tvector.tvector_max_as_vector('[4,1,7,2]') AS mx,
vsql_tvector.tvector_min_as_vector('[4,1,7,2]') AS mn;
mx	mn
[7]	[1]
SELECT id, v, vsql_tvector.tvector_as_double(v) AS widened
FROM v3 ORDER BY id;
id	v	widened
1	[3,9,4]	[3,9,4]
2	[-5,-1,-7]	[-5,-1,-7]
SELECT vsql_tvector.tvector_dim(vsql_tvector.tvector_as_double(v)) AS n
FROM v3 WHERE id = 1;
n
3
# It really is type=double now: it stores into a double column and is
# refused by a float one of the same dimension.
CREATE TABLE wide3 (v TVECTOR('dimension=3,type=double'));
INSERT INTO wide3 SELECT vsql_tvector.tvector_as_double(v) FROM v3 WHERE id = 1;
SELECT v FROM wide3;
v
[3,9,4]
INSERT INTO v3 SELECT 9, vsql_tvector.tvector_as_double(v) FROM v3 WHERE id = 1;
ERROR HY000: Cannot implicitly cast from vsql_tvector.TVECTOR('dimension=3,type=double') to vsql_tvector.TVECTOR(3) for column 'v' at row 1
# A double argument passes through unchanged.
SELECT vsql_tvector.tvector_as_double(v) AS already_wide FROM d3;
already_wide
[1.5,9.25,3.5]
# And from a bare literal, which the hook reads as float first.
SELECT vsql_tvector.tvector_as_double('[1.5,2.5]') AS widened;
widened
[1.5,2.5]
INSERT INTO v3 VALUES (3, NULL);
SELECT id,
vsql_tvector.tvector_dim(v) IS NULL AS dim_null,
vsql_tvector.tvector_max_as_vector(v) IS NULL AS max_null,
vsql_tvector.tvector_min_as_vector(v) IS NULL AS min_null,
vsql_tvector.tvector_as_double(v) IS NULL AS wide_null
FROM v3 ORDER BY id;
id	dim_null	max_null	min_null	wide_null
1	0	0	0	0
2	0	0	0	0
3	1	1	1	1
SELECT vsql_tvector.tvector_dim('not a vector');
ERROR HY000: Can't initialize function 'tvector_dim'; tvector_dim: argument 1 is not a vector literal
SELECT vsql_tvector.tvector_max_as_vector('[]');
ERROR HY000: Can't initialize function 'tvector_max_as_vector'; tvector_max_as_vector: argument 1 is empty; a TVECTOR must have at least one element
SELECT vsql_tvector.tvector_as_double('[]');
ERROR HY000: Can't initialize function 'tvector_as_double'; tvector_as_double: argument 1 is empty; a TVECTOR must have at least one element
DROP TABLE wide3;
DROP TABLE dpeaks;
DROP TABLE peaks;
DROP TABLE d3;
DROP TABLE v3;
UNINSTALL EXTENSION vsql_tvector;
