INSTALL EXTENSION vsql_tvector;
CREATE TABLE t (
id INT AUTO_INCREMENT PRIMARY KEY,
v TVECTOR('dimension=3,type=double')
);
INSERT INTO t (v) VALUES ('[1.0,2.0,3.0]');
INSERT INTO t (v) VALUES ('[4.5,5.5,6.5]');
INSERT INTO t (v) VALUES ('[0,0,0]');
INSERT INTO t (v) VALUES ('[-1.5,2.5,-3.5]');
SELECT id, v FROM t ORDER BY id;
id	v
1	[1,2,3]
2	[4.5,5.5,6.5]
3	[0,0,0]
4	[-1.5,2.5,-3.5]
CREATE TABLE t_prec (
id INT AUTO_INCREMENT PRIMARY KEY,
v TVECTOR('dimension=2,type=double')
);
INSERT INTO t_prec (v) VALUES ('[1.23456789012345,9.87654321098765]');
SELECT id, v FROM t_prec ORDER BY id;
id	v
1	[1.23456789012345,9.87654321098765]
DROP TABLE t_prec;
CREATE TABLE t_nulls (
id INT AUTO_INCREMENT PRIMARY KEY,
v TVECTOR('dimension=3,type=double') DEFAULT NULL
);
INSERT INTO t_nulls (v) VALUES ('[1,2,3]');
INSERT INTO t_nulls (v) VALUES (NULL);
INSERT INTO t_nulls (v) VALUES ('[4,5,6]');
SELECT id, v FROM t_nulls ORDER BY id;
id	v
1	[1,2,3]
2	NULL
3	[4,5,6]
SELECT id, v FROM t_nulls WHERE v IS NULL;
id	v
2	NULL
SELECT id, v FROM t_nulls WHERE v IS NOT NULL ORDER BY id;
id	v
1	[1,2,3]
3	[4,5,6]
SELECT id, v FROM t WHERE v = '[1,2,3]';
id	v
1	[1,2,3]
SELECT id, v FROM t ORDER BY v;
id	v
4	[-1.5,2.5,-3.5]
3	[0,0,0]
1	[1,2,3]
2	[4.5,5.5,6.5]
INSERT INTO t (v) VALUES ('not a vector');
ERROR HY000: Incorrect TVECTOR value: 'not a vector' for column 'v' at row 1
INSERT INTO t (v) VALUES ('[1,2]');
ERROR HY000: Incorrect TVECTOR value: '[1,2]' for column 'v' at row 1
INSERT INTO t (v) VALUES ('[1,2,3,4]');
ERROR HY000: Incorrect TVECTOR value: '[1,2,3,4]' for column 'v' at row 1
CREATE TABLE t_float (
id INT AUTO_INCREMENT PRIMARY KEY,
v TVECTOR('dimension=3,type=float')
);
INSERT INTO t_float (v) VALUES ('[1,2,3]');
SELECT id, v FROM t_float ORDER BY id;
id	v
1	[1,2,3]
DROP TABLE t_float;
CREATE TABLE t_err (v TVECTOR('dimension=3,type=int'));
ERROR 42000: TVECTOR: type must be 'float' or 'double', got 'int' near 'TVECTOR('dimension=3,type=int'))' at line 1
CREATE TABLE t_err (v TVECTOR('dimension=3,type='));
ERROR 42000: TVECTOR: type must be 'float' or 'double', got '' near 'TVECTOR('dimension=3,type='))' at line 1
DROP TABLE t, t_nulls;
UNINSTALL EXTENSION vsql_tvector;
