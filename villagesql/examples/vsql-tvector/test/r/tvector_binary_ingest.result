INSERT INTO t VALUES (5, _binary 0x0000803F0000004000004040FF);
ERROR HY000: Incorrect TVECTOR value: '\x00\x00\x80?\x00\x00\x00@\x00\x00@@\xFF' for column 'v' at row 1
INSERT INTO t VALUES (5, _binary 0x5B312C322C335D);
ERROR HY000: Incorrect TVECTOR value: '[1,2,3]' for column 'v' at row 1
