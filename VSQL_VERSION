# When changing the version, update these test result files:
# Automation in villagesql/bld_tools/prepare_release_update.sh uses the "#VUP"
# string to automatically edit these result files.
#VUP   mysql-test/suite/sys_vars/r/villagesql_schema_version_basic.result
#VUP   mysql-test/suite/sys_vars/r/villagesql_server_version_basic.result
#VUP   mysql-test/suite/villagesql/startup/r/init_file_schema_version.result
#VUP   mysql-test/suite/villagesql/startup/r/init_file_install_extension.result
#VUP   mysql-test/suite/villagesql/startup/r/upgrade_basic.result
#VUP   mysql-test/suite/villagesql/startup/r/upgrade_scenarios.result
#VUP   mysql-test/suite/villagesql/startup/r/upgrade_skip_grant_tables.result
# When changing the codebase, also update:
#   mysql-test/suite/villagesql/startup/r/upgrade_minimal.result
# Codebase identifies a named fork that receives VillageSQL changes.
# Versions with different codebase values should not allow upgrades.
VSQL_CODE_BASE=mysql-8.4
VSQL_MAJOR_VERSION=0
VSQL_MINOR_VERSION=0
VSQL_PATCH_VERSION=7
VSQL_PRE_RELEASE_VERSION=dev
